// L_string_eq_helper: pure AArch64. Matches io.rs get_string_data_and_length + silica_string_equals
// (SilicaString tag -1 at offset 0, data at +8, length at +16; else null-terminated C string, cap 1MiB).
// X0/X1 = pointers; W0 = 0/1. No external runtime.
//
// L_string_cmp_helper: same resolve rules; unsigned byte lexicographic order, then shorter prefix first.
// X0/X1 = pointers; W0 = -1 (lt) / 0 (eq) / 1 (gt). Used by string lt/gt/le/ge/eq/nq prims.

export emit_string_eq_helper/0;
export emit_string_cmp_helper/0;

fn emit_string_eq_helper() -> string {
    "L_string_eq_helper:\n    STP X29, X30, [SP, #-16]!\n    STP X19, X20, [SP, #-16]!\n    STP X21, X22, [SP, #-16]!\n    STP X23, X24, [SP, #-16]!\n    STP X25, X26, [SP, #-16]!\n    STP X27, X28, [SP, #-16]!\n    MOV X19, X0\n    MOV X20, X1\n    CBZ X19, Leq_anull\n    CBZ X20, Leq_neq\n    LDR X1, [X19]\n    MVN X2, X1\n    CMP X2, #1\n    B.HI Leq_bad\n    LDR X21, [X19, #8]\n    LDR X22, [X19, #16]\n    LDR X1, [X20]\n    MVN X2, X1\n    CMP X2, #1\n    B.HI Leq_bad\n    LDR X23, [X20, #8]\n    LDR X24, [X20, #16]\nLeq_n2_done:\n    CMP X22, X24\n    B.NE Leq_neq\n    CBZ X22, Leq_yes\n    MOV X25, X21\n    MOV X26, X23\n    MOV X27, X22\nLeq_cloop:\n    LDRB W28, [X25], #1\n    LDRB W0, [X26], #1\n    CMP W28, W0\n    B.NE Leq_neq\n    SUBS X27, X27, #1\n    B.NE Leq_cloop\nLeq_yes:\n    MOV W0, #1\n    B Leq_exit\nLeq_anull:\n    CBZ X20, Leq_yes\n    B Leq_neq\nLeq_neq:\n    MOV W0, #0\nLeq_exit:\n    LDP X27, X28, [SP], #16\n    LDP X25, X26, [SP], #16\n    LDP X23, X24, [SP], #16\n    LDP X21, X22, [SP], #16\n    LDP X19, X20, [SP], #16\n    LDP X29, X30, [SP], #16\n    RET\nLeq_bad:\n    BRK #1\n"
}

fn emit_string_cmp_helper() -> string {
    "L_string_cmp_helper:\n    STP X29, X30, [SP, #-16]!\n    STP X19, X20, [SP, #-16]!\n    STP X21, X22, [SP, #-16]!\n    STP X23, X24, [SP, #-16]!\n    STP X25, X26, [SP, #-16]!\n    STP X27, X28, [SP, #-16]!\n    MOV X19, X0\n    MOV X20, X1\n    CBZ X19, Lcmp_anull\n    CBZ X20, Lcmp_gt\n    LDR X1, [X19]\n    MVN X2, X1\n    CMP X2, #1\n    B.HI Lcmp_bad\n    LDR X21, [X19, #8]\n    LDR X22, [X19, #16]\n    LDR X1, [X20]\n    MVN X2, X1\n    CMP X2, #1\n    B.HI Lcmp_bad\n    LDR X23, [X20, #8]\n    LDR X24, [X20, #16]\nLcmp_n2_done:\n    MOV X25, X22\n    CMP X25, X24\n    B.LS Lcmp_minok\n    MOV X25, X24\nLcmp_minok:\n    CBZ X25, Lcmp_len\n    MOV X26, X21\n    MOV X27, X23\nLcmp_cloop:\n    LDRB W28, [X26], #1\n    LDRB W1, [X27], #1\n    CMP W28, W1\n    B.LO Lcmp_lt\n    B.HI Lcmp_gt\n    SUBS X25, X25, #1\n    B.NE Lcmp_cloop\nLcmp_len:\n    CMP X22, X24\n    B.EQ Lcmp_eq\n    B.LO Lcmp_lt\n    B Lcmp_gt\nLcmp_anull:\n    CBZ X20, Lcmp_eq\nLcmp_lt:\n    MOV W0, #-1\n    B Lcmp_exit\nLcmp_gt:\n    MOV W0, #1\n    B Lcmp_exit\nLcmp_eq:\n    MOV W0, #0\nLcmp_exit:\n    LDP X27, X28, [SP], #16\n    LDP X25, X26, [SP], #16\n    LDP X23, X24, [SP], #16\n    LDP X21, X22, [SP], #16\n    LDP X19, X20, [SP], #16\n    LDP X29, X30, [SP], #16\n    RET\nLcmp_bad:\n    BRK #1\n"
}
