// Fully inline emission for print_int32/print_uint32 built-in
// Const arg: emit write(2) with L_pi32_N label. Var arg: extend W0->X0, BL L_pi_helper or L_pu_helper.

use atom_table;
use int_rodata;
use emitter_effects;

export emit_print_int32_inline/4;
export is_print_int32_const_arg/2;
export is_print_uint32_const_arg/2;
export emit_print_int32_var/3;
export emit_print_uint32_var/3;


// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes)
    produces
        pure result
    end
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
        }
    }
}


fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len(nodes);
            case idx >= n of {
                true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
                false -> {
                    e: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- list_nth(nodes, n - 1 - idx);
                    { kind: e.kind, type_name: e.type_name, value: e.value, name: e.name, inner: e.inner, right_expr: e.right_expr }
                }
            }
        }
    }
}


fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case term.root < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> sir_term_node_at(term.nodes, term.root)
    }
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

fn is_print_int32_const_arg(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> boolean {
    case sir_term_root_node(term).name == "main.print_int32" of {
        false -> false;
        true -> case sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).kind of {
            0 -> sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).type_name == "int32";
            _: int64 -> false
        }
    }
}

fn is_print_uint32_const_arg(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> boolean {
    case sir_term_root_node(term).name == "main.print_uint32" of {
        false -> false;
        true -> case sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).kind of {
            0 -> sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).type_name == "uint32";
            _: int64 -> false
        }
    }
}

fn emit_print_int32_inline(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, int32_table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }) -> string {
    value: string <- sir_term_root_node(sir_term_at(term, sir_term_root_node(term).inner)).value;
    index: int64 <- int_rodata@int32_value_to_index(int32_table, value);
    index_str: string <- atom_table@int64_to_decimal_string(index);
    lp: string <- concat("L_pi32", "_");
    label: string <- concat(lp, index_str);
    length: int64 <- length_bytes(value);
    length_str: string <- atom_table@int64_to_decimal_string(length);
    call_effects: string <- sir_term_root_node(term).value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case length_bytes(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    mov_fd: string <- "    MOV X0, #1\n";
    adrp_part: string <- concat(concat(concat("    ADRP X1, ", label), "@PAGE"), "\n");
    add_part: string <- concat(concat(concat("    ADD X1, X1, ", label), "@PAGEOFF"), "\n");
    mov_count: string <- concat(concat("    MOV X2, #", length_str), "\n");
    syscall_line: string <- "\n    MOV X16, #4\n    SVC #0x80\n";
    ok_index: int64 <- atom_table@ok_atom_index(table);
    ok_index_str: string <- atom_table@int64_to_decimal_string(ok_index);
    result_line: string <- concat(concat("    MOV ", dest), concat(", #", concat(ok_index_str, "\n")));
    with_comment: string <- concat(comment_line, mov_fd);
    with_adrp: string <- concat(with_comment, concat(concat(adrp_part, add_part), concat(mov_count, syscall_line)));
    with_result: string <- concat(with_adrp, result_line);
    with_post: string <- case length_bytes(post_barrier) > 0 of {
        true -> concat(with_result, concat(concat("\n", post_barrier), "\n"));
        false -> concat(with_result, "\n")
    };
    with_pre: string <- case length_bytes(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

fn emit_print_int32_var(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    call_effects: string <- sir_term_root_node(term).value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case length_bytes(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    ext_line: string <- "    SXTW X0, W0\n";
    bl_line: string <- "    BL L_pi_helper\n";
    ok_index: int64 <- atom_table@ok_atom_index(table);
    ok_index_str: string <- atom_table@int64_to_decimal_string(ok_index);
    mov_ret: string <- concat(concat("    MOV ", dest), concat(", #", concat(ok_index_str, "\n")));
    with_comment: string <- concat(comment_line, ext_line);
    with_bl: string <- concat(with_comment, bl_line);
    with_ret: string <- concat(with_bl, mov_ret);
    with_post: string <- case length_bytes(post_barrier) > 0 of {
        true -> concat(with_ret, concat(concat("\n", post_barrier), "\n"));
        false -> with_ret
    };
    with_pre: string <- case length_bytes(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}

fn emit_print_uint32_var(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
    call_effects: string <- sir_term_root_node(term).value;
    eff_comment: string <- emitter_effects@effect_annotation(call_effects);
    pre_barrier: string <- emitter_effects@barrier_before_call(call_effects);
    post_barrier: string <- emitter_effects@barrier_after_call(call_effects);
    comment_line: string <- case length_bytes(eff_comment) > 0 of {
        true -> concat(eff_comment, "\n");
        false -> ""
    };
    ext_line: string <- "    UXTW X0, W0\n";
    bl_line: string <- "    BL L_pu_helper\n";
    ok_index: int64 <- atom_table@ok_atom_index(table);
    ok_index_str: string <- atom_table@int64_to_decimal_string(ok_index);
    mov_ret: string <- concat(concat("    MOV ", dest), concat(", #", concat(ok_index_str, "\n")));
    with_comment: string <- concat(comment_line, ext_line);
    with_bl: string <- concat(with_comment, bl_line);
    with_ret: string <- concat(with_bl, mov_ret);
    with_post: string <- case length_bytes(post_barrier) > 0 of {
        true -> concat(with_ret, concat(concat("\n", post_barrier), "\n"));
        false -> with_ret
    };
    with_pre: string <- case length_bytes(pre_barrier) > 0 of {
        true -> concat(pre_barrier, concat("\n", with_post));
        false -> with_post
    };
    with_pre
}
