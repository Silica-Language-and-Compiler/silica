// Control flow: function prologue/epilogue, case-to-decision-tree (placeholder)
// sir_emitter_pattern_spec §8: case terms handled here when added
// Effect-aware: barriers for register_rwr (DSB SY+ISB), mem(atomic) (DMB ISH) per spec §9.1.1

use emitter_effects;

export function_prologue/1;
export function_epilogue_with_frame/0;
export function_prologue_with_effects/2;
export function_epilogue_with_effects/1;
export function_tail_frame_release/1;

// Emit function prologue: label and STP on one line (matches .ascomp baseline)
fn function_prologue(name: string) -> string {
    stp_on_same_line: string <- ":     STP X29, X30, [SP, #-16]!\n    MOV X29, SP\n";
    concat(name, stp_on_same_line)
}

// Emit function epilogue: restore frame, then return (matches function_prologue)
fn function_epilogue_with_frame() -> string {
    concat("    LDP X29, X30, [SP], #16\n", "    RET")
}

// Effect-aware prologue: label + frame + entry barrier for effectful functions
// mem(atomic): DMB ISH at entry (acquire semantics for function scope)
// device_io: no entry barrier needed (barriers go around individual calls)
fn function_prologue_with_effects(name: string, fn_effects: string) -> string {
    base: string <- function_prologue(name);
    has_atomic: boolean <- case emitter_effects@is_pure(fn_effects) of {
        true -> false;
        false -> emitter_effects@has_mem_atomic(fn_effects)
    };
    case has_atomic of {
        true -> concat(base, "    DMB ISH\n");
        false -> base
    }
}

// Effect-aware epilogue: exit barrier + frame restore + return
// mem(atomic): DMB ISH at exit (release semantics for function scope)
// device_io: no exit barrier needed
fn function_epilogue_with_effects(fn_effects: string) -> string {
    base: string <- function_epilogue_with_frame();
    has_atomic: boolean <- case emitter_effects@is_pure(fn_effects) of {
        true -> false;
        false -> emitter_effects@has_mem_atomic(fn_effects)
    };
    case has_atomic of {
        true -> concat("    DMB ISH\n", base);
        false -> base
    }
}

// Phase 2 / 5 (recursion_implementation.md): release frame before tail transfer (BR).
// Same DMB+LDP ordering as function_epilogue_with_effects but no RET — callee returns to our caller.
fn function_tail_frame_release(fn_effects: string) -> string {
    ldp_only: string <- "    LDP X29, X30, [SP], #16\n";
    has_atomic: boolean <- case emitter_effects@is_pure(fn_effects) of {
        true -> false;
        false -> emitter_effects@has_mem_atomic(fn_effects)
    };
    case has_atomic of {
        true -> concat("    DMB ISH\n", ldp_only);
        false -> ldp_only
    }
}
