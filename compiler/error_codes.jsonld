{
  "@context": {
    "@vocab": "https://aalang.dev/silica-dev/error-code/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "spec": "https://aalang.dev/silica-dev/specification/"
  },
  "@graph": [
    {
      "@id": "error-code-allocation",
      "@type": "ErrorCodeAllocation",
      "name": "Silica Compiler Error Code Allocation",
      "description": "Per silica-error-code-scheme.jsonld and silica-specification.md §1.6",
      "phaseAllocations": [
        {
          "phase": "Lexer",
          "range": "E0001-E0999",
          "category": "LexicalErrors",
          "specificationSection": "spec:§2"
        },
        {
          "phase": "Parser",
          "range": "E1000-E1999",
          "category": "ParseErrors",
          "specificationSection": "spec:§3"
        },
        {
          "phase": "Type checker",
          "range": "E2000-E2999",
          "category": "TypeErrors",
          "specificationSection": "spec:§6"
        },
        {
          "phase": "Effect checker",
          "range": "E3000-E3999",
          "category": "EffectErrors",
          "specificationSection": "spec:§8"
        },
        {
          "phase": "SIR generator",
          "range": "E4000-E4049",
          "category": "CodegenErrors (SIR)",
          "specificationSection": null
        },
        {
          "phase": "Emitter",
          "range": "E4050-E4099",
          "category": "CodegenErrors (emit)",
          "specificationSection": null
        },
        {
          "phase": "Module",
          "range": "E5000-E5999",
          "category": "ModuleErrors",
          "specificationSection": "spec:§11"
        },
        {
          "phase": "Internal",
          "range": "E9000-E9999",
          "category": "InternalErrors",
          "specificationSection": null
        }
      ]
    },
    {
      "@id": "E0001",
      "@type": "LexicalError",
      "errorCode": "E0001",
      "name": "UnexpectedCharacter",
      "description": "a character that begins no token outside string, character and atom literals and comments: ASCII punctuation outside spec §2.2.4 (`$`, `&`, `#`, backtick, `\\`, `~`, `^`), a control character such as NUL, a non-ASCII character, or a byte order mark after the first character (spec §2.1, §2.2; a leading byte order mark is skipped)"
    },
    {
      "@id": "E0002",
      "@type": "LexicalError",
      "errorCode": "E0002",
      "name": "InvalidEscapeSequence",
      "description": "a backslash in a string or character literal that starts none of the escapes of spec §2.2.3 (\\\\ \\' \\\" \\n \\t \\r \\e \\xHH) (spec §2.5)"
    },
    {
      "@id": "E0003",
      "@type": "LexicalError",
      "errorCode": "E0003",
      "name": "UnterminatedStringLiteral",
      "description": "a string literal with no closing `\"` before the end of the file (spec §2.5)"
    },
    {
      "@id": "E0004",
      "@type": "LexicalError",
      "errorCode": "E0004",
      "name": "UnterminatedCharacterLiteral",
      "description": "a character literal with no closing `'` after its one character or escape, or the empty literal `''` (spec §2.2.3, §2.5)"
    },
    {
      "@id": "E0005",
      "@type": "LexicalError",
      "errorCode": "E0005",
      "name": "InvalidNumericLiteral",
      "description": "a malformed numeric literal: `0x` or `0b` without digits, a float exponent without digits, `1.` before the end of the file, `;`, `)`, `,` or `]`, a second `.` (`1.5.2`), or a literal followed directly by a letter, digit or `_` (`12abc`, `0x1G`, `0b102`, `1_000`, `1e5`) (spec §2.2.3, §2.5)"
    },
    {
      "@id": "E0006",
      "@type": "LexicalError",
      "errorCode": "E0006",
      "name": "UnterminatedBlockComment",
      "description": "a `{-` block comment with no closing `-}` before the end of the file (spec §2.3.2)"
    },
    {
      "@id": "E0007",
      "@type": "LexicalError",
      "errorCode": "E0007",
      "name": "InvalidUtf8",
      "description": "the source bytes do not form UTF-8: a lone continuation byte, a lead byte C0, C1 or F5-FF, a truncated sequence, an overlong form, a surrogate, or a value above U+10FFFF, anywhere in the file including literals and comments (spec §2.1)"
    },
    {
      "@id": "E1000",
      "@type": "ParseError",
      "errorCode": "E1000",
      "name": "ParseErrorDefault",
      "description": "uncategorized syntactic defect (statement-boundary fall-through when the next token does not start another statement)"
    },
    {
      "@id": "E1001",
      "@type": "ParseError",
      "errorCode": "E1001",
      "name": "ParseFailureNoCode",
      "description": "fallback reported by the driver when parsing failed and the parser supplied no code of its own"
    },
    {
      "@id": "E1009",
      "@type": "ParseError",
      "errorCode": "E1009",
      "name": "UnknownModuleInUse",
      "description": "`use` names a module that is not in the configured file set (module checker, spec 19.3)"
    },
    {
      "@id": "E1010",
      "@type": "ParseError",
      "errorCode": "E1010",
      "name": "QualifiedCallWithoutUse",
      "description": "a module-qualified call has no matching `use` for its module prefix, or the prefix does not match the `use` spelling (module checker, spec 19.3)"
    },
    {
      "@id": "E1011",
      "@type": "ParseError",
      "errorCode": "E1011",
      "name": "CallNotInExportSurface",
      "description": "a cross-module call names a function that the target module does not export (module checker, spec 19.2)"
    },
    {
      "@id": "E1040",
      "@type": "ParseError",
      "errorCode": "E1040",
      "name": "MissingStatementTerminator",
      "description": "expected `;` after a statement before the next statement"
    },
    {
      "@id": "E1041",
      "@type": "ParseError",
      "errorCode": "E1041",
      "name": "UnexpectedTrailingSemicolon",
      "description": "the last expression in a block must not be followed by `;`"
    },
    {
      "@id": "E1042",
      "@type": "ParseError",
      "errorCode": "E1042",
      "name": "MissingReturnType",
      "description": "function declaration without `-> <type>` before its body"
    },
    {
      "@id": "E1043",
      "@type": "ParseError",
      "errorCode": "E1043",
      "name": "BindingNameColonSpacing",
      "description": "a variable declaration name must be followed immediately by `:` with no whitespace"
    },
    {
      "@id": "E1044",
      "@type": "ParseError",
      "errorCode": "E1044",
      "name": "AtomLiteralSpacing",
      "description": "atom literal `:` must be followed immediately by the atom name with no whitespace"
    },
    {
      "@id": "E1045",
      "@type": "ParseError",
      "errorCode": "E1045",
      "name": "MissingFnPrefix",
      "description": "function declaration is missing the `fn` prefix"
    },
    {
      "@id": "E1046",
      "@type": "ParseError",
      "errorCode": "E1046",
      "name": "UnexpectedTokenAfterRecordItems",
      "description": "unexpected token after the last item in a struct/record; close it with `}`"
    },
    {
      "@id": "E1047",
      "@type": "ParseError",
      "errorCode": "E1047",
      "name": "NamedStructOrTypeAlias",
      "description": "named struct declaration or named type alias declaration is not allowed; types are declared inline where used"
    },
    {
      "@id": "E1048",
      "@type": "ParseError",
      "errorCode": "E1048",
      "name": "ProducesWithoutSequence",
      "description": "`produces` appears without a preceding `sequence`"
    },
    {
      "@id": "E1049",
      "@type": "ParseError",
      "errorCode": "E1049",
      "name": "SequenceMissingProduces",
      "description": "sequence block is missing `produces`"
    },
    {
      "@id": "E1050",
      "@type": "ParseError",
      "errorCode": "E1050",
      "name": "ProducesMissingPure",
      "description": "sequence `produces` clause is missing `pure`"
    },
    {
      "@id": "E1051",
      "@type": "ParseError",
      "errorCode": "E1051",
      "name": "SequenceMissingEnd",
      "description": "sequence block is missing its closing `end`"
    },
    {
      "@id": "E1052",
      "@type": "ParseError",
      "errorCode": "E1052",
      "name": "DuplicateSequenceKeyword",
      "description": "duplicate `sequence` keyword in a sequence block"
    },
    {
      "@id": "E1053",
      "@type": "ParseError",
      "errorCode": "E1053",
      "name": "DuplicateProducesKeyword",
      "description": "duplicate `produces` keyword in a sequence block"
    },
    {
      "@id": "E1054",
      "@type": "ParseError",
      "errorCode": "E1054",
      "name": "ExtraEndAfterSequence",
      "description": "extra `end` after a sequence block"
    },
    {
      "@id": "E1055",
      "@type": "ParseError",
      "errorCode": "E1055",
      "name": "UnusedVariable",
      "description": "a binding is never used in its scope (use it, pass it on, return it, or bind it as `_`)"
    },
    {
      "@id": "E1056",
      "@type": "ParseError",
      "errorCode": "E1056",
      "name": "EmptyProcOnPureSequence",
      "description": "empty `proc[]` on a pure sequence block"
    },
    {
      "@id": "E1057",
      "@type": "ParseError",
      "errorCode": "E1057",
      "name": "SequenceAsArrowRhs",
      "description": "sequence...produces pure...end cannot be the right-hand side of `->`; use a `{ ... }` block"
    },
    {
      "@id": "E1058",
      "@type": "ParseError",
      "errorCode": "E1058",
      "name": "ReservedKeywordAsBindingName",
      "description": "a reserved keyword used as a variable binding name"
    },
    {
      "@id": "E1059",
      "@type": "ParseError",
      "errorCode": "E1059",
      "name": "ReservedKeywordAsFieldName",
      "description": "a reserved keyword used as a record field name"
    },
    {
      "@id": "E1060",
      "@type": "ParseError",
      "errorCode": "E1060",
      "name": "UnbalancedDelimiters",
      "description": "unbalanced brackets, braces or parentheses"
    },
    {
      "@id": "E1061",
      "@type": "ParseError",
      "errorCode": "E1061",
      "name": "NamedStructConstruction",
      "description": "named struct construction is not allowed; use an anonymous record `{ field: ... }`"
    },
    {
      "@id": "E1062",
      "@type": "ParseError",
      "errorCode": "E1062",
      "name": "IncompleteListReturnType",
      "description": "`List` return type written without type arguments before the function body"
    },
    {
      "@id": "E1063",
      "@type": "ParseError",
      "errorCode": "E1063",
      "name": "UnclosedListTypeBracket",
      "description": "`List[` type with no matching `]`"
    },
    {
      "@id": "E1064",
      "@type": "ParseError",
      "errorCode": "E1064",
      "name": "UnbracedMultiStatementArm",
      "description": "a multi-statement case arm must be wrapped in `{ ... }`"
    },
    {
      "@id": "E1065",
      "@type": "ParseError",
      "errorCode": "E1065",
      "name": "UnclosedFunctionParameterList",
      "description": "function body `{` began before `)` closed the parameter list"
    },
    {
      "@id": "E1066",
      "@type": "ParseError",
      "errorCode": "E1066",
      "name": "IfOutsideCaseGuard",
      "description": "`if` is only valid as a case-arm guard"
    },
    {
      "@id": "E1067",
      "@type": "ParseError",
      "errorCode": "E1067",
      "name": "ReturnedCapturingFunctionLiteral",
      "description": "a function literal that captures local bindings cannot be returned from the function that owns them"
    },
    {
      "@id": "E1068",
      "@type": "ParseError",
      "errorCode": "E1068",
      "name": "IntrinsicNamedFunction",
      "description": "a module function or export line is named after an actor runtime intrinsic (`link`, `monitor`, `demonitor`; spec 15.4.8.5-15.4.8.6), which `Q@name(...)` always resolves to instead of the export"
    },
    {
      "@id": "E1069",
      "@type": "ParseError",
      "errorCode": "E1069",
      "name": "FunctionBodyNotParsed",
      "description": "a function declaration whose body the parser could not extract (for example a qualified call whose function name is a keyword)"
    },
    {
      "@id": "E1070",
      "@type": "ParseError",
      "errorCode": "E1070",
      "name": "FunctionTooManyParameters",
      "description": "a function has more than 8 parameters (parse time)"
    },
    {
      "@id": "E1071",
      "@type": "ParseError",
      "errorCode": "E1071",
      "name": "FunctionLiteralMissingReturnType",
      "description": "a function literal has no `-> type` before its body (the return type is never inferred, and the retired `: type` form is rejected; spec 3.3.6)"
    },
    {
      "@id": "E1072",
      "@type": "ParseError",
      "errorCode": "E1072",
      "name": "UnsupportedFunctionLiteralCapture",
      "description": "a function literal captures a binding that is not an integer-typed binding of an integer literal where the literal is written (a parameter, a computed value, a non-integer literal, a rebound name or an enclosing literal's formal); closure environments are not supported (spec 3.3.6)"
    },
    {
      "@id": "E1080",
      "@type": "ParseError",
      "errorCode": "E1080",
      "name": "ForeignDeclarationSyntax",
      "description": "malformed FFI surface (for example wrapper_meta not followed by a string literal path and `;`)"
    },
    {
      "@id": "E2000",
      "@type": "TypeError",
      "errorCode": "E2000",
      "name": "TypeErrorDefault",
      "description": "fallback reported by the driver when type checking failed and no code was supplied"
    },
    {
      "@id": "E2001",
      "@type": "TypeError",
      "errorCode": "E2001",
      "name": "TypeMismatch",
      "description": "a literal does not fit the expected type (atom literal needs an atom type; unit literal; numeric literal where char or string is required; integer literal required, got float literal)"
    },
    {
      "@id": "E2002",
      "@type": "TypeError",
      "errorCode": "E2002",
      "name": "UndefinedIdentifier",
      "description": "undefined identifier; also the misspelling `bool` where `boolean` was meant"
    },
    {
      "@id": "E2003",
      "@type": "TypeError",
      "errorCode": "E2003",
      "name": "TypeUnificationFailure",
      "description": "a type does not match the expected type (many sites): builtin or call result type differs from the expected type, invalid return type, record or tuple literal matches no variant, malformed inline record type, argument type mismatch, no trait implementation matches an argument, negation not supported for unit"
    },
    {
      "@id": "E2004",
      "@type": "TypeError",
      "errorCode": "E2004",
      "name": "UnknownOperator",
      "description": "unknown operator"
    },
    {
      "@id": "E2005",
      "@type": "TypeError",
      "errorCode": "E2005",
      "name": "InvalidCaseOrBuiltinShape",
      "description": "structural errors, several meanings: invalid or unsupported case pattern; case pattern does not match scrutinee type; malformed case branch; case on boolean must cover true and false or include a wildcard; case with no branch; cannot infer scrutinee, field or struct-literal type; wrong argument count for a builtin (expects N arguments); builtin requires a tuple type; actor behavior must take (message, state) or must be a function; ill-formed struct literal; no such field; unknown list, region, collection or actor builtin; tuple decomposition shape mismatch; internal dispatcher miss"
    },
    {
      "@id": "E2006",
      "@type": "TypeError",
      "errorCode": "E2006",
      "name": "InvalidTypeUse",
      "description": "`unit` is not a valid return type or variable/parameter type; single-element tuples are not allowed; lambda parameter needs an explicit type"
    },
    {
      "@id": "E2007",
      "@type": "TypeError",
      "errorCode": "E2007",
      "name": "UnknownFunction",
      "description": "unknown function, or an unqualified call to a function defined only in another module (imported functions are called module-qualified); also unknown behavior function in spawn builtins"
    },
    {
      "@id": "E2008",
      "@type": "TypeError",
      "errorCode": "E2008",
      "name": "CaseMissingCatchAllArm",
      "description": "a case over an integer type or string must end with a typed catch-all arm `_: T ->` (a bare `_ ->` does not count); also a catch-all arm that is not last"
    },
    {
      "@id": "E2009",
      "@type": "TypeError",
      "errorCode": "E2009",
      "name": "SumRecordVariantFieldTypeConflict",
      "description": "record variants in one sum type share a field name with different types"
    },
    {
      "@id": "E2010",
      "@type": "TypeError",
      "errorCode": "E2010",
      "name": "InvalidMemoryRegionType",
      "description": "invalid memory region type or declaration: buf/ref parameter count, empty region or element type, invalid memory space, runtime length identifier, read_ref/read_buf operand types, alloc_region space, rec outside any tuple type (binding annotation today; record field, parameter type and return type to follow: rec binds to the innermost enclosing tuple type and an unbound rec is an error)"
    },
    {
      "@id": "E2011",
      "@type": "TypeError",
      "errorCode": "E2011",
      "name": "IntegerLiteralOutOfRange",
      "description": "integer literal is out of range for its type"
    },
    {
      "@id": "E2012",
      "@type": "TypeError",
      "errorCode": "E2012",
      "name": "TupleDecomposeBindingOverflow",
      "description": "tuple decomposition pattern has more elements than the register file supports"
    },
    {
      "@id": "E2013",
      "@type": "TypeError",
      "errorCode": "E2013",
      "name": "UnaryMinusNotAllowed",
      "description": "unary minus is not allowed; use negate_<type>(...)"
    },
    {
      "@id": "E2014",
      "@type": "TypeError",
      "errorCode": "E2014",
      "name": "CaseGuardDoesNotDependOnBindings",
      "description": "a case guard does not depend on the arm's bindings"
    },
    {
      "@id": "E2015",
      "@type": "TypeError",
      "errorCode": "E2015",
      "name": "CollectionMissingMemorySpace",
      "description": "a collection builtin requires an explicit `mem(Space)`"
    },
    {
      "@id": "E2016",
      "@type": "TypeError",
      "errorCode": "E2016",
      "name": "EmptyListRequiresTypedBinding",
      "description": "empty[...]() needs a typed List binding, or the List type cannot be resolved"
    },
    {
      "@id": "E2017",
      "@type": "TypeError",
      "errorCode": "E2017",
      "name": "CollectionConstructorTypeError",
      "description": "collection constructor error: missing or ill-typed compare_item / compare_node / compare_edge_data / compare_key / compare_value witness, constructor must call empty/1 or with_root/2, invalid OrderedSet/OrderedMap/Heap/SearchTree/Tree type declaration"
    },
    {
      "@id": "E2018",
      "@type": "TypeError",
      "errorCode": "E2018",
      "name": "BindingMissingTypeAnnotation",
      "description": "a variable binding has no type annotation"
    },
    {
      "@id": "E2019",
      "@type": "TypeError",
      "errorCode": "E2019",
      "name": "MainReturnTypeInvalid",
      "description": "main must return an integer, float or atom"
    },
    {
      "@id": "E2020",
      "@type": "TypeError",
      "errorCode": "E2020",
      "name": "AmbiguousBuiltinCallName",
      "description": "an unqualified call names both a builtin and a function of the calling module; the module's function is called as module@name (also from inside that module), a builtin is always called unqualified"
    },
    {
      "@id": "E2090",
      "@type": "TypeError",
      "errorCode": "E2090",
      "name": "SupervisorTraitShape",
      "description": "Supervisor or FailureReporter trait/impl shape error: required methods (init; region_dump_limit, handle_report), parameter and return types (spec 15.4.13)"
    },
    {
      "@id": "E2091",
      "@type": "TypeError",
      "errorCode": "E2091",
      "name": "ActorOperationPlacement",
      "description": "spawn_linked, link, monitor, demonitor, child_table_first_ref, kill_abnormal, stop_self and fail_self calls only inside an actor behavior; wait_for_exit only inside main/0; spawn_linked is no longer public; add_child parent must be a Supervisor actor_ref"
    },
    {
      "@id": "E2092",
      "@type": "TypeError",
      "errorCode": "E2092",
      "name": "SupervisorInitSignature",
      "description": "Supervisor impl must declare init/1 with one ActorState parameter (spec 15.4.13.1)"
    },
    {
      "@id": "E2093",
      "@type": "TypeError",
      "errorCode": "E2093",
      "name": "InvalidChildSpecAgentType",
      "description": "child_spec agent_type must be a literal :worker or :supervisor"
    },
    {
      "@id": "E2094",
      "@type": "TypeError",
      "errorCode": "E2094",
      "name": "InvalidChildSpecFlavor",
      "description": "child_spec flavor must be a literal :plain or :dangerous; :dangerous requires an id starting with :dangerous_"
    },
    {
      "@id": "E2095",
      "@type": "TypeError",
      "errorCode": "E2095",
      "name": "DangerousChildNeedsCastBehavior",
      "description": "a :dangerous child_spec requires a cast-type behavior returning (:no_reply, State)"
    },
    {
      "@id": "E2100",
      "@type": "TypeError",
      "errorCode": "E2100",
      "name": "ExternalDangerTaintInProduced",
      "description": "external_danger-touched data appears in the produced value of a sequence proc[external_danger]"
    },
    {
      "@id": "E2101",
      "@type": "TypeError",
      "errorCode": "E2101",
      "name": "ExternalDangerRegionInMessage",
      "description": "external_danger regions in an ordinary call reply or cast payload; only FFI result casts are permitted"
    },
    {
      "@id": "E2102",
      "@type": "TypeError",
      "errorCode": "E2102",
      "name": "ExternalDangerRegionEscape",
      "description": "external_danger regions move out of the FFI worker behavior"
    },
    {
      "@id": "E2103",
      "@type": "TypeError",
      "errorCode": "E2103",
      "name": "ExternalDangerInEffectfulSequence",
      "description": "external_danger-touched data used inside sequence blocks that declare device_io, network_io, hot_swap or register_rwr (spec 7.3)"
    },
    {
      "@id": "E2110",
      "@type": "TypeError",
      "errorCode": "E2110",
      "name": "RawForeignStringBinding",
      "description": "raw foreign c_wrapper bindings use Silica string arguments or return one; use pointer-plus-length"
    },
    {
      "@id": "E2111",
      "@type": "TypeError",
      "errorCode": "E2111",
      "name": "ForeignTooManyArguments",
      "description": "foreign c_wrapper declaration has more than eight Silica-level arguments after lowering"
    },
    {
      "@id": "E2112",
      "@type": "TypeError",
      "errorCode": "E2112",
      "name": "ForeignDisallowedReturnType",
      "description": "foreign c_wrapper declaration uses a disallowed Silica-facing return type"
    },
    {
      "@id": "E2113",
      "@type": "TypeError",
      "errorCode": "E2113",
      "name": "SidecarResultShapeMismatch",
      "description": "sidecar result kind (scalar, tagged_result, struct) does not match the foreign return type"
    },
    {
      "@id": "E2114",
      "@type": "TypeError",
      "errorCode": "E2114",
      "name": "AdapterStringBindingMismatch",
      "description": "adapter wrapper with string parameter or result requires a raw binding with pointer-plus-length fields"
    },
    {
      "@id": "E2201",
      "@type": "TypeError",
      "errorCode": "E2201",
      "name": "DuplicateDeviceDescription",
      "description": "a second device description for one device tag"
    },
    {
      "@id": "E2202",
      "@type": "TypeError",
      "errorCode": "E2202",
      "name": "MalformedDeviceDescription",
      "description": "device description body must be a single list literal of literal register records"
    },
    {
      "@id": "E2203",
      "@type": "TypeError",
      "errorCode": "E2203",
      "name": "DuplicateRegisterName",
      "description": "device description lists a register twice"
    },
    {
