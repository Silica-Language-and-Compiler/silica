// The supervision tree of the transit examples (transit_mesh_tcp, transit_hub_spoke_tcp, transit_two_hubs_tcp):
//
//   transit_sup           the root supervisor, started by main with spawn_registered_supervisor
//    |- actors_sup        a :supervisor child: the coordinator and every link, session and dialer actor
//    `- carriers_sup      a :supervisor child: every (:tcp) carrier (the listener, the dialing carriers and the
//                         accepted connections)
//
// Both sub-supervisors start with no children. Each program adds its actors and carriers at run time as :temporary
// children with call_supervisor(<sub-supervisor>, { op: :add_child, ... }); it finds the sub-supervisor with
// call_supervisor(transit_sup, { op: :get_child, id: :actors_sup }) (or :carriers_sup). A :temporary child that ends is
// not restarted, so a normal end of a connection leaves nothing to clean up, and any failure is reported to the
// FailureReporter that each program registers before it starts this tree.
//
// A supervisor's child rows are typed. Both sub-supervisors are rows of the same list in the root, so they share one
// start function (transit_sub_start) and one declared row type for their children, the carrier's. The actors added to
// actors_sup have other state and behaviour types; add_child takes them all the same, as the earlier single-supervisor
// form of this example already did.
module transit_sup;

use Supervisor;

impl TransitSup for Supervisor;

export start/0;
export transit_sub_start/1;

fn sub_init(_initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string },
            behavior: fn(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll, state: { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string }) -> (:no_reply, { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string }),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous, state_policy: state_policy
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        flags: {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        } <- { strategy: :one_for_one, allowed_restart_count: 2, restarts_time_frame: 60 };
        children: List[
            {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string },
                behavior: fn(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll, state: { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string }) -> (:no_reply, { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string }),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous, state_policy: state_policy
            },
            mem(normal)
        ] <- empty[
            {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string },
                behavior: fn(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll, state: { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string }) -> (:no_reply, { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string }),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous, state_policy: state_policy
            },
            mem(normal)
        ]()
    produces
        pure (flags, children)
    end
}

// The start function of both sub-supervisors (a :supervisor row names it as its behaviour).
fn transit_sub_start(initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string },
            behavior: fn(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll, state: { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string }) -> (:no_reply, { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string }),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous, state_policy: state_policy
        },
        mem(normal)
    ]
) {
    sub_init(initial_state)
}

fn init(_initial_state: int64) -> (
    {
        strategy: :one_for_one | :one_for_all | :rest_for_one,
        allowed_restart_count: int64,
        restarts_time_frame: int64
    },
    List[
        {
            id: atom,
            agent_type: :worker | :supervisor,
            initial_state: int64,
            behavior: fn(initial_state: int64) -> (
                {
                    strategy: :one_for_one | :one_for_all | :rest_for_one,
                    allowed_restart_count: int64,
                    restarts_time_frame: int64
                },
                List[
                    {
                        id: atom,
                        agent_type: :worker | :supervisor,
                        initial_state: { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string },
                        behavior: fn(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll, state: { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string }) -> (:no_reply, { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string }),
                        restart: :permanent | :temporary | :transient,
                        shutdown: int64,
                        flavor: :plain | :dangerous, state_policy: state_policy
                    },
                    mem(normal)
                ]
            ),
            restart: :permanent | :temporary | :transient,
            shutdown: int64,
            flavor: :plain | :dangerous, state_policy: state_policy
        },
        mem(normal)
    ]
) {
    sequence proc[mem(normal)]
        flags: {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        } <- { strategy: :one_for_one, allowed_restart_count: 2, restarts_time_frame: 60 };
        children: List[
            {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: int64,
                behavior: fn(initial_state: int64) -> (
                    {
                        strategy: :one_for_one | :one_for_all | :rest_for_one,
                        allowed_restart_count: int64,
                        restarts_time_frame: int64
                    },
                    List[
                        {
                            id: atom,
                            agent_type: :worker | :supervisor,
                            initial_state: { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string },
                            behavior: fn(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | :poll, state: { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string }) -> (:no_reply, { owner: actor_ref, fd: int64, rx_credit: int64, up: boolean, listening: boolean, link_spec: string }),
                            restart: :permanent | :temporary | :transient,
                            shutdown: int64,
                            flavor: :plain | :dangerous, state_policy: state_policy
                        },
                        mem(normal)
                    ]
                ),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous, state_policy: state_policy
            },
            mem(normal)
        ] <- [
            { id: :actors_sup, agent_type: :supervisor, initial_state: 0, behavior: transit_sub_start, restart: :permanent, shutdown: 0, flavor: :plain, state_policy: state_policy(:keep_state_area) },
            { id: :carriers_sup, agent_type: :supervisor, initial_state: 0, behavior: transit_sub_start, restart: :permanent, shutdown: 0, flavor: :plain, state_policy: state_policy(:keep_state_area) }
        ]
    produces
        pure (flags, children)
    end
}

// Starts the root supervisor, and with it actors_sup and carriers_sup. The caller has registered its FailureReporter
// first (E2236).
fn start() -> supervisor_ref {
    sequence proc[concurrency]
        sup: supervisor_ref <- spawn_registered_supervisor(TransitSup, 0, :transit_sup, stack_policy(0, :keep_last_message), state_policy(:keep_state_area))
    produces
        pure sup
    end
}
