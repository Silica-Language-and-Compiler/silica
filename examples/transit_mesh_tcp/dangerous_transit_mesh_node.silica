// One node of the five-node full mesh (examples/transit_mesh_tcp, run.sh). Five copies of this program run as five
// OS processes on one Mac, over 127.0.0.1. Every pair of nodes shares ONE direct TCP connection, so there are ten
// connections. The lower-numbered node of a pair dials and the higher-numbered node listens: node n listens on
// 127.0.0.1:(4599 + n) and dials every node above it.
//
// The messages are ETF terms behind wireframe's 4-byte length prefix (Erlang's gen_tcp {packet, 4}):
//
//   (:request, src: int64, id: int64)      id = 10 * src + dest, so it names the pair and the direction
//   (:reply,   src: int64, id: int64)      the same id, sent back over the same connection
//
// The dialer sends its request as soon as the connection is up. The listener does not know who dialed until a
// request arrives (its `src`), so it answers that request and then sends its own request to that node. Each side
// matches the reply it gets to its request by id. A node is done when all four of its connections are done (a reply
// received, the peer's request answered, every :tx confirmed). It then prints "node N: 4 of 4 replies", waits 1.5 s
// for its peers to read the last frames, and exits 0.
//
// The node number is the only difference between the five copies. This language has no command line arguments and no
// environment access, so run.sh makes the five copies with sed from this one file (it rewrites `my_node` only).
//
// Actors. The coordinator listens (nodes 2 to 5), starts one dialer actor per higher node, and gives every accepted
// connection a session actor. Dialers and sessions are one behaviour, `peer_link`, with one state record (`dials` tells
// them apart). A dialer is not retried: run.sh starts a node only after the listeners it dials are accepting
// connections. Frames go out through an outbox: a frame goes out only while a transmit credit is in hand.
//
// Supervision. main registers a failure reporter and starts the root supervisor transit_sup (../transit_common), whose
// two :supervisor children are actors_sup (the coordinator and every link, session and dialer actor) and carriers_sup
// (every carrier). Each actor and carrier is added as a :temporary child of its sub-supervisor with call_supervisor
// (add_child); no carrier is started with spawn_dangerous_carrier. The reporter drops reports whose reason is :normal and writes any other to stderr.
// A listener hands the accepted descriptor to its owner as (:accepted, fd, peer); the owner starts the carrier.
//
// SECURITY: the (:tcp) carrier is plain TCP, with no authentication, no encryption and no peer identity: anyone who
// can reach a listening port can connect and send frames. Here the carrier is declared (:loopback), so every listener
// is on 127.0.0.1 and no other host can reach it.
//
// No completion within 45 s prints "node N: timeout, K of 4 replies" and exits 5.
module dangerous_transit_mesh_node;

use wire_etf;
use wireframe;
use Carrier;
use dangerous_sockets;
use dangerous_tcp_carrier;
use transit_sup;

carried_on wire: (:tcp) (:loopback);

// ---- The one per-copy setting (run.sh rewrites this line) ----
fn my_node() -> int64 { 1 }

fn node_count() -> int64 { 5 }

fn peer_count() -> int64 { 4 }

// The credits a connection carrier grants at :link_up. All :tx are confirmed when they are all back.
fn tx_credits() -> int64 { 8 }

fn timeout_ms() -> uint64 { 45000 }

fn listen_address(n: int64) -> string {
    case n == 1 of { true -> "listen:4600"; false ->
    case n == 2 of { true -> "listen:4601"; false ->
    case n == 3 of { true -> "listen:4602"; false ->
    case n == 4 of { true -> "listen:4603"; false -> "listen:4604" } } } }
}

fn dial_address(n: int64) -> string {
    case n == 1 of { true -> "127.0.0.1:4600:3000"; false ->
    case n == 2 of { true -> "127.0.0.1:4601:3000"; false ->
    case n == 3 of { true -> "127.0.0.1:4602:3000"; false ->
    case n == 4 of { true -> "127.0.0.1:4603:3000"; false -> "127.0.0.1:4604:3000" } } } }
}

// ---- Helpers ----
fn first_segment(xs: List[string, mem(normal)]) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, _t: List[string, mem(normal)]] -> h
    }
}

fn segment_of(frame: string) -> string {
    segs: List[string, mem(normal)] <- wireframe@frame(frame, Carrier@mtu(wire), Carrier@boundaries(wire));
    first_segment(segs)
}

// Each term is bound to an annotated name before encode, as in ../transport_pairs/ethernet_direct.
fn request_segment(src: int64, id: int64) -> string {
    sequence proc[mem(normal), transport]
        msg: (:request, int64, int64) <- (:request, src, id);
        frame: string <- encode((:etf), msg)
    produces
        pure segment_of(frame)
    end
}

fn reply_segment(src: int64, id: int64) -> string {
    sequence proc[mem(normal), transport]
        msg: (:reply, int64, int64) <- (:reply, src, id);
        frame: string <- encode((:etf), msg)
    produces
        pure segment_of(frame)
    end
}

// One line of output: "node N: <label> id=I peer=P".
fn say_msg(label: string, id: int64, who: int64) -> atom {
    sequence proc[device_io]
        me: int64 <- my_node();
        _: atom <- print("node ");
        _: atom <- print_int64(me);
        _: atom <- print(": ");
        _: atom <- print(label);
        _: atom <- print(" id=");
        _: atom <- print_int64(id);
        _: atom <- print(" peer=");
        _: atom <- print_int64(who);
        _: atom <- println("")
    produces
        pure :ok
    end
}

fn say(label: string, why: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print_atom(why);
        _: atom <- println("")
    produces
        pure :ok
    end
}

// ---- Supervision: every actor is a :temporary child of actors_sup and every carrier a :temporary child of carriers_sup, both children of the root supervisor transit_sup ----
// The failure reporter takes every report the runtime hands over. A report whose reason is :normal (a connection that
// ended in the ordinary way) is not printed. Any other report is written to standard error, so a real failure is
// never hidden.
fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        is_normal: boolean <- contains(report, "reason:          :normal\n");
        _: atom <- case is_normal of {
            true -> :ok;
            false -> println_stderr(report)
        }
    produces
        pure (:no_reply, state)
    end
}

// Child ids are registered names, so each live child has its own: :dcar_2 to :dcar_5 and :dial_2 to :dial_5 for the
// carriers and dialers of this node, :conn_1 to :conn_4 and :ses_1 to :ses_4 for its accepted connections.
fn dcar_id(k: int64) -> atom {
    case k == 2 of { true -> :dcar_2; false ->
    case k == 3 of { true -> :dcar_3; false ->
    case k == 4 of { true -> :dcar_4; false ->
    :dcar_5 } } }
}

fn dial_id(k: int64) -> atom {
    case k == 2 of { true -> :dial_2; false ->
    case k == 3 of { true -> :dial_3; false ->
    case k == 4 of { true -> :dial_4; false ->
    :dial_5 } } }
}

fn conn_id(k: int64) -> atom {
    case k == 1 of { true -> :conn_1; false ->
    case k == 2 of { true -> :conn_2; false ->
    case k == 3 of { true -> :conn_3; false ->
    :conn_4 } } }
}

fn ses_id(k: int64) -> atom {
    case k == 1 of { true -> :ses_1; false ->
    case k == 2 of { true -> :ses_2; false ->
    case k == 3 of { true -> :ses_3; false ->
    :ses_4 } } }
}

// A (:tcp) carrier as a child: fd is an accepted descriptor, or -1 for a carrier that dials or listens. spec is the
// carrier's link ("loopback" for a dialer or listener, "" for an accepted connection).
fn start_carrier(sup: supervisor_ref, id: atom, fd: int64, spec: string) -> actor_ref {
    sequence
        sub: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sup, { op: :get_child, id: :carriers_sup } impl SupervisorMessage {});
        added: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sub.child, {
            op: :add_child,
            child: {
                id: id,
                agent_type: :worker,
                initial_state: { owner: actor_ref_of_word(0), fd: fd, rx_credit: 0, up: false, listening: false, link_spec: spec },
                behavior: dangerous_tcp_carrier@carrier,
                restart: :temporary,
                shutdown: 0,
                flavor: :dangerous, state_policy: state_policy(:keep_state_area)
            }
        } impl SupervisorMessage {})
    produces
        pure added.child
    end
}

// A link actor (a dialer or a session) as a child.
fn start_link(sup: supervisor_ref, id: atom, st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }) -> actor_ref {
    sequence
        sub: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sup, { op: :get_child, id: :actors_sup } impl SupervisorMessage {});
        added: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sub.child, {
            op: :add_child,
            child: {
                id: id,
                agent_type: :worker,
                initial_state: st,
                behavior: peer_link,
                restart: :temporary,
                shutdown: 0,
                flavor: :plain, state_policy: state_policy(:keep_state_area)
            }
        } impl SupervisorMessage {})
    produces
        pure added.child
    end
}

// The coordinator as a child.
fn start_coordinator(sup: supervisor_ref, id: atom, st: { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 }) -> actor_ref {
    sequence
        sub: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sup, { op: :get_child, id: :actors_sup } impl SupervisorMessage {});
        added: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sub.child, {
            op: :add_child,
            child: {
                id: id,
                agent_type: :worker,
                initial_state: st,
                behavior: coordinator,
                restart: :temporary,
                shutdown: 0,
                flavor: :plain, state_policy: state_policy(:keep_state_area)
            }
        } impl SupervisorMessage {})
    produces
        pure added.child
    end
}

// ---- A link actor: the dialer to a higher node, or the session of an accepted connection ----
// stage: 1 = this side's reply received, 2 = the peer's request answered, 3 = both, 7 = reported to the coordinator.
fn mk(car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    { car: car, coord: coord, rx: rx, credit: credit, out: out, peer: peer, dials: dials, stage: stage }
}

fn p_flush(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    sequence proc[concurrency]
        go: boolean <- length_bytes(st.out) > 0 and st.credit > 0;
        _: boolean <- case go of {
            true -> cast(st.car, (:tx, st.out, self()) impl ActorMessage {});
            false -> false
        };
        next: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } <- case go of {
            true -> mk(st.car, st.coord, st.rx, st.credit - 1, "", st.peer, st.dials, st.stage);
            false -> st
        }
    produces
        pure next
    end
}

fn p_post(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }, seg: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    p_flush(mk(st.car, st.coord, st.rx, st.credit, concat(st.out, seg), st.peer, st.dials, st.stage))
}

fn p_said(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }, _o: atom) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    st
}

// Connected (the dialer) or accepted (a session): grant receive credit; the dialer sends its request.
fn p_link_up(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    sequence proc[concurrency]
        _: boolean <- cast(st.car, (:credit, 4) impl ActorMessage {})
    produces
        pure p_dialer_request(st)
    end
}

fn p_dialer_request(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    case st.dials of {
        true -> p_post(st, request_segment(my_node(), 10 * my_node() + st.peer));
        false -> st
    }
}

// A link_down: the connection ended. Nothing is retried here: run.sh starts every node only after the listeners it dials
// are accepting connections, and a :temporary carrier that ended is not restarted.
fn p_link_down(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    st
}

fn p_tx_credit(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }, n: int64) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    p_maybe_done(p_flush(mk(st.car, st.coord, st.rx, st.credit + n, st.out, st.peer, st.dials, st.stage)))
}

// Done: the reply is in, the peer's request is answered, every :tx is confirmed.
fn p_maybe_done(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    done: boolean <- st.stage == 3 and st.credit == tx_credits() and length_bytes(st.out) == 0;
    case done of {
        true -> p_done(st);
        false -> st
    }
}

fn p_done(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    sequence proc[concurrency]
        _: boolean <- cast(st.coord, :link_done impl ActorMessage {})
    produces
        pure mk(st.car, st.coord, st.rx, st.credit, st.out, st.peer, st.dials, 7)
    end
}

// ---- Frames in ----
fn p_with_rx(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }, rx: { mode: atom, expected: int64, pending: string }) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    mk(st.car, st.coord, rx, st.credit, st.out, st.peer, st.dials, st.stage)
}

fn p_rx(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }, segment: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    sequence proc[concurrency]
        _: boolean <- cast(st.car, (:credit, 1) impl ActorMessage {})
    produces
        pure p_maybe_done(p_absorb(st, segment))
    end
}

fn p_absorb(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }, segment: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- wireframe@unframe(st.rx, segment, 4096);
    case un of {
        (:more, r1: { mode: atom, expected: int64, pending: string }) -> p_with_rx(st, r1);
        (:frame, frame0: string, r2: { mode: atom, expected: int64, pending: string }) -> p_absorb(take_frame(p_with_rx(st, r2), frame0), "");
        (:rejected, why: atom) -> p_said(st, say("framing rejected ", why))
    }
}

// Every frame is a reply to this side's request or else a peer request.
fn take_frame(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }, frame0: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    sequence proc[mem(normal), transport]
        decoded: (:ok, (:reply, int64, int64)) | (:rejected, atom) <- decode((:etf), frame0);
        next: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } <- case decoded of {
            (:ok, m: (:reply, int64, int64)) -> take_reply(st, m);
            (:rejected, _why: atom) -> request_frame(st, frame0)
        }
    produces
        pure next
    end
}

fn request_frame(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }, frame0: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    sequence proc[mem(normal), transport]
        decoded: (:ok, (:request, int64, int64)) | (:rejected, atom) <- decode((:etf), frame0);
        next: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } <- case decoded of {
            (:ok, m: (:request, int64, int64)) -> take_request(st, m);
            (:rejected, why: atom) -> p_said(st, say("rejected ", why))
        }
    produces
        pure next
    end
}

// ---- A reply, matched to this side's request by id ----
fn take_reply(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }, m: (:reply, int64, int64)) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    case m of {
        (:reply, src: int64, id: int64) -> settle_reply(st, src, id)
    }
}

// Every output line is printed by the coordinator, one actor, so that lines of different links never mix.
// kind 1 = request answered, 2 = reply matched, 3 = reply with an unknown id.
fn tell_line(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }, kind: int64, id: int64, who: int64) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    sequence proc[concurrency]
        _: boolean <- cast(st.coord, (:line, kind, id, who) impl ActorMessage {})
    produces
        pure st
    end
}

fn settle_reply(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }, src: int64, id: int64) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    want: int64 <- 10 * my_node() + st.peer;
    case id == want and src == st.peer of {
        true -> tell_line(mk(st.car, st.coord, st.rx, st.credit, st.out, st.peer, st.dials, st.stage + 1), 2, id, src);
        false -> tell_line(st, 3, id, src)
    }
}

// ---- A peer request, answered at once. A session learns its peer here and then sends its own request. ----
fn take_request(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }, m: (:request, int64, int64)) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    case m of {
        (:request, src: int64, id: int64) -> serve_request(st, src, id)
    }
}

fn serve_request(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }, src: int64, id: int64) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    seg: string <- reply_segment(my_node(), id);
    own_request(p_post(tell_line(mk(st.car, st.coord, st.rx, st.credit, st.out, src, st.dials, st.stage + 2), 1, id, src), seg), src)
}

fn own_request(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }, src: int64) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 } {
    case st.dials of {
        true -> st;
        false -> p_post(st, request_segment(my_node(), 10 * my_node() + src))
    }
}

fn peer_link(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom), state: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }) -> (:no_reply, { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, peer: int64, dials: boolean, stage: int64 }) {
    case msg of {
        (:link_up, _info: string) -> (:no_reply, p_link_up(state));
        (:tx_credit, n: int64) -> (:no_reply, p_tx_credit(state, n));
        (:rx, segment: string) -> (:no_reply, p_rx(state, segment));
        (:tx_failed, _why: atom) -> (:no_reply, state);
        (:link_down, _why2: atom) -> (:no_reply, p_link_down(state))
    }
}

// ---- The coordinator: listens, starts the dialers, counts finished links, ends the run ----
fn mkc(car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64) -> { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 } {
    { car: car, sup: sup, accepts: accepts, done: done, phase: phase }
}

fn c_start(st: { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 }) -> { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 } {
    dial_all(c_listen(st), my_node() + 1)
}

// Node 1 has nobody to accept; every other node listens.
fn c_listen(st: { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 }) -> { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 } {
    case my_node() > 1 of {
        true -> c_open_listener(st);
        false -> st
    }
}

fn c_open_listener(st: { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 }) -> { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 } {
    sequence proc[concurrency]
        _: boolean <- cast(st.car, (:open, self(), listen_address(my_node())) impl ActorMessage {})
    produces
        pure st
    end
}

fn dial_all(st: { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 }, p: int64) -> { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 } {
    case p > node_count() of {
        true -> st;
        false -> dial_all(dial_one(st, p), p + 1)
    }
}

fn dial_one(st: { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 }, p: int64) -> { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 } {
    sequence proc[concurrency]
        car: actor_ref <- start_carrier(st.sup, dcar_id(p), 0 - 1, "loopback");
        d: actor_ref <- start_link(st.sup, dial_id(p), mk(car, self(), wireframe@fresh(Carrier@boundaries(wire)), 0, "", p, true, 0));
        _: boolean <- cast(car, (:open, d, dial_address(p)) impl ActorMessage {})
    produces
        pure st
    end
}

// An accepted connection: the listener gave the descriptor. This actor starts the connection carrier and its
// session as children of the supervisor.
fn c_accepted(st: { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 }, fd: int64) -> { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 } {
    sequence proc[concurrency]
        k: int64 <- st.accepts + 1;
        conn: actor_ref <- start_carrier(st.sup, conn_id(k), fd, "");
        ses: actor_ref <- start_link(st.sup, ses_id(k), mk(conn, self(), wireframe@fresh(Carrier@boundaries(wire)), 0, "", 0, false, 0));
        _: boolean <- cast(conn, (:open, ses, "") impl ActorMessage {})
    produces
        pure mkc(st.car, st.sup, k, st.done, st.phase)
    end
}

fn c_line(st: { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 }, kind: int64, id: int64, who: int64) -> { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 } {
    case kind == 1 of {
        true -> p_said_c(st, say_msg("request", id, who));
        false -> case kind == 2 of {
            true -> p_said_c(st, say_msg("reply", id, who));
            false -> p_said_c(st, say_msg("reply to unknown id", id, who))
        }
    }
}

fn p_said_c(st: { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 }, _o: atom) -> { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 } {
    st
}

fn c_link_done(st: { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 }) -> { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 } {
    n: int64 <- st.done + 1;
    case n == peer_count() of {
        true -> c_all_done(st, n);
        false -> mkc(st.car, st.sup, st.accepts, n, st.phase)
    }
}

fn c_summary(n: int64) -> atom {
    sequence proc[device_io]
        me: int64 <- my_node();
        _: atom <- print("node ");
        _: atom <- print_int64(me);
        _: atom <- print(": ");
        _: atom <- print_int64(n);
        _: atom <- print(" of ");
        _: atom <- print_int64(peer_count());
        _: atom <- println(" replies")
    produces
        pure :ok
    end
}

fn c_all_done(st: { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 }, n: int64) -> { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 } {
    sequence proc[concurrency]
        _: timer_ref <- send_after(1500, self(), :finish impl ActorMessage {})
    produces
        pure mkc(st.car, st.sup, st.accepts, n, c_phase_done(c_summary(n)))
    end
}

fn c_phase_done(_o: atom) -> int64 {
    2
}

fn c_timeout(st: { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 }) -> { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 } {
    case st.phase == 0 of {
        true -> c_timed_out(st);
        false -> st
    }
}

fn c_timed_out(st: { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 }) -> { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 } {
    sequence proc[concurrency, device_io]
        me: int64 <- my_node();
        _: atom <- print("node ");
        _: atom <- print_int64(me);
        _: atom <- print(": timeout, ");
        _: atom <- print_int64(st.done);
        _: atom <- print(" of ");
        _: atom <- print_int64(peer_count());
        _: atom <- println(" replies");
        _: boolean <- cast_exit(5)
    produces
        pure mkc(st.car, st.sup, st.accepts, st.done, 3)
    end
}

fn c_listener_down(st: { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 }, why: atom) -> { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 } {
    case st.phase == 0 of {
        true -> c_listen_failed(st, why);
        false -> st
    }
}

fn c_listen_failed(st: { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 }, why: atom) -> { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 } {
    sequence proc[concurrency, device_io]
        _: atom <- print("listen failed ");
        _: atom <- print_atom(why);
        _: atom <- println("");
        _: boolean <- cast_exit(1)
    produces
        pure mkc(st.car, st.sup, st.accepts, st.done, 3)
    end
}

// The listener is closed (no listener is left on the port); the dialed connections close when the process exits.
fn c_finish(st: { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 }) -> { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 } {
    sequence proc[concurrency]
        _: boolean <- case my_node() > 1 of {
            true -> cast(st.car, :close impl ActorMessage {});
            false -> false
        };
        _: boolean <- cast_exit(0)
    produces
        pure st
    end
}

fn coordinator(msg: (:link_up, string) | (:accepted, int64, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | (:line, int64, int64, int64) | :start | :link_done | :timeout | :finish, state: { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 }) -> (:no_reply, { car: actor_ref, sup: supervisor_ref, accepts: int64, done: int64, phase: int64 }) {
    case msg of {
        :start -> (:no_reply, c_start(state));
        (:link_up, _info: string) -> (:no_reply, state);
        (:accepted, fd: int64, _info2: string) -> (:no_reply, c_accepted(state, fd));
        (:line, kind: int64, id: int64, who: int64) -> (:no_reply, c_line(state, kind, id, who));
        :link_done -> (:no_reply, c_link_done(state));
        :timeout -> (:no_reply, c_timeout(state));
        :finish -> (:no_reply, c_finish(state));
        (:rx, _segment: string) -> (:no_reply, state);
        (:tx_credit, _n: int64) -> (:no_reply, state);
        (:tx_failed, _why: atom) -> (:no_reply, state);
        (:link_down, why2: atom) -> (:no_reply, c_listener_down(state, why2))
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep);
        sup: supervisor_ref <- transit_sup@start();
        lst: actor_ref <- start_carrier(sup, :listener, 0 - 1, "loopback");
        me: actor_ref <- start_coordinator(sup, :coordinator, mkc(lst, sup, 0, 0, 0));
        _: timer_ref <- send_after(timeout_ms(), me, :timeout impl ActorMessage {});
        _: boolean <- cast(me, :start impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
