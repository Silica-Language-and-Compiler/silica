// A hub of the two-hubs example (examples/transit_two_hubs_tcp, run.sh). Two sub-graphs, A and B, each with one hub and
// three spokes, run as eight OS processes on one Mac, over 127.0.0.1. Each spoke dials only its own hub. The only link
// between the sub-graphs is ONE TCP connection between hub A and hub B (hub A dials hub B). That is seven connections.
// The spoke program is dangerous_transit_two_hubs_spoke.silica.
//
// Names. A node number is 10 * group + k: the spokes of A are 11, 12, 13 and the spokes of B are 21, 22, 23; the hubs
// are 10 (A) and 20 (B). The output writes them as a1 to a3 and b1 to b3. Hub A listens on 127.0.0.1:4620 and hub B on
// 127.0.0.1:4621; hub B's listener takes its three spokes and hub A's link.
//
// The messages are ETF terms behind wireframe's 4-byte length prefix (Erlang's gen_tcp {packet, 4}):
//
//   (:data, kind: int64, src: int64, dest: int64, id: int64)   kind 1 = request, 2 = reply; id = 100 * src + dest
//   (:ctl, code: int64, who: int64)                            code 1 = hello (who is the sender), 2 = ready, 3 = go
//
// Routing. A hub knows its own three spokes and nothing else. A data frame whose dest is one of them goes to that
// spoke: it "stayed local" if the sender was also one of them, and it came across the hub-to-hub link if the sender
// was in the other group. Everything else goes over the hub-to-hub link to the other hub, which delivers it. The reply
// takes the same path back. A frame between two spokes of different groups is therefore relayed twice: by its own hub
// (out over the link) and by the other hub (in to the spoke). Both lines say "cross".
//
// Start. Every connection begins with a hello from both ends, so each hub learns which session is which spoke and
// which is the link. A hub that has all four (three spokes and the link) sends ready over the link. A hub that has all
// four and has received the other hub's ready sends go to its spokes, so no frame reaches a spoke that the other hub
// has not yet registered. The spokes then send their requests (5 each, 30 in all).
//
// Done. Each hub relays 12 frames that stay local (6 requests and 6 replies) and 36 that cross (18 requests and 18
// replies, each hub seeing every crossing frame once). It prints one total line, waits 1.5 s and
// exits 0. No completion within 45 s prints a timeout line and exits 5.
//
// Output. Every line of a hub is printed by its coordinator, one actor, so lines never mix.
//
// Supervision. main registers a failure reporter and starts the root supervisor transit_sup (../transit_common), whose
// two :supervisor children are actors_sup (the coordinator and every link, session and dialer actor) and carriers_sup
// (every carrier). Each actor and carrier is added as a :temporary child of its sub-supervisor with call_supervisor
// (add_child); no carrier is started with spawn_dangerous_carrier. The reporter drops reports whose reason is :normal and writes any other to stderr.
// A listener hands the accepted descriptor to its owner as (:accepted, fd, peer); the owner starts the carrier.
//
// SECURITY: the (:tcp) carrier is plain TCP, with no authentication, no encryption and no peer identity: anyone who
// can reach a listening port can connect and send frames. Here the carrier is declared (:loopback), so every listener
// is on 127.0.0.1 and no other host can reach it.
module dangerous_transit_two_hubs_hub;

use wire_etf;
use wireframe;
use Carrier;
use dangerous_sockets;
use dangerous_tcp_carrier;
use transit_sup;

carried_on wire: (:tcp) (:loopback);

// ---- The one per-copy setting (run.sh rewrites this line): 1 = hub A, 2 = hub B ----
fn my_hub() -> int64 { 1 }

fn my_id() -> int64 { 10 * my_hub() }

fn listen_address() -> string {
    case my_hub() == 1 of { true -> "listen:4620"; false -> "listen:4621" }
}

fn link_address() -> string { "127.0.0.1:4621:3000" }

fn local_total() -> int64 { 12 }

fn cross_total() -> int64 { 36 }

fn timeout_ms() -> uint64 { 45000 }

// ---- Helpers ----
fn first_segment(xs: List[string, mem(normal)]) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, _t: List[string, mem(normal)]] -> h
    }
}

fn segment_of(frame: string) -> string {
    segs: List[string, mem(normal)] <- wireframe@frame(frame, Carrier@mtu(wire), Carrier@boundaries(wire));
    first_segment(segs)
}

fn ctl_segment(code: int64, who: int64) -> string {
    sequence proc[mem(normal), transport]
        msg: (:ctl, int64, int64) <- (:ctl, code, who);
        frame: string <- encode((:etf), msg)
    produces
        pure segment_of(frame)
    end
}

fn say(label: string, why: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print_atom(why);
        _: atom <- println("")
    produces
        pure :ok
    end
}

// The group letter and digit of a node number, for output: 11 is a1, 23 is b3.
fn print_name(n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- case n / 10 == 1 of { true -> print("a"); false -> print("b") };
        _: atom <- print_int64(n - 10 * (n / 10))
    produces
        pure :ok
    end
}

// ---- Supervision: every actor is a :temporary child of actors_sup and every carrier a :temporary child of carriers_sup, both children of the root supervisor transit_sup ----
// The failure reporter takes every report the runtime hands over. A report whose reason is :normal (a connection that
// ended in the ordinary way) is not printed. Any other report is written to standard error, so a real failure is
// never hidden.
fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        is_normal: boolean <- contains(report, "reason:          :normal\n");
        _: atom <- case is_normal of {
            true -> :ok;
            false -> println_stderr(report)
        }
    produces
        pure (:no_reply, state)
    end
}

// Child ids are registered names, so each live child has its own: :conn_1 to :conn_4 for the carriers of accepted
// connections and :ses_1 to :ses_4 for their sessions (hub B accepts three spokes and the link; hub A three spokes),
// :link_conn and :link_ses for hub A's dial to hub B.
fn conn_id(k: int64) -> atom {
    case k == 1 of { true -> :conn_1; false ->
    case k == 2 of { true -> :conn_2; false ->
    case k == 3 of { true -> :conn_3; false ->
    :conn_4 } } }
}

fn ses_id(k: int64) -> atom {
    case k == 1 of { true -> :ses_1; false ->
    case k == 2 of { true -> :ses_2; false ->
    case k == 3 of { true -> :ses_3; false ->
    :ses_4 } } }
}

// A (:tcp) carrier as a child: fd is an accepted descriptor, or -1 for a carrier that dials or listens. spec is the
// carrier's link ("loopback" for a dialer or listener, "" for an accepted connection).
fn start_carrier(sup: supervisor_ref, id: atom, fd: int64, spec: string) -> actor_ref {
    sequence
        sub: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sup, { op: :get_child, id: :carriers_sup } impl SupervisorMessage {});
        added: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sub.child, {
            op: :add_child,
            child: {
                id: id,
                agent_type: :worker,
                initial_state: { owner: actor_ref_of_word(0), fd: fd, rx_credit: 0, up: false, listening: false, link_spec: spec },
                behavior: dangerous_tcp_carrier@carrier,
                restart: :temporary,
                shutdown: 0,
                flavor: :dangerous, state_policy: state_policy(:keep_state_area)
            }
        } impl SupervisorMessage {})
    produces
        pure added.child
    end
}

// A session as a child.
fn start_session(sup: supervisor_ref, id: atom, st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }) -> actor_ref {
    sequence
        sub: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sup, { op: :get_child, id: :actors_sup } impl SupervisorMessage {});
        added: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sub.child, {
            op: :add_child,
            child: {
                id: id,
                agent_type: :worker,
                initial_state: st,
                behavior: session,
                restart: :temporary,
                shutdown: 0,
                flavor: :plain, state_policy: state_policy(:keep_state_area)
            }
        } impl SupervisorMessage {})
    produces
        pure added.child
    end
}

// The coordinator as a child.
fn start_coordinator(sup: supervisor_ref, id: atom, st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }) -> actor_ref {
    sequence
        sub: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sup, { op: :get_child, id: :actors_sup } impl SupervisorMessage {});
        added: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sub.child, {
            op: :add_child,
            child: {
                id: id,
                agent_type: :worker,
                initial_state: st,
                behavior: coordinator,
                restart: :temporary,
                shutdown: 0,
                flavor: :plain, state_policy: state_policy(:keep_state_area)
            }
        } impl SupervisorMessage {})
    produces
        pure added.child
    end
}

// ---- A session: this hub's end of one connection (a spoke's or the hub-to-hub link) ----
fn mkh(car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    { car: car, coord: coord, rx: rx, credit: credit, out: out, flight: flight }
}

fn h_flush(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    sequence proc[concurrency]
        go: boolean <- length_bytes(st.out) > 0 and st.credit > 0;
        _: boolean <- case go of {
            true -> cast(st.car, (:tx, st.out, self()) impl ActorMessage {});
            false -> false
        };
        next: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } <- case go of {
            true -> mkh(st.car, st.coord, st.rx, st.credit - 1, "", st.flight + 1);
            false -> st
        }
    produces
        pure next
    end
}

fn h_post(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, seg: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    h_flush(mkh(st.car, st.coord, st.rx, st.credit, concat(st.out, seg), st.flight))
}

fn h_said(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, _o: atom) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    st
}

// Connected or accepted: grant receive credit and say hello.
fn h_link_up(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    sequence proc[concurrency]
        _: boolean <- cast(st.car, (:credit, 4) impl ActorMessage {})
    produces
        pure h_post(st, ctl_segment(1, my_id()))
    end
}

fn h_tx_credit(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, n: int64) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    confirmed: int64 <- case n == 1 of { true -> 1; false -> 0 };
    h_flush(mkh(st.car, st.coord, st.rx, st.credit + n, st.out, st.flight - confirmed))
}

fn h_with_rx(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, rx: { mode: atom, expected: int64, pending: string }) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    mkh(st.car, st.coord, rx, st.credit, st.out, st.flight)
}

fn h_rx(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, segment: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    sequence proc[concurrency]
        _: boolean <- cast(st.car, (:credit, 1) impl ActorMessage {})
    produces
        pure h_absorb(st, segment)
    end
}

fn h_absorb(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, segment: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- wireframe@unframe(st.rx, segment, 4096);
    case un of {
        (:more, r1: { mode: atom, expected: int64, pending: string }) -> h_with_rx(st, r1);
        (:frame, frame0: string, r2: { mode: atom, expected: int64, pending: string }) -> h_absorb(h_take_frame(h_with_rx(st, r2), frame0), "");
        (:rejected, why: atom) -> h_said(st, say("framing rejected ", why))
    }
}

// A frame is a control frame, else a data frame.
fn h_take_frame(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, frame0: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    sequence proc[mem(normal), transport]
        decoded: (:ok, (:ctl, int64, int64)) | (:rejected, atom) <- decode((:etf), frame0);
        next: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } <- case decoded of {
            (:ok, m: (:ctl, int64, int64)) -> h_ctl(st, m);
            (:rejected, _why: atom) -> h_data_frame(st, frame0)
        }
    produces
        pure next
    end
}

fn h_data_frame(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, frame0: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    sequence proc[mem(normal), transport]
        decoded: (:ok, (:data, int64, int64, int64, int64)) | (:rejected, atom) <- decode((:etf), frame0);
        next: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } <- case decoded of {
            (:ok, m: (:data, int64, int64, int64, int64)) -> h_data(st, m, frame0);
            (:rejected, why: atom) -> h_said(st, say("rejected ", why))
        }
    produces
        pure next
    end
}

fn h_ctl(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, m: (:ctl, int64, int64)) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    case m of {
        (:ctl, code: int64, who: int64) -> h_ctl_code(st, code, who)
    }
}

// hello: tell the coordinator who this session is; ready: tell it the other hub is ready.
fn h_ctl_code(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, code: int64, who: int64) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    sequence proc[concurrency]
        _: boolean <- case code == 1 of {
            true -> cast(st.coord, (:peer, who, self()) impl ActorMessage {});
            false -> case code == 2 of {
                true -> cast(st.coord, :ready_in impl ActorMessage {});
                false -> false
            }
        }
    produces
        pure st
    end
}

fn h_data(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, m: (:data, int64, int64, int64, int64), frame0: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    case m of {
        (:data, kind: int64, src: int64, dest: int64, id: int64) -> h_relay(st, kind, src, dest, id, frame0)
    }
}

// Every data frame goes to the coordinator, which relays it unchanged.
fn h_relay(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, kind: int64, src: int64, dest: int64, id: int64, frame0: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    sequence proc[concurrency]
        seg: string <- segment_of(frame0);
        _: boolean <- cast(st.coord, (:relay, kind, src, dest, id, seg) impl ActorMessage {})
    produces
        pure st
    end
}

fn session(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | (:send, string), state: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }) -> (:no_reply, { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }) {
    case msg of {
        (:link_up, _info: string) -> (:no_reply, h_link_up(state));
        (:tx_credit, n: int64) -> (:no_reply, h_tx_credit(state, n));
        (:rx, segment: string) -> (:no_reply, h_rx(state, segment));
        (:send, seg: string) -> (:no_reply, h_post(state, seg));
        (:tx_failed, _why: atom) -> (:no_reply, state);
        (:link_down, _why2: atom) -> (:no_reply, state)
    }
}

// ---- The coordinator ----
// slots: a1 to a3 are the sessions of this group's spokes 1 to 3, a4 is the session of the hub-to-hub link. A slot
// holds the coordinator's own reference until its hello has arrived. phase: 0 starting, 1 go sent, 2 done, 3 failed.
fn mkc(sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    { sup: sup, accepts: accepts, slots: slots, peers: peers, ready: ready, local: local, cross: cross, phase: phase }
}

fn slot_of(s: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, k: int64) -> actor_ref {
    case k == 1 of { true -> s.a1; false ->
    case k == 2 of { true -> s.a2; false ->
    case k == 3 of { true -> s.a3; false -> s.a4 } } }
}

fn slots_with(s: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, k: int64, r: actor_ref) -> { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref } {
    case k == 1 of { true -> { a1: r, a2: s.a2, a3: s.a3, a4: s.a4 }; false ->
    case k == 2 of { true -> { a1: s.a1, a2: r, a3: s.a3, a4: s.a4 }; false ->
    case k == 3 of { true -> { a1: s.a1, a2: s.a2, a3: r, a4: s.a4 }; false -> { a1: s.a1, a2: s.a2, a3: s.a3, a4: r } } } }
}

// A node number to a slot: a hub (10 or 20) is the link, any other number is a spoke of some group.
fn slot_index(who: int64) -> int64 {
    case who == 10 or who == 20 of {
        true -> 4;
        false -> who - 10 * (who / 10)
    }
}

// Where a frame for dest goes: a spoke of this group, else over the link.
fn route_slot(dest: int64) -> int64 {
    case dest / 10 == my_hub() of {
        true -> dest - 10 * (dest / 10);
        false -> 4
    }
}

fn c_start(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    c_dial(st)
}

// Hub A dials hub B; hub B only listens.
fn c_dial(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    case my_hub() == 1 of {
        true -> c_dial_link(st);
        false -> st
    }
}

fn c_dial_link(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    sequence proc[concurrency]
        car: actor_ref <- start_carrier(st.sup, :link_conn, 0 - 1, "loopback");
        d: actor_ref <- start_session(st.sup, :link_ses, mkh(car, self(), wireframe@fresh(Carrier@boundaries(wire)), 0, "", 0));
        _: boolean <- cast(car, (:open, d, link_address()) impl ActorMessage {})
    produces
        pure st
    end
}

// An accepted connection: the listener gave the descriptor. This actor starts the connection carrier and its
// session as children of the supervisor.
fn c_accepted(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }, fd: int64) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    sequence proc[concurrency]
        k: int64 <- st.accepts + 1;
        conn: actor_ref <- start_carrier(st.sup, conn_id(k), fd, "");
        ses: actor_ref <- start_session(st.sup, ses_id(k), mkh(conn, self(), wireframe@fresh(Carrier@boundaries(wire)), 0, "", 0));
        _: boolean <- cast(conn, (:open, ses, "") impl ActorMessage {})
    produces
        pure mkc(st.sup, k, st.slots, st.peers, st.ready, st.local, st.cross, st.phase)
    end
}

// A session said hello. With all four known, tell the other hub this one is ready (over the link).
fn c_peer(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }, who: int64, ses: actor_ref) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    next: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } <- mkc(st.sup, st.accepts, slots_with(st.slots, slot_index(who), ses), st.peers + 1, st.ready, st.local, st.cross, st.phase);
    c_check_go(c_send_ready(next))
}

fn c_send_ready(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    sequence proc[concurrency]
        seg: string <- ctl_segment(2, my_id());
        _: boolean <- case st.peers == 4 of {
            true -> cast(st.slots.a4, (:send, seg) impl ActorMessage {});
            false -> false
        }
    produces
        pure st
    end
}

fn c_ready_in(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    c_check_go(mkc(st.sup, st.accepts, st.slots, st.peers, 1, st.local, st.cross, st.phase))
}

// All four sessions known and the other hub ready: send go to the three spokes, once.
fn c_check_go(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    case st.peers == 4 and st.ready == 1 and st.phase == 0 of {
        true -> go_all(st);
        false -> st
    }
}

fn go_all(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    sequence proc[concurrency]
        seg: string <- ctl_segment(3, my_id());
        _: boolean <- cast(st.slots.a1, (:send, seg) impl ActorMessage {});
        _: boolean <- cast(st.slots.a2, (:send, seg) impl ActorMessage {});
        _: boolean <- cast(st.slots.a3, (:send, seg) impl ActorMessage {})
    produces
        pure mkc(st.sup, st.accepts, st.slots, st.peers, st.ready, st.local, st.cross, 1)
    end
}

// Relay one frame, print one line, count it.
fn c_relay(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }, kind: int64, src: int64, dest: int64, id: int64, seg: string) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    sequence proc[concurrency, device_io]
        same: boolean <- src / 10 == dest / 10;
        target: actor_ref <- slot_of(st.slots, route_slot(dest));
        _: atom <- print("hub ");
        _: atom <- case my_hub() == 1 of { true -> print("a"); false -> print("b") };
        _: atom <- print(": relay ");
        _: atom <- case kind == 1 of { true -> print("request"); false -> print("reply") };
        _: atom <- print(" id=");
        _: atom <- print_int64(id);
        _: atom <- print(" ");
        _: atom <- print_name(src);
        _: atom <- print(" -> ");
        _: atom <- print_name(dest);
        _: atom <- case same of { true -> println(" local"); false -> println(" cross") };
        _: boolean <- cast(target, (:send, seg) impl ActorMessage {})
    produces
        pure c_count(st, same)
    end
}

fn c_count(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }, is_local: boolean) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    case is_local of {
        true -> c_maybe_done(mkc(st.sup, st.accepts, st.slots, st.peers, st.ready, st.local + 1, st.cross, st.phase));
        false -> c_maybe_done(mkc(st.sup, st.accepts, st.slots, st.peers, st.ready, st.local, st.cross + 1, st.phase))
    }
}

fn c_maybe_done(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    done: boolean <- st.phase == 1 and st.local == local_total() and st.cross == cross_total();
    case done of {
        true -> c_all_done(st);
        false -> st
    }
}

fn c_all_done(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    sequence proc[concurrency, device_io]
        _: atom <- print("hub ");
        _: atom <- case my_hub() == 1 of { true -> print("a"); false -> print("b") };
        _: atom <- print(": ");
        _: atom <- print_int64(st.local);
        _: atom <- print(" local relays, ");
        _: atom <- print_int64(st.cross);
        _: atom <- println(" cross relays");
        _: timer_ref <- send_after(1500, self(), :finish impl ActorMessage {})
    produces
        pure mkc(st.sup, st.accepts, st.slots, st.peers, st.ready, st.local, st.cross, 2)
    end
}

fn c_timeout(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    case st.phase < 2 of {
        true -> c_timed_out(st);
        false -> st
    }
}

fn c_timed_out(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    sequence proc[concurrency, device_io]
        _: atom <- print("hub ");
        _: atom <- case my_hub() == 1 of { true -> print("a"); false -> print("b") };
        _: atom <- print(": timeout, ");
        _: atom <- print_int64(st.local);
        _: atom <- print(" local, ");
        _: atom <- print_int64(st.cross);
        _: atom <- println(" cross");
        _: boolean <- cast_exit(5)
    produces
        pure mkc(st.sup, st.accepts, st.slots, st.peers, st.ready, st.local, st.cross, 3)
    end
}

fn c_listener_down(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }, why: atom) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    case st.phase < 2 of {
        true -> c_listen_failed(st, why);
        false -> st
    }
}

fn c_listen_failed(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }, why: atom) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    sequence proc[concurrency, device_io]
        _: atom <- print("listen failed ");
        _: atom <- print_atom(why);
        _: atom <- println("");
        _: boolean <- cast_exit(1)
    produces
        pure mkc(st.sup, st.accepts, st.slots, st.peers, st.ready, st.local, st.cross, 3)
    end
}

fn c_finish(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 } {
    sequence proc[concurrency]
        _: boolean <- cast_exit(0)
    produces
        pure st
    end
}

fn coordinator(msg: (:link_up, string) | (:accepted, int64, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | (:peer, int64, actor_ref) | (:relay, int64, int64, int64, int64, string) | :ready_in | :start | :timeout | :finish, state: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }) -> (:no_reply, { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref }, peers: int64, ready: int64, local: int64, cross: int64, phase: int64 }) {
    case msg of {
        :start -> (:no_reply, c_start(state));
        (:link_up, _info: string) -> (:no_reply, state);
        (:accepted, fd: int64, _info2: string) -> (:no_reply, c_accepted(state, fd));
        (:peer, who: int64, ses: actor_ref) -> (:no_reply, c_peer(state, who, ses));
        (:relay, kind: int64, src: int64, dest: int64, id: int64, seg: string) -> (:no_reply, c_relay(state, kind, src, dest, id, seg));
        :ready_in -> (:no_reply, c_ready_in(state));
        :timeout -> (:no_reply, c_timeout(state));
        :finish -> (:no_reply, c_finish(state));
        (:rx, _segment: string) -> (:no_reply, state);
        (:tx_credit, _n: int64) -> (:no_reply, state);
        (:tx_failed, _why: atom) -> (:no_reply, state);
        (:link_down, why2: atom) -> (:no_reply, c_listener_down(state, why2))
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep);
        sup: supervisor_ref <- transit_sup@start();
        lst: actor_ref <- start_carrier(sup, :listener, 0 - 1, "loopback");
        z: actor_ref <- self();
        me: actor_ref <- start_coordinator(sup, :coordinator, mkc(sup, 0, { a1: z, a2: z, a3: z, a4: z }, 0, 0, 0, 0, 0));
        _: boolean <- cast(lst, (:open, me, listen_address()) impl ActorMessage {});
        _: timer_ref <- send_after(timeout_ms(), me, :timeout impl ActorMessage {});
        _: boolean <- cast(me, :start impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
