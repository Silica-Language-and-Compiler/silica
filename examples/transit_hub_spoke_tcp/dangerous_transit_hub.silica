// The hub of the hub-and-spoke example (examples/transit_hub_spoke_tcp, run.sh). One hub and six spokes run as seven
// OS processes on one Mac, over 127.0.0.1. The hub listens on 127.0.0.1:4610; each spoke dials only the hub, so there
// are six TCP connections and no spoke-to-spoke connection. The spoke program is dangerous_transit_spoke.silica.
//
// The messages are ETF terms behind wireframe's 4-byte length prefix (Erlang's gen_tcp {packet, 4}):
//
//   (:request, src: int64, dest: int64, id: int64)   id = 10 * src + dest; spoke numbers are 1 to 6, the hub is 0
//   (:reply,   src: int64, dest: int64, id: int64)   src is who answers, dest is who asked, id is the request's
//   (:go, n: int64)                                  hub to spoke: all n spokes are connected, start part (b)
//
// Part (a). Each spoke sends (:request, S, 0, 10 * S) to the hub, and the hub answers (:reply, 0, S, 10 * S).
// Part (b). When all six spokes have made their part (a) request, the hub sends every spoke (:go, 6). Each spoke then
// sends one request to every other spoke, addressed by spoke number: (:request, S, D, 10 * S + D). The hub relays
// each frame whose dest is not 0 to the connection of spoke dest, unchanged, and prints a line for it. The spoke D
// answers (:reply, D, S, 10 * S + D) to the hub, and the hub relays that to spoke S, which matches it by id.
// That is 30 relayed requests and 30 relayed replies.
//
// Actors. The coordinator listens, and gives every accepted connection a session actor. A session learns its spoke
// number from the spoke's part (a) request and tells the coordinator (:peer, n, session). The coordinator keeps the
// six sessions in `slots`, counts, relays (:send, segment) to the session of the destination, and prints the total.
// When 6 hub requests are answered and 30 replies are relayed it prints the total line, waits 1.5 s (the spokes read
// the last frames), and exits 0. No completion within 45 s prints "hub: timeout" and exits 5.
//
// Supervision. main registers a failure reporter and starts the root supervisor transit_sup (../transit_common), whose
// two :supervisor children are actors_sup (the coordinator and every link, session and dialer actor) and carriers_sup
// (every carrier). Each actor and carrier is added as a :temporary child of its sub-supervisor with call_supervisor
// (add_child); no carrier is started with spawn_dangerous_carrier. The reporter drops reports whose reason is :normal and writes any other to stderr.
// A listener hands the accepted descriptor to its owner as (:accepted, fd, peer); the owner starts the carrier.
//
// SECURITY: the (:tcp) carrier is plain TCP, with no authentication, no encryption and no peer identity: anyone who
// can reach the listening port can connect and send frames. Here the carrier is declared (:loopback), so the
// listener is on 127.0.0.1 and no other host can reach it.
module dangerous_transit_hub;

use wire_etf;
use wireframe;
use Carrier;
use dangerous_sockets;
use dangerous_tcp_carrier;
use transit_sup;

carried_on wire: (:tcp) (:loopback);

fn listen_address() -> string { "listen:4610" }

fn spoke_count() -> int64 { 6 }

fn pair_count() -> int64 { 30 }

fn timeout_ms() -> uint64 { 45000 }

// ---- Helpers ----
fn first_segment(xs: List[string, mem(normal)]) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, _t: List[string, mem(normal)]] -> h
    }
}

fn segment_of(frame: string) -> string {
    segs: List[string, mem(normal)] <- wireframe@frame(frame, Carrier@mtu(wire), Carrier@boundaries(wire));
    first_segment(segs)
}

fn reply_segment(src: int64, dest: int64, id: int64) -> string {
    sequence proc[mem(normal), transport]
        msg: (:reply, int64, int64, int64) <- (:reply, src, dest, id);
        frame: string <- encode((:etf), msg)
    produces
        pure segment_of(frame)
    end
}

fn go_segment(n: int64) -> string {
    sequence proc[mem(normal), transport]
        msg: (:go, int64) <- (:go, n);
        frame: string <- encode((:etf), msg)
    produces
        pure segment_of(frame)
    end
}

fn say(label: string, why: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print_atom(why);
        _: atom <- println("")
    produces
        pure :ok
    end
}

// ---- Supervision: every actor is a :temporary child of actors_sup and every carrier a :temporary child of carriers_sup, both children of the root supervisor transit_sup ----
// The failure reporter takes every report the runtime hands over. A report whose reason is :normal (a connection that
// ended in the ordinary way) is not printed. Any other report is written to standard error, so a real failure is
// never hidden.
fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        is_normal: boolean <- contains(report, "reason:          :normal\n");
        _: atom <- case is_normal of {
            true -> :ok;
            false -> println_stderr(report)
        }
    produces
        pure (:no_reply, state)
    end
}

// Child ids are registered names, so each live child has its own: :conn_1 to :conn_6 for the carriers of the accepted
// connections and :ses_1 to :ses_6 for their sessions.
fn conn_id(k: int64) -> atom {
    case k == 1 of { true -> :conn_1; false ->
    case k == 2 of { true -> :conn_2; false ->
    case k == 3 of { true -> :conn_3; false ->
    case k == 4 of { true -> :conn_4; false ->
    case k == 5 of { true -> :conn_5; false ->
    :conn_6 } } } } }
}

fn ses_id(k: int64) -> atom {
    case k == 1 of { true -> :ses_1; false ->
    case k == 2 of { true -> :ses_2; false ->
    case k == 3 of { true -> :ses_3; false ->
    case k == 4 of { true -> :ses_4; false ->
    case k == 5 of { true -> :ses_5; false ->
    :ses_6 } } } } }
}

// A (:tcp) carrier as a child: fd is an accepted descriptor, or -1 for a carrier that dials or listens. spec is the
// carrier's link ("loopback" for a dialer or listener, "" for an accepted connection).
fn start_carrier(sup: supervisor_ref, id: atom, fd: int64, spec: string) -> actor_ref {
    sequence
        sub: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sup, { op: :get_child, id: :carriers_sup } impl SupervisorMessage {});
        added: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sub.child, {
            op: :add_child,
            child: {
                id: id,
                agent_type: :worker,
                initial_state: { owner: actor_ref_of_word(0), fd: fd, rx_credit: 0, up: false, listening: false, link_spec: spec },
                behavior: dangerous_tcp_carrier@carrier,
                restart: :temporary,
                shutdown: 0,
                flavor: :dangerous, state_policy: state_policy(:keep_state_area)
            }
        } impl SupervisorMessage {})
    produces
        pure added.child
    end
}

// A session as a child.
fn start_session(sup: supervisor_ref, id: atom, st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }) -> actor_ref {
    sequence
        sub: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sup, { op: :get_child, id: :actors_sup } impl SupervisorMessage {});
        added: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sub.child, {
            op: :add_child,
            child: {
                id: id,
                agent_type: :worker,
                initial_state: st,
                behavior: session,
                restart: :temporary,
                shutdown: 0,
                flavor: :plain, state_policy: state_policy(:keep_state_area)
            }
        } impl SupervisorMessage {})
    produces
        pure added.child
    end
}

// The coordinator as a child.
fn start_coordinator(sup: supervisor_ref, id: atom, st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }) -> actor_ref {
    sequence
        sub: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sup, { op: :get_child, id: :actors_sup } impl SupervisorMessage {});
        added: {
            tag: :child_started | :ok | :children | :count | :child_info | :error,
            child: actor_ref,
            status: atom,
            children: List[
                {
                    id: atom,
                    agent_type: :worker | :supervisor,
                    child: actor_ref,
                    restart: :permanent | :temporary | :transient
                },
                mem(normal)
            ],
            count: int64,
            child_info: {
                id: atom,
                agent_type: :worker | :supervisor,
                child: actor_ref,
                restart: :permanent | :temporary | :transient
            },
            error: atom
        } <- call_supervisor(sub.child, {
            op: :add_child,
            child: {
                id: id,
                agent_type: :worker,
                initial_state: st,
                behavior: coordinator,
                restart: :temporary,
                shutdown: 0,
                flavor: :plain, state_policy: state_policy(:keep_state_area)
            }
        } impl SupervisorMessage {})
    produces
        pure added.child
    end
}

// ---- A session: the hub's end of one spoke's connection ----
fn mkh(car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    { car: car, coord: coord, rx: rx, credit: credit, out: out, flight: flight }
}

fn h_flush(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    sequence proc[concurrency]
        go: boolean <- length_bytes(st.out) > 0 and st.credit > 0;
        _: boolean <- case go of {
            true -> cast(st.car, (:tx, st.out, self()) impl ActorMessage {});
            false -> false
        };
        next: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } <- case go of {
            true -> mkh(st.car, st.coord, st.rx, st.credit - 1, "", st.flight + 1);
            false -> st
        }
    produces
        pure next
    end
}

fn h_post(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, seg: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    h_flush(mkh(st.car, st.coord, st.rx, st.credit, concat(st.out, seg), st.flight))
}

fn h_said(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, _o: atom) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    st
}

fn h_link_up(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    sequence proc[concurrency]
        _: boolean <- cast(st.car, (:credit, 4) impl ActorMessage {})
    produces
        pure st
    end
}

fn h_tx_credit(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, n: int64) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    confirmed: int64 <- case n == 1 of { true -> 1; false -> 0 };
    h_flush(mkh(st.car, st.coord, st.rx, st.credit + n, st.out, st.flight - confirmed))
}

fn h_with_rx(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, rx: { mode: atom, expected: int64, pending: string }) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    mkh(st.car, st.coord, rx, st.credit, st.out, st.flight)
}

fn h_rx(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, segment: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    sequence proc[concurrency]
        _: boolean <- cast(st.car, (:credit, 1) impl ActorMessage {})
    produces
        pure h_absorb(st, segment)
    end
}

fn h_absorb(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, segment: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- wireframe@unframe(st.rx, segment, 4096);
    case un of {
        (:more, r1: { mode: atom, expected: int64, pending: string }) -> h_with_rx(st, r1);
        (:frame, frame0: string, r2: { mode: atom, expected: int64, pending: string }) -> h_absorb(h_take_frame(h_with_rx(st, r2), frame0), "");
        (:rejected, why: atom) -> h_said(st, say("framing rejected ", why))
    }
}

// A spoke sends requests and replies. A request is tried first; a frame that is not one is tried as a reply.
fn h_take_frame(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, frame0: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    sequence proc[mem(normal), transport]
        decoded: (:ok, (:request, int64, int64, int64)) | (:rejected, atom) <- decode((:etf), frame0);
        next: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } <- case decoded of {
            (:ok, m: (:request, int64, int64, int64)) -> h_request(st, m, frame0);
            (:rejected, _why: atom) -> h_reply_frame(st, frame0)
        }
    produces
        pure next
    end
}

fn h_reply_frame(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, frame0: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    sequence proc[mem(normal), transport]
        decoded: (:ok, (:reply, int64, int64, int64)) | (:rejected, atom) <- decode((:etf), frame0);
        next: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } <- case decoded of {
            (:ok, m: (:reply, int64, int64, int64)) -> h_reply(st, m, frame0);
            (:rejected, why: atom) -> h_said(st, say("rejected ", why))
        }
    produces
        pure next
    end
}

fn h_request(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, m: (:request, int64, int64, int64), frame0: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    case m of {
        (:request, src: int64, dest: int64, id: int64) -> h_route_request(st, src, dest, id, frame0)
    }
}

fn h_reply(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, m: (:reply, int64, int64, int64), frame0: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    case m of {
        (:reply, src: int64, dest: int64, id: int64) -> h_relay_reply(st, src, dest, id, frame0)
    }
}

fn h_route_request(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, src: int64, dest: int64, id: int64, frame0: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    case dest == 0 of {
        true -> h_serve_own(st, src, id);
        false -> h_relay_request(st, src, dest, id, frame0)
    }
}

// Part (a): a request for the hub. Tell the coordinator who this session is (it prints the line: every output line of
// the hub is printed by the coordinator, one actor, so that lines never mix), answer, and count it.
fn h_serve_own(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, src: int64, id: int64) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    sequence proc[concurrency]
        _: boolean <- cast(st.coord, (:peer, src, self()) impl ActorMessage {});
        _: boolean <- cast(st.coord, :served impl ActorMessage {})
    produces
        pure h_post(st, reply_segment(0, src, id))
    end
}

// Part (b): a request or reply for another spoke goes to the coordinator, which relays the frame unchanged.
fn h_relay_request(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, src: int64, dest: int64, id: int64, frame0: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    sequence proc[concurrency]
        seg: string <- segment_of(frame0);
        _: boolean <- cast(st.coord, (:relay_request, src, dest, id, seg) impl ActorMessage {})
    produces
        pure st
    end
}

fn h_relay_reply(st: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }, src: int64, dest: int64, id: int64, frame0: string) -> { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 } {
    sequence proc[concurrency]
        seg: string <- segment_of(frame0);
        _: boolean <- cast(st.coord, (:relay_reply, src, dest, id, seg) impl ActorMessage {})
    produces
        pure st
    end
}

fn session(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | (:send, string) | :go, state: { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }) -> (:no_reply, { car: actor_ref, coord: actor_ref, rx: { mode: atom, expected: int64, pending: string }, credit: int64, out: string, flight: int64 }) {
    case msg of {
        (:link_up, _info: string) -> (:no_reply, h_link_up(state));
        (:tx_credit, n: int64) -> (:no_reply, h_tx_credit(state, n));
        (:rx, segment: string) -> (:no_reply, h_rx(state, segment));
        (:send, seg: string) -> (:no_reply, h_post(state, seg));
        :go -> (:no_reply, h_post(state, go_segment(spoke_count())));
        (:tx_failed, _why: atom) -> (:no_reply, state);
        (:link_down, _why2: atom) -> (:no_reply, state)
    }
}

// ---- The coordinator ----
// slots holds the session of spoke k in a_k once its part (a) request has arrived.
fn mkc(sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 } {
    { sup: sup, accepts: accepts, slots: slots, peers: peers, req: req, rep: rep, served: served, phase: phase }
}

fn slot_of(s: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, k: int64) -> actor_ref {
    case k == 1 of { true -> s.a1; false ->
    case k == 2 of { true -> s.a2; false ->
    case k == 3 of { true -> s.a3; false ->
    case k == 4 of { true -> s.a4; false ->
    case k == 5 of { true -> s.a5; false -> s.a6 } } } } }
}

fn slots_with(s: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, k: int64, r: actor_ref) -> { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref } {
    case k == 1 of { true -> { a1: r, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6 }; false ->
    case k == 2 of { true -> { a1: s.a1, a2: r, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6 }; false ->
    case k == 3 of { true -> { a1: s.a1, a2: s.a2, a3: r, a4: s.a4, a5: s.a5, a6: s.a6 }; false ->
    case k == 4 of { true -> { a1: s.a1, a2: s.a2, a3: s.a3, a4: r, a5: s.a5, a6: s.a6 }; false ->
    case k == 5 of { true -> { a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: r, a6: s.a6 }; false -> { a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: r } } } } } }
}

// An accepted connection: the listener gave the descriptor. This actor starts the connection carrier and its
// session as children of the supervisor.
fn c_accepted(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }, fd: int64) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 } {
    sequence proc[concurrency]
        k: int64 <- st.accepts + 1;
        conn: actor_ref <- start_carrier(st.sup, conn_id(k), fd, "");
        ses: actor_ref <- start_session(st.sup, ses_id(k), mkh(conn, self(), wireframe@fresh(Carrier@boundaries(wire)), 0, "", 0));
        _: boolean <- cast(conn, (:open, ses, "") impl ActorMessage {})
    produces
        pure mkc(st.sup, k, st.slots, st.peers, st.req, st.rep, st.served, st.phase)
    end
}

// A session reported its spoke. When all six are known, every spoke is told to start part (b).
fn c_peer(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }, n: int64, ses: actor_ref) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 } {
    next: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 } <- mkc(st.sup, st.accepts, slots_with(st.slots, n, ses), st.peers + 1, st.req, st.rep, st.served, st.phase);
    c_peer_go(c_announce(next, n), n)
}

fn c_announce(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }, n: int64) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 } {
    sequence proc[device_io]
        _: atom <- print("hub: request id=");
        _: atom <- print_int64(10 * n);
        _: atom <- print(" from ");
        _: atom <- print_int64(n);
        _: atom <- println("")
    produces
        pure st
    end
}

fn c_peer_go(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }, _n: int64) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 } {
    case st.peers == spoke_count() of {
        true -> go_all(st);
        false -> st
    }
}

fn go_all(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 } {
    sequence proc[concurrency]
        _: boolean <- cast(st.slots.a1, :go impl ActorMessage {});
        _: boolean <- cast(st.slots.a2, :go impl ActorMessage {});
        _: boolean <- cast(st.slots.a3, :go impl ActorMessage {});
        _: boolean <- cast(st.slots.a4, :go impl ActorMessage {});
        _: boolean <- cast(st.slots.a5, :go impl ActorMessage {});
        _: boolean <- cast(st.slots.a6, :go impl ActorMessage {})
    produces
        pure st
    end
}

// Relay one frame to the session of its destination spoke and print one line for it.
fn c_relay(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }, kind: string, src: int64, dest: int64, id: int64, seg: string) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 } {
    sequence proc[concurrency, device_io]
        target: actor_ref <- slot_of(st.slots, dest);
        _: atom <- print("hub: relay ");
        _: atom <- print(kind);
        _: atom <- print(" id=");
        _: atom <- print_int64(id);
        _: atom <- print(" ");
        _: atom <- print_int64(src);
        _: atom <- print(" -> ");
        _: atom <- print_int64(dest);
        _: atom <- println("");
        _: boolean <- cast(target, (:send, seg) impl ActorMessage {})
    produces
        pure st
    end
}

fn c_relayed_request(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }, src: int64, dest: int64, id: int64, seg: string) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 } {
    c_maybe_done(mkc(st.sup, st.accepts, st.slots, st.peers, st.req + 1, st.rep, st.served, st.phase), c_relay(st, "request", src, dest, id, seg))
}

fn c_relayed_reply(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }, src: int64, dest: int64, id: int64, seg: string) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 } {
    c_maybe_done(mkc(st.sup, st.accepts, st.slots, st.peers, st.req, st.rep + 1, st.served, st.phase), c_relay(st, "reply", src, dest, id, seg))
}

fn c_served(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 } {
    c_maybe_done(mkc(st.sup, st.accepts, st.slots, st.peers, st.req, st.rep, st.served + 1, st.phase), st)
}

// Done: all six hub requests answered and all 30 replies relayed. The second argument orders the relay's print first.
fn c_maybe_done(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }, _printed: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 } {
    done: boolean <- st.phase == 0 and st.served == spoke_count() and st.rep == pair_count();
    case done of {
        true -> c_all_done(st);
        false -> st
    }
}

fn c_all_done(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 } {
    sequence proc[concurrency, device_io]
        _: atom <- print("hub: ");
        _: atom <- print_int64(st.served);
        _: atom <- print(" requests answered, ");
        _: atom <- print_int64(st.req);
        _: atom <- print(" requests relayed, ");
        _: atom <- print_int64(st.rep);
        _: atom <- println(" replies relayed");
        _: timer_ref <- send_after(1500, self(), :finish impl ActorMessage {})
    produces
        pure mkc(st.sup, st.accepts, st.slots, st.peers, st.req, st.rep, st.served, 2)
    end
}

fn c_timeout(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 } {
    case st.phase == 0 of {
        true -> c_timed_out(st);
        false -> st
    }
}

fn c_timed_out(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 } {
    sequence proc[concurrency, device_io]
        _: atom <- println("hub: timeout");
        _: boolean <- cast_exit(5)
    produces
        pure mkc(st.sup, st.accepts, st.slots, st.peers, st.req, st.rep, st.served, 3)
    end
}

fn c_listener_down(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }, why: atom) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 } {
    case st.phase == 0 of {
        true -> c_listen_failed(st, why);
        false -> st
    }
}

fn c_listen_failed(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }, why: atom) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 } {
    sequence proc[concurrency, device_io]
        _: atom <- print("listen failed ");
        _: atom <- print_atom(why);
        _: atom <- println("");
        _: boolean <- cast_exit(1)
    produces
        pure mkc(st.sup, st.accepts, st.slots, st.peers, st.req, st.rep, st.served, 3)
    end
}

fn c_finish(st: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }) -> { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 } {
    sequence proc[concurrency]
        _: boolean <- cast_exit(0)
    produces
        pure st
    end
}

fn coordinator(msg: (:link_up, string) | (:accepted, int64, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | (:peer, int64, actor_ref) | (:relay_request, int64, int64, int64, string) | (:relay_reply, int64, int64, int64, string) | :served | :timeout | :finish, state: { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }) -> (:no_reply, { sup: supervisor_ref, accepts: int64, slots: { a1: actor_ref, a2: actor_ref, a3: actor_ref, a4: actor_ref, a5: actor_ref, a6: actor_ref }, peers: int64, req: int64, rep: int64, served: int64, phase: int64 }) {
    case msg of {
        (:link_up, _info: string) -> (:no_reply, state);
        (:accepted, fd: int64, _info2: string) -> (:no_reply, c_accepted(state, fd));
        (:peer, n: int64, ses: actor_ref) -> (:no_reply, c_peer(state, n, ses));
        (:relay_request, src: int64, dest: int64, id: int64, seg: string) -> (:no_reply, c_relayed_request(state, src, dest, id, seg));
        (:relay_reply, src2: int64, dest2: int64, id2: int64, seg2: string) -> (:no_reply, c_relayed_reply(state, src2, dest2, id2, seg2));
        :served -> (:no_reply, c_served(state));
        :timeout -> (:no_reply, c_timeout(state));
        :finish -> (:no_reply, c_finish(state));
        (:rx, _segment: string) -> (:no_reply, state);
        (:tx_credit, _n: int64) -> (:no_reply, state);
        (:tx_failed, _why: atom) -> (:no_reply, state);
        (:link_down, why2: atom) -> (:no_reply, c_listener_down(state, why2))
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep);
        sup: supervisor_ref <- transit_sup@start();
        lst: actor_ref <- start_carrier(sup, :listener, 0 - 1, "loopback");
        z: actor_ref <- self();
        me: actor_ref <- start_coordinator(sup, :coordinator, mkc(sup, 0, { a1: z, a2: z, a3: z, a4: z, a5: z, a6: z }, 0, 0, 0, 0, 0));
        _: boolean <- cast(lst, (:open, me, listen_address()) impl ActorMessage {});
        _: timer_ref <- send_after(timeout_ms(), me, :timeout impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
