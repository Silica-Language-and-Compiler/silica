link_library: "silica_tls"

wrapper silica_tls_set_args {
    symbol: "silica_tls_set_args"
    result: "tagged_result"
    error_domain: "dangerous_tls"
}

wrapper silica_tls_connect {
    symbol: "silica_tls_connect"
    result: "tagged_result"
    error_domain: "dangerous_tls"
    arguments: [
        { name: "host_ptr", lifetime: "borrowed", retain: false },
        { name: "host_len", role: "length", length_of: "host_ptr" }
    ]
}

wrapper silica_tls_listen {
    symbol: "silica_tls_listen"
    result: "tagged_result"
    error_domain: "dangerous_tls"
}

wrapper silica_tls_listen_any {
    symbol: "silica_tls_listen_any"
    result: "tagged_result"
    error_domain: "dangerous_tls"
}

wrapper silica_tls_local_port {
    symbol: "silica_tls_local_port"
    result: "tagged_result"
    error_domain: "dangerous_tls"
}

wrapper silica_tls_accept {
    symbol: "silica_tls_accept"
    result: "tagged_result"
    error_domain: "dangerous_tls"
}

wrapper silica_tls_send {
    symbol: "silica_tls_send"
    result: "tagged_result"
    error_domain: "dangerous_tls"
    arguments: [
        { name: "data_ptr", lifetime: "borrowed", retain: false },
        { name: "data_len", role: "length", length_of: "data_ptr" }
    ]
}

wrapper silica_tls_recv {
    symbol: "silica_tls_recv"
    result: "tagged_result"
    error_domain: "dangerous_tls"
}

wrapper silica_tls_take {
    symbol: "silica_tls_take"
    result: "struct"
    error_domain: "dangerous_tls"
}

wrapper silica_tls_close {
    symbol: "silica_tls_close"
    result: "tagged_result"
    error_domain: "dangerous_tls"
}
