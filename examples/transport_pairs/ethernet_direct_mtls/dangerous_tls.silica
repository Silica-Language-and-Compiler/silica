// The Fifi wrappers of the mutual-TLS example (net/silica_tls.c) as a dangerous module, with the names and
// the answers of the standard dangerous_sockets module so that a carrier written for one reads the same over
// the other: every answer is the tagged result { tag, value, error_code } with tag 0 ok, 1 error, 2 timeout,
// 3 closed by the peer, and received bytes come back through take/1 as a string. What differs is below the
// names: tcp_connect and tcp_accept run a TLS 1.3 handshake in which BOTH ends present a certificate and
// each accepts only a peer whose certificate it has been given (README.md); send_bytes and recv_bytes carry
// TLS records. The project links libsilica_tls.a (and the host's OpenSSL 3) and places
// silica_tls_wrapper.meta under dangerous_exposure_source/tls.
module dangerous_tls;

wrapper_meta "dangerous_exposure_source/tls/silica_tls_wrapper.meta";

export tcp_connect/2;
export tcp_listen/1;
export tcp_listen_any/1;
export local_port/1;
export tcp_accept/2;
export send_bytes/3;
export recv_bytes/3;
export take/1;
export close_fd/1;

// The FFI carries a pointer-plus-length pair only as a binding's sole parameters, so a wrapper that
// needs a string and scalars takes the scalars first (set_args; kept per worker thread).
foreign c_wrapper "silica_tls_set_args"
fn set_args_raw(a: int64, b: int64) -> { tag: int64, value: int64, error_code: int64 };
foreign c_wrapper "silica_tls_connect"
fn connect_raw(host_ptr: uint8, host_len: uint64) -> { tag: int64, value: int64, error_code: int64 };
foreign c_wrapper "silica_tls_listen"
fn listen_raw(port: int64) -> { tag: int64, value: int64, error_code: int64 };
foreign c_wrapper "silica_tls_listen_any"
fn listen_any_raw(port: int64) -> { tag: int64, value: int64, error_code: int64 };
foreign c_wrapper "silica_tls_local_port"
fn local_port_raw(fd: int64) -> { tag: int64, value: int64, error_code: int64 };
foreign c_wrapper "silica_tls_accept"
fn accept_raw(fd: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 };
foreign c_wrapper "silica_tls_send"
fn send_raw(data_ptr: uint8, data_len: uint64) -> { tag: int64, value: int64, error_code: int64 };
foreign c_wrapper "silica_tls_recv"
fn recv_raw(fd: int64, max: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 };
foreign c_wrapper "silica_tls_take"
fn take_raw(fd: int64) -> { tag: int64, text_ptr: uint8, text_len: uint64, error_code: int64 };
foreign c_wrapper "silica_tls_close"
fn close_raw(fd: int64) -> { tag: int64, value: int64, error_code: int64 };

// Dials host:port and runs the handshake as the client. An error when the host does not answer and when
// the handshake fails (this node's certificate or the peer's was not accepted).
fn tcp_connect(host: string, port: int64) -> { tag: int64, value: int64, error_code: int64 } {
    _: { tag: int64, value: int64, error_code: int64 } <- set_args_raw(port, 0);
    r: { tag: int64, value: int64, error_code: int64 } <- connect_raw(host);
    r
}

// tcp_listen binds 127.0.0.1 only; tcp_listen_any binds every IPv4 interface (0.0.0.0). The listening
// socket is plain; TLS begins on each accepted connection.
fn tcp_listen(port: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- listen_raw(port);
    r
}

fn tcp_listen_any(port: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- listen_any_raw(port);
    r
}

fn local_port(fd: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- local_port_raw(fd);
    r
}

// Accepts one peer and runs the handshake as the server, which demands the peer's certificate. A peer that
// fails it is dropped inside the wrapper and the answer is a timeout: no peer this time.
fn tcp_accept(fd: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- accept_raw(fd, timeout_ms);
    r
}

fn send_bytes(fd: int64, data: string, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 } {
    _: { tag: int64, value: int64, error_code: int64 } <- set_args_raw(fd, timeout_ms);
    r: { tag: int64, value: int64, error_code: int64 } <- send_raw(data);
    r
}

fn recv_bytes(fd: int64, max: int64, timeout_ms: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- recv_raw(fd, max, timeout_ms);
    r
}

// The decrypted bytes of the last recv_bytes on this worker.
fn take(fd: int64) -> string {
    out: string <- take_raw(fd);
    out
}

fn close_fd(fd: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- close_raw(fd);
    r
}
