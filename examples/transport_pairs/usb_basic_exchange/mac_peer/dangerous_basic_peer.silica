// The Silica Mac peer of the basic exchange (examples/transport_pairs/usb_basic_exchange): the hosted (:serial)
// carrier (dangerous_serial_carrier, termios; the USB-Serial-JTAG controller ignores the baud) opened on the
// board's native USB-C port reads the one frame the board program sends, reassembles it with wireframe@unframe
// (the 4-byte length prefix of a :stream carrier), decodes the ETF term into (:accel, { x, y, z, at_ms }), and
// answers one LED command, (:led, { which: :red, on: true }), the term the Erlang peer (basic_peer.erl) answers
// with, as an ETF frame on the same port. It closes the port a second after the reply left (the board reads and
// prints it in that time; closing earlier would race the board's own close). run.sh puts the port path in place
// of the placeholder below.
module dangerous_basic_peer;

use wire_etf;
use wireframe;
use Carrier;
use dangerous_sockets;
use dangerous_serial_carrier;
use trial_wait_int64;

// The link under the (:serial) carrier (transport_links_design.md §3.3, specification §16.4.9): the
// board's USB-Serial-JTAG port on this Mac, patched per run by run.sh (the controller ignores the
// line speed; 115200 is the termios setting). spawn_dangerous_carrier(board, ...) in main starts the
// carrier on it, and the :open address is then "".
carried_on board: (:serial) (:serial_port, "/dev/cu.usbmodem-PLACEHOLDER", 115200);

fn first_segment(xs: List[string, mem(normal)]) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, _t: List[string, mem(normal)]] -> h
    }
}

fn show_reading(r: { x: int16, y: int16, z: int16, at_ms: uint64 }) -> atom {
    sequence proc[device_io]
        _: atom <- print("accel x=");
        _: atom <- print_int64(to_int64(r.x));
        _: atom <- print(" y=");
        _: atom <- print_int64(to_int64(r.y));
        _: atom <- print(" z=");
        _: atom <- print_int64(to_int64(r.z));
        _: atom <- print(" at_ms=");
        _: atom <- print_int64(to_int64(r.at_ms));
        o: atom <- println("")
    produces
        pure o
    end
}

// The LED command as one framed segment, sent as one :tx; returns its length.
fn send_led(car: dangerous_actor_ref) -> int64 {
    sequence proc[mem(normal), concurrency, transport]
        frame: string <- encode((:etf), (:led, { which: :red, on: true }));
        segs: List[string, mem(normal)] <- wireframe@frame(frame, Carrier@mtu(board), Carrier@boundaries(board));
        seg: string <- first_segment(segs);
        _: boolean <- cast(car, (:tx, seg, self()) impl ActorMessage {})
    produces
        pure length_bytes(seg)
    end
}

fn owner(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | :finish,
         state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, code: int64, reply: int64 })
    -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, code: int64, reply: int64 }) {
    case msg of {
        (:link_up, info: string) -> {
            sequence proc[concurrency, device_io]
                _: atom <- print("serial open ");
                _: atom <- println(info);
                _: boolean <- cast(state.car, (:credit, 4) impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        (:tx_credit, n: int64) -> {
            sequence proc[concurrency, device_io]
                _: atom <- case n == 1 of {
                    true -> {
                        _: atom <- print("sent ");
                        _: atom <- print_int64(state.reply);
                        _: atom <- println(" bytes");
                        _: timer_ref <- send_after(1000, self(), :finish impl ActorMessage {});
                        :ok
                    };
                    false -> :ok
                }
            produces
                pure (:no_reply, state)
            end
        };
        :finish -> {
            sequence proc[concurrency]
                _: boolean <- cast(state.car, :close impl ActorMessage {})
            produces
                pure (:no_reply, state)
            end
        };
        (:rx, segment: string) -> {
            sequence proc[concurrency]
                un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- wireframe@unframe(state.rx, segment, 4096);
                code2: int64 <- case un of {
                    (:more, _r0: { mode: atom, expected: int64, pending: string }) -> state.code;
                    (:frame, frame0: string, _r3: { mode: atom, expected: int64, pending: string }) -> {
                        sequence proc[mem(normal), device_io, concurrency, transport]
                            _: atom <- print("frame ");
                            _: atom <- print_int64(length_bytes(frame0));
                            _: atom <- println(" bytes");
                            decoded: (:ok, (:accel, { x: int16, y: int16, z: int16, at_ms: uint64 })) | (:rejected, atom) <- decode((:etf), frame0);
                            code: int64 <- case decoded of {
                                (:ok, (:accel, r: { x: int16, y: int16, z: int16, at_ms: uint64 })) -> {
                                    _: atom <- show_reading(r);
                                    0
                                };
                                (:rejected, why: atom) -> {
                                    _: atom <- print("rejected ");
                                    _: atom <- print_atom(why);
                                    _: atom <- println("");
                                    _: boolean <- cast(state.car, :close impl ActorMessage {});
                                    2
                                }
                            }
                        produces pure code end
                    };
                    (:rejected, _why1: atom) -> 3
                };
                reply2: int64 <- case un of {
                    (:frame, _f: string, _r4: { mode: atom, expected: int64, pending: string }) -> case code2 == 0 of {
                        true -> send_led(state.car);
                        false -> state.reply
                    };
                    (:more, _r5: { mode: atom, expected: int64, pending: string }) -> state.reply;
                    (:rejected, _why3: atom) -> state.reply
                };
                rx2: { mode: atom, expected: int64, pending: string } <- case un of {
                    (:more, r1: { mode: atom, expected: int64, pending: string }) -> r1;
                    (:frame, _frame: string, r2: { mode: atom, expected: int64, pending: string }) -> r2;
                    (:rejected, why2: atom) -> {
                        sequence proc[device_io, concurrency]
                            _: atom <- print("framing rejected ");
                            _: atom <- print_atom(why2);
                            _: atom <- println("");
                            _: boolean <- cast_exit(3)
                        produces pure state.rx end
                    }
                };
                _: boolean <- cast(state.car, (:credit, 1) impl ActorMessage {})
            produces
                pure (:no_reply, { car: state.car, rx: rx2, code: code2, reply: reply2 })
            end
        };
        (:tx_failed, why4: atom) -> {
            sequence proc[device_io]
                _: atom <- print("tx failed ");
                _: atom <- print_atom(why4);
                _: atom <- println("")
            produces pure (:no_reply, state) end
        };
        (:link_down, why5: atom) -> {
            sequence proc[device_io, concurrency]
                _: atom <- print("link down ");
                _: atom <- print_atom(why5);
                _: atom <- println("");
                _: boolean <- case why5 == :closed of {
                    true -> cast_exit(state.code);
                    false -> cast_exit(1)
                }
            produces pure (:no_reply, state) end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: supervisor_ref <- trial_wait_int64@start();
        _: boolean <- trial_wait_int64@run(fn() -> int64 {
            sequence proc[concurrency]
                car: dangerous_actor_ref <- spawn_dangerous_carrier(board, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                me: actor_ref <- spawn({ car: car, rx: wireframe@fresh(Carrier@boundaries(board)), code: 4, reply: 0 }, owner, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(car, (:open, me, "") impl ActorMessage {})
            produces
                pure 0
            end
        });
        code: int64 <- wait_for_exit()
    produces
        pure code
    end
}
