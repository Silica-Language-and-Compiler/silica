{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Silica",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#dangerous"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#type-annotations"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#character-literals"
    },
    {
      "include": "#atom-literals"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#arrow-operators"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#effects"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.silica",
          "match": "//[^\\n]*"
        },
        {
          "name": "comment.block.silica",
          "begin": "\\{-",
          "end": "-\\}"
        }
      ]
    },
    "dangerous": {
      "patterns": [
        {
          "name": "markup.bold markup.italic keyword.other.dangerous.silica",
          "match": "\\b(spawn_dangerous|dangerous_actor_ref|external_danger)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.silica",
          "match": "\\b(actor|actor_ref|and|as|atom|atomic|buf|case|cast|do|else|end|enum|fn|for|from|if|impl|import|module|not|of|or|proc|pub|recv|ref|region|return|self|send|spawn|spawn_registered|spawn_linked|trait|type|use|wait_for_exit|where)\\b"
        },
        {
          "name": "keyword.other.silica",
          "match": "\\b(concurrency|core_id|core_set|device_io|effect|efficiency_cores|mailbox|mem|normal|performance_cores)\\b"
        },
        {
          "name": "constant.language.silica",
          "match": "\\b(true|false|underscore)\\b"
        }
      ]
    },
    "type-annotations": {
      "patterns": [
        {
          "match": "(->|:)\\s*(dangerous_actor_ref)\\b",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.silica"
            },
            "2": {
              "name": "markup.bold markup.italic keyword.other.dangerous.silica"
            }
          }
        },
        {
          "match": "(->)\\s*(int8|int16|int32|int64|uint8|uint16|uint32|uint64|float16|float32|float64|bool|boolean|char|string|unit|atom|actor_ref|pid|dangerous_pid|supervisor_ref|monitor_ref|failure_reason|bytes|core_id|core_set|performance_cores|efficiency_cores)\\b",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.silica"
            },
            "2": {
              "name": "storage.type.annotation.silica"
            }
          }
        },
        {
          "match": ":\\s*(int8|int16|int32|int64|uint8|uint16|uint32|uint64|float16|float32|float64|bool|boolean|char|string|unit|atom|actor_ref|pid|dangerous_pid|supervisor_ref|monitor_ref|failure_reason|bytes|core_id|core_set|performance_cores|efficiency_cores)\\b",
          "captures": {
            "1": {
              "name": "storage.type.annotation.silica"
            }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.silica",
          "match": "\\b(int8|int16|int32|int64|uint8|uint16|uint32|uint64|float16|float32|float64|bool|boolean|char|string|unit|atom|actor_ref|pid|dangerous_pid|supervisor_ref|monitor_ref|failure_reason|bytes|core_id|core_set|performance_cores|efficiency_cores)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.silica",
          "match": "\\b(?!(spawn_dangerous|spawn_registered|spawn_linked|wait_for_exit)\\b)([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.silica",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.silica",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "character-literals": {
      "patterns": [
        {
          "name": "string.quoted.single.silica",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.silica",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "atom-literals": {
      "patterns": [
        {
          "name": "constant.other.symbol.silica",
          "match": ":[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.silica",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.silica",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.silica",
          "match": "\\b\\d+(\\.\\d+)?[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.silica",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "arrow-operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.silica",
          "match": "(<-|->)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.silica",
          "match": "(::|\\+|\\-|\\*|/|%|==|!=|<=|>=|<|>|&&|\\|\\||!|\\?|:|\\||=|@)"
        }
      ]
    },
    "effects": {
      "patterns": [
        {
          "name": "meta.effect.silica",
          "begin": "proc\\[",
          "end": "\\]",
          "patterns": [
            {
              "name": "markup.bold markup.italic keyword.other.dangerous.silica",
              "match": "\\bexternal_danger\\b"
            },
            {
              "name": "keyword.other.effect.silica",
              "match": "\\b(device_io|mem\\(normal\\)|concurrency)\\b"
            }
          ]
        }
      ]
    }
  },
  "scopeName": "source.silica"
}