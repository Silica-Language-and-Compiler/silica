  "semanticTokenColors": {
    "comment": {
      "foreground": "#7d8b95",
      "italic": true
    },
    "keyword": "#5eb6e0",
    "string": "#e0956a",
    "number": "#9dce9a",
    "regexp": "#e0956a",
    "operator": "#d7dee3",
    "namespace": "#7fcdd4",
    "type": "#f0a04a",
    "struct": "#f0a04a",
    "class": "#f0a04a",
    "interface": "#f0a04a",
    "enum": "#f0a04a",
    "typeParameter": "#f0a04a",
    "function": "#f3d7a1",
    "method": "#f3d7a1",
    "macro": "#f07167",
    "variable": "#d7dee3",
    "parameter": "#d7dee3",
    "property": "#d7dee3",
    "enumMember": "#9dce9a",
    "event": "#d4b4e0",
    "decorator": "#7fcdd4"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#7d8b95",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["comment.line.double-slash.silica", "comment.block.silica"],
      "settings": {
        "foreground": "#7d8b95",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["keyword", "keyword.control", "keyword.control.silica", "storage.modifier"],
      "settings": {
        "foreground": "#5eb6e0"
      }
    },
    {
      "scope": [
        "keyword.other",
        "keyword.other.silica",
        "keyword.other.effect.silica",
        "constant.language",
        "constant.language.silica"
      ],
      "settings": {
        "foreground": "#9adbe2"
      }
    },
    {
      "scope": ["meta.effect.silica"],
      "settings": {
        "foreground": "#7fcdd4"
      }
    },
    {
      "scope": ["storage.type", "storage.type.silica", "storage.type.annotation.silica", "support.type", "entity.name.type"],
      "settings": {
        "foreground": "#f0a04a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.function.silica",
        "support.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#f3d7a1"
      }
    },
    {
      "scope": ["string", "string.quoted.double.silica", "string.quoted.single.silica"],
      "settings": {
        "foreground": "#e0956a"
      }
    },
    {
      "scope": ["constant.character.escape", "constant.character.escape.silica"],
      "settings": {
        "foreground": "#f0d2a0"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.numeric.silica",
        "constant.numeric.hex.silica",
        "constant.numeric.binary.silica",
        "constant.other.symbol",
        "constant.other.symbol.silica"
      ],
      "settings": {
        "foreground": "#9dce9a"
      }
    },
    {
      "scope": ["keyword.operator", "keyword.operator.silica"],
      "settings": {
        "foreground": "#d7dee3"
      }
    },
    {
      "scope": ["keyword.operator.arrow.silica"],
      "settings": {
        "foreground": "#d4b4e0"
      }
    },
    {
      "scope": ["keyword.other.dangerous.silica"],
      "settings": {
        "foreground": "#f07167",
        "fontStyle": "bold italic"
      }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter", "support.variable"],
      "settings": {
        "foreground": "#d7dee3"
      }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#93a2ad"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#f07167"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#58b8c1",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#e0956a"
      }
    }
  ]
}
