  "semanticTokenColors": {
    "comment": {
      "foreground": "#59656f",
      "italic": true
    },
    "keyword": "#1a6e7a",
    "string": "#8f4324",
    "number": "#2a6b45",
    "regexp": "#8f4324",
    "operator": "#1f272e",
    "namespace": "#135861",
    "type": "#9a4a22",
    "struct": "#9a4a22",
    "class": "#9a4a22",
    "interface": "#9a4a22",
    "enum": "#9a4a22",
    "typeParameter": "#9a4a22",
    "function": "#8a4b12",
    "method": "#8a4b12",
    "macro": "#b42318",
    "variable": "#1f272e",
    "parameter": "#1f272e",
    "property": "#1f272e",
    "enumMember": "#2a6b45",
    "event": "#5c4a86",
    "decorator": "#135861"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#59656f",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["comment.line.double-slash.silica", "comment.block.silica"],
      "settings": {
        "foreground": "#59656f",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["keyword", "keyword.control", "keyword.control.silica", "storage.modifier"],
      "settings": {
        "foreground": "#1a6e7a"
      }
    },
    {
      "scope": [
        "keyword.other",
        "keyword.other.silica",
        "keyword.other.effect.silica",
        "constant.language",
        "constant.language.silica"
      ],
      "settings": {
        "foreground": "#0f5c78"
      }
    },
    {
      "scope": ["meta.effect.silica"],
      "settings": {
        "foreground": "#135861"
      }
    },
    {
      "scope": ["storage.type", "storage.type.silica", "storage.type.annotation.silica", "support.type", "entity.name.type"],
      "settings": {
        "foreground": "#9a4a22"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.function.silica",
        "support.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#8a4b12"
      }
    },
    {
      "scope": ["string", "string.quoted.double.silica", "string.quoted.single.silica"],
      "settings": {
        "foreground": "#8f4324"
      }
    },
    {
      "scope": ["constant.character.escape", "constant.character.escape.silica"],
      "settings": {
        "foreground": "#7a4e16"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.numeric.silica",
        "constant.numeric.hex.silica",
        "constant.numeric.binary.silica",
        "constant.other.symbol",
        "constant.other.symbol.silica"
      ],
      "settings": {
        "foreground": "#2a6b45"
      }
    },
    {
      "scope": ["keyword.operator", "keyword.operator.silica"],
      "settings": {
        "foreground": "#1f272e"
      }
    },
    {
      "scope": ["keyword.operator.arrow.silica"],
      "settings": {
        "foreground": "#5c4a86"
      }
    },
    {
      "scope": ["keyword.other.dangerous.silica"],
      "settings": {
        "foreground": "#b42318",
        "fontStyle": "bold italic"
      }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter", "support.variable"],
      "settings": {
        "foreground": "#1f272e"
      }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#59656f"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#b42318"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#1a6e7a",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#8f4324"
      }
    }
  ]
}
