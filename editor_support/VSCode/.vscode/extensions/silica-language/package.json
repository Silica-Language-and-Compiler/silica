{
  "name": "silica-language",
  "displayName": "Silica Language Support",
  "description": "Syntax highlighting, language support, and the Silica color scheme",
  "version": "0.0.9",
  "publisher": "silica",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "contributes": {
    "languages": [
      {
        "id": "silica",
        "aliases": [
          "Silica",
          "silica"
        ],
        "extensions": [
          ".silica"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "silica",
        "scopeName": "source.silica",
        "path": "./syntaxes/silica.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Silica Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/silica-dark-color-theme.json"
      },
      {
        "label": "Silica Light",
        "uiTheme": "vs",
        "path": "./themes/silica-light-color-theme.json"
      }
    ]
  }
}