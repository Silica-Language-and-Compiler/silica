{
  "name": "silica-language",
  "displayName": "Silica Language Support",
  "description": "Syntax highlighting and basic language support for Silica",
  "version": "0.0.8",
  "publisher": "silica",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "silica",
        "aliases": [
          "Silica",
          "silica"
        ],
        "extensions": [
          ".silica"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "silica",
        "scopeName": "source.silica",
        "path": "./syntaxes/silica.tmLanguage.json"
      }
    ]
  }
}