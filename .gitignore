# Build artifacts
target/

# LLVM intermediate files
*.ll
*.bc

# Object files
*.o


# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/
# The Silica VS Code extension is kept in the repository (editor_support/VSCode/INSTALL.md).
!/editor_support/VSCode/.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Temporary files
*.tmp

# Optional trial scratch: substring needles for merged-atom rodata checks (prefer inlining in Makefile).
*.atom_rotext.expect


# Local debugging scratch (SP checkers, minimal repros)
.scratch/

# Per-integrate stdlib object cache for standard_data_structures trials
trials/standard_data_structures/.stdlib_cache/

# Content-addressed per-trial compile cache (trials/standard_data_structures/trial_cache.sh)
trials/standard_data_structures/*/.trial_cache/

# Claude Code persistent memory (local only, never committed)
.claude-memory/

# make fixpoint (compiler/src): gen3 binary, gen2's stamp, and the saved gen1 .sams
compiler/.src_fixpoint/
compiler/src/.gen1_emission_stamp
compiler/src/silica-compiler-gen3

# Per-target compiler build directories (compiler/src/Makefile): compiler/build/<emit target>/ holds
# one target's silica.config, .sams, .iface, .o, silica.link and linked compiler; the unit symlinks
# into src/ live there too. compiler/build/<target>.fixpoint is make fixpoint's saved gen1 .sams.
compiler/build/

# Machines this checkout builds on (build_all_platforms.sh). Never commit: it names your hosts.
.silica_build_hosts

# Compiler and trial build outputs (the same list programmer_tools/sync_excludes.sh keeps off other
# machines). Goldens stay tracked: .ascomp, .scout (board and ladder apps: expected.scout), .golden_fail.
# Published compilers in binaries/ are not matched by any of these.
*.sams
*.iface
*.a
*.so
*.dylib
*.sout
*.cur_fail
*.cur_warn
*.mklog
*.elf
*.map
__pycache__/
silica.link
silica.atoms
silica.shapes
silica.needs_runtime
silica.compile.order
silica.target
.silica.config.units
/compiler/src/silica-compiler
/compiler/src/silica-gen1
/compiler/src/silica-gen2

.claude/
.codex_artifacts/
.cursor/
board_backups/
*.pptx
