/// DeviceDescription trait — see `silica_device_actor_specification.md` §4.9.
///
/// A device description is the programmer's statement of a device's register layout: one
/// `impl fn registers(device: (:tag))` per device tag, written in a `device_*` module that
/// `use`s this file, whose body is a single list literal of record literals. The compiler reads it
/// as data (register names, offsets, widths, access modes) and programs may also call it.
/// Access modes: `:read_write`, `:read_only`, `:write_only`, `:write_one_to_clear`.

export trait DeviceDescription;
export registers/1;

required {
    fn registers(device: DeviceDescription) -> List[{ name: atom, offset: uint64, width: uint64, access: atom }, mem(normal)];
}
