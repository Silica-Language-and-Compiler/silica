/// Supervisor trait — see `silica-specification.md` §15.4.13 (Supervisor Trait).
///
/// Implementors supply `init`, which returns `supervisor_flags` and a static `child_spec` list.
/// Supervisor startup is runtime-owned: `spawn_registered_supervisor(T, state, name)` calls
/// `T.init(state)` exactly once, registers the supervisor, and owns child lifecycle.
///
/// Shapes below follow §15.4.13.2:
/// - `supervisor_flags`: `strategy`, `allowed_restart_count`, `restarts_time_frame` (seconds).
/// - `restart_strategy`: `:one_for_one` | `:one_for_all` | `:rest_for_one`.
/// - `child_spec`: `id`, `agent_type`, `initial_state`, `behavior`,
///   `restart`, `shutdown` (0 = immediate; > 0 ms timeout),
///   `flavor` (`:plain` = normal PID registry; `:dangerous` = dangerous PID registry,
///    requires `id` starting with `:dangerous_` and cast-type behavior).
/// - Static children list: `List[child_spec, mem(ρ)]` where `ρ` is any memory space allowed for
///   list-element storage (`normal`, `device`, `atomic`, etc.); the required return type spells the
///   union explicitly so implementors are not misread as “lists must use normal only”.
///
/// Each supervised child behavior must use a single reply convention throughout (§15.1). The
/// `behavior` type here uses the `(:no_reply, …)` form; call-only children use `(:reply, Reply, State)`
/// with monomorphic `Msg` / `Reply` / `State`.

export trait Supervisor;
export init/1;

required {
    fn init(initial_supervisor_state: ActorState) -> (
        {
            strategy: :one_for_one | :one_for_all | :rest_for_one,
            allowed_restart_count: int64,
            restarts_time_frame: int64
        },
        List[
            {
                id: atom,
                agent_type: :worker | :supervisor,
                initial_state: ActorState,
                behavior: fn(msg: ActorMessage, state: ActorState) -> (:no_reply, ActorState),
                restart: :permanent | :temporary | :transient,
                shutdown: int64,
                flavor: :plain | :dangerous
            },
            mem(normal)
                | mem(normal_writeback)
                | mem(normal_writethrough)
                | mem(normal_noncacheable)
                | mem(atomic)
                | mem(device)
        ]
    );
}
