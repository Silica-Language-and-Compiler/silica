// Public Tree trait — Layer 3E over the tree_rose persistent rose tree with skew-binary child
// slots. Authority: design_documents/Phase1_TODOs/data_structure_designs/tree_trait.md §5.
//
// get/child_at keep a not-found placeholder argument (same as the tree_rose core, the BinaryTree
// and OrderedMap traits: Silica source cannot conjure an ItemType zero). root_item/1 returns the
// item directly (a Tree is never empty); see the note on its impl. Paths are List[int64, mem(normal)] of stable child slots
// (the empty list is the root) and may be written as literals. The design declares no provided
// methods for Tree, so there is no provided block.

use tree_rose;

export trait Tree;
export node_count/1;
export root_item/1;
export get/3;
export child_count/2;
export child_slot_count/2;
export child_at/4;
export fold_preorder/3;
export compare_item/3;

required {
    fn node_count(tree: Tree) -> int64;
    fn root_item(tree: Tree) -> ItemType;
    fn get(tree: Tree, path: List[int64, mem(normal)], placeholder: ItemType)
        -> { status: :not_found | :found, value: ItemType };
    fn child_count(tree: Tree, path: List[int64, mem(normal)])
        -> { status: :not_found | :found, count: int64 };
    fn child_slot_count(tree: Tree, path: List[int64, mem(normal)])
        -> { status: :not_found | :found, count: int64 };
    fn child_at(tree: Tree, path: List[int64, mem(normal)], slot: int64, placeholder: ItemType)
        -> { status: :not_found | :found, value: ItemType, child_path: List[int64, mem(normal)] };
    fn fold_preorder(
        tree: Tree,
        init: AccType,
        step: fn(AccType, List[int64, mem(normal)], ItemType) -> AccType
    ) -> AccType;
    fn compare_item(tree: Tree, a: ItemType, b: ItemType) -> :less | :equal | :greater;
}

impl fn node_count(
    tree: {
        root: ref?(L, normal, (ItemType, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> int64 {
    tree_rose@node_count(tree)
}

// Deviation: inside a trait impl body the checker resolves every call that returns ItemType
// against the concrete receiver while the impl's declared return stays the placeholder, so a
// bare-ItemType result cannot come from tree_rose@root_item (or any witness-bearing call). The
// impl therefore reads the root node itself (tree_rose's nine-field node, spelled in full: item,
// subtree_node_count, live_child_count, slot_count, weight, slot, left, right, spine; see the
// tree_rose header, deviation 2); a :none root is unreachable through public constructors and halts.
impl fn root_item(
    tree: {
        root: ref?(L, normal, (ItemType, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    }
) -> ItemType {
    case tree.root of {
        :none -> root_item_halt(0);
        node_ref: ref(L, normal, (ItemType, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])) -> root_item_of(node_ref)
    }
}

fn root_item_of(node_ref: ref(L, normal, (ItemType, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]))) -> ItemType {
    sequence proc[mem(normal)]
        node: (ItemType, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)]) <- read_ref(node_ref);
        (item, _: int64, _: int64, _: int64, _: int64, _: ref?(L, normal, (ItemType, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), _: ref?(L, normal, (ItemType, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), _: ref?(L, normal, (ItemType, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), _: List[ref?(L, normal, (ItemType, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])), mem(normal)]) <- node
    produces
        pure item
    end
}

fn root_item_halt(depth: int64) -> ItemType {
    sequence
        _: int64 <- 1 / 0
    produces
        pure root_item_halt(depth + 1)
    end
}

impl fn get(
    tree: {
        root: ref?(L, normal, (ItemType, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    path: List[int64, mem(normal)],
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    tree_rose@get(tree, path, placeholder)
}

impl fn child_count(
    tree: {
        root: ref?(L, normal, (ItemType, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    path: List[int64, mem(normal)]
) -> { status: :not_found | :found, count: int64 } {
    tree_rose@child_count(tree, path)
}

impl fn child_slot_count(
    tree: {
        root: ref?(L, normal, (ItemType, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    path: List[int64, mem(normal)]
) -> { status: :not_found | :found, count: int64 } {
    tree_rose@child_slot_count(tree, path)
}

impl fn child_at(
    tree: {
        root: ref?(L, normal, (ItemType, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    path: List[int64, mem(normal)],
    slot: int64,
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType, child_path: List[int64, mem(normal)] } {
    tree_rose@child_at(tree, path, slot, placeholder)
}

impl fn fold_preorder(
    tree: {
        root: ref?(L, normal, (ItemType, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    init: AccType,
    step: fn(AccType, List[int64, mem(normal)], ItemType) -> AccType
) -> AccType {
    tree_rose@fold_preorder(tree, init, step)
}

impl fn compare_item(
    tree: {
        root: ref?(L, normal, (ItemType, int64, int64, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec), ref?(L, normal, rec), List[ref?(L, normal, rec), mem(normal)])),
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        region: region(L, normal),
        specialization_key: int64,
        compare_item_ordering_bundle: int64
    },
    a: ItemType,
    b: ItemType
) -> :less | :equal | :greater {
    tree_rose@compare_item(tree, a, b)
}
