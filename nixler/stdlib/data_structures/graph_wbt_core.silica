// Layer 4 — graph_wbt_core: the live WBT adjacency engine shared by every live graph family
// (graph_wbt_directed, graph_wbt_undirected, graph_weighted, graph_weighted_undirected).
// Authority: design_documents/Phase1_TODOs/data_structure_designs/live_wbt_graph.md over
// weight_balanced_tree.md; common_contract.md.
//
// Logical storage (design §1): vertices : WBTMap<NodeId, WBTMap<NodeId, EdgeValue>>, both levels
// keyed by compare_node, over the existing corrected Adams WBT (wbt_map). The outer map's value is
// the inner map's root reference, so every level shares the graph's canonical arena and one
// adjacency position exists per (from, to) pair. The families hand this unit an adjacency record
// with wbt_map's own shape:
//     { root (outer root), compare_key (compare_node), compare_value (edge value comparator),
//       region, specialization_key, compare_key_ordering_bundle, compare_value_ordering_bundle }
// and rebuild the outer record (value = inner root, never compared) or an inner record around it
// for every wbt_map call (the nested-generic rule: each qualified call sees a flat item type and its
// own compare_* witness). Updates path-copy through wbt_map@insert / wbt_map@delete; queries walk
// the node tuples directly and allocate only the materialized lists they return.
//
// Node shapes: outer (KeyType, ref?(inner root), size, left, right); inner (KeyType, ValueType,
// size, left, right) — wbt_map's (key, value, size, left, right) node.
// Every comparison validates the comparator atom; an atom outside :less | :equal | :greater is a
// deterministic collection error (division by zero), never a branch (common_contract.md §4).
// compare_raw stays the first function in this unit (per-unit comparator atom numbering).
// Validation error atoms are created and decoded only in this unit (validate_error_code): atom
// values are numbered per compilation unit.
// Q19 node shapes (spelled at every use): inner (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)); outer, the graph root, (KeyType, ref?(L, normal, <inner>), int64, ref?(L, normal, rec), ref?(L, normal, rec)).

use wbt_map;
use wbt_set;

export arena_key/0;
export has_vertex/2;
export add_vertex/2;
export set_entry/4;
export remove_entry/3;
export has_entry/3;
export lookup/4;
export entry_value/3;
export degree/2;
export self_loop_count/2;
export vertex_count/1;
export targets/2;
export values/2;
export wrappers/2;
export vertices/1;
export degree_list/1;
export fold_values/4;
export fold_wrappers/4;
export fold_vertices/3;
export fold_entries/3;
export fold_entries_wrapped/3;
export fold_entries_canonical/3;
export entry_list/1;
export reachable/3;
export compare_nodes/3;
export compare_values/3;
export validate_directed/4;
export validate_keyed/3;
export validate_undirected/4;
export asymmetry_error/0;
export validate_error_code/1;

fn compare_raw(
    compare: fn(KeyType, KeyType) -> atom,
    a: KeyType,
    b: KeyType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

fn compare_value_raw(
    compare: fn(ValueType, ValueType) -> atom,
    a: ValueType,
    b: ValueType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

// Deterministic collection error for an invalid comparator atom.
fn invalid_halt(_: atom) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0
    produces
        pure :equal
    end
}

// Deterministic collection error: an update found a malformed graph (for example one stored
// direction of an undirected edge) and publishes nothing.
fn malformed_halt(n: int64) -> int64 {
    sequence
        _: int64 <- 1 / 0
    produces
        pure n
    end
}

fn value_halt(n: int64) -> ValueType {
    sequence
        _: int64 <- 1 / 0
    produces
        pure value_halt(n + 1)
    end
}

fn arena_key() -> int64 {
    90
}

// The graph's node comparator, result validated.
fn compare_nodes(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, a: KeyType, b: KeyType) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_raw(adj.compare_key, a, b)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> invalid_halt(bad)
        }
    end
}

// The graph's edge-value comparator, result validated.
fn compare_values(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, a: ValueType, b: ValueType) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_value_raw(adj.compare_value, a, b)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> invalid_halt(bad)
        }
    end
}

fn nodes_equal(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, a: KeyType, b: KeyType) -> boolean {
    c: :less | :equal | :greater <- compare_nodes(adj, a, b);
    case c of {
        :equal -> true;
        _: atom -> false
    }
}

// The outer map value is an inner root; it is never compared (wbt_map@insert replaces on :equal keys).
fn root_compare(_: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) -> :less | :equal | :greater {
    :equal
}

fn none_root() -> ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    :none
}

fn b2i(b: boolean) -> int64 {
    case b of {
        true -> 1;
        false -> 0
    }
}

fn outer_of(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } {
    out: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- {
        root: adj.root,
        compare_key: adj.compare_key,
        compare_value: root_compare,
        region: adj.region,
        specialization_key: adj.specialization_key,
        compare_key_ordering_bundle: adj.compare_key_ordering_bundle,
        compare_value_ordering_bundle: 0
    };
    out
}

fn inner_of(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, inner_root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) -> { root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } {
    out: { root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- {
        root: inner_root,
        compare_key: adj.compare_key,
        compare_value: adj.compare_value,
        region: adj.region,
        specialization_key: adj.specialization_key,
        compare_key_ordering_bundle: adj.compare_key_ordering_bundle,
        compare_value_ordering_bundle: adj.compare_value_ordering_bundle
    };
    out
}

fn with_root(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec)))) -> { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } {
    out: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- {
