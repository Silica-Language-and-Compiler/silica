// Visits every stored entry as (from, {to, data}): ascending from, then ascending target.
fn fold_entries_wrapped(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, init: AccType, step: fn(AccType, KeyType, { to: KeyType, data: ValueType }) -> AccType) -> AccType {
    fold_wentries_go(adj.root, init, step)
}

fn fold_crow_go(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, from: KeyType, node: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), acc: AccType, step: fn(AccType, KeyType, KeyType, ValueType) -> AccType) -> AccType {
    case node of {
        :none -> acc;
        node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                n: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (k, v, _: int64, left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- n;
                a1: AccType <- fold_crow_go(adj, from, left, acc, step);
                c: :less | :equal | :greater <- compare_nodes(adj, from, k);
                a2: AccType <- case c of {
                    :greater -> a1;
                    _: atom -> step(a1, from, k, v)
                }
            produces
                pure fold_crow_go(adj, from, right, a2, step)
            end
        }
    }
}

fn fold_centries_go(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, node: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), acc: AccType, step: fn(AccType, KeyType, KeyType, ValueType) -> AccType) -> AccType {
    case node of {
        :none -> acc;
        node_ref: ref(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                n: (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (k, inner: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: int64, left: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- n;
                a1: AccType <- fold_centries_go(adj, left, acc, step);
                a2: AccType <- fold_crow_go(adj, k, inner, a1, step)
            produces
                pure fold_centries_go(adj, right, a2, step)
            end
        }
    }
}

// Undirected logical-edge fold (undirected_graph_trait.md §7): a self-loop once, a non-loop edge
// only from the endpoint that compares less; ascending (from, to) order.
fn fold_entries_canonical(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, init: AccType, step: fn(AccType, KeyType, KeyType, ValueType) -> AccType) -> AccType {
    fold_centries_go(adj, adj.root, init, step)
}

fn entry_row_go(from: KeyType, node: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), acc: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)]) -> List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] {
    case node of {
        :none -> acc;
        node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                n: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (k, v, _: int64, left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- n;
                r: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] <- entry_row_go(from, right, acc);
                e: { from: KeyType, to: KeyType, data: ValueType } <- { from: from, to: k, data: v };
                m: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] <- prepend[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)](e, r)
            produces
                pure entry_row_go(from, left, m)
            end
        }
    }
}

fn entry_list_go(node: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), acc: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)]) -> List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] {
    case node of {
        :none -> acc;
        node_ref: ref(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                n: (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (k, inner: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: int64, left: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- n;
                r: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] <- entry_list_go(right, acc);
                m: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] <- entry_row_go(k, inner, r)
            produces
                pure entry_list_go(left, m)
            end
        }
    }
}

// Every stored entry as {from, to, data}, ascending from then target (diagnostics and freezing).
fn entry_list(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }) -> List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] <- empty[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)]()
    produces
        pure entry_list_go(adj.root, e)
    end
}

// ---------------------------------------------------------------------------------------------
// Reachability (directed_graph_trait.md §6, undirected_graph_trait.md §8): depth-first search over
// stored entries with a wbt_set visited set under the graph's node comparator; terminates on
// cycles and self-loops. Absent endpoints are unreachable; an existing vertex reaches itself.
// ---------------------------------------------------------------------------------------------

fn push_targets(node: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), stack: List[KeyType, mem(normal)]) -> List[KeyType, mem(normal)] {
    targets_go(node, stack)
}

fn search_go(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, visited: { root: ref?(L, normal, (KeyType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(KeyType, KeyType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, stack: List[KeyType, mem(normal)], goal: KeyType) -> boolean {
    case stack.is_nil of {
        true -> false;
        false -> {
            x: KeyType <- stack.head;
            seen: boolean <- wbt_set@contains(visited, x);
            case seen of {
                true -> search_go(adj, visited, stack.tail, goal);
                false -> case nodes_equal(adj, x, goal) of {
                    true -> true;
                    false -> {
                        ins: { set: { root: ref?(L, normal, (KeyType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(KeyType, KeyType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, inserted: boolean } <- wbt_set@insert(visited, x);
                        more: List[KeyType, mem(normal)] <- push_targets(inner_root_of(adj, x), stack.tail);
                        search_go(adj, ins.set, more, goal)
                    }
                }
            }
        }
    }
}

fn prepend_key(k: KeyType, rest: List[KeyType, mem(normal)]) -> List[KeyType, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[KeyType, mem(normal)] <- prepend[KeyType, mem(normal)](k, rest)
    produces
        pure out
    end
}

fn reachable(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, from: KeyType, to: KeyType) -> boolean {
    case has_vertex(adj, from) and has_vertex(adj, to) of {
        false -> false;
        true -> case nodes_equal(adj, from, to) of {
            true -> true;
            false -> {
                visited: { root: ref?(L, normal, (KeyType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(KeyType, KeyType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- wbt_set@empty({ compare_item: adj.compare_key });
                e: List[KeyType, mem(normal)] <- empty_keys();
                stack: List[KeyType, mem(normal)] <- prepend_key(from, e);
                search_go(adj, visited, stack, to)
            }
        }
    }
}

// ---------------------------------------------------------------------------------------------
// Validation (design §11; common_contract.md §12). Preorder: counts, outer WBT, node count, then
// each vertex ascending: its inner WBT, then each target ascending (endpoint, payload target or
// reverse entry). Finally the count equations. O(V + A log V). logical_count is the logical edge
// count on success and 0 on failure.
// ---------------------------------------------------------------------------------------------

fn ok_result(n: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    { valid: true, error: :ok, logical_count: n }
}

fn fail_result(e: atom) -> { valid: boolean, error: atom, logical_count: int64 } {
    { valid: false, error: e, logical_count: 0 }
}

// wbt_map validator codes to this unit's atoms (wbt_map@validate_error_code numbering).
fn wbt_error(code: int64) -> atom {
    case code of {
        1 -> :cycle;
        2 -> :wrong_arena;
        3 -> :repeated_child;
        4 -> :invalid_comparator_result;
        5 -> :negative_count;
        6 -> :size_mismatch;
        7 -> :order_violation;
        8 -> :balance_violation;
        _: int64 -> :wbt_violation
    }
}

fn asymmetry_error() -> atom {
    :undirected_asymmetry
}

fn check_inner_wbt(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, inner_root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) -> atom {
    inner: { root: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- inner_of(adj, inner_root);
    r: { valid: boolean, error: atom, logical_count: int64 } <- wbt_map@validate(inner);
    case r.valid of {
        true -> :ok;
        false -> wbt_error(wbt_map@validate_error_code(r.error))
    }
}

fn check_outer_wbt(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, node_count: int64) -> atom {
    o: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- outer_of(adj);
    r: { valid: boolean, error: atom, logical_count: int64 } <- wbt_map@validate(o);
    case r.valid of {
        false -> wbt_error(wbt_map@validate_error_code(r.error));
        true -> case r.logical_count == node_count of {
            true -> :ok;
            false -> :size_mismatch
        }
    }
}

fn apply_target(f: fn(ValueType) -> KeyType, v: ValueType) -> KeyType {
    f(v)
}

// Directed per-entry checks: the target is a vertex and the payload's extracted target equals the
// adjacency key (directed_graph_trait.md §9 items 2 and 4).
fn dcheck_row(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, target_of: fn(ValueType) -> KeyType, node: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), err: atom) -> atom {
    case err of {
        :ok -> case node of {
            :none -> :ok;
            node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
                sequence proc[mem(normal)]
                    n: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                    (k, v, _: int64, left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- n;
                    e1: atom <- dcheck_row(adj, target_of, left, :ok);
                    e2: atom <- dcheck_entry(adj, target_of, k, v, e1)
                produces
                    pure dcheck_row(adj, target_of, right, e2)
                end
            }
        };
        _: atom -> err
    }
}

fn dcheck_entry(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, target_of: fn(ValueType) -> KeyType, k: KeyType, v: ValueType, err: atom) -> atom {
    case err of {
        :ok -> case has_vertex(adj, k) of {
            false -> :missing_endpoint;
            true -> {
                t: KeyType <- apply_target(target_of, v);
                case nodes_equal(adj, t, k) of {
                    true -> :ok;
                    false -> :target_mismatch
                }
            }
        };
        _: atom -> err
    }
}

fn dcheck_vertices(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, target_of: fn(ValueType) -> KeyType, node: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), st: { error: atom, entries: int64 }) -> { error: atom, entries: int64 } {
    case st.error of {
        :ok -> case node of {
            :none -> st;
            node_ref: ref(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
                sequence proc[mem(normal)]
                    n: (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                    (_, inner: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: int64, left: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- n;
                    s1: { error: atom, entries: int64 } <- dcheck_vertices(adj, target_of, left, st);
                    s2: { error: atom, entries: int64 } <- dcheck_one(adj, target_of, inner, s1)
                produces
                    pure dcheck_vertices(adj, target_of, right, s2)
                end
            }
        };
        _: atom -> st
    }
}

fn dcheck_one(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, target_of: fn(ValueType) -> KeyType, inner: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), st: { error: atom, entries: int64 }) -> { error: atom, entries: int64 } {
    case st.error of {
        :ok -> {
            w: atom <- check_inner_wbt(adj, inner);
            case w of {
                :ok -> {
                    e: atom <- dcheck_row(adj, target_of, inner, :ok);
                    { error: e, entries: st.entries + node_size(inner) }
                };
                _: atom -> { error: w, entries: st.entries }
            }
        };
        _: atom -> st
    }
}

// Validates a directed live graph: WBTs, endpoints, payload targets, node and edge counts
// (edge_count = adjacency entries).
fn validate_directed(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, target_of: fn(ValueType) -> KeyType, node_count: int64, edge_count: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    case node_count < 0 or edge_count < 0 of {
        true -> fail_result(:negative_count);
        false -> {
            w: atom <- check_outer_wbt(adj, node_count);
            case w of {
                :ok -> {
                    s0: { error: atom, entries: int64 } <- { error: :ok, entries: 0 };
                    s: { error: atom, entries: int64 } <- dcheck_vertices(adj, target_of, adj.root, s0);
                    case s.error of {
                        :ok -> case s.entries == edge_count of {
                            true -> ok_result(edge_count);
                            false -> fail_result(:edge_count_mismatch)
                        };
                        _: atom -> fail_result(s.error)
                    }
                };
                _: atom -> fail_result(w)
            }
        }
    }
}

// Keyed directed checks (attributed/weighted directed graphs: the neighbor view's target is the
// adjacency key by construction, so only endpoint existence is checked per entry).
fn kcheck_row(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, node: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), err: atom) -> atom {
    case err of {
        :ok -> case node of {
            :none -> :ok;
            node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
                sequence proc[mem(normal)]
                    n: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                    (k, _, _: int64, left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- n;
                    e1: atom <- kcheck_row(adj, left, :ok);
                    e2: atom <- kcheck_entry(adj, k, e1)
                produces
                    pure kcheck_row(adj, right, e2)
                end
            }
        };
        _: atom -> err
    }
}

fn kcheck_entry(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, k: KeyType, err: atom) -> atom {
    case err of {
        :ok -> case has_vertex(adj, k) of {
            false -> :missing_endpoint;
            true -> :ok
        };
        _: atom -> err
    }
}

fn kcheck_vertices(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, node: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), st: { error: atom, entries: int64 }) -> { error: atom, entries: int64 } {
    case st.error of {
        :ok -> case node of {
            :none -> st;
            node_ref: ref(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
                sequence proc[mem(normal)]
                    n: (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                    (_, inner: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: int64, left: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- n;
                    s1: { error: atom, entries: int64 } <- kcheck_vertices(adj, left, st);
                    s2: { error: atom, entries: int64 } <- kcheck_one(adj, inner, s1)
                produces
                    pure kcheck_vertices(adj, right, s2)
                end
            }
        };
        _: atom -> st
    }
}

fn kcheck_one(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, inner: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), st: { error: atom, entries: int64 }) -> { error: atom, entries: int64 } {
    case st.error of {
        :ok -> {
            w: atom <- check_inner_wbt(adj, inner);
            case w of {
                :ok -> {
                    e: atom <- kcheck_row(adj, inner, :ok);
                    { error: e, entries: st.entries + node_size(inner) }
                };
                _: atom -> { error: w, entries: st.entries }
            }
        };
        _: atom -> st
    }
}

// Validates a keyed directed live graph (graph_weighted): WBTs, endpoints, node and edge counts.
fn validate_keyed(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, node_count: int64, edge_count: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    case node_count < 0 or edge_count < 0 of {
        true -> fail_result(:negative_count);
        false -> {
            w: atom <- check_outer_wbt(adj, node_count);
            case w of {
                :ok -> {
                    s0: { error: atom, entries: int64 } <- { error: :ok, entries: 0 };
                    s: { error: atom, entries: int64 } <- kcheck_vertices(adj, adj.root, s0);
                    case s.error of {
                        :ok -> case s.entries == edge_count of {
                            true -> ok_result(edge_count);
                            false -> fail_result(:edge_count_mismatch)
                        };
                        _: atom -> fail_result(s.error)
                    }
                };
                _: atom -> fail_result(w)
            }
        }
    }
}

// Undirected per-entry checks: the target is a vertex; a non-loop entry has its reverse entry and
// the two carry comparator-equal edge data (undirected_graph_trait.md §11 items 1–2).
fn ucheck_row(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, from: KeyType, node: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), st: { error: atom, loops: int64 }) -> { error: atom, loops: int64 } {
    case st.error of {
        :ok -> case node of {
            :none -> st;
            node_ref: ref(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
                sequence proc[mem(normal)]
                    n: (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                    (k, v, _: int64, left: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- n;
                    s1: { error: atom, loops: int64 } <- ucheck_row(adj, from, left, st);
                    s2: { error: atom, loops: int64 } <- ucheck_entry(adj, from, k, v, s1)
                produces
                    pure ucheck_row(adj, from, right, s2)
                end
            }
        };
        _: atom -> st
    }
}

fn ucheck_entry(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, from: KeyType, k: KeyType, v: ValueType, st: { error: atom, loops: int64 }) -> { error: atom, loops: int64 } {
    case st.error of {
        :ok -> case has_vertex(adj, k) of {
            false -> { error: :missing_endpoint, loops: st.loops };
            true -> case nodes_equal(adj, from, k) of {
                true -> { error: :ok, loops: st.loops + 1 };
                false -> case has_entry(adj, k, from) of {
                    false -> { error: :undirected_asymmetry, loops: st.loops };
                    true -> {
                        back: ValueType <- entry_value(adj, k, from);
                        c: :less | :equal | :greater <- compare_values(adj, v, back);
                        case c of {
                            :equal -> st;
                            _: atom -> { error: :undirected_asymmetry, loops: st.loops }
                        }
                    }
                }
            }
        };
        _: atom -> st
    }
}

fn ucheck_vertices(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, node: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), st: { error: atom, entries: int64, loops: int64 }) -> { error: atom, entries: int64, loops: int64 } {
    case st.error of {
        :ok -> case node of {
            :none -> st;
            node_ref: ref(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
                sequence proc[mem(normal)]
                    n: (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                    (k, inner: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: int64, left: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- n;
                    s1: { error: atom, entries: int64, loops: int64 } <- ucheck_vertices(adj, left, st);
                    s2: { error: atom, entries: int64, loops: int64 } <- ucheck_one(adj, k, inner, s1)
                produces
                    pure ucheck_vertices(adj, right, s2)
                end
            }
        };
        _: atom -> st
    }
}

fn ucheck_one(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, from: KeyType, inner: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), st: { error: atom, entries: int64, loops: int64 }) -> { error: atom, entries: int64, loops: int64 } {
    case st.error of {
        :ok -> {
            w: atom <- check_inner_wbt(adj, inner);
            case w of {
                :ok -> {
                    r0: { error: atom, loops: int64 } <- { error: :ok, loops: st.loops };
                    r: { error: atom, loops: int64 } <- ucheck_row(adj, from, inner, r0);
                    { error: r.error, entries: st.entries + node_size(inner), loops: r.loops }
                };
                _: atom -> { error: w, entries: st.entries, loops: st.loops }
            }
        };
        _: atom -> st
    }
}

// Validates an undirected live graph: WBTs, endpoints, symmetry with equal data, node count,
// adjacency_entry_count = L + 2N and edge_count = L + N (live_wbt_graph.md §9).
fn validate_undirected(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, node_count: int64, edge_count: int64, adjacency_entry_count: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    case node_count < 0 or edge_count < 0 or adjacency_entry_count < 0 of {
        true -> fail_result(:negative_count);
        false -> {
            w: atom <- check_outer_wbt(adj, node_count);
            case w of {
                :ok -> {
                    s0: { error: atom, entries: int64, loops: int64 } <- { error: :ok, entries: 0, loops: 0 };
                    s: { error: atom, entries: int64, loops: int64 } <- ucheck_vertices(adj, adj.root, s0);
                    case s.error of {
                        :ok -> case s.entries == adjacency_entry_count and edge_count == s.loops + (s.entries - s.loops) / 2 of {
                            true -> ok_result(edge_count);
                            false -> fail_result(:edge_count_mismatch)
                        };
                        _: atom -> fail_result(s.error)
                    }
                };
                _: atom -> fail_result(w)
            }
        }
    }
}

fn validate_error_code(error: atom) -> int64 {
    case error of {
        :ok -> 0;
        :cycle -> 1;
        :wrong_arena -> 2;
        :repeated_child -> 3;
        :invalid_comparator_result -> 4;
        :negative_count -> 5;
        :size_mismatch -> 6;
        :order_violation -> 7;
        :balance_violation -> 8;
        :edge_count_mismatch -> 9;
        :missing_endpoint -> 10;
        :undirected_asymmetry -> 11;
        :target_mismatch -> 12;
        :wbt_violation -> 13;
        _: atom -> 99
    }
}
