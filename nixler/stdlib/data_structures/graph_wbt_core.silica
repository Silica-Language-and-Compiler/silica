}

fn fold_entries_go(node: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), acc: AccType, step: fn(AccType, KeyType, ValueType) -> AccType) -> AccType {
    case node of {
        :none -> acc;
        node_ref: ref(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                n: (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(node_ref);
                (k, inner: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), _: int64, left: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), right: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec)))) <- n;
                a1: AccType <- fold_entries_go(left, acc, step);
                a2: AccType <- fold_row_go(k, inner, a1, step)
            produces
                pure fold_entries_go(right, a2, step)
            end
        }
    }
}

// Visits every stored entry (from, value) once: ascending from, then ascending target.
fn fold_entries(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, init: AccType, step: fn(AccType, KeyType, ValueType) -> AccType) -> AccType {
    fold_entries_go(adj.root, init, step)
}

fn fold_wrow_go(from: KeyType, node: ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), acc: AccType, step: fn(AccType, KeyType, { to: KeyType, data: ValueType }) -> AccType) -> AccType {
