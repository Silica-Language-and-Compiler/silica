// Layer 2 §15 steps 5–6 — skew binary random-access list: forest lookup and persistent update.
// Authority: skew_binary_random_access_list.md §6, §7. The forest walk subtracts whole-tree
// Node shape, spelled in every ref? to a node so rec binds to it: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)).
// A forest digit is (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))).
// weights until the target lies in one tree; update rebuilds only the digits ahead of that tree.
// Every exported function whose signature mentions ItemType takes the collection record first:
// the compiler resolves ItemType at a qualified call site from the record's compare_item witness
// (type_checker_collections@assoc_type_from_record_witness). The core never calls compare_item.

use skew_ral_tree_read;
use skew_ral_tree_write;

export forest_lookup/4;
export forest_update/4;

fn push_digit(
    w: int64,
    t: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]
) -> List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] {
    sequence proc[mem(normal)]
        d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- (w, t);
        out: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] <- prepend[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)](d, rest)
    produces
        pure out
    end
}

fn push_existing(
    d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))),
    rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]
) -> List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] {
    sequence proc[mem(normal)]
        out: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] <- prepend[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)](d, rest)
    produces
        pure out
    end
}

fn lookup_digit(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))),
    rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    i: int64,
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    (w: int64, t: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- d;
    case i < w of {
        true -> skew_ral_tree_read@tree_lookup(ral, t, w, i, placeholder);
        false -> forest_lookup(ral, rest, i - w, placeholder)
    }
}

// Negative or past-the-end indexes answer :not_found; nothing traps and nothing allocates.
fn forest_lookup(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    i: int64,
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    case i < 0 of {
        true -> { status: :not_found, value: placeholder };
        false -> case forest of {
            []: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] -> { status: :not_found, value: placeholder };
            [d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]] -> lookup_digit(ral, d, rest, i, placeholder)
        }
    }
}

fn update_here_result(
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    w: int64,
    new_tree: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], updated: boolean } {
    case new_tree of {
        :none -> { forest: forest, updated: false };
        _: ref(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))) -> { forest: push_digit(w, new_tree, rest), updated: true }
    }
}

fn update_here(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    w: int64,
    t: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec))),
    i: int64,
    item: ItemType
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], updated: boolean } {
    update_here_result(forest, rest, w, skew_ral_tree_write@tree_update(ral, t, w, i, item))
}

fn update_deeper(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))),
    rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    i_rest: int64,
    item: ItemType
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], updated: boolean } {
    inner: { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], updated: boolean } <- forest_update(ral, rest, i_rest, item);
    case inner.updated of {
        false -> { forest: forest, updated: false };
        true -> { forest: push_existing(d, inner.forest), updated: true }
    }
}

fn update_digit(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))),
    rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    i: int64,
    item: ItemType
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], updated: boolean } {
    (w: int64, t: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- d;
    case i < w of {
        true -> update_here(ral, forest, rest, w, t, i, item);
        false -> update_deeper(ral, forest, d, rest, i - w, item)
    }
}

// An invalid index returns the original forest with updated = false (design §7).
fn forest_update(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    i: int64,
    item: ItemType
) -> { forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)], updated: boolean } {
    case i < 0 of {
        true -> { forest: forest, updated: false };
        false -> case forest of {
            []: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] -> { forest: forest, updated: false };
            [d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]] -> update_digit(ral, forest, d, rest, i, item)
        }
    }
}
