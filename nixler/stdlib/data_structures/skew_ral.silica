// Layer 2 §15 — skew binary random-access list: core surface (facade).
// Authority: design_documents/Phase1_TODOs/data_structure_designs/skew_binary_random_access_list.md.
// Node shape, spelled in every ref? to a node so rec binds to it: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)).
// A forest digit is (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))).
//
// Module map (thin dispatchers, tutorials_and_howtos/thin_dispatchers_for_compile_ram.md):
//   skew_ral (facade) ── uses ──> skew_ral_dispatch_access ──> skew_ral_forest, skew_ral_index
//                     └─ uses ──> skew_ral_dispatch_bulk   ──> skew_ral_build, skew_ral_traverse,
//                                                             skew_ral_validate, skew_ral_weights
//   leaves: skew_ral_weights (int64 only), skew_ral_node (cells), skew_ral_tree_read,
//           skew_ral_tree_write, skew_ral_forest, skew_ral_index, skew_ral_traverse,
//           skew_ral_build, skew_ral_validate. The facade never uses a leaf directly.
//
// Representation (inline at every boundary; ItemType appears only inside cells):
//   { count, reversed: boolean, compare_item, forest: List[(weight, tree)], region, specialization_key }
// compare_item is the constructor function record's comparator (the Tree family passes its own,
// tree_trait.md §2; dense graphs pass a cell comparator). The core never calls it: it is the
// ItemType witness the compiler resolves at every qualified call (see skew_ral_node header).
// Physical index 0 is the front. reversed = false reads logical i at physical i; reversed = true
// reads logical i at physical count - 1 - i (design §8), which makes `append` O(1) and keeps every
// earlier logical index stable. Orientation is a boolean rather than :front | :reverse because atom
// values are numbered per compilation unit (see skew_ral_dispatch_bulk header). prepend/head/tail/lookup/update are physical;
// get/set/append/from_list/fold_logical/fold_range are logical.
//
// Arena: canonical_arena_lookup(arena_key()) — one application-lifetime arena for every value of
// this representation until the consumer families (Tree, dense graphs) register specializations.

use skew_ral_dispatch_access;
use skew_ral_dispatch_bulk;

export arena_key/0;
export empty_ral/2;
export size/1;
export is_reversed/1;
export prepend/2;
export head/2;
export tail/1;
export lookup/3;
export update/3;
export logical_to_physical/2;
export get/3;
export set/3;
export append/2;
export from_list/3;
export filled/4;
export fold_logical/3;
export fold_physical/3;
export range_valid/3;
export fold_range/5;
export validate/1;
export validate_error_code/1;

fn arena_key() -> int64 {
    81
}

// Named empty_ral because an unqualified `empty(...)` call resolves to the list builtin (E2020).
fn empty_ral(
    functions: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater },
    reversed: boolean
) -> {
    count: int64,
    reversed: boolean,
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    region: region(L, normal),
    specialization_key: int64
} {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        arena: region(L, normal) <- canonical_arena_lookup(81);
        forest0: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] <-
            empty[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]();
        out: {
            count: int64,
            reversed: boolean,
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
            region: region(L, normal),
            specialization_key: int64
        } <- {
            count: 0,
            reversed: reversed,
            compare_item: functions.compare_item,
            forest: forest0,
            region: arena,
            specialization_key: 0
        }
    produces
        pure out
    end
}

fn size(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    }
) -> int64 {
    ral.count
}

fn is_reversed(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    }
) -> boolean {
    ral.reversed
}

// Deterministic collection error: count or weight overflow can publish no partial value.
fn prepend_overflow_halt(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    }
) -> {
    count: int64,
    reversed: boolean,
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    region: region(L, normal),
    specialization_key: int64
} {
    sequence
        _: int64 <- 1 / 0
    produces
        pure ral
    end
}

// Internal name: an unqualified local `prepend(...)` call resolves to the list primitive.
fn prepend_ral(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    item: ItemType
) -> {
    count: int64,
    reversed: boolean,
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    region: region(L, normal),
    specialization_key: int64
} {
    grown: {
        list: {
            count: int64,
            reversed: boolean,
            compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
            forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
            region: region(L, normal),
            specialization_key: int64
        },
        status: :ok | :overflow
    } <- skew_ral_dispatch_access@push_front(ral, item);
    case grown.status of {
        :ok -> grown.list;
        :overflow -> prepend_overflow_halt(ral)
    }
}

// O(1) worst case: at most one link. Physical index 0 becomes `item`.
fn prepend(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    item: ItemType
) -> {
    count: int64,
    reversed: boolean,
    compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    region: region(L, normal),
    specialization_key: int64
} {
    prepend_ral(ral, item)
}

fn head(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    skew_ral_dispatch_access@peek_front(ral, placeholder)
}

// Empty tail returns the same value with :not_found; it never traps.
fn tail(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    }
) -> {
    list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    status: :not_found | :found
} {
    skew_ral_dispatch_access@pop_front(ral)
}

fn lookup(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    i: int64,
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    skew_ral_dispatch_access@lookup_physical(ral, i, placeholder)
}

fn update(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    i: int64,
    item: ItemType
) -> {
    list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    updated: boolean
} {
    skew_ral_dispatch_access@update_physical(ral, i, item)
}

// Out-of-range logical indexes map to an out-of-range physical index (never overflowing).
fn logical_to_physical(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    i: int64
) -> int64 {
    case i < 0 of {
        true -> -1;
        false -> case i >= ral.count of {
            true -> ral.count;
            false -> case ral.reversed of {
                false -> i;
                true -> ral.count - 1 - i
            }
        }
    }
}

fn get(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    i: int64,
    placeholder: ItemType
) -> { status: :not_found | :found, value: ItemType } {
    skew_ral_dispatch_access@lookup_physical(ral, logical_to_physical(ral, i), placeholder)
}

fn set(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    i: int64,
    item: ItemType
) -> {
    list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    updated: boolean
} {
    skew_ral_dispatch_access@update_physical(ral, logical_to_physical(ral, i), item)
}

// Design §8: only the reverse orientation appends in O(1); the new item takes logical index
// `count` and every existing logical index keeps its value. Orientation :front declines.
fn append(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    item: ItemType
) -> {
    list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    appended: boolean
} {
    case ral.reversed of {
        true -> { list: prepend_ral(ral, item), appended: true };
        false -> { list: ral, appended: false }
    }
}

// Items are in logical order under either orientation; O(n) total.
fn from_list(
    functions: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater },
    reversed: boolean,
    items: List[ItemType, mem(normal)]
) -> {
    list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    valid: boolean,
    error: atom
} {
    skew_ral_dispatch_bulk@build_from_items(empty_ral(functions, reversed), items)
}

fn filled(
    functions: { compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater },
    reversed: boolean,
    n: int64,
    value: ItemType
) -> {
    list: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    valid: boolean,
    error: atom
} {
    skew_ral_dispatch_bulk@build_filled_count(empty_ral(functions, reversed), n, value)
}

fn fold_logical(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    init: AccType,
    step: fn(AccType, ItemType) -> AccType
) -> AccType {
    skew_ral_dispatch_bulk@fold_logical(ral, init, step)
}

fn fold_physical(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    init: AccType,
    step: fn(AccType, ItemType) -> AccType
) -> AccType {
    skew_ral_dispatch_bulk@fold_physical(ral, init, step)
}

fn range_valid(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    start: int64,
    count: int64
) -> boolean {
    skew_ral_dispatch_bulk@range_valid(ral, start, count)
}

// Visits logical indexes [start, start + count) in O(log n + count); an invalid range returns init.
fn fold_range(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    init: AccType,
    step: fn(AccType, ItemType) -> AccType,
    start: int64,
    count: int64
) -> AccType {
    skew_ral_dispatch_bulk@fold_range(ral, init, step, start, count)
}

fn validate(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    }
) -> { valid: boolean, error: atom, logical_count: int64 } {
    skew_ral_dispatch_bulk@validate(ral)
}

fn validate_error_code(error: atom) -> int64 {
    skew_ral_dispatch_bulk@validate_error_code(error)
}
