// Layer 6 — graph_csr_core: the compressed-sparse-row snapshot engine shared by the CSR graph
// families (graph_csr_directed, graph_csr_undirected, graph_csr_weighted,
// graph_csr_weighted_undirected). Authority: design_documents/Phase1_TODOs/data_structure_designs/
// csr_graph_snapshot.md; standard_data_structures_baseline/csr_dense_representation_contract.md
// (CSR-D1..D4, D7); common_contract.md.
//
// Snapshot record (compiler-version-private layout, CSR-D1; the families wrap it):
//   { node_ids: buf(V) of NodeId, offsets: buf(V + 1) of int64, targets: buf(A) of NodeId,
//     values: buf(A) of EdgeValue, slot_root (WBT map NodeId -> int64 slot), compare_key
//     (compare_node), compare_value (edge value comparator), region, specialization_key,
//     node_count (V), entry_count (A) }
// Public NodeId values and int64 slots are distinct domains (CSR-D2): every public operation resolves
// an ID through the node_to_slot WBT map (slot_root, built with wbt_map@from_sorted) before it touches
// a buffer; a public ID is never an index. V, V + 1 and A are runtime extents bound during freeze
// (CSR-D3), not type parameters. targets and values are parallel: position p is one adjacency
// entry (CSR-D4).
//
// freeze (design §4) reads a live graph through graph_wbt_core in O(V + A): the ascending vertex
// list gives slots and node_ids, the per-vertex entry counts give the checked prefix sums in offsets,
// and the ascending entry list fills targets and values in row order. No comparison sort. The
// snapshot is published only after the written counts equal V and A; the live graph is never
// modified. Every read is an O(1) buffer access; a row is [offsets[s], offsets[s + 1]) with
// strictly ascending targets, so has_edge is a binary search, O(log V + log d).
//
// Every comparison validates the comparator atom (common_contract.md §4). compare_raw stays the first
// function in this unit. Validation error atoms are created and decoded here (validate_error_code).
// Buffer extents in parameter types are spelled nv / nv1 / na at every boundary: the checker
// compares a buffer's extent name as written.
// Q19 node shapes (spelled at every use): slot_root is a wbt_map node (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec)); freeze reads graph_wbt_core's outer node (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec)).

use wbt_map;
use wbt_set;
use graph_wbt_core;

export arena_key/0;
export freeze/3;
export slot_of/2;
export has_vertex/2;
export node_at/2;
export has_entry/3;
export entry_value/3;
export lookup/4;
export degree/2;
export self_loop_count/2;
export values/2;
export wrappers/2;
export vertices/1;
export fold_values/4;
export fold_wrappers/4;
export fold_vertices/3;
export fold_entries/3;
export fold_entries_wrapped/3;
export fold_entries_canonical/3;
export entry_list/1;
export reachable/3;
export validate_directed/3;
export validate_keyed/2;
export validate_undirected/3;
export asymmetry_error/0;
export validate_error_code/1;

fn compare_raw(
    compare: fn(KeyType, KeyType) -> atom,
    a: KeyType,
    b: KeyType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

fn compare_value_raw(
    compare: fn(ValueType, ValueType) -> atom,
    a: ValueType,
    b: ValueType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

fn invalid_halt(_: atom) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0
    produces
        pure :equal
    end
}

// Deterministic collection error: freeze found inconsistent counts or an overflow; no snapshot is
// published (design §9).
fn freeze_halt(n: int64) -> int64 {
    sequence
        _: int64 <- 1 / 0
    produces
        pure n
    end
}

fn value_halt(n: int64) -> ValueType {
    sequence
        _: int64 <- 1 / 0
    produces
        pure value_halt(n + 1)
    end
}

fn b2i(b: boolean) -> int64 {
    case b of {
        true -> 1;
        false -> 0
    }
}

// Slot order (int64); slots are never compared with public IDs.
fn cmp_slot(a: int64, b: int64) -> :less | :equal | :greater {
    case a < b of {
        true -> :less;
        false -> case a == b of {
            true -> :equal;
            false -> :greater
        }
    }
}

fn arena_key() -> int64 {
    91
}

fn compare_nodes(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, a: KeyType, b: KeyType) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_raw(cs.compare_key, a, b)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> invalid_halt(bad)
        }
    end
}

fn compare_values(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, a: ValueType, b: ValueType) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_value_raw(cs.compare_value, a, b)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> invalid_halt(bad)
        }
    end
}

fn nodes_equal(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, a: KeyType, b: KeyType) -> boolean {
    c: :less | :equal | :greater <- compare_nodes(cs, a, b);
    case c of {
        :equal -> true;
        _: atom -> false
    }
}

// ---------------------------------------------------------------------------------------------
// Buffer reads (O(1)) and the node -> slot index (O(log V)).
// ---------------------------------------------------------------------------------------------

fn off(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, i: int64) -> int64 {
    sequence proc[mem(normal)]
        v: int64 <- read_buf(cs.offsets, i)
    produces
        pure v
    end
}

fn node_at(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64) -> KeyType {
    sequence proc[mem(normal)]
        v: KeyType <- read_buf(cs.node_ids, s)
    produces
        pure v
    end
}

fn target_at(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, p: int64) -> KeyType {
    sequence proc[mem(normal)]
        v: KeyType <- read_buf(cs.targets, p)
    produces
        pure v
    end
}

fn value_at(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, p: int64) -> ValueType {
    sequence proc[mem(normal)]
        v: ValueType <- read_buf(cs.values, p)
    produces
        pure v
    end
}

fn slot_map(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }) -> { root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } {
    out: { root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- {
        root: cs.slot_root,
        compare_key: cs.compare_key,
        compare_value: cmp_slot,
        region: cs.region,
        specialization_key: cs.specialization_key,
        compare_key_ordering_bundle: 0,
        compare_value_ordering_bundle: 0
    };
    out
}

// The dense slot of a public vertex ID, or -1 when the ID is not a vertex.
fn slot_of(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, id: KeyType) -> int64 {
    m: { root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- slot_map(cs);
    got: { status: :not_found | :found, value: int64 } <- wbt_map@get(m, id, -1);
    got.value
}

fn has_vertex(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, id: KeyType) -> boolean {
    slot_of(cs, id) >= 0
}

// ---------------------------------------------------------------------------------------------
// Rows (design §5–§6): row(s) = [offsets[s], offsets[s + 1]), targets strictly ascending.
// ---------------------------------------------------------------------------------------------

fn row_find(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, lo: int64, hi: int64, to: KeyType) -> int64 {
    case lo >= hi of {
        true -> -1;
        false -> {
            mid: int64 <- lo + (hi - lo) / 2;
            k: KeyType <- target_at(cs, mid);
            c: :less | :equal | :greater <- compare_nodes(cs, to, k);
            case c of {
                :less -> row_find(cs, lo, mid, to);
                :equal -> mid;
                :greater -> row_find(cs, mid + 1, hi, to)
            }
        }
    }
}

// Position of the entry (from, to), or -1.
fn find_entry(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, from: KeyType, to: KeyType) -> int64 {
    s: int64 <- slot_of(cs, from);
    case s < 0 of {
        true -> -1;
        false -> {
            lo: int64 <- off(cs, s);
            hi: int64 <- off(cs, s + 1);
            row_find(cs, lo, hi, to)
        }
    }
}

fn has_entry(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, from: KeyType, to: KeyType) -> boolean {
    find_entry(cs, from, to) >= 0
}

// The value of an existing entry; an absent entry is a deterministic collection error.
fn entry_value(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, from: KeyType, to: KeyType) -> ValueType {
    p: int64 <- find_entry(cs, from, to);
    case p < 0 of {
        true -> value_halt(0);
        false -> value_at(cs, p)
    }
}

fn lookup(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, from: KeyType, to: KeyType, placeholder: ValueType) -> { status: :not_found | :found, value: ValueType } {
    p: int64 <- find_entry(cs, from, to);
    case p < 0 of {
        true -> { status: :not_found, value: placeholder };
        false -> {
            v: ValueType <- value_at(cs, p);
            { status: :found, value: v }
        }
    }
}

// Row length: stored adjacency entries at id; zero when id is absent or isolated.
fn degree(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, id: KeyType) -> int64 {
    s: int64 <- slot_of(cs, id);
    case s < 0 of {
        true -> 0;
        false -> off(cs, s + 1) - off(cs, s)
    }
}

fn self_loop_count(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, id: KeyType) -> int64 {
    b2i(has_entry(cs, id, id))
}

// ---------------------------------------------------------------------------------------------
// Materialization (common_contract.md §11) in stored (ascending target / slot) order, and folds that
// stream the contiguous row without allocation. Lists are built from the row's end backwards.
// ---------------------------------------------------------------------------------------------

fn values_go(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, lo: int64, p: int64, acc: List[ValueType, mem(normal)]) -> List[ValueType, mem(normal)] {
    case p < lo of {
        true -> acc;
        false -> {
            sequence proc[mem(normal)]
                v: ValueType <- read_buf(cs.values, p);
                next: List[ValueType, mem(normal)] <- prepend[ValueType, mem(normal)](v, acc)
            produces
                pure values_go(cs, lo, p - 1, next)
            end
        }
    }
}

fn wrappers_go(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, lo: int64, p: int64, acc: List[{ to: KeyType, data: ValueType }, mem(normal)]) -> List[{ to: KeyType, data: ValueType }, mem(normal)] {
    case p < lo of {
        true -> acc;
        false -> {
            sequence proc[mem(normal)]
                k: KeyType <- read_buf(cs.targets, p);
                v: ValueType <- read_buf(cs.values, p);
                w: { to: KeyType, data: ValueType } <- { to: k, data: v };
                next: List[{ to: KeyType, data: ValueType }, mem(normal)] <- prepend[{ to: KeyType, data: ValueType }, mem(normal)](w, acc)
            produces
                pure wrappers_go(cs, lo, p - 1, next)
            end
        }
    }
}

fn keys_go(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, p: int64, acc: List[KeyType, mem(normal)]) -> List[KeyType, mem(normal)] {
    case p < 0 of {
        true -> acc;
        false -> {
            sequence proc[mem(normal)]
                k: KeyType <- read_buf(cs.node_ids, p);
                next: List[KeyType, mem(normal)] <- prepend[KeyType, mem(normal)](k, acc)
            produces
                pure keys_go(cs, p - 1, next)
            end
        }
    }
}

fn empty_values() -> List[ValueType, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[ValueType, mem(normal)] <- empty[ValueType, mem(normal)]()
    produces
        pure e
    end
}

fn empty_wrappers() -> List[{ to: KeyType, data: ValueType }, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[{ to: KeyType, data: ValueType }, mem(normal)] <- empty[{ to: KeyType, data: ValueType }, mem(normal)]()
    produces
        pure e
    end
}

fn empty_keys() -> List[KeyType, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[KeyType, mem(normal)] <- empty[KeyType, mem(normal)]()
    produces
        pure e
    end
}

fn values(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, id: KeyType) -> List[ValueType, mem(normal)] {
    s: int64 <- slot_of(cs, id);
    e: List[ValueType, mem(normal)] <- empty_values();
    case s < 0 of {
        true -> e;
        false -> {
            lo: int64 <- off(cs, s);
            hi: int64 <- off(cs, s + 1);
            values_go(cs, lo, hi - 1, e)
        }
    }
}

fn wrappers(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, id: KeyType) -> List[{ to: KeyType, data: ValueType }, mem(normal)] {
    s: int64 <- slot_of(cs, id);
    e: List[{ to: KeyType, data: ValueType }, mem(normal)] <- empty_wrappers();
    case s < 0 of {
        true -> e;
        false -> {
            lo: int64 <- off(cs, s);
            hi: int64 <- off(cs, s + 1);
            wrappers_go(cs, lo, hi - 1, e)
        }
    }
}

fn vertices(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }) -> List[KeyType, mem(normal)] {
    e: List[KeyType, mem(normal)] <- empty_keys();
    keys_go(cs, cs.node_count - 1, e)
}

fn fold_values_go(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, p: int64, hi: int64, acc: AccType, step: fn(AccType, ValueType) -> AccType) -> AccType {
    case p >= hi of {
        true -> acc;
        false -> {
            v: ValueType <- value_at(cs, p);
            fold_values_go(cs, p + 1, hi, step(acc, v), step)
        }
    }
}

fn fold_wrappers_go(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, p: int64, hi: int64, acc: AccType, step: fn(AccType, { to: KeyType, data: ValueType }) -> AccType) -> AccType {
    case p >= hi of {
        true -> acc;
        false -> {
            k: KeyType <- target_at(cs, p);
            v: ValueType <- value_at(cs, p);
            w: { to: KeyType, data: ValueType } <- { to: k, data: v };
            fold_wrappers_go(cs, p + 1, hi, step(acc, w), step)
        }
    }
}

fn fold_values(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, init: AccType, step: fn(AccType, ValueType) -> AccType, id: KeyType) -> AccType {
    s: int64 <- slot_of(cs, id);
    case s < 0 of {
        true -> init;
        false -> {
            lo: int64 <- off(cs, s);
            hi: int64 <- off(cs, s + 1);
            fold_values_go(cs, lo, hi, init, step)
        }
    }
}

fn fold_wrappers(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, init: AccType, step: fn(AccType, { to: KeyType, data: ValueType }) -> AccType, id: KeyType) -> AccType {
    s: int64 <- slot_of(cs, id);
    case s < 0 of {
        true -> init;
        false -> {
            lo: int64 <- off(cs, s);
            hi: int64 <- off(cs, s + 1);
            fold_wrappers_go(cs, lo, hi, init, step)
        }
    }
}

fn fold_vertices_go(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64, acc: AccType, step: fn(AccType, KeyType) -> AccType) -> AccType {
    case s >= cs.node_count of {
        true -> acc;
        false -> {
            k: KeyType <- node_at(cs, s);
            fold_vertices_go(cs, s + 1, step(acc, k), step)
        }
    }
}

// Visits every vertex once in ascending node (slot) order.
fn fold_vertices(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, init: AccType, step: fn(AccType, KeyType) -> AccType) -> AccType {
    fold_vertices_go(cs, 0, init, step)
}

fn fold_row_go(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, from: KeyType, p: int64, hi: int64, acc: AccType, step: fn(AccType, KeyType, ValueType) -> AccType) -> AccType {
    case p >= hi of {
        true -> acc;
        false -> {
            v: ValueType <- value_at(cs, p);
            fold_row_go(cs, from, p + 1, hi, step(acc, from, v), step)
        }
    }
}

fn fold_entries_go(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64, acc: AccType, step: fn(AccType, KeyType, ValueType) -> AccType) -> AccType {
    case s >= cs.node_count of {
        true -> acc;
        false -> {
            from: KeyType <- node_at(cs, s);
            lo: int64 <- off(cs, s);
            hi: int64 <- off(cs, s + 1);
            a1: AccType <- fold_row_go(cs, from, lo, hi, acc, step);
            fold_entries_go(cs, s + 1, a1, step)
        }
    }
}

// Every stored entry (from, value) once: ascending from, then ascending target. O(V + A).
fn fold_entries(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, init: AccType, step: fn(AccType, KeyType, ValueType) -> AccType) -> AccType {
    fold_entries_go(cs, 0, init, step)
}

fn fold_wrow_go(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, from: KeyType, p: int64, hi: int64, acc: AccType, step: fn(AccType, KeyType, { to: KeyType, data: ValueType }) -> AccType) -> AccType {
    case p >= hi of {
        true -> acc;
        false -> {
            k: KeyType <- target_at(cs, p);
            v: ValueType <- value_at(cs, p);
            w: { to: KeyType, data: ValueType } <- { to: k, data: v };
            fold_wrow_go(cs, from, p + 1, hi, step(acc, from, w), step)
        }
    }
}

fn fold_wentries_go(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64, acc: AccType, step: fn(AccType, KeyType, { to: KeyType, data: ValueType }) -> AccType) -> AccType {
    case s >= cs.node_count of {
        true -> acc;
        false -> {
            from: KeyType <- node_at(cs, s);
            lo: int64 <- off(cs, s);
            hi: int64 <- off(cs, s + 1);
            a1: AccType <- fold_wrow_go(cs, from, lo, hi, acc, step);
            fold_wentries_go(cs, s + 1, a1, step)
        }
    }
}

// Every stored entry as (from, {to, data}): ascending from, then ascending target.
fn fold_entries_wrapped(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, init: AccType, step: fn(AccType, KeyType, { to: KeyType, data: ValueType }) -> AccType) -> AccType {
    fold_wentries_go(cs, 0, init, step)
}

fn fold_crow_go(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, from: KeyType, p: int64, hi: int64, acc: AccType, step: fn(AccType, KeyType, KeyType, ValueType) -> AccType) -> AccType {
    case p >= hi of {
        true -> acc;
        false -> {
            k: KeyType <- target_at(cs, p);
            v: ValueType <- value_at(cs, p);
            c: :less | :equal | :greater <- compare_nodes(cs, from, k);
            a1: AccType <- case c of {
                :greater -> acc;
                _: atom -> step(acc, from, k, v)
            };
            fold_crow_go(cs, from, p + 1, hi, a1, step)
        }
    }
}

fn fold_centries_go(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64, acc: AccType, step: fn(AccType, KeyType, KeyType, ValueType) -> AccType) -> AccType {
    case s >= cs.node_count of {
        true -> acc;
        false -> {
            from: KeyType <- node_at(cs, s);
            lo: int64 <- off(cs, s);
            hi: int64 <- off(cs, s + 1);
            a1: AccType <- fold_crow_go(cs, from, lo, hi, acc, step);
            fold_centries_go(cs, s + 1, a1, step)
        }
    }
}

// Undirected logical-edge fold: a self-loop once, a non-loop edge from its lesser endpoint.
fn fold_entries_canonical(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, init: AccType, step: fn(AccType, KeyType, KeyType, ValueType) -> AccType) -> AccType {
    fold_centries_go(cs, 0, init, step)
}

fn entry_row_go(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, from: KeyType, lo: int64, p: int64, acc: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)]) -> List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] {
    case p < lo of {
        true -> acc;
        false -> {
            sequence proc[mem(normal)]
                k: KeyType <- read_buf(cs.targets, p);
                v: ValueType <- read_buf(cs.values, p);
                e: { from: KeyType, to: KeyType, data: ValueType } <- { from: from, to: k, data: v };
                next: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] <- prepend[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)](e, acc)
            produces
                pure entry_row_go(cs, from, lo, p - 1, next)
            end
        }
    }
}

fn entry_list_go(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64, acc: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)]) -> List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] {
    case s < 0 of {
        true -> acc;
        false -> {
            from: KeyType <- node_at(cs, s);
            lo: int64 <- off(cs, s);
            hi: int64 <- off(cs, s + 1);
            next: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] <- entry_row_go(cs, from, lo, hi - 1, acc);
            entry_list_go(cs, s - 1, next)
        }
    }
}

// Every stored entry as {from, to, data} in row order.
fn entry_list(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }) -> List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)] <- empty[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)]()
    produces
        pure entry_list_go(cs, cs.node_count - 1, e)
    end
}

// ---------------------------------------------------------------------------------------------
// Reachability over slots: depth-first with a wbt_set visited set of slots; terminates on cycles.
// ---------------------------------------------------------------------------------------------

fn prepend_slot(s: int64, rest: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[int64, mem(normal)] <- prepend[int64, mem(normal)](s, rest)
    produces
        pure out
    end
}

fn push_row(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, p: int64, hi: int64, stack: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    case p >= hi of {
        true -> stack;
        false -> {
            k: KeyType <- target_at(cs, p);
            s: int64 <- slot_of(cs, k);
            next: List[int64, mem(normal)] <- prepend_slot(s, stack);
            push_row(cs, p + 1, hi, next)
        }
    }
}

fn search_go(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, visited: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, stack: List[int64, mem(normal)], goal: int64) -> boolean {
    case stack.is_nil of {
        true -> false;
        false -> {
            s: int64 <- stack.head;
            seen: boolean <- wbt_set@contains(visited, s);
            case seen of {
                true -> search_go(cs, visited, stack.tail, goal);
                false -> case s == goal of {
                    true -> true;
                    false -> {
                        ins: { set: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 }, inserted: boolean } <- wbt_set@insert(visited, s);
                        lo: int64 <- off(cs, s);
                        hi: int64 <- off(cs, s + 1);
                        more: List[int64, mem(normal)] <- push_row(cs, lo, hi, stack.tail);
                        search_go(cs, ins.set, more, goal)
                    }
                }
            }
        }
    }
}

fn empty_slots() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[int64, mem(normal)] <- empty[int64, mem(normal)]()
    produces
        pure e
    end
}

// Reports whether to is reachable from from along stored entries; absent endpoints are unreachable
// and an existing vertex reaches itself.
fn reachable(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, from: KeyType, to: KeyType) -> boolean {
    a: int64 <- slot_of(cs, from);
    b: int64 <- slot_of(cs, to);
    case a < 0 or b < 0 of {
        true -> false;
        false -> case a == b of {
            true -> true;
            false -> {
                visited: { root: ref?(L, normal, (int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_item: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_item_ordering_bundle: int64 } <- wbt_set@empty({ compare_item: cmp_slot });
                e: List[int64, mem(normal)] <- empty_slots();
                stack: List[int64, mem(normal)] <- prepend_slot(a, e);
                search_go(cs, visited, stack, b)
            }
        }
    }
}

// ---------------------------------------------------------------------------------------------
// Freeze (design §4): O(V + A), no comparison sort; publication only after the counts agree.
// ---------------------------------------------------------------------------------------------

// The fill helpers write only below the buffer's capacity and return how many items they saw, so a
// live record whose cached counts disagree with its storage is caught by consistent() before
// publication instead of writing past a buffer.
fn fill_node_ids(b: buf(L, normal, KeyType, nv), cap: int64, i: int64, xs: List[KeyType, mem(normal)]) -> int64 {
    case xs.is_nil of {
        true -> i;
        false -> case i < cap of {
            false -> fill_node_ids(b, cap, i + 1, xs.tail);
            true -> {
                sequence proc[mem(normal)]
                    _: atom <- write_buf(b, i, xs.head)
                produces
                    pure fill_node_ids(b, cap, i + 1, xs.tail)
                end
            }
        }
    }
}

// offsets[i] = sum of the first i row sizes (checked, design §4 step 3); returns the final offset,
// or -1 when there are more rows than the buffer holds.
fn fill_offsets(b: buf(L, normal, int64, nv1), cap: int64, i: int64, running: int64, sizes: List[int64, mem(normal)]) -> int64 {
    case i >= cap of {
        true -> -1;
        false -> {
            sequence proc[mem(normal)]
                _: atom <- write_buf(b, i, running)
            produces
                pure case sizes.is_nil of {
                    true -> running;
                    false -> case sizes.head > 9223372036854775807 - running of {
                        true -> freeze_halt(running);
                        false -> fill_offsets(b, cap, i + 1, running + sizes.head, sizes.tail)
                    }
                }
            end
        }
    }
}

fn fill_entries(t: buf(L, normal, KeyType, na), v: buf(L, normal, ValueType, na), cap: int64, i: int64, es: List[{ from: KeyType, to: KeyType, data: ValueType }, mem(normal)]) -> int64 {
    case es.is_nil of {
        true -> i;
        false -> case i < cap of {
            false -> fill_entries(t, v, cap, i + 1, es.tail);
            true -> {
                sequence proc[mem(normal)]
                    e: { from: KeyType, to: KeyType, data: ValueType } <- es.head;
                    _: atom <- write_buf(t, i, e.to);
                    _: atom <- write_buf(v, i, e.data)
                produces
                    pure fill_entries(t, v, cap, i + 1, es.tail)
                end
            }
        }
    }
}

fn slot_pairs(xs: List[KeyType, mem(normal)], i: int64) -> List[(KeyType, int64), mem(normal)] {
    case xs.is_nil of {
        true -> {
            sequence proc[mem(normal)]
                e: List[(KeyType, int64), mem(normal)] <- empty[(KeyType, int64), mem(normal)]()
            produces
                pure e
            end
        };
        false -> {
            sequence proc[mem(normal)]
                rest: List[(KeyType, int64), mem(normal)] <- slot_pairs(xs.tail, i + 1);
                p: (KeyType, int64) <- (xs.head, i);
                out: List[(KeyType, int64), mem(normal)] <- prepend[(KeyType, int64), mem(normal)](p, rest)
            produces
                pure out
            end
        }
    }
}

// node_to_slot, built linearly from the already sorted IDs with wbt_map@from_sorted (design §2).
fn slot_root_of(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, arena: region(L, normal)) -> ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence
        ids: List[KeyType, mem(normal)] <- graph_wbt_core@vertices(adj);
        m0: { root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- {
            root: :none,
            compare_key: adj.compare_key,
            compare_value: cmp_slot,
            region: arena,
            specialization_key: adj.specialization_key,
            compare_key_ordering_bundle: 0,
            compare_value_ordering_bundle: 0
        };
        pairs: List[(KeyType, int64), mem(normal)] <- slot_pairs(ids, 0);
        fs: { map: { root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, valid: boolean, error: atom } <- wbt_map@from_sorted(m0, pairs)
    produces
        pure fs.map.root
    end
}

fn consistent(written: int64, expected: int64) -> int64 {
    case written == expected of {
        true -> 0;
        false -> freeze_halt(written)
    }
}

// V + 1 with the count preconditions checked before any allocation (common_contract.md §9).
fn offsets_extent(node_count: int64, entry_count: int64) -> int64 {
    case node_count < 0 or entry_count < 0 or node_count >= 9223372036854775807 of {
        true -> freeze_halt(node_count);
        false -> node_count + 1
    }
}

// Freezes a live graph's adjacency record (graph_wbt_core's shape) with V vertices and A stored
// adjacency entries into a snapshot in the canonical CSR arena. The live graph is only read.
fn freeze(adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, node_count: int64, entry_count: int64) -> { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 } {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        arena: region(L, normal) <- canonical_arena_lookup(91);
        nv1: int64 <- offsets_extent(node_count, entry_count);
        nv: int64 <- node_count;
        na: int64 <- entry_count;
        node_ids: buf(L, normal, KeyType, nv) <- alloc_buf(arena, nv);
        offsets: buf(L, normal, int64, nv1) <- alloc_buf(arena, nv1);
        targets: buf(L, normal, KeyType, na) <- alloc_buf(arena, na);
        values: buf(L, normal, ValueType, na) <- alloc_buf(arena, na);
        c1: int64 <- consistent(fill_node_ids(node_ids, nv, 0, graph_wbt_core@vertices(adj)), nv);
        c2: int64 <- consistent(fill_offsets(offsets, nv1, 0, 0, graph_wbt_core@degree_list(adj)), na);
        c3: int64 <- consistent(fill_entries(targets, values, na, 0, graph_wbt_core@entry_list(adj)), na)
    produces
        pure {
            node_ids: node_ids,
            offsets: offsets,
            targets: targets,
            values: values,
            slot_root: slot_root_of(adj, arena),
            compare_key: adj.compare_key,
            compare_value: adj.compare_value,
            region: arena,
            specialization_key: adj.specialization_key,
            node_count: nv + c1 + c2 + c3,
            entry_count: na
        }
    end
}

// ---------------------------------------------------------------------------------------------
// Validation (design §10; common_contract.md §12): extents and offsets, node order, the node-to-slot
// bijection, row order and target membership, then the per-family checks and count equations.
// logical_count is the logical edge count on success and 0 on failure. O(V + A log V).
// ---------------------------------------------------------------------------------------------

fn ok_result(n: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    { valid: true, error: :ok, logical_count: n }
}

fn fail_result(e: atom) -> { valid: boolean, error: atom, logical_count: int64 } {
    { valid: false, error: e, logical_count: 0 }
}

fn asymmetry_error() -> atom {
    :undirected_asymmetry
}

fn offsets_ok(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, i: int64) -> boolean {
    case i >= cs.node_count of {
        true -> true;
        false -> case off(cs, i) <= off(cs, i + 1) of {
            false -> false;
            true -> offsets_ok(cs, i + 1)
        }
    }
}

fn check_offsets(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }) -> atom {
    case off(cs, 0) == 0 and off(cs, cs.node_count) == cs.entry_count of {
        false -> :csr_offset_violation;
        true -> case offsets_ok(cs, 0) of {
            true -> :ok;
            false -> :csr_offset_violation
        }
    }
}

fn nodes_ascending(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64) -> boolean {
    case s + 1 >= cs.node_count of {
        true -> true;
        false -> {
            a: KeyType <- node_at(cs, s);
            b: KeyType <- node_at(cs, s + 1);
            c: :less | :equal | :greater <- compare_nodes(cs, a, b);
            case c of {
                :less -> nodes_ascending(cs, s + 1);
                _: atom -> false
            }
        }
    }
}

fn slots_match(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64) -> boolean {
    case s >= cs.node_count of {
        true -> true;
        false -> {
            k: KeyType <- node_at(cs, s);
            case slot_of(cs, k) == s of {
                false -> false;
                true -> slots_match(cs, s + 1)
            }
        }
    }
}

fn check_slots(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }) -> atom {
    m: { root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- slot_map(cs);
    r: { valid: boolean, error: atom, logical_count: int64 } <- wbt_map@validate(m);
    case r.valid and r.logical_count == cs.node_count of {
        false -> :slot_mismatch;
        true -> case slots_match(cs, 0) of {
            true -> :ok;
            false -> :slot_mismatch
        }
    }
}

fn row_ok(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, lo: int64, p: int64, hi: int64) -> atom {
    case p >= hi of {
        true -> :ok;
        false -> {
            k: KeyType <- target_at(cs, p);
            case slot_of(cs, k) < 0 of {
                true -> :missing_endpoint;
                false -> case p > lo of {
                    false -> row_ok(cs, lo, p + 1, hi);
                    true -> {
                        prev: KeyType <- target_at(cs, p - 1);
                        c: :less | :equal | :greater <- compare_nodes(cs, prev, k);
                        case c of {
                            :less -> row_ok(cs, lo, p + 1, hi);
                            _: atom -> :order_violation
                        }
                    }
                }
            }
        }
    }
}

fn rows_ok(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64) -> atom {
    case s >= cs.node_count of {
        true -> :ok;
        false -> {
            lo: int64 <- off(cs, s);
            hi: int64 <- off(cs, s + 1);
            e: atom <- row_ok(cs, lo, lo, hi);
            case e of {
                :ok -> rows_ok(cs, s + 1);
                _: atom -> e
            }
        }
    }
}

// The checks every CSR family shares, in the design's order.
fn check_common(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }) -> atom {
    case cs.node_count < 0 or cs.entry_count < 0 of {
        true -> :negative_count;
        false -> {
            o: atom <- check_offsets(cs);
            case o of {
                :ok -> case nodes_ascending(cs, 0) of {
                    false -> :order_violation;
                    true -> {
                        sl: atom <- check_slots(cs);
                        case sl of {
                            :ok -> rows_ok(cs, 0);
                            _: atom -> sl
                        }
                    }
                };
                _: atom -> o
            }
        }
    }
}

fn apply_target(f: fn(ValueType) -> KeyType, v: ValueType) -> KeyType {
    f(v)
}

fn targets_match(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, target_of: fn(ValueType) -> KeyType, p: int64) -> boolean {
    case p >= cs.entry_count of {
        true -> true;
        false -> {
            v: ValueType <- value_at(cs, p);
            k: KeyType <- target_at(cs, p);
            t: KeyType <- apply_target(target_of, v);
            case nodes_equal(cs, t, k) of {
                false -> false;
                true -> targets_match(cs, target_of, p + 1)
            }
        }
    }
}

// Directed CSR over payloads: the payload buffer's extracted targets equal the neighbor buffer.
fn validate_directed(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, target_of: fn(ValueType) -> KeyType, edge_count: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    e: atom <- check_common(cs);
    case e of {
        :ok -> case targets_match(cs, target_of, 0) of {
            false -> fail_result(:target_mismatch);
            true -> case edge_count == cs.entry_count of {
                true -> ok_result(edge_count);
                false -> fail_result(:edge_count_mismatch)
            }
        };
        _: atom -> fail_result(e)
    }
}

// Keyed (weighted) directed CSR: the shared checks and edge_count = A.
fn validate_keyed(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, edge_count: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    e: atom <- check_common(cs);
    case e of {
        :ok -> case edge_count == cs.entry_count of {
            true -> ok_result(edge_count);
            false -> fail_result(:edge_count_mismatch)
        };
        _: atom -> fail_result(e)
    }
}

fn sym_row(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, from: KeyType, p: int64, hi: int64, loops: int64) -> { error: atom, loops: int64 } {
    case p >= hi of {
        true -> { error: :ok, loops: loops };
        false -> {
            k: KeyType <- target_at(cs, p);
            case nodes_equal(cs, from, k) of {
                true -> sym_row(cs, from, p + 1, hi, loops + 1);
                false -> {
                    q: int64 <- find_entry(cs, k, from);
                    case q < 0 of {
                        true -> { error: :undirected_asymmetry, loops: loops };
                        false -> {
                            v: ValueType <- value_at(cs, p);
                            w: ValueType <- value_at(cs, q);
                            c: :less | :equal | :greater <- compare_values(cs, v, w);
                            case c of {
                                :equal -> sym_row(cs, from, p + 1, hi, loops);
                                _: atom -> { error: :undirected_asymmetry, loops: loops }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn sym_rows(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, s: int64, loops: int64) -> { error: atom, loops: int64 } {
    case s >= cs.node_count of {
        true -> { error: :ok, loops: loops };
        false -> {
            from: KeyType <- node_at(cs, s);
            lo: int64 <- off(cs, s);
            hi: int64 <- off(cs, s + 1);
            r: { error: atom, loops: int64 } <- sym_row(cs, from, lo, hi, loops);
            case r.error of {
                :ok -> sym_rows(cs, s + 1, r.loops);
                _: atom -> r
            }
        }
    }
}

// Undirected CSR: the shared checks, every non-loop entry's reverse entry with comparator-equal
// data, adjacency_entry_count = A = L + 2N and edge_count = L + N (design §7).
fn validate_undirected(cs: { node_ids: buf(L, normal, KeyType, nv), offsets: buf(L, normal, int64, nv1), targets: buf(L, normal, KeyType, na), values: buf(L, normal, ValueType, na), slot_root: ref?(L, normal, (KeyType, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, entry_count: int64 }, edge_count: int64, adjacency_entry_count: int64) -> { valid: boolean, error: atom, logical_count: int64 } {
    e: atom <- check_common(cs);
    case e of {
        :ok -> {
            r: { error: atom, loops: int64 } <- sym_rows(cs, 0, 0);
            case r.error of {
                :ok -> case adjacency_entry_count == cs.entry_count and edge_count == r.loops + (cs.entry_count - r.loops) / 2 of {
                    true -> ok_result(edge_count);
                    false -> fail_result(:edge_count_mismatch)
                };
                _: atom -> fail_result(r.error)
            }
        };
        _: atom -> fail_result(e)
    }
}

fn validate_error_code(error: atom) -> int64 {
    case error of {
        :ok -> 0;
        :negative_count -> 1;
        :csr_offset_violation -> 2;
        :order_violation -> 3;
        :slot_mismatch -> 4;
        :missing_endpoint -> 5;
        :target_mismatch -> 6;
        :edge_count_mismatch -> 7;
        :undirected_asymmetry -> 8;
        _: atom -> 99
    }
}
