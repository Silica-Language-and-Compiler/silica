// Endpoint-key lookup of (from, to): :found carries the extracted weight, :not_found the placeholder.
fn weight_of(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, from: KeyType, to: KeyType, placeholder: ItemType) -> { status: :not_found | :found, weight: ItemType } {
    adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- adj_of(g);
    case graph_wbt_core@has_entry(adj, from, to) of {
        false -> { status: :not_found, weight: placeholder };
        true -> {
            data: ValueType <- graph_wbt_core@entry_value(adj, from, to);
            w: ItemType <- apply_weight(g.edge_weight, data);
            { status: :found, weight: w }
        }
    }
}

// Graph-theoretic degree: stored entries plus one more for a self-loop, so a loop counts twice
// (design §6). Zero for a missing or isolated vertex.
fn degree(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, id: KeyType) -> int64 {
    adj: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- adj_of(g);
    graph_wbt_core@degree(adj, id) + graph_wbt_core@self_loop_count(adj, id)
}

// Cached adjacency-entry count: 2 per non-loop logical edge plus 1 per self-loop.
fn adjacency_entry_count(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }) -> int64 {
