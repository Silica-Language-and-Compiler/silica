// Layer 4 — graph_weighted_undirected: the live WBT weighted undirected graph generated module
// (weighted_graph_trait.md §1–§12 with undirected_graph_trait.md §4–§12 over live_wbt_graph.md).
// The value implements both UndirectedGraph and WeightedGraph.
//
// Record (inline at every boundary):
//   { root, compare_node, compare_edge_data, compare_value, edge_weight, compare_weight,
//     compare_item, region, specialization_key, node_count, edge_count, adjacency_entry_count,
//     compare_node_ordering_token, compare_edge_data_ordering_token, edge_weight_ordering_token,
//     compare_weight_ordering_token }
// One logical edge datum produces two generated directional wrappers {to: v, data} and
// {to: u, data}; replacement updates both atomically; a self-loop has one (design §7).
//
// Deviations forced by the compiler (each mirrors an existing stdlib module):
//   1. Placeholders: KeyType (NodeIdType), ValueType (EdgeDataType), ItemType (WeightType);
//      compare_value / compare_item repeat compare_edge_data / compare_weight as type witnesses.
//   2. The type checker registers only graph_weighted for the WeightedGraph[...] bracket binding,
//      so a weighted undirected graph is bound with the inline record type; mem(normal) only.
//   3. weight_of takes a placeholder weight; folds take the accumulator second.
//   4. add_edge/4 on an existing pair replaces the data in both directions (replaced = true).
//   5. degree, has_edge and connected are module functions and required trait methods.
//   6. An update that finds only one stored direction is a deterministic collection error.
//   7. Validation error atoms are created and decoded in graph_wbt_core (validate_error_code);
//      the weight check reuses graph_wbt_core@asymmetry_error.
//   8. The ordering-identity fields are named *_ordering_token, not *_ordering_bundle. The trait
//      checker selects an implementation by structural fit, and a record carrying every field of
//      the graph_wbt_undirected and graph_weighted records was dispatched to their implementations;
//      with these names no live graph record's fields include another's. (graph_wbt_undirected and
//      graph_weighted keep *_ordering_bundle: their bracket constructor bindings write those names.)
// compare_raw stays the first function in this unit (comparator atom numbering).
// Q19 node shapes (spelled at every use): inner (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec)); outer, the graph root, (KeyType, ref?(L, normal, <inner>), int64, ref?(L, normal, rec), ref?(L, normal, rec)).

use graph_wbt_core;

export empty/1;
export add_vertex/2;
export add_edge/4;
export remove_edge/3;
export has_vertex/2;
export has_edge/3;
export neighbors/2;
export weighted_neighbors/2;
export weight_of/4;
export fold_neighbors/4;
export fold_weighted_neighbors/4;
export fold_vertices/3;
export fold_edges/3;
export vertices/1;
export node_count/1;
export edge_count/1;
export adjacency_entry_count/1;
export degree/2;
export neighbor_entry_count/2;
export connected/3;
export compare_node/3;
export compare_edge_data/3;
export edge_target/2;
export edge_weight/2;
export compare_weight/3;
export validate/1;
export validate_error_code/1;

fn compare_raw(
    compare: fn(KeyType, KeyType) -> atom,
    a: KeyType,
    b: KeyType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

fn compare_value_raw(
    compare: fn(ValueType, ValueType) -> atom,
    a: ValueType,
    b: ValueType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

fn compare_item_raw(
    compare: fn(ItemType, ItemType) -> atom,
    a: ItemType,
    b: ItemType
) -> atom {
    sequence
        result: atom <- comparator_result_validate(compare(a, b))
    produces
        pure result
    end
}

// Deterministic collection error for an invalid comparator atom (common_contract.md §4).
fn invalid_halt(_: atom) -> :less | :equal | :greater {
    sequence
        _: int64 <- 1 / 0
    produces
        pure :equal
    end
}

// Deterministic collection error: count overflow or a malformed graph found by an update; nothing
// is published (common_contract.md §9).
fn update_halt(n: int64) -> int64 {
    sequence
        _: int64 <- 1 / 0
    produces
        pure n
    end
}

fn b2i(b: boolean) -> int64 {
    case b of {
        true -> 1;
        false -> 0
    }
}

// Checked non-negative count addition (delta may be negative).
fn count_add(count: int64, delta: int64) -> int64 {
    case delta > 0 and count > 9223372036854775807 - delta of {
        true -> update_halt(count);
        false -> count + delta
    }
}

fn apply_target(f: fn(ValueType) -> KeyType, v: ValueType) -> KeyType {
    f(v)
}

fn apply_weight(f: fn(ValueType) -> ItemType, v: ValueType) -> ItemType {
    f(v)
}

// Compares two vertex IDs with the captured node comparator.
fn compare_node(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, a: KeyType, b: KeyType) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_raw(g.compare_node, a, b)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> invalid_halt(bad)
        }
    end
}

// Compares two direction-independent edge-data values with the captured comparator.
fn compare_edge_data(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, a: ValueType, b: ValueType) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_value_raw(g.compare_edge_data, a, b)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> invalid_halt(bad)
        }
    end
}

// Compares two extracted weights with the captured weight comparator.
fn compare_weight(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }, a: ItemType, b: ItemType) -> :less | :equal | :greater {
    sequence
        result: atom <- compare_item_raw(g.compare_weight, a, b)
    produces
        pure case result of {
            :less -> :less;
            :equal -> :equal;
            :greater -> :greater;
            bad: atom -> invalid_halt(bad)
        }
    end
}

// The adjacency record graph_wbt_core works on (wbt_map's record shape over node -> value).
fn adj_of(g: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_node: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_edge_data: fn(ValueType, ValueType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, edge_weight: fn(ValueType) -> ItemType, compare_weight: fn(ItemType, ItemType) -> :less | :equal | :greater, compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, node_count: int64, edge_count: int64, adjacency_entry_count: int64, compare_node_ordering_token: int64, compare_edge_data_ordering_token: int64, edge_weight_ordering_token: int64, compare_weight_ordering_token: int64 }) -> { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } {
    out: { root: ref?(L, normal, (KeyType, ref?(L, normal, (KeyType, ValueType, int64, ref?(L, normal, rec), ref?(L, normal, rec))), int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(KeyType, KeyType) -> :less | :equal | :greater, compare_value: fn(ValueType, ValueType) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 } <- {
