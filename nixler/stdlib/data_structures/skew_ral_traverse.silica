// Layer 2 §15 step 8 — skew binary random-access list: forest folds and range traversal.
// Authority: skew_binary_random_access_list.md §10. Forward folds walk digits in physical order;
// Node shape, spelled in every ref? to a node so rec binds to it: (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)).
// A forest digit is (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))).
// reverse folds walk the spine tail-first so orientation :reverse still visits logical order.
// Range folds skip whole digits outside [lo, hi) in O(1) each: total O(log n + k).
// Every exported function whose signature mentions ItemType takes the collection record first:
// the compiler resolves ItemType at a qualified call site from the record's compare_item witness
// (type_checker_collections@assoc_type_from_record_witness). The core never calls compare_item.

use skew_ral_tree_read;

export forest_fold_fwd/4;
export forest_fold_rev/4;
export forest_fold_range_fwd/7;
export forest_fold_range_rev/7;

fn fold_fwd_digit(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    acc: AccType,
    step: fn(AccType, ItemType) -> AccType,
    d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))),
    rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]
) -> AccType {
    (_: int64, t: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- d;
    acc_tree: AccType <- skew_ral_tree_read@tree_fold_fwd(ral, acc, step, t);
    forest_fold_fwd(ral, acc_tree, step, rest)
}

fn forest_fold_fwd(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    acc: AccType,
    step: fn(AccType, ItemType) -> AccType,
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]
) -> AccType {
    case forest of {
        []: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] -> acc;
        [d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]] -> fold_fwd_digit(ral, acc, step, d, rest)
    }
}

fn fold_rev_digit(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    acc: AccType,
    step: fn(AccType, ItemType) -> AccType,
    d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))),
    rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]
) -> AccType {
    (_: int64, t: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- d;
    acc_rest: AccType <- forest_fold_rev(ral, acc, step, rest);
    skew_ral_tree_read@tree_fold_rev(ral, acc_rest, step, t)
}

fn forest_fold_rev(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    acc: AccType,
    step: fn(AccType, ItemType) -> AccType,
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]
) -> AccType {
    case forest of {
        []: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] -> acc;
        [d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]] -> fold_rev_digit(ral, acc, step, d, rest)
    }
}

fn range_fwd_digit(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    acc: AccType,
    step: fn(AccType, ItemType) -> AccType,
    d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))),
    rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    base: int64,
    lo: int64,
    hi: int64
) -> AccType {
    (w: int64, t: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- d;
    case base >= hi of {
        true -> acc;
        false -> {
            acc_tree: AccType <- skew_ral_tree_read@tree_fold_range_fwd(ral, acc, step, t, w, base, lo, hi);
            forest_fold_range_fwd(ral, acc_tree, step, rest, base + w, lo, hi)
        }
    }
}

// base is the physical index of the first item in `forest`; visits lo <= p < hi ascending.
fn forest_fold_range_fwd(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    acc: AccType,
    step: fn(AccType, ItemType) -> AccType,
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    base: int64,
    lo: int64,
    hi: int64
) -> AccType {
    case forest of {
        []: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] -> acc;
        [d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]] -> range_fwd_digit(ral, acc, step, d, rest, base, lo, hi)
    }
}

fn range_rev_digit(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    acc: AccType,
    step: fn(AccType, ItemType) -> AccType,
    d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))),
    rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    base: int64,
    lo: int64,
    hi: int64
) -> AccType {
    (w: int64, t: ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))) <- d;
    case base >= hi of {
        true -> acc;
        false -> {
            acc_rest: AccType <- forest_fold_range_rev(ral, acc, step, rest, base + w, lo, hi);
            skew_ral_tree_read@tree_fold_range_rev(ral, acc_rest, step, t, w, base, lo, hi)
        }
    }
}

// Visits lo <= p < hi in descending physical order (logical order for orientation :reverse).
fn forest_fold_range_rev(
    ral: {
        count: int64,
        reversed: boolean,
        compare_item: fn(ItemType, ItemType) -> :less | :equal | :greater,
        forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
        region: region(L, normal),
        specialization_key: int64
    },
    acc: AccType,
    step: fn(AccType, ItemType) -> AccType,
    forest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)],
    base: int64,
    lo: int64,
    hi: int64
) -> AccType {
    case forest of {
        []: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)] -> acc;
        [d: (int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), rest: List[(int64, ref?(L, normal, (ItemType, ref?(L, normal, rec), ref?(L, normal, rec)))), mem(normal)]] -> range_rev_digit(ral, acc, step, d, rest, base, lo, hi)
    }
}
