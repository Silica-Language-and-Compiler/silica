// --- identity ------------------------------------------------------------------------------------

fn board_name() -> string {
    "BYU-I eBadge v4.0 (FEB26)"
}

fn board_sheet() -> string {
    "board/PORT_TEST_BOARD_byu_idaho_v4.0_feb26.md"
}

fn chip_name() -> string {
    "ESP32-S3"
}

fn chip_module_name() -> string {
    "ESP32-S3-MINI-1-N4R2"
}

fn emit_target() -> string {
    "ESP32-S3_raw"
}

// Two Xtensa LX7 cores; both run actors (rt_start.S starts the APP cpu).
fn core_count() -> int64 {
    2
}

fn cpu_hz_rated() -> int64 {
    240000000
}

// The ROM hands off without starting the PLL. Measured 40 MHz (the crystal) on 2026-09-29: 40.00 M
// CCOUNT cycles per ets_delay_us(1 s), on both test units, loaded into RAM by run_on_board.py. The
// 2026-09-12 measurement was ~20 MHz (10.03 M cycles in 0.503 s); which of the two a program gets is
// not under its control, so bit-banged timing must measure the clock first (asm_11 does).
fn cpu_hz_at_boot() -> int64 {
    40000000
}

fn crystal_hz() -> int64 {
    40000000
}

// 4 MB embedded quad-SPI flash, 2 MB embedded quad PSRAM (eFuse, read on the test unit).
fn flash_bytes() -> int64 {
    4194304
}

fn psram_bytes() -> int64 {
    2097152
}

// --- memory map (silica_esp32s3.ld) --------------------------------------------------------------
//
// Internal SRAM1 is one array seen on two buses: instructions at 0x40378000, data at 0x3FC88000. The
// image runs from RAM; no flash cache or XIP. None of these ranges is ever a device window.

fn sram_data_base() -> int64 {
    0x3FC88000
}

// The ROM keeps its own stack and data above this while it loads the image.
fn sram_data_end() -> int64 {
    0x3FCE9700
}

fn sram_inst_base() -> int64 {
    0x40378000
}

fn sram_inst_end() -> int64 {
    0x403D9700
}

fn sram_inst_to_data_offset() -> int64 {
    0x6F0000
}

fn machine_stack_bytes() -> int64 {
    0x20000
}

fn fault_stack_bytes() -> int64 {
    0x800
}

// The auxiliary data stack the emitted code keeps in .bss (rt_start.S).
fn aux_stack_bytes() -> int64 {
    0x10000
}

// ROM entry points the runtime calls (rt_board.S, rt_start.S).
fn rom_ets_delay_us() -> int64 {
    0x40000600
}

fn rom_ets_set_appcpu_boot_addr() -> int64 {
    0x40000720
}

fn is_sram_address(a: int64) -> boolean {
    (a >= sram_data_base() and a < sram_data_end()) or (a >= sram_inst_base() and a < sram_inst_end())
}

// --- device windows --------------------------------------------------------------------------------
//
// The legal [base, base + size) ranges for map_device and the widths the pack allows (porting
// document §5.1, §10; device spec §2 "Board window"). Every base is a constant the runtime already
// uses, verified on the test board, except SPI2 (index 9): its base is ESP-IDF's SPI2 register base
// for the ESP32-S3 (the display's bus, board sheet "Display (SPI2)"), nothing in this tree drives it
// yet, and it is TRM-unconfirmed until the address-map table is checked; the 4 KB extents are the pack's
// statement and are the first of the two TRM checks (address-map table). Widths: 32 only until the TRM confirms sub-word peripheral
// access (the second TRM check); a 64-bit access cannot be one load or store on this bus.

fn peripheral_bus_base() -> int64 {
    0x60000000
}

fn window_count() -> int64 {
    10
}

fn window_tag(i: int64) -> string {
    case i of {
        0 -> ":esp32s3_uart";
        1 -> ":esp32s3_gpio";
        2 -> ":esp32s3_rtc_cntl";
        3 -> ":esp32s3_io_mux";
        4 -> ":esp32s3_timg0";
        5 -> ":esp32s3_timg1";
        6 -> ":esp32s3_systimer";
        7 -> ":esp32s3_usb_serial_jtag";
        8 -> ":esp32s3_system";
        9 -> ":esp32s3_spi2";
        _: int64 -> ""
    }
}

fn window_base(i: int64) -> int64 {
    case i of {
        0 -> 0x60000000;
        1 -> 0x60004000;
        2 -> 0x60008000;
        3 -> 0x60009000;
        4 -> 0x6001F000;
        5 -> 0x60020000;
        6 -> 0x60023000;
        7 -> 0x60038000;
        8 -> 0x600C0000;
        9 -> 0x60024000;
        _: int64 -> 0 - 1
    }
}

fn window_size(i: int64) -> int64 {
    case i >= 0 and i < window_count() of {
        true -> 0x1000;
        false -> 0
    }
}

// True when the base is a constant a runtime routine or bring-up app in this tree uses on the test
// board. False for a row taken from vendor headers and not yet confirmed against the TRM (SPI2).
fn window_base_verified(i: int64) -> boolean {
    i >= 0 and i < window_count() and i != 9
}

fn window_index_of_from(tag: string, i: int64) -> int64 {
    case i >= window_count() of {
        true -> 0 - 1;
        false -> case window_tag(i) == tag of {
            true -> i;
            false -> window_index_of_from(tag, i + 1)
        }
    }
}

fn window_index_of(tag: string) -> int64 {
    window_index_of_from(tag, 0)
}

fn window_allows_width(i: int64, width: int64) -> boolean {
    i >= 0 and i < window_count() and width == 32
}

// UART0 is the console (rt_console.S) and SYSTIMER is the supervisors' restart clock
// (rt_supervisors.S). Both stay legal to map; a program that maps UART0 and also prints interleaves
// at the byte level, since the console lock does not know about a worker's writes.
fn window_shared_with_runtime(i: int64) -> boolean {
    i == 0 or i == 6
}

fn window_containing_from(base: int64, size: int64, i: int64) -> int64 {
    case i >= window_count() of {
        true -> 0 - 1;
        false -> case base >= window_base(i) and base + size <= window_base(i) + window_size(i) of {
            true -> i;
            false -> window_containing_from(base, size, i + 1)
        }
    }
}

// The window that holds all of [base, base + size), or -1: the compile-time check for a constant
// map_device, and the row rt_device.S finds for a non-constant one.
fn window_containing(base: int64, size: int64) -> int64 {
    case size <= 0 of {
        true -> 0 - 1;
        false -> window_containing_from(base, size, 0)
    }
}

fn is_window(base: int64, size: int64) -> boolean {
    window_containing(base, size) >= 0
}

// --- registers the runtime drives ------------------------------------------------------------------
//
// One row per register a runtime routine or bring-up app touches, grouped by window, as
// window_base + offset. `register_stride` is 4 for the per-pin arrays (offset + 4 * pin), else 0.
// `register_runtime_use` says how this tree uses the register (:reads, :writes, :reads_writes); it is
// not the TRM's access mode, which a device description states as :read_only, :write_only,
// :read_write or :write_one_to_clear. Rows 0-1 rt_console.S; 2-15 rt_board.S and asm_08_gpio_diag;
// 16-21 rt_start.S; 22 rt_board.S; 23-26 rt_start.S; 27-30 rt_supervisors.S; 31 rt_board.S;
// 32 rt_start.S.

fn register_count() -> int64 {
    33
}

fn register_window(i: int64) -> int64 {
    case i of {
        0 -> 0;
        1 -> 0;
        2 -> 1;
        3 -> 1;
        4 -> 1;
        5 -> 1;
        6 -> 1;
        7 -> 1;
        8 -> 1;
        9 -> 1;
        10 -> 1;
        11 -> 1;
        12 -> 1;
        13 -> 1;
        14 -> 1;
        15 -> 1;
        16 -> 2;
        17 -> 2;
        18 -> 2;
        19 -> 2;
        20 -> 2;
        21 -> 2;
        22 -> 3;
        23 -> 4;
        24 -> 4;
        25 -> 5;
        26 -> 5;
        27 -> 6;
        28 -> 6;
        29 -> 6;
        30 -> 6;
        31 -> 7;
        32 -> 8;
        _: int64 -> 0 - 1
    }
}

fn register_name(i: int64) -> string {
    case i of {
        0 -> ":fifo";
        1 -> ":status";
        2 -> ":out";
        3 -> ":out_w1ts";
        4 -> ":out_w1tc";
        5 -> ":out1_w1ts";
        6 -> ":out1_w1tc";
        7 -> ":enable";
        8 -> ":enable_w1ts";
        9 -> ":enable_w1tc";
        10 -> ":enable1_w1ts";
        11 -> ":enable1_w1tc";
        12 -> ":in";
        13 -> ":in1";
        14 -> ":pin0";
        15 -> ":func0_out_sel_cfg";
        16 -> ":options0";
        17 -> ":wdtconfig0";
        18 -> ":wdtwprotect";
        19 -> ":swd_conf";
        20 -> ":swd_wprotect";
        21 -> ":sw_cpu_stall";
        22 -> ":gpio0";
        23 -> ":wdtconfig0";
        24 -> ":wdtwprotect";
        25 -> ":wdtconfig0";
        26 -> ":wdtwprotect";
        27 -> ":conf";
        28 -> ":unit0_op";
        29 -> ":unit0_value_hi";
        30 -> ":unit0_value_lo";
        31 -> ":conf0";
        32 -> ":core_1_control_0";
        _: int64 -> ""
    }
}

fn register_offset(i: int64) -> int64 {
    case i of {
        0 -> 0x00;
        1 -> 0x1C;
        2 -> 0x04;
        3 -> 0x08;
        4 -> 0x0C;
        5 -> 0x14;
        6 -> 0x18;
        7 -> 0x20;
        8 -> 0x24;
        9 -> 0x28;
        10 -> 0x30;
        11 -> 0x34;
        12 -> 0x3C;
        13 -> 0x40;
        14 -> 0x74;
        15 -> 0x554;
        16 -> 0x00;
        17 -> 0x98;
        18 -> 0xB0;
        19 -> 0xB4;
        20 -> 0xB8;
        21 -> 0xBC;
        22 -> 0x04;
        23 -> 0x48;
        24 -> 0x64;
        25 -> 0x48;
        26 -> 0x64;
        27 -> 0x00;
        28 -> 0x04;
        29 -> 0x40;
        30 -> 0x44;
        31 -> 0x18;
        32 -> 0x00;
        _: int64 -> 0 - 1
    }
}

fn register_stride(i: int64) -> int64 {
    case i == 14 or i == 15 or i == 22 of {
        true -> 4;
        false -> 0
    }
}

fn register_runtime_use(i: int64) -> string {
    case i of {
        0 -> ":writes";
        1 -> ":reads";
        2 -> ":reads";
        3 -> ":writes";
        4 -> ":writes";
        5 -> ":writes";
        6 -> ":writes";
        7 -> ":reads";
        8 -> ":writes";
        9 -> ":writes";
        10 -> ":writes";
        11 -> ":writes";
        12 -> ":reads";
        13 -> ":reads";
        14 -> ":reads_writes";
        15 -> ":reads_writes";
        16 -> ":reads_writes";
        17 -> ":reads_writes";
        18 -> ":reads_writes";
        19 -> ":reads_writes";
        20 -> ":reads_writes";
        21 -> ":reads_writes";
        22 -> ":reads_writes";
        23 -> ":reads_writes";
        24 -> ":reads_writes";
        25 -> ":reads_writes";
        26 -> ":reads_writes";
        27 -> ":reads_writes";
        28 -> ":reads_writes";
        29 -> ":reads";
        30 -> ":reads";
        31 -> ":reads_writes";
        32 -> ":reads_writes";
        _: int64 -> ""
    }
}

fn register_offset_of_from(window: int64, name: string, i: int64) -> int64 {
    case i >= register_count() of {
        true -> 0 - 1;
        false -> case register_window(i) == window and register_name(i) == name of {
            true -> register_offset(i);
            false -> register_offset_of_from(window, name, i + 1)
        }
    }
}

// Offset of the named register in the window, or -1.
fn register_offset_of(window: int64, name: string) -> int64 {
    register_offset_of_from(window, name, 0)
}

// --- register fields the runtime uses (rt_board.S, rt_console.S, rt_start.S) -------------------------

fn io_mux_mcu_sel_mask() -> int64 {
    0x7000
}

// Function 1 of the pad is GPIO.
fn io_mux_mcu_sel_gpio() -> int64 {
    0x1000
}

fn io_mux_fun_drv_mask() -> int64 {
    0x0C00
}

fn io_mux_fun_drv_20ma() -> int64 {
    0x0800
}

fn io_mux_fun_ie() -> int64 {
    0x0200
}

fn io_mux_fun_pu() -> int64 {
    0x0100
}

fn io_mux_fun_pd() -> int64 {
    0x0080
}

// FUNCn_OUT_SEL value that routes GPIO_OUT to the pad.
fn gpio_sig_out_idx() -> int64 {
    256
}

// Bit 2 of GPIO_PINn: open drain.
fn gpio_pin_open_drain_bit() -> int64 {
    0x4
}

// USB_SERIAL_JTAG_CONF0: cleared before GPIO19/20 act as GPIO.
fn usb_pad_enable() -> int64 {
    0x4000
}

// UART0 FIFO holds 128; the console leaves slack.
fn uart_txfifo_max() -> int64 {
    120
}

fn wdt_wkey() -> int64 {
    0x50D83AA1
}

fn swd_wkey() -> int64 {
    0x8F1D312A
}

// --- pins ----------------------------------------------------------------------------------------
//
// GPIO0..48. Rules the bring-up apps follow: never drive flash/PSRAM (26-32) or the console UART
// (43, 44); strapping pins are sampled at reset (Point on GPIO0 held low enters ROM download mode);
// GPIO19/20 are the USB PHY pads and act as GPIO only after the USB pad enable is cleared; a shared
// pin is one physical line the sheet gives two jobs. (The sheet's "display SPI CS: 10" is not one:
// the netlist and the working display put no display signal on GPIO10; it is the Right button.)

fn pin_count() -> int64 {
    49
}

fn pin_is_reserved(p: int64) -> boolean {
    (p >= 26 and p <= 32) or p == 43 or p == 44
}

fn pin_is_strapping(p: int64) -> boolean {
    p == 0 or p == 3 or p == 45 or p == 46
}

fn pin_needs_usb_pad_release(p: int64) -> boolean {
    p == 19 or p == 20
}

fn pin_is_shared(p: int64) -> boolean {
    p == 0 or p == 12 or p == 45 or (p >= 37 and p <= 40)
}

// Peripherals reach the ESP32 only through header J4: the odd J4 pin is the GPIO, the even pin beside
// it the peripheral, a shunt across the pair connects them. 0 = directly wired, no jumper.
fn pin_j4_pin(p: int64) -> int64 {
    case p of {
        2 -> 1;
        4 -> 3;
        5 -> 5;
        6 -> 7;
        7 -> 9;
        8 -> 11;
        9 -> 13;
        10 -> 15;
        11 -> 17;
        21 -> 19;
        47 -> 21;
        33 -> 23;
        34 -> 25;
        48 -> 27;
        12 -> 29;
        _: int64 -> 0
    }
}

// --- LEDs, buzzer, analog ------------------------------------------------------------------------

// Single red 0603 LED behind 5.1 kOhm: works, faint.
fn pin_led() -> int64 {
    6
}

fn led_active_high() -> boolean {
    true
}

// The sheet says GPIO1; the netlist and the hardware say GPIO2 (GPIO1 is a display-connector pin).
fn pin_rgb_red() -> int64 {
    2
}

fn pin_rgb_green() -> int64 {
    4
}

fn pin_rgb_blue() -> int64 {
    5
}

fn rgb_active_high() -> boolean {
    true
}

// 24 x WS2813B-2121 on one data line, 5V_STABLE, driven bit-banged from 3.3 V without a level shifter
// (asm_11), 3.3 V data into a 5 V part. The bit pulses are nop counts, so they depend on the CPU
// clock: 4/14 nops (0/1) at the 20 MHz hand-off, 13/34 at the 40 MHz one (clean from 12/32 to
// 14/36; 9/29 gives mixed colours, 16/40 all ones). asm_11 measures the clock at start and picks
// the table; with the 20 MHz table at 40 MHz only LED 1 lit, which was first mistaken for a faulty
// chain. Both test units light all 24 with the right table (2026-09-29).
fn pin_addressable_leds() -> int64 {
    7
}

fn addressable_led_count() -> int64 {
    24
}

fn addressable_led_order() -> string {
    ":grb"
}

// MLT-5020 through a DTC114E transistor, fed through the RV1 volume trimmer (silent at one end).
fn pin_buzzer() -> int64 {
    48
}

fn buzzer_resonance_hz() -> int64 {
    2730
}

// Analog axes (a pot wiper each); the runtime has no ADC yet. Read as digital inputs they are 1 at
// rest (mid-rail); X reads 0 pushed left and 1 pushed right, Y reads 0 pushed up and 1 pushed down
// (probe, second test unit, 2026-09-29).
fn pin_joystick_x() -> int64 {
    8
}

fn pin_joystick_y() -> int64 {
    9
}

// Battery voltage divider.
fn pin_battery_voltage() -> int64 {
    12
}

// --- buttons ---------------------------------------------------------------------------------------
//
// Six buttons are active high (external pull-downs win over the pad pull-up): 0 at rest, 1 pressed,
// clean edges at a 10 ms poll. Point (GPIO0) is the BOOT tactile switch SW1 by the USB-UART jack
// (SW1 -> 470 ohm -> GPIO0, netlist), not a joystick push -- the joystick has no push wired to a
// GPIO; it has the strapping pull-up and reads 1 at rest, 0 pressed. Holding it through a reset
// enters the ROM download mode. All seven confirmed on the second test unit (asm_03, 2026-09-29).

fn button_count() -> int64 {
    7
}

fn button_name(i: int64) -> string {
    case i of {
        0 -> "Left";
        1 -> "Right";
        2 -> "Down";
        3 -> "Up";
        4 -> "Point";
        5 -> "A";
        6 -> "B";
        _: int64 -> ""
    }
}

fn button_pin(i: int64) -> int64 {
    case i of {
        0 -> 21;
        1 -> 10;
        2 -> 47;
        3 -> 11;
        4 -> 0;
        5 -> 34;
        6 -> 33;
        _: int64 -> 0 - 1
    }
}

fn button_idle_level(i: int64) -> int64 {
    case i == 4 of {
        true -> 1;
        false -> 0
    }
}

