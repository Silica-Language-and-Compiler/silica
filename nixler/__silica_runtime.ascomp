; PID registry primitive actor.
; State layout: 3840 B calloc block, occ[240] at +0, actor_ref words[240] at +1920.
; Message record layout follows value-flat record emission: op@0, name@8, pid@16.
; Behavior return layout follows actor runtime convention: tag@0, reply@8, next_state@16.
	.globl	_silica_rt_pid_registry_beh
	.p2align	2
