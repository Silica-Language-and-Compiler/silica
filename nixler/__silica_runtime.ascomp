; Stores the spawned dangerous registry actor_ref in _silica_dangerous_pid_registry_ref.
	.globl	_silica_dangerous_pid_registry_init
	.p2align	2
_silica_dangerous_pid_registry_init:
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	bl	_silica_rt_dangerous_pid_registry_init_spawn
	adrp	x1, _silica_dangerous_pid_registry_ref@PAGE
	str	x0, [x1, _silica_dangerous_pid_registry_ref@PAGEOFF]
	mov	x0, #0
	ldp	x29, x30, [sp], #16
	ret
	.globl	_silica_rt_wait_for_exit
	.p2align	2
_silica_rt_wait_for_exit:               ; Phase I - stdin line e-x-i-t terminates process; EOF returns 0.
	.cfi_startproc
	stp	x29, x30, [sp, #-80]!
	mov	x29, sp
	stp	x19, x20, [sp, #16]
	stp	x21, x22, [sp, #32]
; Layout: fd_set 128 B @0, timeval 16 B @128, line buf 256 B @144, scratch @400 -- 416 B total.
; poll(2) on macOS often never signals POLLIN for tty stdin; select(2) is reliable (Phase I trial / interactive main).
	sub	sp, sp, #416
	mov	x20, xzr
Lwi_loop:
	mov	x22, xzr
Lwi_after_root:
	mov	x0, sp
	mov	x1, xzr
	mov	x2, #128
	bl	_memset
	ldr	w8, [sp]
	orr	w8, w8, #0x1
	str	w8, [sp]
	str	xzr, [sp, #128]
	movz	w9, #0xd090
	movk	w9, #3, lsl #16
	str	w9, [sp, #136]
	mov	w0, #1
	mov	x1, sp
	mov	x2, xzr
	mov	x3, xzr
	add	x4, sp, #128
	bl	_select
	cmp	w0, #-1
	b.eq	Lwi_select_sleep
	cmp	w0, #0
	b.eq	Lwi_loop
	cmp	x20, #255
	b.hs	Lwi_overflow_discard
	add	x21, sp, #144
	add	x21, x21, x20
	mov	x0, xzr
	mov	x2, #1
	mov	x1, x21
	bl	_read
	cmp	x0, #0
	b.ne	Lwi_line_read_nz
	cbz	x22, Lwi_ret_ok
	b	Lwi_loop
Lwi_line_read_nz:
	cmp	x0, #1
	b.ne	Lwi_select_sleep
	ldrb	w9, [x21]
	cmp	w9, #10
	b.eq	Lwi_line_done
	strb	w9, [x21]
	add	x20, x20, #1
	b	Lwi_loop
Lwi_line_done:
Lwi_trim_cr:
	cmp	x20, #0
	b.le	Lwi_cmp_exit
	sub	x21, x20, #1
	add	x22, sp, #144
	ldrb	w9, [x22, x21]
	cmp	w9, #13
	b.ne	Lwi_cmp_exit
	mov	x20, x21
	b	Lwi_trim_cr
Lwi_cmp_exit:
	cmp	x20, #4
	b.ne	Lwi_line_reset
	add	x21, sp, #144
	ldrb	w9, [x21]
	cmp	w9, #101
	b.ne	Lwi_line_reset
	ldrb	w9, [x21, #1]
	cmp	w9, #120
	b.ne	Lwi_line_reset
	ldrb	w9, [x21, #2]
	cmp	w9, #105
	b.ne	Lwi_line_reset
	ldrb	w9, [x21, #3]
	cmp	w9, #116
	b.ne	Lwi_line_reset
	b	Lwi_process_exit
Lwi_line_reset:
	mov	x20, xzr
	b	Lwi_loop
Lwi_overflow_discard:
	mov	x0, xzr
	add	x1, sp, #400
	mov	x2, #1
	bl	_read
	cmp	x0, #0
	b.ne	Lwi_overflow_read_nz
	cbz	x22, Lwi_ret_ok
	b	Lwi_loop
Lwi_overflow_read_nz:
	cmp	x0, #1
	b.ne	Lwi_select_sleep
	ldrb	w9, [sp, #400]
	cmp	w9, #10
	b.eq	Lwi_overflow_reset
	b	Lwi_overflow_discard
Lwi_overflow_reset:
	mov	x20, xzr
	b	Lwi_loop
Lwi_select_sleep:
	mov	x0, xzr
	mov	w1, wzr
	mov	w2, #100
	bl	_poll
	b	Lwi_loop
Lwi_process_exit:
	mov	w0, wzr
	bl	_exit
	b	Lwi_process_exit
Lwi_ret_ok:
	mov	x0, #0
	add	sp, sp, #416
	ldp	x21, x22, [x29, #32]
	ldp	x19, x20, [x29, #16]
	ldp	x29, x30, [sp], #80
	ret
	.cfi_endproc
	.section	__TEXT,__text,regular,pure_instructions
	.globl	_silica_rt_actor_deliver_exit   ; Phase C — §15.4.10 unified delivery
	.p2align	2
_silica_rt_actor_deliver_exit:          ; X0=child self; X0 out: 0 delivered, 1 drop (no sup / dead / OOM)
	.cfi_startproc
	stp	x22, x21, [sp, #-48]!
	stp	x20, x19, [sp, #16]
	stp	x29, x30, [sp, #32]
	add	x29, sp, #32
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	mov	x19, x0
	ldr	x20, [x19, #192]
	cbz	x20, Lde_nosup
	mov	w0, #1
	mov	w1, #32
	bl	_calloc
	cbz	x0, Lde_nosup
	mov	x21, x0
	str	x19, [x21]
	ldr	x9, [x19, #336]
	str	x9, [x21, #8]
	str	xzr, [x21, #16]
	ldr	x8, [x19, #200]
	str	x8, [x21, #24]
	add	x0, x20, #16
	bl	_os_unfair_lock_lock
	ldr	w9, [x20, #152]
	cbz	w9, Lde_dead
	ldr	w9, [x20, #248]
	cmp	w9, #1024
	b.hs	Lde_abort
	mov	w0, #1
	mov	w1, #152
	bl	_calloc
	cbz	x0, Lde_dead
	mov	x22, x0
	str	x21, [x22, #8]
	str	wzr, [x22, #16]
	add	x0, x20, #232
	mov	x1, x22
	bl	_silica_rt_q_enqueue_locked
	ldr	w9, [x20, #248]
	add	w9, w9, #1
	str	w9, [x20, #248]
	add	x0, x20, #80
	bl	_silica_rt_cv_signal
	add	x0, x20, #16
	bl	_os_unfair_lock_unlock
	mov	x0, #0
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
Lde_dead:
	mov	x0, x21
	bl	_free
	add	x0, x20, #16
	bl	_os_unfair_lock_unlock
	mov	x0, #1
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
Lde_nosup:
	mov	x0, #1
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
Lde_abort:
	bl	_abort
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_supervision_wait_and_drain_one ; Phase C trial accessor — behavior-only
	.p2align	2
_silica_rt_actor_supervision_wait_and_drain_one:
	.cfi_startproc
; No args; returns X0 = failure payload pointer dequeued from self's supervision ingress, blocks until one is available.
	stp	x22, x21, [sp, #-48]!
	stp	x20, x19, [sp, #16]
	stp	x29, x30, [sp, #32]
	add	x29, sp, #32
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	bl	_silica_rt_tls_current_actor_get
	mov	x19, x0
	cbz	x19, Lswd_null
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
Lswd_try:
	add	x0, x19, #232
	bl	_silica_rt_q_dequeue_locked
	cbz	x0, Lswd_wait
	mov	x20, x0
	ldr	w9, [x19, #248]
	sub	w9, w9, #1
	str	w9, [x19, #248]
	ldr	x21, [x20, #8]
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
; Phase E: mirror LBB1_free (mutex must not be held — maybe_restart may spawn / take table locks). X2 = reason_tag (e4b).
	cbz	x21, Lswd_free_wrap
	ldr	x8, [x21]
	cbz	x8, Lswd_free_wrap
	mov	x0, x8
	mov	x1, x19
	ldr	x2, [x21, #8]
	bl	_silica_rt_supervisor_maybe_restart
Lswd_free_wrap:
	mov	x0, x20
	bl	_free
	mov	x0, x21
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
Lswd_wait:
; Phase E e4f: blocking pthread_cond_wait. Same rationale as in _silica_rt_actor_call /
; actor_thread_main wait paths — the 1 ms timedwait was a missed-signal band-aid that drove
; libpthread internal kwq malloc churn racing with new-actor TLS instantiation (mfm_alloc
; SIGBUS). All paths that enqueue a failure (LBB1_free's _silica_rt_actor_deliver_exit, etc.)
; signal sup#80 cond while holding sup#16 mutex, so plain cond_wait is correctly delivered.
	add	x0, x19, #80
	add	x1, x19, #16
	bl	_silica_rt_cv_wait
	b	Lswd_try
Lswd_null:
	mov	x0, #0
	ldp	x29, x30, [sp, #32]
	ldp	x20, x19, [sp, #16]
	ldp	x22, x21, [sp], #48
	ret
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_failure_reason_tag
	.p2align	2
_silica_rt_actor_failure_reason_tag:    ; X0=payload ptr -> X0=int64 reason_tag (0 :normal)
	.cfi_startproc
	cbz	x0, Lfrt_zero
	ldr	x0, [x0, #8]
	ret
Lfrt_zero:
	mov	x0, #0
	ret
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_failure_reason_atom
	.p2align	2
_silica_rt_actor_failure_reason_atom:   ; X0=payload ptr -> X0=atom failure_reason variant
	.cfi_startproc
	cbz	x0, Lfra_unknown
	ldr	x8, [x0, #8]
	cbz	x8, Lfra_normal
	cmp	x8, #2
	b.eq	Lfra_language_error
	cmp	x8, #3
	b.eq	Lfra_memory_fault
	cmp	x8, #4
	b.eq	Lfra_explicit
	cmp	x8, #5
	b.eq	Lfra_foreign_fault
	b	Lfra_unknown
Lfra_normal:
	mov	x0, #3
	ret
Lfra_language_error:
	mov	x0, #4
	ret
Lfra_memory_fault:
	mov	x0, #5
	ret
Lfra_explicit:
	mov	x0, #6
	ret
Lfra_foreign_fault:
	mov	x0, #-1
	ret
Lfra_unknown:
	mov	x0, #7
	ret
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_failure_agent_type
	.p2align	2
_silica_rt_actor_failure_agent_type:    ; X0=payload ptr -> X0=atom agent_type
	.cfi_startproc
	cbz	x0, Lfat_zero
	ldr	x0, [x0, #24]
	ret
Lfat_zero:
	mov	x0, #0
	ret
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_failure_release
	.p2align	2
_silica_rt_actor_failure_release:       ; X0=payload ptr; frees payload; returns X0=atom :ok
	.cfi_startproc
	cbz	x0, Lfrr_zero
	stp	x29, x30, [sp, #-16]!
	add	x29, sp, #0
	bl	_free
	mov	x0, #2
	ldp	x29, x30, [sp], #16
	ret
Lfrr_zero:
	mov	x0, #2
	ret
	.cfi_endproc
                                        ; -- End function

.subsections_via_symbols
	.section	__DATA,__bss
	.p2align	3
.globl	_silica_rt_root_failure_reporter
