	mov	x8, #20
	str	x8, [x0]
	str	x23, [x0, #8]
	b	L_pidreg_done
L_pidreg_insert:
	cmp	x22, #0
	b.lt	L_pidreg_insert_ok
	cmp	x22, #240
	b.ge	L_pidreg_insert_ok
	mov	x8, #1
	str	x8, [x20, x22, lsl #3]
	add	x9, x20, #1920
	str	x23, [x9, x22, lsl #3]
L_pidreg_insert_ok:
	mov	x8, #2
	str	x8, [x0]
	str	x23, [x0, #8]
	b	L_pidreg_done
L_pidreg_lookup:
	cmp	x22, #0
	b.lt	L_pidreg_not_found
	cmp	x22, #240
	b.ge	L_pidreg_not_found
	ldr	x8, [x20, x22, lsl #3]
