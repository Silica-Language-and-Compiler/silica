; Silica actor/supervisor runtime definitions. Link this object once per executable.
	.section	__TEXT,__text,regular,pure_instructions
	.globl	_silica_rt_actor_spawn          ; -- Begin function silica_rt_actor_spawn
	.p2align	2
_silica_rt_actor_spawn:                 ; @silica_rt_actor_spawn
	.cfi_startproc
; %bb.0:
	stp	x24, x23, [sp, #-64]!           ; 16-byte Folded Spill
	stp	x22, x21, [sp, #16]             ; 16-byte Folded Spill
	stp	x20, x19, [sp, #32]             ; 16-byte Folded Spill
	stp	x29, x30, [sp, #48]             ; 16-byte Folded Spill
	add	x29, sp, #48
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	.cfi_offset w23, -56
	.cfi_offset w24, -64
	mov	x24, x3
	mov	x23, x2
	mov	x20, x1
	mov	x21, x0
	mov	w22, #1                         ; =0x1
	mov	w0, #1                          ; =0x1
	mov	w1, #384
	bl	_calloc
	mov	x19, x0
	cbz	x0, LBB0_4
; %bb.1:
	stp	x21, x20, [x19]
	str	xzr, [x19, #192]
	str	xzr, [x19, #200]
	str	x23, [x19, #208]
	str	xzr, [x19, #216]
	str	xzr, [x19, #224]
	str	xzr, [x19, #232]
	str	xzr, [x19, #240]
	str	wzr, [x19, #248]
	str	xzr, [x19, #256]
	str	xzr, [x19, #264]
	str	xzr, [x19, #272]
	str	x24, [x19, #280]
	str	xzr, [x19, #288]
	str	xzr, [x19, #296]
	str	xzr, [x19, #304]
	str	xzr, [x19, #312]
	str	xzr, [x19, #320]
	str	xzr, [x19, #328]
	str	xzr, [x19, #336]
	str	xzr, [x19, #344]
; Phase E e4f: ACB+16 is now an os_unfair_lock (4 B) and ACB+80 is a 4 B futex seq word.
; Both are zero from calloc above (OS_UNFAIR_LOCK_INIT == 0); no init call needed.
	str	w22, [x19, #152]
Lloh0:
	adrp	x2, _actor_thread_main@PAGE
Lloh1:
	add	x2, x2, _actor_thread_main@PAGEOFF
	add	x0, x19, #144
	mov	x1, #0                          ; =0x0
	mov	x3, x19
	bl	_pthread_create
	cbz	w0, LBB0_3
; %bb.2:
	mov	x0, x19
	bl	_free
	mov	x19, #0                         ; =0x0
	b	LBB0_4
LBB0_3:
	ldur	x0, [x19, #144]
	bl	_pthread_detach
	mov	x0, x19
	bl	_silica_rt_actor_init_region
; Phase E: supervisor trampoline (ACB#280) runs on the new thread; wait until #288 is set so
; callers see a materialized child table before receiving the actor_ref.
	cbz	x24, LBB0_4
LBB0_tramp_spin:
	ldr	x8, [x19, #288]
	cbz	x8, LBB0_tramp_spin
LBB0_4:
; Phase I: wait_for_exit consults _silica_rt_wait_root_acb (+#152 alive). Only top-level spawn()
; registers here; spawn_linked workers must not steal the slot (see LBBsl_4).
	cbz	x19, LBB0_wr_skip
LBB0_wr_try:
	adrp	x8, _silica_rt_wait_root_acb@PAGE
LBB0_wr_page:
	add	x8, x8, _silica_rt_wait_root_acb@PAGEOFF
	ldr	x9, [x8]
	cbnz	x9, LBB0_wr_skip
	str	x19, [x8]
LBB0_wr_skip:
	mov	x0, x19
	ldp	x29, x30, [sp, #48]             ; 16-byte Folded Reload
	ldp	x20, x19, [sp, #32]             ; 16-byte Folded Reload
	ldp	x22, x21, [sp, #16]             ; 16-byte Folded Reload
	ldp	x24, x23, [sp], #64             ; 16-byte Folded Reload
	ret
	.loh AdrpAdd	Lloh0, Lloh1
	.loh AdrpAdd	LBB0_wr_try, LBB0_wr_page
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_spawn_linked   ; Phase A: supervision metadata (supervisors_implementation_development_plan.md §A)
	.p2align	2
_silica_rt_actor_spawn_linked:          ; @silica_rt_actor_spawn_linked
	.cfi_startproc
	stp	x24, x23, [sp, #-64]!
	stp	x22, x21, [sp, #16]
	stp	x20, x19, [sp, #32]
	stp	x29, x30, [sp, #48]
	add	x29, sp, #48
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	.cfi_offset w23, -56
	.cfi_offset w24, -64
	mov	x23, x2
	mov	x24, x3
	mov	x22, x4
	mov	x20, x1
	mov	x21, x0
	mov	w0, #1
	mov	w1, #384
	bl	_calloc
	mov	x19, x0
	cbz	x0, LBBsl_4
	stp	x21, x20, [x19]
; Parent/supervisor is recorded by the internal supervisor runtime path after spawn returns.
	str	xzr, [x19, #192]
	mov	x21, xzr
	mov	x0, xzr
	str	x23, [x19, #200]
	str	x24, [x19, #208]
	str	xzr, [x19, #216]
	str	xzr, [x19, #224]
	str	xzr, [x19, #232]
	str	xzr, [x19, #240]
	str	wzr, [x19, #248]
	str	xzr, [x19, #256]
	str	xzr, [x19, #264]
	str	xzr, [x19, #272]
	str	x22, [x19, #280]
	str	xzr, [x19, #288]
	str	xzr, [x19, #296]
	str	xzr, [x19, #304]
	str	xzr, [x19, #312]
	str	xzr, [x19, #320]
	str	xzr, [x19, #328]
	str	xzr, [x19, #336]
	str	xzr, [x19, #344]
	cbz	x0, Lslp_skip_list
	sub	sp, sp, #16
	str	x0, [sp, #8]
	ldr	x1, [sp, #8]
	add	x0, x1, #16
	bl	_os_unfair_lock_lock
	ldr	x1, [sp, #8]
	ldr	x8, [x1, #216]
	str	x8, [x19, #224]
	str	x19, [x1, #216]
	add	x0, x1, #16
	bl	_os_unfair_lock_unlock
	add	sp, sp, #16
Lslp_skip_list:
; Phase E e4f: ACB+16 (os_unfair_lock) and ACB+80 (futex seq word) are pre-zeroed by calloc.
; OS_UNFAIR_LOCK_INIT == 0, seq baseline 0; no init call required.
	mov	w8, #1
	str	w8, [x19, #152]
Lslp_tm0:
	adrp	x2, _actor_thread_main@PAGE
Lslp_tm1:
	add	x2, x2, _actor_thread_main@PAGEOFF
	add	x0, x19, #144
	mov	x1, #0
	mov	x3, x19
	bl	_pthread_create
	cbz	w0, LBBsl_3
	mov	x0, x19
	bl	_free
	mov	x19, #0
	b	LBBsl_4
LBBsl_3:
	ldur	x0, [x19, #144]
	bl	_pthread_detach
	mov	x0, x19
	bl	_silica_rt_actor_init_region
; Phase E e4f: spin until the new actor's thread has finished its TLS init / trampoline
; (signalled by ACB[+288] == 1 in actor_thread_main). Keeps spawn ordering strictly
; sequential — the supervisor never overlaps two children's startup, eliminating the
; libsystem mfm_alloc / TLS-instantiate race observed with 3+ concurrent spawns.
LBBsl_started_spin:
	ldr	x8, [x19, #288]
	cbz	x8, LBBsl_started_spin
LBBsl_4:
	mov	x0, x19
	ldp	x29, x30, [sp, #48]
	ldp	x20, x19, [sp, #32]
	ldp	x22, x21, [sp, #16]
	ldp	x24, x23, [sp], #64
	ret
	.loh AdrpAdd	Lslp_tm0, Lslp_tm1
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_spawn_dangerous_linked
	.p2align	2
_silica_rt_actor_spawn_dangerous_linked:
	b	_silica_rt_actor_spawn_linked
	.p2align	2                               ; -- Begin function actor_thread_main
_actor_thread_main:                     ; @actor_thread_main
	.cfi_startproc
; %bb.0:
	stp	x22, x21, [sp, #-48]!           ; 16-byte Folded Spill
	stp	x20, x19, [sp, #16]             ; 16-byte Folded Spill
	stp	x29, x30, [sp, #32]             ; 16-byte Folded Spill
	add	x29, sp, #32
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	mov	x19, x0
	bl	_silica_rt_ensure_actor_tls_key
	bl	_silica_rt_tls_actor_set_from_x19
; Phase E e3b: first-schedule supervisor trampoline hook
	ldr	x8, [x19, #280]
	cbz	x8, LBB1_skip_tramp
	ldr	x9, [x19, #288]
	cbnz	x9, LBB1_skip_tramp
	mov	x0, x19
	blr	x8
LBB1_skip_tramp:
; Phase E e4f: mark actor as started (post TLS init + post any first-schedule trampoline) so
; spawn / spawn_linked callers can serialize on +288 == 1 for both supervisors and workers.
; This delivers the user-requested ordering: each child starts one at a time, waiting until
; the previous child's actor_thread_main has materialised before the next spawn proceeds.
	mov	x8, #1
	str	x8, [x19, #288]
	mov	w22, #1                         ; =0x1
LBB1_loop:
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
LBB1_wait:
	add	x0, x19, #232
	bl	_silica_rt_q_dequeue_locked
	mov	x20, x0
	cbz	x20, LBB1_try_std
	ldr	w9, [x19, #248]
	sub	w9, w9, #1
	str	w9, [x19, #248]
	mov	w21, #1
	b	LBB1_process
LBB1_try_std:
	ldr	w9, [x19, #152]
	cbz	w9, LBB1_exit
	add	x0, x19, #128
	bl	_silica_rt_q_dequeue_locked
	mov	x20, x0
	mov	w21, #0
	cbnz	x20, LBB1_process
	ldr	w9, [x19, #152]
	cbz	w9, LBB1_exit
; Phase E e4f: blocking _silica_rt_cv_wait (os_unfair_lock + ___ulock_wait UL_COMPARE_AND_WAIT_SHARED).
; Earlier pthread_cond_timedwait_relative_np drove libpthread kwq malloc churn racing TLS instantiation
; (mfm_alloc SIGBUS). Wake paths hold ACB+16, signal ACB+80, then unlock before _silica_rt_cv_wait.
	add	x0, x19, #80
	add	x1, x19, #16
	bl	_silica_rt_cv_wait
	b	LBB1_wait
LBB1_process:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	sub	sp, sp, #48
	str	x20, [sp, #24]
	ldr	w8, [x20, #16]
	str	w8, [sp, #32]
	cbz	w8, LBB1_no_active_call
	str	x20, [x19, #344]
	b	LBB1_active_call_set
LBB1_no_active_call:
	str	xzr, [x19, #344]
LBB1_active_call_set:
	mov	w22, w21
	cbnz	w22, LBB1_ingress_check_kind
	ldr	x0, [x20, #8]
	ldp	x1, x8, [x19]
	cbz	x8, LBB1_ingress_no_beh
	mov	x2, sp
	blr	x8
	ldr	x10, [x0]
	ldr	w8, [sp, #32]
	cbz	w8, LBB1_no_reply_result
	ldr	x21, [x0, #8]
	ldr	x9, [x0, #16]
	b	LBB1_post_beh
LBB1_no_reply_result:
	mov	x21, xzr
	ldr	x9, [x0, #8]
	b	LBB1_post_beh
LBB1_ingress_check_kind:
	ldr	w9, [x20, #24]
	cbnz	w9, LBB1_ingress_user_beh
LBB1_ingress_no_beh:
; Phase C / structured exit: message[+8] is heap payload; do not invoke beh(msg,…). phase_e4f rest_for_one.
	mov	x21, xzr
	mov	x9, xzr
	b	LBB1_post_beh
LBB1_ingress_user_beh:
; Phase B trial: message[+8] is inline int64; run behavior like a normal dequeue.
	ldr	x0, [x20, #8]
	ldp	x1, x8, [x19]
	cbz	x8, LBB1_ingress_no_beh
	mov	x2, sp
	blr	x8
	ldr	x10, [x0]
	ldr	w8, [sp, #32]
	cbz	w8, LBB1_ingress_no_reply_result
	ldr	x21, [x0, #8]
	ldr	x9, [x0, #16]
	mov	w22, #0
	b	LBB1_post_beh
LBB1_ingress_no_reply_result:
	mov	x21, xzr
	ldr	x9, [x0, #8]
	mov	w22, #0
	b	LBB1_post_beh
LBB1_post_beh:
	ldr	x20, [sp, #24]
	ldr	w8, [sp, #32]
	add	sp, sp, #48
	str	xzr, [x19, #344]
	cbnz	w22, LBB1_skip_actor_state
	str	x9, [x19]
LBB1_skip_actor_state:
	cbnz	w22, LBB1_ingress_restore_w21
	b	LBB1_after_w21
LBB1_ingress_restore_w21:
	mov	w21, w22
LBB1_after_w21:
	cbz	w8, LBB1_free
; Phase E e4f: take the call wrapper lock before draining supervision ingress so the
; caller cannot complete actor_call (and free the wrapper) until every enqueued exit
; notification has been processed. kill_abnormal only signals the victim; deliver_exit
; runs on child threads while sup_beh is still finishing — without this ordering, main
; could free the wrapper concurrently with deliver_exit / LBB1_exit (SIGBUS mfm_*) on
; phase_e4f_rest_for_one.
	add	x0, x20, #72
	bl	_os_unfair_lock_lock
LBB1_drain_ingress:
	add	x0, x19, #16
	bl	_os_unfair_lock_lock
	add	x0, x19, #232
	bl	_silica_rt_q_dequeue_locked
	mov	x23, x0
	cbz	x23, LBB1_drain_ingress_done
	ldr	w9, [x19, #248]
	sub	w9, w9, #1
	str	w9, [x19, #248]
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	ldr	w9, [x23, #24]
	cbnz	w9, LBB1_drain_ingress_free_msg
	ldr	x22, [x23, #8]
	cbz	x22, LBB1_drain_ingress_free_msg
	ldr	x0, [x22]
	mov	x1, x19
	ldr	x2, [x22, #8]
	bl	_silica_rt_supervisor_maybe_restart
	mov	x0, x22
	bl	_free
LBB1_drain_ingress_free_msg:
	mov	x0, x23
	bl	_free
	b	LBB1_drain_ingress
LBB1_drain_ingress_done:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	str	x21, [x20, #144]
	mov	w8, #1
	str	w8, [x20, #136]
	add	x0, x20, #24
	bl	_silica_rt_cv_signal
	add	x0, x20, #72
	bl	_os_unfair_lock_unlock
	b	LBB1_loop
LBB1_free:
; Phase E e3c+e4b: if this was an ingress message (w22==1), attempt automatic restart before freeing. X2 = reason_tag from payload+8 (e4b).
; Payload ptr must live in a callee-saved reg across maybe_restart — x8 is caller-saved and was clobbered, yielding free(non-heap) (e.g. 0x1).
; Phase B trial: message[+24]!=0 and +8 is inline int64 — do not treat +8 as heap or call maybe_restart (phase_b_ingress_before_cast).
	cbz	w22, LBB1_free_skip_restart
	ldr	w9, [x20, #24]
	cbnz	w9, LBB1_free_skip_restart
	ldr	x25, [x20, #8]
	cbz	x25, LBB1_free_skip_restart
	ldr	x0, [x25]
	mov	x1, x19
	ldr	x2, [x25, #8]
	bl	_silica_rt_supervisor_maybe_restart
	mov	x0, x25
	bl	_free
LBB1_free_skip_restart:
	mov	x0, x20
	bl	_free
	b	LBB1_loop
LBB1_exit:
	add	x0, x19, #16
	bl	_os_unfair_lock_unlock
	ldr	x8, [x19, #272]
	cbnz	x8, LBB1_exit_report_already_done
	mov	x0, x19
	bl	_silica_rt_actor_deliver_exit
	mov	x20, x0
	mov	x0, x19
	bl	_silica_rt_actor_deliver_unwind_report
	b	LBB1_exit_after_report
LBB1_exit_report_already_done:
	mov	x20, #0
LBB1_exit_after_report:
	ldr	x21, [x19, #192]
	cbz	x21, LBB1_exit_no_sup_drain
	mov	x0, x21
	bl	_silica_rt_supervisor_drain_ingress
	ldr	w23, [x19, #336]
	cbz	w23, LBB1_exit_no_sup_drain
	ldr	x22, [x19, #208]
	cbz	x22, LBB1_exit_no_sup_drain
	ldr	w8, [x21, #152]
	cbz	w8, LBB1_exit_no_sup_drain
LBB1_exit_wait_new_child:
	ldr	x0, [x22]
	cmp	x0, x19
	beq	LBB1_exit_wait_new_child
	cbz	x0, LBB1_exit_wait_new_child
	ldr	x8, [x0, #288]
	cbz	x8, LBB1_exit_wait_new_child
LBB1_exit_no_sup_drain:
	mov	x0, x19
	bl	_silica_rt_actor_signal_pending_call_deaths
	cbz	x20, LBB1_exit_skip_legacy_root
	mov	w0, #2
Lloh_rn0:
	adrp	x1, L_silica_root_actor_exit@PAGE
Lloh_rn1:
	add	x1, x1, L_silica_root_actor_exit@PAGEOFF
	mov	w2, #43
	bl	_write
LBB1_exit_skip_legacy_root:
; Phase E e4f: capture row_ptr from ACB[+208] (set by spawn_linked from X3) into a
; callee-saved register so we can flag the supervisor AFTER our own teardown completes.
; Top-level supervisors spawned via spawn() have ACB[+208] == 0 (their X3 is the
; trampoline fn pointer routed to ACB[+280]), so x20 == 0 and the post-free flag write
; is skipped — there is no parent row to notify.
	ldr	x20, [x19, #208]
	ldr	x21, [x19, #192]
	cbz	x21, LBB1_exit_no_row
	mov	x0, x19
	bl	_silica_rt_child_table_free
	mov	x0, x19
	bl	_silica_rt_ffi_arena_teardown
	mov	x0, x19
	bl	_silica_rt_actor_dealloc_region
	mov	x0, x19
	bl	_free
; Phase E e4f: AFTER full teardown (mutex/cond destroyed, ACB freed) signal the
; supervisor's row.exit_done = 1. The supervisor's cascade kill loop spins on this
; flag for sequential stop ordering — every libsystem cleanup has now retired before
; the next sibling is asked to die, eliminating the malloc / TLS-instantiate races
; observed when 3+ worker teardowns overlapped.
	cbz	x20, LBB1_exit_no_row
	mov	x9, #1
	str	x9, [x20, #56]
LBB1_exit_no_row:
	mov	x0, #0                          ; =0x0
	ldp	x29, x30, [sp, #32]             ; 16-byte Folded Reload
	ldp	x20, x19, [sp, #16]             ; 16-byte Folded Reload
	ldp	x22, x21, [sp], #48             ; 16-byte Folded Reload
	ret
	.loh AdrpAdd	Lloh_rn0, Lloh_rn1
	.cfi_endproc
                                        ; -- End function
	.p2align	2                               ; functional queue dequeue; caller holds queue's lock
_silica_rt_q_dequeue_locked:            ; X0 = &queue (pair: front, rear). Returns X0 = node or null.
	.cfi_startproc
	ldr	x1, [x0]
	cbnz	x1, Lqd_pop
	ldr	x1, [x0, #8]
	cbz	x1, Lqd_empty
	mov	x2, xzr
Lqd_rev:
	ldr	x3, [x1]
	str	x2, [x1]
	mov	x2, x1
	mov	x1, x3
	cbnz	x1, Lqd_rev
	str	x2, [x0]
	str	xzr, [x0, #8]
	mov	x1, x2
Lqd_pop:
	ldr	x3, [x1]
	str	x3, [x0]
	mov	x0, x1
	ret
Lqd_empty:
	mov	x0, #0
	ret
	.cfi_endproc
                                        ; -- End function
	.p2align	2                               ; functional queue enqueue; caller holds queue's lock
_silica_rt_q_enqueue_locked:            ; X0 = &queue (pair), X1 = node. Prepends to rear.
	.cfi_startproc
	ldr	x2, [x0, #8]
	str	x2, [x1]
	str	x1, [x0, #8]
	ret
	.cfi_endproc
                                        ; -- End function
	.globl	_silica_rt_actor_send           ; -- Begin function silica_rt_actor_send
	.p2align	2
_silica_rt_actor_send:                  ; @silica_rt_actor_send
	.cfi_startproc
; %bb.0:
	stp	x22, x21, [sp, #-48]!           ; 16-byte Folded Spill
	stp	x20, x19, [sp, #16]             ; 16-byte Folded Spill
	stp	x29, x30, [sp, #32]             ; 16-byte Folded Spill
	add	x29, sp, #32
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
	.cfi_offset w19, -24
	.cfi_offset w20, -32
	.cfi_offset w21, -40
	.cfi_offset w22, -48
	cbz	x0, LBB2_5
; %bb.1:
	mov	x21, x1
; %bb.2:
