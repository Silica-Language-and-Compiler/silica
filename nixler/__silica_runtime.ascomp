	mov	x29, sp
	mov	x19, x0
	mov	x20, x1
	ldr	x21, [x19]       ; op atom index
	ldr	x22, [x19, #8]   ; name atom index
	ldr	x23, [x19, #16]  ; pid actor_ref
	mov	x0, #1
	mov	x1, #24
	bl	_calloc
	mov	x24, x0
	cbz	x24, L_pidreg_ret_null
	mov	x0, #1
	mov	x1, #16
	bl	_calloc
	cbz	x0, L_pidreg_ret_null
	str	x0, [x24, #8]
	str	x20, [x24, #16]
	cmp	x21, #15
	b.eq	L_pidreg_insert
	cmp	x21, #16
	b.eq	L_pidreg_lookup
	cmp	x21, #17
