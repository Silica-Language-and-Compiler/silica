      "canMessage": ["ex:PlanningGenerationPersona2", "ex:SilicaPatternExpertPersona", "ex:PlanningStatePersona", "ex:SpecificationStatePersona", "user"],
      "canReceiveFrom": ["user", "ex:PlanningGenerationPersona2", "ex:SilicaPatternExpertPersona", "ex:PlanningStatePersona", "ex:SpecificationStatePersona"]
    },
