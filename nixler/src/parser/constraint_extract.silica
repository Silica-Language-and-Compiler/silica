// Constraint extraction modules (use these directly from constraint_runner):
//   constraint_extract_slots       — roles, slot helpers, token/type classifiers
//   constraint_extract_params      — params/types/fn·effect declaration heads
//   constraint_extract_expr        — expr/case/sequence/body (+ extract_function)
//   constraint_extract_expr_bindings — binding + struct-literal extraction
//   constraint_extract_expr_lits   — list/paren/value-block extraction
//   constraint_extract_decls       — top-level decls + slots_to_program
//   constraint_extract_lambda_lift — lambda lifting
//   constraint_extract_hof_wrap    — HOF arity shim for lifted lambdas
//   constraint_extract_validate    — post-parse validators
//
// This unit is a tiny index only (no giant AST facade signatures).

export constraint_extract_split_index/0;

fn constraint_extract_split_index() -> int64 {
    0
}
