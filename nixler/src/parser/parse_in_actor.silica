// NOT WIRED IN (2026-09-10). This unit parses a token list inside a spawned actor so that the parse
// scratch dies with the actor (remove_actor) instead of living for the whole unit compile. It compiles
// and is kept for when the runtime can host it; today gen2 built with main_parse calling
// parse_program_in_actor dies on emitter_core with EXC_BAD_ACCESS in silica_rt_region_alloc's prologue:
// actor threads run on the 512 KB default pthread stack (both pthread_create sites pass attr = NULL)
// while the compiler's main thread has 256 MB (-Wl,-stack_size), and the actor's bump arena has 8 MB
// committed with no growth. The parser needs far more of both on a large unit. Prerequisite: the
// segmented runtime-managed actor stack + chained arena design (spec 15.1.2.2). main_parse still calls
// parser_runner@parse_program directly. remove_actor also prints the runtime's failure banner on every
// exit (golden-locked in trials/supervisors_addition), which would need gating on the abnormal flag.

// Parse a unit inside a throw-away actor so the parser's scratch dies with it.
//
// Every implicit allocation on an actor thread bump-allocates from that actor's region, so the
// parser's discarded intermediate node lists (0.8 GB on emitter_core after the small-to-large
// combine) land there instead of in main's never-freed malloc arena. The reply is the
// declaration list (a pointer into the actor's region); main deep-copies the compact AST into
// its own memory (tens of MB), then kills the actor, whose region is munmapped on death
// (_silica_rt_actor_dealloc_region). Strings are untouched: lexemes and literals live in the
// global string arenas, not the actor region. This is ownership-shaped release: the subtree
// garbage has an owner (the actor) that dies exactly when the copied result no longer needs it.
//
// Note the copy happens BEFORE the kill (the reply dangles afterwards). On a parse error the
// actor replies an empty list and main re-parses on its own thread to produce the diagnostics;
// a genuinely empty program takes the same path, which is harmless.

use parser_runner;

export parse_program_in_actor/1;

fn parse_beh(msg: List[{ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], state: int64) -> (:reply, List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], int64) {
    r: { is_ok: boolean, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- parser_runner@parse_program(msg);
    decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- case r.is_ok of {
        true -> r.program.declarations;
        false -> empty_copy_decls()
    };
    (:reply, decls, state)
}

fn zero_loc() -> { file: string, line: int64, column: int64, offset: int64 } {
    r: { file: string, line: int64, column: int64, offset: int64 } <- { file: "", line: 0, column: 0, offset: 0 };
    r
}

fn copy_loc(l: { file: string, line: int64, column: int64, offset: int64 }) -> { file: string, line: int64, column: int64, offset: int64 } {
    r: { file: string, line: int64, column: int64, offset: int64 } <- { file: l.file, line: l.line, column: l.column, offset: l.offset };
    r
}

fn copy_param(p: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } } {
    r: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: p.name, type_name: p.type_name, location: copy_loc(p.location) };
    r
}

fn copy_eff(e: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } {
    r: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: e.name, parameter: e.parameter, location: copy_loc(e.location) };
    r
}

fn copy_pb(b: { name: string, path: string, type_str: string }) -> { name: string, path: string, type_str: string } {
    r: { name: string, path: string, type_str: string } <- { name: b.name, path: b.path, type_str: b.type_str };
    r
}

fn copy_node(n: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } {
    r: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- { kind: n.kind, value: n.value, name: n.name, location: copy_loc(n.location), inner: n.inner, right_expr: n.right_expr, pattern_bindings: copy_pbs(n.pattern_bindings), sequence_effects: copy_effs(n.sequence_effects) };
    r
}

fn copy_decl(d: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } {
    r: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- { tag: d.tag, name: d.name, parameters: copy_params(d.parameters), return_type_name: d.return_type_name, return_type_location: copy_loc(d.return_type_location), location: copy_loc(d.location), body: { nodes: copy_nodes(d.body.nodes), root: d.body.root }, declared_effects: copy_effs(d.declared_effects) };
    r
}

fn copy_params(xs: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    copy_params_rev(copy_params_rev(xs, empty_copy_params()), empty_copy_params())
}

fn empty_copy_params() -> List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- empty[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]()
    produces
        pure r
    end
}

fn copy_params_rev(xs: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], acc: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case xs.is_nil of {
        true -> acc;
        false -> copy_params_rev(xs.tail, copy_params_cons(copy_param(xs.head), acc))
    }
}

fn copy_params_cons(x: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, acc: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- prepend[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)](x, acc)
    produces
        pure r
    end
}

fn copy_effs(xs: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    copy_effs_rev(copy_effs_rev(xs, empty_copy_effs()), empty_copy_effs())
}

fn empty_copy_effs() -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- empty[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]()
    produces
        pure r
    end
}

fn copy_effs_rev(xs: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], acc: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case xs.is_nil of {
        true -> acc;
        false -> copy_effs_rev(xs.tail, copy_effs_cons(copy_eff(xs.head), acc))
    }
}

fn copy_effs_cons(x: { name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, acc: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- prepend[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)](x, acc)
    produces
        pure r
    end
}

fn copy_pbs(xs: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    copy_pbs_rev(copy_pbs_rev(xs, empty_copy_pbs()), empty_copy_pbs())
}

fn empty_copy_pbs() -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[{ name: string, path: string, type_str: string }, mem(normal)] <- empty[{ name: string, path: string, type_str: string }, mem(normal)]()
    produces
        pure r
    end
}

fn copy_pbs_rev(xs: List[{ name: string, path: string, type_str: string }, mem(normal)], acc: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    case xs.is_nil of {
        true -> acc;
        false -> copy_pbs_rev(xs.tail, copy_pbs_cons(copy_pb(xs.head), acc))
    }
}

fn copy_pbs_cons(x: { name: string, path: string, type_str: string }, acc: List[{ name: string, path: string, type_str: string }, mem(normal)]) -> List[{ name: string, path: string, type_str: string }, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[{ name: string, path: string, type_str: string }, mem(normal)] <- prepend[{ name: string, path: string, type_str: string }, mem(normal)](x, acc)
    produces
        pure r
    end
}

fn copy_nodes(xs: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] {
    copy_nodes_rev(copy_nodes_rev(xs, empty_copy_nodes()), empty_copy_nodes())
}

fn empty_copy_nodes() -> List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- empty[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]()
    produces
        pure r
    end
}

fn copy_nodes_rev(xs: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], acc: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] {
    case xs.is_nil of {
        true -> acc;
        false -> copy_nodes_rev(xs.tail, copy_nodes_cons(copy_node(xs.head), acc))
    }
}

fn copy_nodes_cons(x: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, acc: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] {
    sequence proc[mem(normal)]
        r: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- prepend[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)](x, acc)
    produces
        pure r
    end
}

fn copy_decls(xs: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] {
    copy_decls_rev(copy_decls_rev(xs, empty_copy_decls()), empty_copy_decls())
}

