// Capability: sequence ... produces pure expression end
// Grammar: sequence [proc[effect_list]] {statement} produces pure expression end
// Minimal: sequence produces pure 42 end (no statements, no proc)

use lexer_core;
use lexer_token_kind;
use constraint_core;
use capability_fn_decl;

export constraints/0;
export initial_roles/1;

// Role codes for sequence block (70-74). Shared: role_left_brace 7, role_stmt_sep 55, role_bind_arrow 43, role_operand 12, role_op 13, role_call_lparen 15, role_call_rparen 16.
fn role_seq_sequence() -> int64 { 70 }
fn role_seq_produces() -> int64 { 71 }
fn role_seq_pure() -> int64 { 72 }
fn role_seq_result() -> int64 { 73 }
fn role_seq_end() -> int64 { 74 }
fn role_left_brace() -> int64 { 7 }
fn role_stmt_sep() -> int64 { 55 }
fn role_bind_arrow() -> int64 { 43 }
fn role_operand() -> int64 { 12 }
fn role_op() -> int64 { 13 }
fn role_call_lparen() -> int64 { 15 }
fn role_call_rparen() -> int64 { 16 }
fn role_call_name() -> int64 { 14 }

fn single_role(r: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn four_roles(r1: int64, r2: int64, r3: int64, r4: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, three_roles(r2, r3, r4))
}

fn five_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, four_roles(r2, r3, r4, r5))
}

fn six_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, five_roles(r2, r3, r4, r5, r6))
}

fn constraints() -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    // sequence keyword can follow left_brace, stmt_sep, or bind_arrow (sequence as first stmt, next stmt, or RHS of binding)
    c1: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_left_brace(), next_token_roles: single_role(role_seq_sequence()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 70 };
    c2: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_stmt_sep(), next_token_roles: single_role(role_seq_sequence()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 71 };
    c3: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_bind_arrow(), next_token_roles: single_role(role_seq_sequence()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 72 };
    // sequence -> produces (minimal) or proc (sequence proc[ε])
    c4: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_seq_sequence(), next_token_roles: two_roles(role_seq_produces(), capability_fn_decl@role_proc_keyword()), prev_token_roles: three_roles(role_left_brace(), role_stmt_sep(), role_bind_arrow()), constraint_id: 73 };
    // produces -> pure. Prev includes a binding RHS (operand / call_rparen /
    // seq_result) because newlines are lexer whitespace, not tokens: `<- 7 produces`
    // is adjacent. Without that, propagate empties the literal's roles and
    // slot_role(.head) faults.
    c5: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_seq_produces(), next_token_roles: single_role(role_seq_pure()), prev_token_roles: six_roles(role_seq_sequence(), capability_fn_decl@role_right_bracket(), role_operand(), role_call_rparen(), role_seq_result(), role_stmt_sep()), constraint_id: 74 };
    // pure -> result expr (seq_result, operand, or call_name for f(args))
    c6: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_seq_pure(), next_token_roles: three_roles(role_seq_result(), role_operand(), role_call_name()), prev_token_roles: single_role(role_seq_produces()), constraint_id: 75 };
    // seq_result (single-token expr) -> end
    c7: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_seq_result(), next_token_roles: single_role(role_seq_end()), prev_token_roles: single_role(role_seq_pure()), constraint_id: 76 };
    // seq_result can start compound expr: seq_result -> op or call_lparen
    c8: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_seq_result(), next_token_roles: two_roles(role_op(), role_call_lparen()), prev_token_roles: single_role(role_seq_pure()), constraint_id: 77 };
    // operand (last token of compound expr or single-token result) -> end; prev can be op, call_lparen, or seq_pure
    c9: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_operand(), next_token_roles: single_role(role_seq_end()), prev_token_roles: three_roles(role_op(), role_call_lparen(), role_seq_pure()), constraint_id: 78 };
    // op can follow seq_result (first operand of binary expr)
    c10: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_op(), next_token_roles: single_role(role_operand()), prev_token_roles: single_role(role_seq_result()), constraint_id: 79 };
    // call_lparen can follow seq_result or call_name (call as result expr)
    c11: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_call_lparen(), next_token_roles: single_role(role_operand()), prev_token_roles: two_roles(role_seq_result(), role_call_name()), constraint_id: 80 };
    // call_name can follow seq_pure (e.g. sequence produces pure f(42) end)
    c11b: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_call_name(), next_token_roles: single_role(role_call_lparen()), prev_token_roles: single_role(role_seq_pure()), constraint_id: 83 };
    // call_rparen can be followed by seq_end or produces (`<- go() produces`)
    c11c: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_call_rparen(), next_token_roles: two_roles(role_seq_end(), role_seq_produces()), prev_token_roles: single_role(role_operand()), constraint_id: 84 };
    // operand can follow seq_pure (first token of result when it's operand, e.g. ( expr ) or call)
    c12: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_operand(), next_token_roles: two_roles(role_op(), role_call_rparen()), prev_token_roles: single_role(role_seq_pure()), constraint_id: 81 };
    // seq_end -> nothing (end of sequence); prev can be seq_result, operand, or call_rparen (e.g. f(42) end)
    c13: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_seq_end(), next_token_roles: constraint_core@empty_list_int(), prev_token_roles: three_roles(role_seq_result(), role_operand(), role_call_rparen()), constraint_id: 82 };
    c14: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_operand(), next_token_roles: single_role(role_seq_produces()), prev_token_roles: two_roles(role_bind_arrow(), role_stmt_sep()), constraint_id: 87 };
    c15: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_call_rparen(), next_token_roles: single_role(role_seq_produces()), prev_token_roles: single_role(role_operand()), constraint_id: 88 };
    c16: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_seq_result(), next_token_roles: single_role(role_seq_produces()), prev_token_roles: two_roles(role_bind_arrow(), role_stmt_sep()), constraint_id: 89 };
    r13: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c13, constraint_core@empty_list_constraint());
    r16: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c16, r13);
    r15: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c15, r16);
    r14: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c14, r15);
    r12: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c12, r14);
    r11c: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c11c, r12);
    r11b: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c11b, r11c);
    r11: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c11, r11b);
    r10: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c10, r11);
    r9: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c9, r10);
    r8: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c8, r9);
    r7: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c7, r8);
    r6: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c6, r7);
    // right_bracket (after proc[ε] in sequence) -> seq_produces
    c4b: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: capability_fn_decl@role_right_bracket(), next_token_roles: single_role(role_seq_produces()), prev_token_roles: two_roles(capability_fn_decl@role_effect_name(), capability_fn_decl@role_effect_param_rparen()), constraint_id: 85 };
    // proc_keyword can follow seq_sequence (sequence proc[ε])
    c4c: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: capability_fn_decl@role_proc_keyword(), next_token_roles: single_role(capability_fn_decl@role_left_bracket()), prev_token_roles: single_role(role_seq_sequence()), constraint_id: 86 };
    r5: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c5, r6);
    r4c: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c4c, constraint_core@cons_constraint(c4b, constraint_core@cons_constraint(c4, r5)));
    r3: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c3, r4c);
    r2: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c2, r3);
    constraint_core@cons_constraint(c1, r2)
}

fn initial_roles(token_kind: int64) -> List[int64, mem(normal)] {
        case token_kind == lexer_token_kind@token_kind_sequence_keyword() of {
        true -> single_role(role_seq_sequence());
        false -> case token_kind == lexer_token_kind@token_kind_produces_keyword() of {
            true -> single_role(role_seq_produces());
            false -> case token_kind == lexer_token_kind@token_kind_pure_keyword() of {
                true -> single_role(role_seq_pure());
                false -> case token_kind == lexer_token_kind@token_kind_end_keyword() of {
                    true -> single_role(role_seq_end());
                    false -> case token_kind == lexer_token_kind@token_kind_integer_literal() of {
                        true -> single_role(role_seq_result());
                        false -> case lexer_token_kind@is_identifier_lexeme_token(token_kind) of {
                            true -> single_role(role_seq_result());
                            false -> case token_kind == lexer_token_kind@token_kind_atom_literal() of {
                                true -> single_role(role_seq_result());
                                false -> case token_kind == lexer_token_kind@token_kind_float_literal() of {
                                    true -> single_role(role_seq_result());
                                    false -> case token_kind == lexer_token_kind@token_kind_string_literal() of {
                                        true -> single_role(role_seq_result());
                                        false -> case token_kind == lexer_token_kind@token_kind_true_literal() of {
                                            true -> single_role(role_seq_result());
                                            false -> case token_kind == lexer_token_kind@token_kind_false_literal() of {
                                                true -> single_role(role_seq_result());
                                                false -> case token_kind == lexer_token_kind@token_kind_left_paren() of {
                                                    true -> single_role(role_seq_result());
                                                    false -> constraint_core@empty_list_int()
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
