// Capability: case expression — case expr of { branches }
// Grammar (spec): case_expression ::= "case" expression "of" "{" {case_branch} "}"
// case_branch ::= pattern ["if" expression] "->" expression ";"
// Roles 110–125: case surface + pattern + RHS duplicate chain (avoids merging operand 12 with case_rhs_operand 120)

use lexer_core;
use lexer_token_kind;
use constraint_core;
use capability_list;

export constraints/0;
export initial_roles/1;
export role_case_keyword/0;
export role_case_of/0;
export role_case_branch_arrow/0;
export role_case_pat_int/0;
export role_case_pat_ident/0;
export role_case_pat_colon/0;
export role_case_pat_type/0;
export role_case_guard_if/0;
export role_case_pat_bool/0;
export role_case_pat_atom/0;
export role_case_branch_stmt_sep/0;
export role_case_rhs_operand/0;
export role_case_rhs_op/0;
export role_case_rhs_call_name/0;
export role_case_rhs_lparen/0;
export role_case_rhs_rparen/0;
export role_case_rhs_unary_minus/0;
export role_case_branch_lbrace/0;

fn role_case_keyword() -> int64 { 110 }
fn role_case_of() -> int64 { 111 }
fn role_case_branch_arrow() -> int64 { 112 }
fn role_case_pat_int() -> int64 { 113 }
fn role_case_pat_ident() -> int64 { 114 }
fn role_case_pat_colon() -> int64 { 115 }
fn role_case_pat_type() -> int64 { 116 }
fn role_case_guard_if() -> int64 { 117 }
fn role_case_pat_bool() -> int64 { 118 }
// Atom pattern (`:normal`, `:language_error`, …) for failure_reason / ingress matching (§15.4.11.2).
fn role_case_pat_atom() -> int64 { 127 }
fn role_case_branch_stmt_sep() -> int64 { 119 }
fn role_case_rhs_operand() -> int64 { 120 }
fn role_case_rhs_op() -> int64 { 121 }
fn role_case_rhs_call_name() -> int64 { 122 }
fn role_case_rhs_lparen() -> int64 { 123 }
fn role_case_rhs_rparen() -> int64 { 124 }
fn role_case_rhs_unary_minus() -> int64 { 125 }
fn role_case_branch_lbrace() -> int64 { 126 }
fn role_case_rhs_bnot_prefix() -> int64 { 129 }
// Same numeric role as capability_expr_int64_ops.role_qual_module_name — case_keyword/c_arr must allow mod@fn in scrutinee and after ->.
fn role_qual_module_name() -> int64 { 233 }

fn role_left_brace() -> int64 { 7 }
fn role_right_brace() -> int64 { 8 }
fn role_operand() -> int64 { 12 }
fn role_op() -> int64 { 13 }
fn role_call_name() -> int64 { 14 }
fn role_call_lparen() -> int64 { 15 }
fn role_call_rparen() -> int64 { 16 }
fn role_right_arrow() -> int64 { 5 }

fn single_role(r: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn four_roles(r1: int64, r2: int64, r3: int64, r4: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, three_roles(r2, r3, r4))
}

fn five_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, four_roles(r2, r3, r4, r5))
}

fn six_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, five_roles(r2, r3, r4, r5, r6))
}

fn seven_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64, r7: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, six_roles(r2, r3, r4, r5, r6, r7))
}

fn eight_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64, r7: int64, r8: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, seven_roles(r2, r3, r4, r5, r6, r7, r8))
}

fn nine_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64, r7: int64, rest: { r8: int64, r9: int64 }) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, eight_roles(r2, r3, r4, r5, r6, r7, rest.r8, rest.r9))
}

fn ten_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64, r7: int64, rest: { r8: int64, r9: int64, r10: int64 }) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, nine_roles(r2, r3, r4, r5, r6, r7, rest.r8, { r8: rest.r9, r9: rest.r10 }))
}

fn eleven_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64, r7: int64, rest: { r8: int64, r9: int64, r10: int64, r11: int64 }) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, ten_roles(r2, r3, r4, r5, r6, r7, rest.r8, { r8: rest.r9, r9: rest.r10, r10: rest.r11 }))
}

// Must match capability_tuple_decompose role_td_rparen (53).
fn role_td_rparen() -> int64 { 53 }

fn case_rhs_operand_next() -> List[int64, mem(normal)] {
    constraint_core@cons_int(role_case_rhs_op(), four_roles(role_right_brace(), role_case_rhs_rparen(), role_case_branch_stmt_sep(), role_case_branch_arrow()))
}

fn case_rhs_operand_prev() -> List[int64, mem(normal)] {
    five_roles(role_case_rhs_op(), role_case_rhs_lparen(), role_case_branch_arrow(), role_case_rhs_unary_minus(), role_case_rhs_bnot_prefix())
}

fn is_type_keyword(token_kind: int64) -> boolean {
    token_kind == lexer_token_kind@token_kind_int8_keyword() or token_kind == lexer_token_kind@token_kind_int16_keyword() or token_kind == lexer_token_kind@token_kind_int32_keyword() or token_kind == lexer_token_kind@token_kind_int64_keyword() or token_kind == lexer_token_kind@token_kind_uint8_keyword() or token_kind == lexer_token_kind@token_kind_uint16_keyword() or token_kind == lexer_token_kind@token_kind_uint32_keyword() or token_kind == lexer_token_kind@token_kind_uint64_keyword() or token_kind == lexer_token_kind@token_kind_float16_keyword() or token_kind == lexer_token_kind@token_kind_float32_keyword() or token_kind == lexer_token_kind@token_kind_float64_keyword() or token_kind == lexer_token_kind@token_kind_bool_keyword() or token_kind == lexer_token_kind@token_kind_char_keyword() or token_kind == lexer_token_kind@token_kind_string_keyword() or token_kind == lexer_token_kind@token_kind_bytes_keyword() or token_kind == lexer_token_kind@token_kind_unit_keyword() or token_kind == lexer_token_kind@token_kind_atom_keyword() or token_kind == lexer_token_kind@token_kind_list_keyword() or token_kind == lexer_token_kind@token_kind_failure_reason_keyword()
}

fn is_arithmetic_op(token_kind: int64) -> boolean {
    token_kind == lexer_token_kind@token_kind_plus() or token_kind == lexer_token_kind@token_kind_minus() or token_kind == lexer_token_kind@token_kind_star() or token_kind == lexer_token_kind@token_kind_slash() or token_kind == lexer_token_kind@token_kind_percent()
}

fn is_comparison_op(token_kind: int64) -> boolean {
    token_kind == lexer_token_kind@token_kind_less_than() or token_kind == lexer_token_kind@token_kind_greater_than() or token_kind == lexer_token_kind@token_kind_less_equal() or token_kind == lexer_token_kind@token_kind_greater_equal() or token_kind == lexer_token_kind@token_kind_equal_equal() or token_kind == lexer_token_kind@token_kind_bang_equal()
}

fn is_op_token(token_kind: int64) -> boolean {
    is_arithmetic_op(token_kind) or is_comparison_op(token_kind) or token_kind == lexer_token_kind@token_kind_and_keyword() or token_kind == lexer_token_kind@token_kind_or_keyword() or token_kind == lexer_token_kind@token_kind_bor_keyword() or token_kind == lexer_token_kind@token_kind_band_keyword() or token_kind == lexer_token_kind@token_kind_shl_keyword() or token_kind == lexer_token_kind@token_kind_shr_keyword()
}

fn constraints() -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    // case_keyword -> scrutinee starters (same as body after {); include module qualifier for case mod@f(...) of { ... }
    c_kw: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_keyword(), next_token_roles: six_roles(role_operand(), role_call_name(), role_qual_module_name(), role_op(), role_call_lparen(), role_call_rparen()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 110 };
    // of -> case_branch_lbrace (distinct from fn body left_brace)
    c_of: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_of(), next_token_roles: single_role(role_case_branch_lbrace()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 111 };
    // { after of -> pattern start or empty (50 = role_td_lparen for `(:explicit, r)` tuple patterns)
    c_lb_case: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_branch_lbrace(), next_token_roles: seven_roles(role_case_pat_int(), role_case_pat_ident(), role_case_pat_bool(), role_case_pat_atom(), role_right_brace(), capability_list@role_case_pat_list_lbracket(), 50), prev_token_roles: single_role(role_case_of()), constraint_id: 112 };
    // pattern int / bool / atom -> ->
    c_pi: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_pat_int(), next_token_roles: single_role(role_case_branch_arrow()), prev_token_roles: two_roles(role_case_branch_lbrace(), role_case_branch_stmt_sep()), constraint_id: 113 };
    c_pb: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_pat_bool(), next_token_roles: single_role(role_case_branch_arrow()), prev_token_roles: two_roles(role_case_branch_lbrace(), role_case_branch_stmt_sep()), constraint_id: 114 };
    c_patom: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_pat_atom(), next_token_roles: single_role(role_case_branch_arrow()), prev_token_roles: two_roles(role_case_branch_lbrace(), role_case_branch_stmt_sep()), constraint_id: 128 };
    // ident pattern -> : or ->
    c_pid: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_pat_ident(), next_token_roles: two_roles(role_case_pat_colon(), role_case_branch_arrow()), prev_token_roles: two_roles(role_case_branch_lbrace(), role_case_branch_stmt_sep()), constraint_id: 115 };
    c_pcol: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_pat_colon(), next_token_roles: two_roles(role_case_pat_type(), capability_list@role_list_type_kw()), prev_token_roles: two_roles(role_case_pat_ident(), capability_list@role_case_pat_list_empty_rbracket()), constraint_id: 116 };
    c_pt: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_pat_type(), next_token_roles: three_roles(role_case_branch_arrow(), role_case_guard_if(), capability_list@role_case_pat_list_comma()), prev_token_roles: single_role(role_case_pat_colon()), constraint_id: 117 };
    c_gif: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_guard_if(), next_token_roles: single_role(role_operand()), prev_token_roles: single_role(role_case_pat_type()), constraint_id: 118 };
    // branch arrow -> case rhs (not plain operand 12 — separate case_rhs chain)
    // prev includes case_rhs_rparen / case_rhs_operand so guard exprs can end with `)` or a literal/identifier before `->` (e.g. `if is_positive(z) ->`, `if true ->` in guard position)
    c_arr: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_branch_arrow(), next_token_roles: six_roles(role_case_rhs_operand(), role_case_rhs_call_name(), role_case_rhs_lparen(), role_case_rhs_unary_minus(), role_qual_module_name(), role_case_rhs_bnot_prefix()), prev_token_roles: eleven_roles(role_case_pat_int(), role_case_pat_bool(), role_case_pat_atom(), role_case_pat_type(), role_call_rparen(), role_td_rparen(), role_operand(), { r8: role_case_rhs_rparen(), r9: role_case_rhs_operand(), r10: capability_list@role_list_type_rbracket(), r11: capability_list@role_case_pat_list_tail_rbracket() }), constraint_id: 119 };
    // case rhs chain (parallel to int64_ops)
    c_r0: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_rhs_operand(), next_token_roles: case_rhs_operand_next(), prev_token_roles: case_rhs_operand_prev(), constraint_id: 120 };
    c_r1: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_rhs_op(), next_token_roles: two_roles(role_case_rhs_operand(), role_case_rhs_bnot_prefix()), prev_token_roles: single_role(role_case_rhs_operand()), constraint_id: 121 };
    c_r2: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_rhs_call_name(), next_token_roles: single_role(role_case_rhs_lparen()), prev_token_roles: two_roles(role_case_branch_arrow(), role_case_rhs_lparen()), constraint_id: 122 };
    c_r3: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_rhs_lparen(), next_token_roles: two_roles(role_case_rhs_operand(), role_case_rhs_bnot_prefix()), prev_token_roles: single_role(role_case_rhs_call_name()), constraint_id: 123 };
    c_r4: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_rhs_rparen(), next_token_roles: three_roles(role_right_brace(), role_case_branch_stmt_sep(), role_case_branch_arrow()), prev_token_roles: single_role(role_case_rhs_operand()), constraint_id: 124 };
    c_r5: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_rhs_unary_minus(), next_token_roles: single_role(role_case_rhs_operand()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 125 };
    c_bnot: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_rhs_bnot_prefix(), next_token_roles: single_role(role_case_rhs_operand()), prev_token_roles: three_roles(role_case_branch_arrow(), role_case_rhs_op(), role_case_rhs_lparen()), constraint_id: 129 };
    // ; after branch rhs
    c_ss: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_case_branch_stmt_sep(), next_token_roles: seven_roles(role_case_pat_int(), role_case_pat_ident(), role_case_pat_bool(), role_case_pat_atom(), role_right_brace(), capability_list@role_case_pat_list_lbracket(), 50), prev_token_roles: single_role(role_case_rhs_operand()), constraint_id: 126 };
    // } closes case block after rhs or ; or empty (prev case_branch_lbrace)
    c_rb: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_right_brace(), next_token_roles: constraint_core@empty_list_int(), prev_token_roles: three_roles(role_case_rhs_operand(), role_case_branch_stmt_sep(), role_case_branch_lbrace()), constraint_id: 127 };
    r_ss: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c_ss, constraint_core@cons_constraint(c_rb, constraint_core@empty_list_constraint()));
    r_r: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c_bnot, constraint_core@cons_constraint(c_r5, constraint_core@cons_constraint(c_r4, r_ss)));
    r_rchain: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c_r0, constraint_core@cons_constraint(c_r1, constraint_core@cons_constraint(c_r2, constraint_core@cons_constraint(c_r3, r_r))));
    r_pat: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c_pi, constraint_core@cons_constraint(c_pb, constraint_core@cons_constraint(c_patom, constraint_core@cons_constraint(c_pid, constraint_core@cons_constraint(c_pcol, constraint_core@cons_constraint(c_pt, constraint_core@cons_constraint(c_gif, constraint_core@cons_constraint(c_arr, r_rchain))))))));
    constraint_core@cons_constraint(c_kw, constraint_core@cons_constraint(c_of, constraint_core@cons_constraint(c_lb_case, r_pat)))
}

fn initial_roles(token_kind: int64) -> List[int64, mem(normal)] {
        case token_kind == lexer_token_kind@token_kind_case_keyword() of {
        true -> single_role(role_case_keyword());
        false -> case token_kind == lexer_token_kind@token_kind_of_keyword() of {
            true -> single_role(role_case_of());
            false -> case token_kind == lexer_token_kind@token_kind_right_arrow() of {
                true -> two_roles(role_right_arrow(), role_case_branch_arrow());
                false -> case token_kind == lexer_token_kind@token_kind_if_keyword() of {
                    true -> single_role(role_case_guard_if());
                    false -> case token_kind == lexer_token_kind@token_kind_integer_literal() of {
                        true -> two_roles(role_case_pat_int(), role_case_rhs_operand());
                        false -> case token_kind == lexer_token_kind@token_kind_float_literal() of {
                            true -> single_role(role_case_rhs_operand());
                            false -> case token_kind == lexer_token_kind@token_kind_true_literal() of {
                                true -> two_roles(role_case_pat_bool(), role_case_rhs_operand());
                                false -> case token_kind == lexer_token_kind@token_kind_false_literal() of {
                                    true -> two_roles(role_case_pat_bool(), role_case_rhs_operand());
                                    false -> case token_kind == lexer_token_kind@token_kind_atom_literal() of {
                                        true -> two_roles(role_case_pat_atom(), role_case_rhs_operand());
                                        false -> case token_kind == lexer_token_kind@token_kind_semicolon() of {
                                            true -> single_role(role_case_branch_stmt_sep());
                                            false -> case lexer_token_kind@is_identifier_lexeme_token(token_kind) of {
                                                true -> three_roles(role_case_pat_ident(), role_case_rhs_call_name(), role_case_rhs_operand());
                                                false -> case token_kind == lexer_token_kind@token_kind_bnot_keyword() or token_kind == lexer_token_kind@token_kind_not_keyword() of {
                                                    true -> single_role(role_case_rhs_bnot_prefix());
                                                    false -> case is_op_token(token_kind) of {
                                                    true -> two_roles(role_op(), role_case_rhs_op());
                                                    false -> case token_kind == lexer_token_kind@token_kind_left_brace() of {
                                                        true -> two_roles(role_left_brace(), role_case_branch_lbrace());
                                                        false -> case token_kind == lexer_token_kind@token_kind_left_bracket() of {
                                                            true -> single_role(capability_list@role_case_pat_list_lbracket());
                                                            false -> case token_kind == lexer_token_kind@token_kind_left_paren() of {
                                                                true -> two_roles(role_call_lparen(), role_case_rhs_lparen());
                                                                false -> case token_kind == lexer_token_kind@token_kind_right_paren() of {
                                                                    true -> two_roles(role_call_rparen(), role_case_rhs_rparen());
                                                                    false -> case token_kind == lexer_token_kind@token_kind_minus() of {
                                                                        true -> two_roles(role_op(), role_case_rhs_unary_minus());
                                                                        false -> case is_type_keyword(token_kind) of {
                                                                            true -> single_role(role_case_pat_type());
                                                                            false -> constraint_core@empty_list_int()
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
