// Capability: integer literal, identifier as expression
// Minimal: fn main(){ 42 } - body is integer literal or identifier

use lexer_core;
use lexer_token_kind;
use constraint_core;

export constraints/0;
export initial_roles/1;

// Role codes: 9 body_expr (shared), 10 integer_literal, 11 identifier, 12 float_literal, 19 string_literal
// 7 left_brace from fn_decl (prev for body context), 55 stmt_sep from tuple_decompose
fn role_body_expr() -> int64 { 9 }
fn role_integer_literal() -> int64 { 10 }
fn role_identifier() -> int64 { 11 }
fn role_float_literal() -> int64 { 12 }
fn role_string_literal() -> int64 { 19 }
fn role_left_brace() -> int64 { 7 }
fn role_right_brace() -> int64 { 8 }
fn role_stmt_sep() -> int64 { 55 }

fn single_role(r: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, single_role(r2))
}

fn constraints() -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    // integer_literal (as body_expr) -> next must be right_brace; prev must be left_brace or stmt_sep
    // float_literal (as body_expr) -> next must be right_brace; prev must be left_brace or stmt_sep
    // identifier (as body_expr) -> next must be right_brace; prev must be left_brace or stmt_sep
    c1: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_integer_literal(), next_token_roles: single_role(role_right_brace()), prev_token_roles: two_roles(role_left_brace(), role_stmt_sep()), constraint_id: 10 };
    c1f: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_float_literal(), next_token_roles: single_role(role_right_brace()), prev_token_roles: two_roles(role_left_brace(), role_stmt_sep()), constraint_id: 12 };
    c2: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_identifier(), next_token_roles: single_role(role_right_brace()), prev_token_roles: two_roles(role_left_brace(), role_stmt_sep()), constraint_id: 11 };
    c1s: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_string_literal(), next_token_roles: single_role(role_right_brace()), prev_token_roles: two_roles(role_left_brace(), role_stmt_sep()), constraint_id: 19 };
    constraint_core@cons_constraint(c1, constraint_core@cons_constraint(c1f, constraint_core@cons_constraint(c2, constraint_core@cons_constraint(c1s, constraint_core@empty_list_constraint()))))
}

fn initial_roles(token_kind: int64) -> List[int64, mem(normal)] {
        case token_kind == lexer_token_kind@token_kind_integer_literal() of {
        true -> two_roles(role_integer_literal(), role_body_expr());
        false -> case token_kind == lexer_token_kind@token_kind_float_literal() of {
            true -> two_roles(role_float_literal(), role_body_expr());
            false -> case lexer_token_kind@is_identifier_lexeme_token(token_kind) of {
                true -> single_role(role_body_expr());
                false -> case token_kind == lexer_token_kind@token_kind_string_literal() of {
                    true -> two_roles(role_string_literal(), role_body_expr());
                    false -> constraint_core@empty_list_int()
                }
            }
        }
    }
}
