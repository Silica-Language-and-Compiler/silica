// Capability: float32 operators, print_float32, concat/2
// Arithmetic: +, -, *, /, % (same tokens as float64)
// Function call: print_float32(expr), concat(string, string)
// Unary negate_float32(expr): token kind negate_float32_keyword; callable like other identifier-lexeme names (lexer_token_kind.is_identifier_lexeme_token)
// Float32 type keyword handled in constraint_extract, capability_fn_decl, capability_bind

use lexer_core;
use lexer_token_kind;
use constraint_core;

export constraints/0;
export initial_roles/1;

// Role codes: reuse 12-16 (same as int64_ops - operand, call, operators), 17 for comma
fn role_operand() -> int64 { 12 }
fn role_op() -> int64 { 13 }
fn role_call_name() -> int64 { 14 }
fn role_call_lparen() -> int64 { 15 }
fn role_call_rparen() -> int64 { 16 }
fn role_comma() -> int64 { 17 }
fn role_left_brace() -> int64 { 7 }
fn role_right_brace() -> int64 { 8 }

fn single_role(r: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn four_roles(r1: int64, r2: int64, r3: int64, r4: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, three_roles(r2, r3, r4))
}

fn operand_next() -> List[int64, mem(normal)] {
    four_roles(role_op(), role_right_brace(), role_call_rparen(), role_comma())
}

fn operand_prev() -> List[int64, mem(normal)] {
    four_roles(role_left_brace(), role_op(), role_call_lparen(), role_comma())
}

fn constraints() -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    // Same constraint pattern as float64: operand, call, operators; plus comma for two-arg calls (concat)
    c1: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_left_brace(), next_token_roles: two_roles(role_operand(), role_call_name()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 27 };
    c2: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_right_brace(), next_token_roles: constraint_core@empty_list_int(), prev_token_roles: two_roles(role_operand(), role_call_rparen()), constraint_id: 28 };
    c3: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_operand(), next_token_roles: operand_next(), prev_token_roles: operand_prev(), constraint_id: 29 };
    c4: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_op(), next_token_roles: single_role(role_operand()), prev_token_roles: single_role(role_operand()), constraint_id: 30 };
    c5: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_call_name(), next_token_roles: single_role(role_call_lparen()), prev_token_roles: two_roles(role_left_brace(), role_comma()), constraint_id: 31 };
    c6: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_call_lparen(), next_token_roles: single_role(role_operand()), prev_token_roles: single_role(role_call_name()), constraint_id: 32 };
    c7: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_call_rparen(), next_token_roles: single_role(role_right_brace()), prev_token_roles: single_role(role_operand()), constraint_id: 33 };
    // After comma: next token may start a nested call (call_name) or an operand (see int64_ops c5 prev_token_roles including role_comma for call_name).
    c8: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_comma(), next_token_roles: two_roles(role_call_name(), role_operand()), prev_token_roles: single_role(role_operand()), constraint_id: 34 };
    constraint_core@cons_constraint(c1, constraint_core@cons_constraint(c2, constraint_core@cons_constraint(c3, constraint_core@cons_constraint(c4, constraint_core@cons_constraint(c5, constraint_core@cons_constraint(c6, constraint_core@cons_constraint(c7, constraint_core@cons_constraint(c8, constraint_core@empty_list_constraint()))))))))
}

fn is_arithmetic_op(token_kind: int64) -> boolean {
    token_kind == lexer_token_kind@token_kind_plus() or token_kind == lexer_token_kind@token_kind_minus() or token_kind == lexer_token_kind@token_kind_star() or token_kind == lexer_token_kind@token_kind_slash() or token_kind == lexer_token_kind@token_kind_percent()
}

fn is_comparison_op(token_kind: int64) -> boolean {
    token_kind == lexer_token_kind@token_kind_less_than() or token_kind == lexer_token_kind@token_kind_greater_than() or token_kind == lexer_token_kind@token_kind_less_equal() or token_kind == lexer_token_kind@token_kind_greater_equal() or token_kind == lexer_token_kind@token_kind_equal_equal() or token_kind == lexer_token_kind@token_kind_bang_equal()
}

fn is_op_token(token_kind: int64) -> boolean {
    is_arithmetic_op(token_kind) or is_comparison_op(token_kind) or token_kind == lexer_token_kind@token_kind_and_keyword() or token_kind == lexer_token_kind@token_kind_or_keyword()
}

fn initial_roles(token_kind: int64) -> List[int64, mem(normal)] {
        case token_kind == lexer_token_kind@token_kind_integer_literal() of {
        true -> single_role(role_operand());
        false -> case token_kind == lexer_token_kind@token_kind_float_literal() of {
            true -> single_role(role_operand());
            false -> case token_kind == lexer_token_kind@token_kind_true_literal() of {
                true -> single_role(role_operand());
                false -> case token_kind == lexer_token_kind@token_kind_false_literal() of {
                    true -> single_role(role_operand());
                    false -> case token_kind == lexer_token_kind@token_kind_and_keyword() of {
                        true -> single_role(role_op());
                        false -> case token_kind == lexer_token_kind@token_kind_or_keyword() of {
                            true -> single_role(role_op());
                            false -> case token_kind == lexer_token_kind@token_kind_string_literal() of {
                                true -> single_role(role_operand());
                                false -> case lexer_token_kind@is_identifier_lexeme_token(token_kind) of {
                                    true -> two_roles(role_call_name(), role_operand());
                                    false -> case is_op_token(token_kind) of {
                                        true -> single_role(role_op());
                                        false -> case token_kind == lexer_token_kind@token_kind_left_paren() of {
                                            true -> two_roles(role_call_lparen(), role_operand());
                                            false -> case token_kind == lexer_token_kind@token_kind_right_paren() of {
                                                true -> two_roles(role_call_rparen(), role_operand());
                                                false -> case token_kind == lexer_token_kind@token_kind_comma() of {
                                                    true -> single_role(role_comma());
                                                    false -> constraint_core@empty_list_int()
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
