// Capability: FFI wrapper surface syntax (silica_ffi_wrapper_specification.md §3.2)
// wrapper_meta "path";
// foreign c_wrapper "sym" [meta "path"] fn name(...) -> Type;

use lexer_core;
use lexer_token_kind;
use constraint_core;
use capability_fn_decl;

export constraints/0;
export initial_roles/1;

fn role_wrapper_meta_kw() -> int64 { 255 }
fn role_wrapper_meta_string() -> int64 { 256 }
fn role_wrapper_meta_semi() -> int64 { 257 }
fn role_foreign_kw() -> int64 { 258 }
fn role_c_wrapper_kw() -> int64 { 259 }
fn role_foreign_symbol() -> int64 { 260 }
fn role_foreign_meta_kw() -> int64 { 261 }
fn role_foreign_meta_path() -> int64 { 262 }

fn single_role(r: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn no_prev() -> List[int64, mem(normal)] {
    constraint_core@empty_list_int()
}

fn constraints() -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    wm1: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_wrapper_meta_kw(), next_token_roles: single_role(role_wrapper_meta_string()), prev_token_roles: no_prev(), constraint_id: 255 };
    wm2: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_wrapper_meta_string(), next_token_roles: single_role(role_wrapper_meta_semi()), prev_token_roles: single_role(role_wrapper_meta_kw()), constraint_id: 256 };
    wm3: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_wrapper_meta_semi(), next_token_roles: no_prev(), prev_token_roles: single_role(role_wrapper_meta_string()), constraint_id: 257 };
    f1: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_foreign_kw(), next_token_roles: single_role(role_c_wrapper_kw()), prev_token_roles: no_prev(), constraint_id: 258 };
    f2: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_c_wrapper_kw(), next_token_roles: single_role(role_foreign_symbol()), prev_token_roles: single_role(role_foreign_kw()), constraint_id: 259 };
    f3: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_foreign_symbol(), next_token_roles: two_roles(capability_fn_decl@role_fn_keyword(), role_foreign_meta_kw()), prev_token_roles: single_role(role_c_wrapper_kw()), constraint_id: 260 };
    f4: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_foreign_meta_kw(), next_token_roles: single_role(role_foreign_meta_path()), prev_token_roles: single_role(role_foreign_symbol()), constraint_id: 261 };
    f5: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_foreign_meta_path(), next_token_roles: single_role(capability_fn_decl@role_fn_keyword()), prev_token_roles: single_role(role_foreign_meta_kw()), constraint_id: 262 };
    f6: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: capability_fn_decl@role_fn_keyword(), next_token_roles: single_role(capability_fn_decl@role_fn_name()), prev_token_roles: two_roles(role_foreign_symbol(), role_foreign_meta_path()), constraint_id: 263 };
    tail_f6: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(f6, constraint_core@empty_list_constraint());
    tail_f5: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(f5, tail_f6);
    tail_f4: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(f4, tail_f5);
    tail_f3: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(f3, tail_f4);
    tail_f2: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(f2, tail_f3);
    tail_f1: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(f1, tail_f2);
    tail_wm3: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(wm3, tail_f1);
    tail_wm2: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(wm2, tail_wm3);
    constraint_core@cons_constraint(wm1, tail_wm2)
}

fn initial_roles(token_kind: int64) -> List[int64, mem(normal)] {
        case token_kind == lexer_token_kind@token_kind_wrapper_meta_keyword() of {
        true -> single_role(role_wrapper_meta_kw());
        false -> case token_kind == lexer_token_kind@token_kind_foreign_keyword() of {
            true -> single_role(role_foreign_kw());
            false -> case token_kind == lexer_token_kind@token_kind_c_wrapper_keyword() of {
                true -> single_role(role_c_wrapper_kw());
                false -> case token_kind == lexer_token_kind@token_kind_meta_keyword() of {
                    true -> single_role(role_foreign_meta_kw());
                    false -> case token_kind == lexer_token_kind@token_kind_string_literal() of {
                        true -> three_roles(role_wrapper_meta_string(), role_foreign_symbol(), role_foreign_meta_path());
                        false -> case token_kind == lexer_token_kind@token_kind_semicolon() of {
                            true -> single_role(role_wrapper_meta_semi());
                            false -> constraint_core@empty_list_int()
                        }
                    }
                }
            }
        }
    }
}
