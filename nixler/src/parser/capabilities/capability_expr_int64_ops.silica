// Capability: int64/float64 operators, print_int64, print_float64, printString
// (print_float32 in capability_expr_float32)
// Arithmetic: +, -, *, /, %
// Comparison: <, >, <=, >=, ==, !=
// Function call: print_int64(expr), print_float64(expr), printString(string)
// Unary builtins: negate_<type>(expr) for int8–int64 and float16–float64 only (lexer kinds; see capability_expr_negate_builtin.silica)

use lexer_core;
use lexer_token_kind;
use constraint_core;
use capability_case;
use capability_list;

export constraints/0;
export initial_roles/1;

// Role codes (12-16, fn_decl uses 1-8, expr_literal uses 9-11)
// 233-234: module-qualified calls module@fn(args) (silica-specification §3.3.2)
fn role_operand() -> int64 { 12 }
fn role_op() -> int64 { 13 }
fn role_call_name() -> int64 { 14 }
fn role_call_lparen() -> int64 { 15 }
fn role_call_rparen() -> int64 { 16 }
fn role_qual_module_name() -> int64 { 233 }
fn role_qual_at_sign() -> int64 { 234 }
fn role_bnot_prefix() -> int64 { 235 }
// Matches capability_case.role_case_rhs_lparen (123); used only in qual_module prev set.
fn role_case_rhs_lparen_slot() -> int64 { 123 }
fn role_stmt_sep() -> int64 { 55 }
fn role_left_brace() -> int64 { 7 }
fn role_right_brace() -> int64 { 8 }
// Same code as capability_expr_float32.role_comma / comma in argument lists (spawn 3rd arg, etc.)
fn role_comma() -> int64 { 17 }

fn single_role(r: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, single_role(r2))
}

fn three_roles(r1: int64, r2: int64, r3: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, two_roles(r2, r3))
}

fn four_roles(r1: int64, r2: int64, r3: int64, r4: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, three_roles(r2, r3, r4))
}

fn five_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, four_roles(r2, r3, r4, r5))
}

fn six_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, five_roles(r2, r3, r4, r5, r6))
}

fn seven_roles(r1: int64, r2: int64, r3: int64, r4: int64, r5: int64, r6: int64, r7: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, six_roles(r2, r3, r4, r5, r6, r7))
}

fn operand_next() -> List[int64, mem(normal)] {
    constraint_core@cons_int(role_op(), five_roles(role_right_brace(), role_call_rparen(), role_stmt_sep(), capability_case@role_case_of(), capability_case@role_case_branch_arrow()))
}

fn operand_prev() -> List[int64, mem(normal)] {
    constraint_core@cons_int(role_left_brace(), five_roles(role_op(), role_call_lparen(), role_stmt_sep(), capability_case@role_case_keyword(), role_bnot_prefix()))
}

fn constraints() -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    // left_brace can be followed by operand, call_name, module qualifier (mod@fn), or case (extends fn_decl)
    c1: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_left_brace(), next_token_roles: five_roles(role_operand(), role_call_name(), role_qual_module_name(), capability_case@role_case_keyword(), role_bnot_prefix()), prev_token_roles: constraint_core@empty_list_int(), constraint_id: 20 };
    // right_brace can be preceded by operand or call_rparen (extends fn_decl)
    c2: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_right_brace(), next_token_roles: constraint_core@empty_list_int(), prev_token_roles: four_roles(role_operand(), role_call_rparen(), role_stmt_sep(), role_right_brace()), constraint_id: 21 };
    // operand: in binary expr or call arg
    c3: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_operand(), next_token_roles: operand_next(), prev_token_roles: operand_prev(), constraint_id: 22 };
    // op: between two operands; unary minus after case keyword uses op role with prev case_keyword
    c4: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_op(), next_token_roles: two_roles(role_operand(), role_bnot_prefix()), prev_token_roles: two_roles(role_operand(), capability_case@role_case_keyword()), constraint_id: 23 };
    // qual_module_name: first identifier in mod@fn(...); prefixes include case scrutinee, branch RHS, and call arg lists (silica-spec §3.3.2).
    c_qual_m: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_qual_module_name(), next_token_roles: single_role(role_qual_at_sign()), prev_token_roles: seven_roles(role_left_brace(), role_stmt_sep(), capability_case@role_case_keyword(), role_comma(), capability_case@role_case_branch_arrow(), role_call_lparen(), role_case_rhs_lparen_slot()), constraint_id: 27 };
    // qual_at_sign: must sit between module and function identifiers
    c_qual_at: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_qual_at_sign(), next_token_roles: single_role(role_call_name()), prev_token_roles: single_role(role_qual_module_name()), constraint_id: 28 };
    // call_name: identifier in body, followed by ( or generic [; can follow left_brace, stmt_sep, case, comma, or @ in mod@fn (multi-arg calls and spawn placement: core_id(...), core_set[...](...))
    c5: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_call_name(), next_token_roles: two_roles(role_call_lparen(), capability_list@role_call_gen_lbracket()), prev_token_roles: five_roles(role_left_brace(), role_stmt_sep(), capability_case@role_case_keyword(), role_comma(), role_qual_at_sign()), constraint_id: 24 };
    // call_lparen: after call_name or after ] closing generic type args
    c6: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_call_lparen(), next_token_roles: two_roles(role_operand(), role_bnot_prefix()), prev_token_roles: two_roles(role_call_name(), capability_list@role_call_gen_rbracket()), constraint_id: 25 };
    // call_rparen: after operand, before right_brace, stmt_sep, or case branch arrow (guard)
    c7: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_call_rparen(), next_token_roles: three_roles(role_right_brace(), role_stmt_sep(), capability_case@role_case_branch_arrow()), prev_token_roles: single_role(role_operand()), constraint_id: 26 };
    c_bnot: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_bnot_prefix(), next_token_roles: single_role(role_operand()), prev_token_roles: six_roles(role_left_brace(), role_op(), role_call_lparen(), role_stmt_sep(), capability_case@role_case_keyword(), role_comma()), constraint_id: 29 };
    tail_bnot: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c_bnot, constraint_core@empty_list_constraint());
    tail_qa: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c7, tail_bnot);
    tail_qat: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c_qual_at, tail_qa);
    tail_qm: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c_qual_m, tail_qat);
    tail_c6: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c6, tail_qm);
    tail_c5: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c5, tail_c6);
    tail_c4: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c4, tail_c5);
    tail_c3: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c3, tail_c4);
    tail_c2: List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] <- constraint_core@cons_constraint(c2, tail_c3);
    constraint_core@cons_constraint(c1, tail_c2)
}

fn is_arithmetic_op(token_kind: int64) -> boolean {
    token_kind == lexer_token_kind@token_kind_plus() or token_kind == lexer_token_kind@token_kind_minus() or token_kind == lexer_token_kind@token_kind_star() or token_kind == lexer_token_kind@token_kind_slash() or token_kind == lexer_token_kind@token_kind_percent()
}

fn is_comparison_op(token_kind: int64) -> boolean {
    token_kind == lexer_token_kind@token_kind_less_than() or token_kind == lexer_token_kind@token_kind_greater_than() or token_kind == lexer_token_kind@token_kind_less_equal() or token_kind == lexer_token_kind@token_kind_greater_equal() or token_kind == lexer_token_kind@token_kind_equal_equal() or token_kind == lexer_token_kind@token_kind_bang_equal()
}

fn is_op_token(token_kind: int64) -> boolean {
    is_arithmetic_op(token_kind) or is_comparison_op(token_kind) or token_kind == lexer_token_kind@token_kind_and_keyword() or token_kind == lexer_token_kind@token_kind_or_keyword() or token_kind == lexer_token_kind@token_kind_bor_keyword() or token_kind == lexer_token_kind@token_kind_band_keyword() or token_kind == lexer_token_kind@token_kind_shl_keyword() or token_kind == lexer_token_kind@token_kind_shr_keyword()
}

fn initial_roles(token_kind: int64) -> List[int64, mem(normal)] {
        case token_kind == lexer_token_kind@token_kind_integer_literal() of {
        true -> single_role(role_operand());
        false -> case token_kind == lexer_token_kind@token_kind_float_literal() of {
            true -> single_role(role_operand());
            false -> case token_kind == lexer_token_kind@token_kind_true_literal() of {
                true -> single_role(role_operand());
                false -> case token_kind == lexer_token_kind@token_kind_false_literal() of {
                    true -> single_role(role_operand());
                    false -> case token_kind == lexer_token_kind@token_kind_bnot_keyword() or token_kind == lexer_token_kind@token_kind_not_keyword() of {
                        true -> single_role(role_bnot_prefix());
                        false -> case token_kind == lexer_token_kind@token_kind_and_keyword() of {
                        true -> single_role(role_op());
                        false -> case token_kind == lexer_token_kind@token_kind_or_keyword() of {
                            true -> single_role(role_op());
                            false -> case token_kind == lexer_token_kind@token_kind_string_literal() of {
                                true -> single_role(role_operand());
                                false -> case lexer_token_kind@is_identifier_lexeme_token(token_kind) of {
                                    true -> three_roles(role_qual_module_name(), role_call_name(), role_operand());
                                    false -> case token_kind == lexer_token_kind@token_kind_at_sign() of {
                                        true -> single_role(role_qual_at_sign());
                                        false -> case is_op_token(token_kind) of {
                                            true -> single_role(role_op());
                                            false -> case token_kind == lexer_token_kind@token_kind_left_paren() of {
                                                true -> two_roles(role_call_lparen(), role_operand());
                                                false -> case token_kind == lexer_token_kind@token_kind_right_paren() of {
                                                    true -> two_roles(role_call_rparen(), role_operand());
                                                    false -> constraint_core@empty_list_int()
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                }
            }
        }
    }
}
