// Trait file surface syntax (silica-specification §3.4.8–3.4.9): required { ... }, provided { ... }.
// export trait Name; and export f/n; live in capability_module. impl fn / impl Type; share capability_actors + fn_decl.

use lexer_token_kind;
use constraint_core;

export constraints/0;
export initial_roles/1;
export role_trait_required_kw/0;
export role_trait_provided_kw/0;
export role_required_block_lbrace/0;
export role_provided_block_lbrace/0;

// 237–240: trait section keywords and block `{` roles (distinct from ordinary fn body `{` = 7).
fn role_trait_required_kw() -> int64 { 237 }
fn role_trait_provided_kw() -> int64 { 238 }
fn role_required_block_lbrace() -> int64 { 239 }
fn role_provided_block_lbrace() -> int64 { 240 }
fn role_fn_keyword() -> int64 { 1 }

fn single_role(r: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r, constraint_core@empty_list_int())
}

fn two_roles(r1: int64, r2: int64) -> List[int64, mem(normal)] {
    constraint_core@cons_int(r1, single_role(r2))
}

fn no_prev() -> List[int64, mem(normal)] {
    constraint_core@empty_list_int()
}

fn constraints() -> List[{ trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 }, mem(normal)] {
    // required {
    c_req: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_trait_required_kw(), next_token_roles: single_role(role_required_block_lbrace()), prev_token_roles: no_prev(), constraint_id: 260 };
    // provided {
    c_prov: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_trait_provided_kw(), next_token_roles: single_role(role_provided_block_lbrace()), prev_token_roles: no_prev(), constraint_id: 261 };
    // required { fn ... }  and  provided { fn ... }
    c_req_fn: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_required_block_lbrace(), next_token_roles: single_role(role_fn_keyword()), prev_token_roles: single_role(role_trait_required_kw()), constraint_id: 262 };
    c_prov_fn: { trigger_role: int64, next_token_roles: List[int64, mem(normal)], prev_token_roles: List[int64, mem(normal)], constraint_id: int64 } <- {  trigger_role: role_provided_block_lbrace(), next_token_roles: single_role(role_fn_keyword()), prev_token_roles: single_role(role_trait_provided_kw()), constraint_id: 263 };
    constraint_core@cons_constraint(c_req, constraint_core@cons_constraint(c_prov, constraint_core@cons_constraint(c_req_fn, constraint_core@cons_constraint(c_prov_fn, constraint_core@empty_list_constraint()))))
}

fn initial_roles(token_kind: int64) -> List[int64, mem(normal)] {
        case token_kind == lexer_token_kind@token_kind_required_keyword() of {
        true -> single_role(role_trait_required_kw());
        false -> case token_kind == lexer_token_kind@token_kind_provided_keyword() of {
            true -> single_role(role_trait_provided_kw());
            false -> constraint_core@empty_list_int()
        }
    }
}
