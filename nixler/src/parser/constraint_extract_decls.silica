                                                                placeholder_sym: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                                                                symbol_body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@make_expr(-1, symbol_lexeme, meta_path, foreign_loc, placeholder_sym, placeholder_sym, parser_ast@nil_tuple_decompose_bindings(), parser_ast@empty_effect_name_list());
                                                                // Literal packed directly into the pair; see extract_module_declaration.
                                                                ({ tag: 9, name: fn_name, parameters: params, return_type_name: ret_type, return_type_location: ret_type_loc, location: fn_loc, body: symbol_body, declared_effects: parser_ast@empty_effect_name_list() }, after_sig)
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    produces
        pure result
    end
}



fn find_malformed_ffi_surface(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (boolean, { file: string, line: int64, column: int64, offset: int64 }, string) {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (false, parser_ast@zero_location(), "");
        false -> case is_wrapper_meta_decl_start(trimmed) of {
            true -> {
                (decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, rest_after: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_wrapper_meta_declaration(trimmed);
                case decl.tag == 8 of {
                    true -> find_malformed_ffi_surface(rest_after);
                    false -> (true, trimmed.head.token.location, "wrapper_meta must be followed by a string literal path and ';'")
                }
            };
            false -> case is_foreign_decl_start(trimmed) of {
                true -> {
                    (decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, rest_after: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- extract_foreign_declaration(trimmed);
                    case decl.tag == 9 of {
                        true -> find_malformed_ffi_surface(rest_after);
                        false -> (true, trimmed.head.token.location, "foreign c_wrapper declaration is malformed; expected foreign c_wrapper \"symbol\" [meta \"path\"] fn name(...) -> Type;")
                    }
                };
                false -> find_malformed_ffi_surface(trimmed.tail)
            }
        }
    }
}




fn append_decl_lists(a: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], b: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] {
    case a.is_nil of {
        true -> b;
        false -> parser_ast@cons_declaration(a.head, append_decl_lists(a.tail, b))
    }
}



fn is_required_section_start(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
    case slots.is_nil of {
        true -> false;
        false -> slots.head.token.kind == lexer_token_kind@token_kind_required_keyword()
    }
}



fn is_provided_section_start(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
    case slots.is_nil of {
        true -> false;
        false -> slots.head.token.kind == lexer_token_kind@token_kind_provided_keyword()
    }
}



fn token_is_impl_keyword(kind: int64, lexeme: string) -> boolean {
    kind == lexer_token_kind@token_kind_impl_keyword() or lexeme == "impl"
}

fn is_impl_fn_decl_start(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
    case slots.is_nil of {
        true -> false;
        false -> case slots.tail.is_nil of {
            true -> false;
            false -> {
                w: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots.tail);
                case w.is_nil of {
                    true -> false;
                    false -> token_is_impl_keyword(slots.head.token.kind, slots.head.token.lexeme) and w.head.token.kind == lexer_token_kind@token_kind_fn_keyword()
                }
            }
        }
    }
}



fn is_postfix_message_impl_marker_start(after_impl: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
    case after_impl.is_nil of {
        true -> false;
        false -> case constraint_extract_params@impl_marker_of_lexeme(after_impl.head.token.lexeme) == "" of {
            true -> false;
            false -> case true of {
            false -> false;
            true -> {
                after_name: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_impl.tail);
                case after_name.is_nil of {
                    true -> false;
                    false -> after_name.head.token.kind == lexer_token_kind@token_kind_left_brace()
                }
            }
        }
    }
        }
}



fn is_trait_marker_impl_start(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
    case slots.is_nil of {
        true -> false;
        false -> case slots.tail.is_nil of {
            true -> false;
            false -> {
                w: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots.tail);
                case w.is_nil of {
                    true -> false;
                    false -> case token_is_impl_keyword(slots.head.token.kind, slots.head.token.lexeme) of {
                        true -> case w.head.token.kind == lexer_token_kind@token_kind_fn_keyword() of {
                            true -> false;
                            false -> case is_postfix_message_impl_marker_start(w) of {
                                true -> false;
                                false -> true
                            }
                        };
                        false -> false
                    }
                }
            }
        }
    }
}



// Trait marker impl body (`impl T for Trait;`): join token lexemes with a single space so the
// downstream suffix check for ` for Supervisor` / ` for FailureReporter` (type_checker_supervisor,
// sir_generator/declarations/traits) can detect the trait target. Prior form joined with no
// separator, turning `PhaseDSup for Supervisor` into `PhaseDSupforSupervisor` and hiding the
// supervisor metadata that Phase D depends on.
fn concat_token_lexeme_is_whitespace(lexeme: string) -> boolean {
    lexeme == " " or lexeme == "\t" or lexeme == "\n" or lexeme == "\r"
}

fn concat_tokens_until_semicolon(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (string, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    case slots.is_nil of {
        true -> ("", slots);
        false -> case slots.head.token.kind == lexer_token_kind@token_kind_semicolon() of {
            true -> ("", slots.tail);
            false -> case concat_token_lexeme_is_whitespace(slots.head.token.lexeme) of {
                true -> concat_tokens_until_semicolon(slots.tail);
                false -> {
                    piece: string <- slots.head.token.lexeme;
                    (suf: string, after: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- concat_tokens_until_semicolon(slots.tail);
                    sep: string <- case length_bytes(suf) == 0 of { true -> ""; false -> " " };
                    full: string <- concat(piece, concat(sep, suf));
                    (full, after)
                }
            }
        }
    }
}



fn extract_trait_marker_impl(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    case slots.is_nil of {
        true -> (parser_ast@dummy_decl(), constraint_core@empty_list_slot());
        false -> case token_is_impl_keyword(slots.head.token.kind, slots.head.token.lexeme) of {
            false -> (parser_ast@dummy_decl(), slots);
            true -> {
                impl_loc: { file: string, line: int64, column: int64, offset: int64 } <- slots.head.token.location;
                after_impl: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots.tail);
                (type_src: string, after_semi: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- concat_tokens_until_semicolon(after_impl);
                dummy_b: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                zero_loc_m: { file: string, line: int64, column: int64, offset: int64 } <- parser_ast@zero_location();
                // Literal packed directly into the pair; see extract_module_declaration.
                ({ tag: 6, name: "", parameters: parser_ast@nil_list_param(), return_type_name: type_src, return_type_location: zero_loc_m, location: impl_loc, body: dummy_b, declared_effects: parser_ast@empty_effect_name_list() }, after_semi)
            }
        }
    }
}



fn extract_impl_fn_function(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    constraint_extract_expr@extract_function(slots.tail)
}



fn extract_trait_required_fn(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    r1: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- slots.tail;
    fn_name: string <- r1.head.token.lexeme;
    fn_loc: { file: string, line: int64, column: int64, offset: int64 } <- r1.head.token.location;
    (ret_type: string, ret_type_loc: { file: string, line: int64, column: int64, offset: int64 }, params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], after_sig: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- constraint_extract_params@collect_params_and_find_type_and_semicolon(r1.tail);
    dummy_body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
    ({ tag: 7, name: fn_name, parameters: params, return_type_name: ret_type, return_type_location: ret_type_loc, location: fn_loc, body: dummy_body, declared_effects: effects }, after_sig)
}



fn declarations_from_slots_trait_required(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (parser_ast@empty_list_decl(), trimmed);
        false -> case trimmed.head.token.kind == lexer_token_kind@token_kind_right_brace() or trimmed.head.token.lexeme == "}" of {
            true -> (parser_ast@empty_list_decl(), trimmed);
