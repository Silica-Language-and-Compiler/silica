// Top-level declarations (use/export/module/FFI/trait) and slots_to_program.

use lexer_core;
use lexer_token_kind;
use constraint_core;
use parser_ast;
use parser_tuples;
use constraint_extract_slots;
use constraint_extract_params;
use constraint_extract_expr;

export find_malformed_ffi_surface/1;
export append_decl_lists/2;
export slots_to_program/1;
export append_declaration_lists/2;

// Int64 1/0 — seed-built selfhost has inverted/stuck bool from `kind == k`.
fn int64_same(a: int64, b: int64) -> int64 {
    case a < b of {
        true -> 0;
        false -> case b < a of {
            true -> 0;
            false -> 1
        }
    }
}

fn offset_lt_i(start: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> int64 {
    case start.is_nil of {
        true -> 0;
        false -> case rest.is_nil of {
            true -> 0;
            false -> case start.head.token.location.offset < rest.head.token.location.offset of {
                true -> 1;
                false -> 0
            }
        }
    }
}

fn kind_is_slash_i(kind: int64) -> int64 {
    int64_same(kind, 48)
}

fn kind_is_semicolon_i(kind: int64) -> int64 {
    int64_same(kind, 72)
}

fn kind_is_comma_i(kind: int64) -> int64 {
    int64_same(kind, 63)
}

fn kind_is_lbracket_i(kind: int64) -> int64 {
    int64_same(kind, 61)
}

fn kind_is_rbracket_i(kind: int64) -> int64 {
    int64_same(kind, 62)
}

fn kind_is_integer_i(kind: int64) -> int64 {
    int64_same(kind, 30)
}

fn kind_is_export_name_i(kind: int64) -> int64 {
    case kind_is_slash_i(kind) < 1 of {
        false -> 0;
        true -> case kind_is_semicolon_i(kind) < 1 of {
            false -> 0;
            true -> case kind_is_comma_i(kind) < 1 of {
                false -> 0;
                true -> case kind_is_lbracket_i(kind) < 1 of {
                    false -> 0;
                    true -> case kind_is_rbracket_i(kind) < 1 of {
                        false -> 0;
                        true -> case kind_is_integer_i(kind) < 1 of {
                            false -> 0;
                            true -> 1
                        }
                    }
                }
            }
        }
    }
}

fn skip_square_brackets_depth_i(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)], depth: int64, acc: string) -> (string, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    t: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots);
    case t.is_nil of {
        true -> (acc, t);
        false -> {
            k: int64 <- t.head.token.kind;
            lex: string <- t.head.token.lexeme;
            case kind_is_lbracket_i(k) < 1 of {
                false -> skip_square_brackets_depth_i(t.tail, depth + 1, concat(acc, lex));
                true -> case kind_is_rbracket_i(k) < 1 of {
                    false -> case int64_same(depth, 1) < 1 of {
                        false -> (acc, t.tail);
                        true -> skip_square_brackets_depth_i(t.tail, depth - 1, concat(acc, lex))
                    };
                    true -> skip_square_brackets_depth_i(t.tail, depth, concat(acc, lex))
                }
            }
        }
    }
}

fn consume_optional_brackets_i(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (string, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    t: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots);
    case t.is_nil of {
        true -> ("", t);
        false -> case kind_is_lbracket_i(t.head.token.kind) < 1 of {
            true -> ("", t);
            false -> {
                (inner: string, after: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- skip_square_brackets_depth_i(t.tail, 1, "");
                (concat("[", concat(inner, "]")), after)
            }
        }
    }
}

fn lexeme_chars_same_i(a: string, b: string, i: int64, n: int64) -> int64 {
    case i < n of {
        false -> 1;
        true -> {
            ca: string <- substring(a, i, i + 1);
            cb: string <- substring(b, i, i + 1);
            case ca == cb of {
                false -> 0;
                true -> lexeme_chars_same_i(a, b, i + 1, n)
            }
        }
    }
}

fn lexeme_is_word_i(lexeme: string, word: string) -> int64 {
    la: int64 <- length_bytes(lexeme);
    lb: int64 <- length_bytes(word);
    case la < lb of {
        true -> 0;
        false -> case lb < la of {
            true -> 0;
            false -> lexeme_chars_same_i(lexeme, word, 0, la)
        }
    }
}

fn lexeme_is_use_chars(s: string) -> int64 {
    case length_bytes(s) < 3 of {
        true -> 0;
        false -> case 3 < length_bytes(s) of {
            true -> 0;
            false -> {
                c0: string <- substring(s, 0, 1);
                c1: string <- substring(s, 1, 2);
                c2: string <- substring(s, 2, 3);
                case c0 == "u" of {
                    false -> 0;
                    true -> case c1 == "s" of {
                        false -> 0;
                        true -> case c2 == "e" of {
                            false -> 0;
                            true -> 1
                        }
                    }
                }
            }
        }
    }
}

fn lexeme_is_export_chars(s: string) -> int64 {
    c0: string <- substring(s, 0, 1);
    c1: string <- substring(s, 1, 2);
    c2: string <- substring(s, 2, 3);
    c3: string <- substring(s, 3, 4);
    c4: string <- substring(s, 4, 5);
    c5: string <- substring(s, 5, 6);
    case c0 == "e" of {
        false -> 0;
        true -> case c1 == "x" of {
            false -> 0;
            true -> case c2 == "p" of {
                false -> 0;
                true -> case c3 == "o" of {
                    false -> 0;
                    true -> case c4 == "r" of {
                        false -> 0;
                        true -> case c5 == "t" of {
                            false -> 0;
                            true -> 1
                        }
                    }
                }
            }
        }
    }
}

fn token_is_use_i(kind: int64, lexeme: string) -> int64 {
    ks: int64 <- int64_same(kind, 140);
    case ks < 1 of {
        true -> lexeme_is_use_chars(lexeme);
        false -> 1
    }
}

fn token_is_export_i(kind: int64, lexeme: string) -> int64 {
    ks: int64 <- int64_same(kind, 141);
    case ks < 1 of {
        true -> lexeme_is_export_chars(lexeme);
        false -> 1
    }
}

fn lexeme_first_is(s: string, ch: string) -> int64 {
    case length_bytes(s) < 1 of {
        true -> 0;
        false -> case 1 < length_bytes(s) of {
            true -> 0;
            false -> {
                c: string <- substring(s, 0, 1);
                case c == ch of {
                    true -> 1;
                    false -> 0
                }
            }
        }
    }
}

fn lexeme_is_trait_chars(s: string) -> int64 {
    case length_bytes(s) < 5 of {
        true -> 0;
        false -> case 5 < length_bytes(s) of {
            true -> 0;
            false -> {
                c0: string <- substring(s, 0, 1);
                c1: string <- substring(s, 1, 2);
                c2: string <- substring(s, 2, 3);
                c3: string <- substring(s, 3, 4);
                c4: string <- substring(s, 4, 5);
                case c0 == "t" of {
                    false -> 0;
                    true -> case c1 == "r" of {
                        false -> 0;
                        true -> case c2 == "a" of {
                            false -> 0;
                            true -> case c3 == "i" of {
                                false -> 0;
                                true -> case c4 == "t" of {
                                    false -> 0;
                                    true -> 1
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn token_lexeme_is_name_i(lexeme: string) -> int64 {
    case lexeme_first_is(lexeme, "/") < 1 of {
        false -> 0;
        true -> case lexeme_first_is(lexeme, ";") < 1 of {
            false -> 0;
            true -> case lexeme_first_is(lexeme, ",") < 1 of {
                false -> 0;
                true -> case lexeme_first_is(lexeme, "[") < 1 of {
                    false -> 0;
                    true -> case lexeme_first_is(lexeme, "]") < 1 of {
                        false -> 0;
                        true -> case length_bytes(lexeme) < 1 of {
                            true -> 0;
                            false -> 1
                        }
                    }
                }
            }
        }
    }
}

fn token_lexeme_is_digit_start_i(lexeme: string) -> int64 {
    case length_bytes(lexeme) < 1 of {
        true -> 0;
        false -> {
            c: string <- substring(lexeme, 0, 1);
            case c == "0" of {
                true -> 1;
                false -> case c == "1" of {
                    true -> 1;
                    false -> case c == "2" of {
                        true -> 1;
                        false -> case c == "3" of {
                            true -> 1;
                            false -> case c == "4" of {
                                true -> 1;
                                false -> case c == "5" of {
                                    true -> 1;
                                    false -> case c == "6" of {
                                        true -> 1;
                                        false -> case c == "7" of {
                                            true -> 1;
                                            false -> case c == "8" of {
                                                true -> 1;
                                                false -> case c == "9" of {
                                                    true -> 1;
                                                    false -> 0
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn slots_start_use_i(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> int64 {
    case slots.is_nil of {
        true -> 0;
        false -> token_is_use_i(slots.head.token.kind, slots.head.token.lexeme)
    }
}



fn slots_start_export_i(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> int64 {
    case slots.is_nil of {
        true -> 0;
        false -> token_is_export_i(slots.head.token.kind, slots.head.token.lexeme)
    }
}



fn is_module_decl_start(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> boolean {
    case slots.is_nil of {
        true -> false;
        false -> slots.head.token.kind == lexer_token_kind@token_kind_module_keyword()
    }
}



fn first_use_imported_module(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> string {
    case params.is_nil of {
        true -> "";
        false -> params.head.name
    }
}

// use a, b, c; — module names in { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }.name (spec §3.4.4, §19.3).
fn collect_use_module_params(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (parser_ast@nil_list_param(), trimmed);
        false -> case kind_is_export_name_i(trimmed.head.token.kind) < 1 of {
            true -> (parser_ast@nil_list_param(), trimmed);
            false -> {
                id_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- trimmed.head;
                after_id: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- trimmed.tail;
                p: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: id_slot.token.lexeme, type_name: "", location: id_slot.token.location };
                after_ws: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_id);
                case after_ws.is_nil of {
                    true -> (parser_ast@nil_list_param(), trimmed);
                    false -> case kind_is_semicolon_i(after_ws.head.token.kind) < 1 of {
                        false -> (parser_ast@cons_param(p, parser_ast@nil_list_param()), after_ws.tail);
                        true -> case kind_is_comma_i(after_ws.head.token.kind) < 1 of {
                            false -> {
                                (rest_params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], final_rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- collect_use_module_params(after_ws.tail);
                                case rest_params.is_nil of {
                                    true -> (parser_ast@nil_list_param(), trimmed);
                                    false -> (parser_ast@cons_param(p, rest_params), final_rest)
                                }
                            };
                            true -> (parser_ast@nil_list_param(), trimmed)
                        }
                    }
                }
            }
        }
    }
}



fn extract_use_declaration(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> ({ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    sequence
        result: ({ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- case slots.is_nil of {
            true -> (parser_ast@dummy_decl(), constraint_core@empty_list_slot());
            false -> {
                    use_loc: { file: string, line: int64, column: int64, offset: int64 } <- slots.head.token.location;
                    after_kw: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots.tail);
                    (params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], after_use: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- collect_use_module_params(after_kw);
                    case params.is_nil of {
                        true -> (parser_ast@dummy_decl(), slots);
                        false -> {
                            dummy: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@dummy_expr();
                            zero_loc: { file: string, line: int64, column: int64, offset: int64 } <- parser_ast@zero_location();
                            // Literal packed directly into the pair; see extract_module_declaration.
                            ({ tag: 2, name: first_use_imported_module(params), parameters: params, return_type_name: "", return_type_location: zero_loc, location: use_loc, body: dummy, declared_effects: parser_ast@empty_effect_name_list() }, after_use)
                        }
                    }
            }
        }
    produces
        pure result
    end
}



// export f/1, g/2; — { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }.name = function, { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }.type_name = arity lexeme (spec §19.2).
fn collect_export_decl_parameters(slots: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) -> (List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) {
    trimmed: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(slots);
    case trimmed.is_nil of {
        true -> (parser_ast@nil_list_param(), trimmed);
        false -> case kind_is_export_name_i(trimmed.head.token.kind) < 1 of {
            true -> (parser_ast@nil_list_param(), trimmed);
            false -> {
                fn_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- trimmed.head;
                after_fn: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- trimmed.tail;
                (bracket_suffix: string, after_brackets: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- consume_optional_brackets_i(after_fn);
                fn_full: string <- concat(fn_slot.token.lexeme, bracket_suffix);
                ws1: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_brackets);
                case ws1.is_nil of {
                    true -> (parser_ast@nil_list_param(), ws1);
                    false -> case kind_is_slash_i(ws1.head.token.kind) < 1 of {
                        true -> (parser_ast@nil_list_param(), ws1);
                        false -> {
                            after_slash: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- ws1.tail;
                            ws2: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_slash);
                            case ws2.is_nil of {
                                true -> (parser_ast@nil_list_param(), ws2);
                                false -> case kind_is_integer_i(ws2.head.token.kind) < 1 of {
                                    true -> (parser_ast@nil_list_param(), ws2);
                                    false -> {
                                        ar_slot: { token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] } <- ws2.head;
                                        p: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { name: fn_full, type_name: ar_slot.token.lexeme, location: fn_slot.token.location };
                                        after_ar: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- ws2.tail;
                                        ws3: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)] <- constraint_extract_slots@skip_leading_whitespace_slots(after_ar);
                                        case ws3.is_nil of {
                                            true -> (parser_ast@cons_param(p, parser_ast@nil_list_param()), ws3);
                                            false -> case kind_is_semicolon_i(ws3.head.token.kind) < 1 of {
                                                false -> (parser_ast@cons_param(p, parser_ast@nil_list_param()), ws3.tail);
                                                true -> case kind_is_comma_i(ws3.head.token.kind) < 1 of {
                                                    false -> {
                                                        (rest_params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], final_rest: List[{ token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, possible_roles: List[int64, mem(normal)] }, mem(normal)]) <- collect_export_decl_parameters(ws3.tail);
                                                        (parser_ast@cons_param(p, rest_params), final_rest)
                                                    };
                                                    true -> (parser_ast@cons_param(p, parser_ast@nil_list_param()), ws3)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}



fn lexeme_is_exactly(s: string, word: string) -> int64 {
    case s == word of {
        true -> 1;
        false -> 0
    }
}

