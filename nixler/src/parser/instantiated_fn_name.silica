// Bracket-instantiated function/export names (List-style `[T, mem(S)]` on definitions and call sites).
// Declarations store the full name including brackets; calls keep base name in expr.name and
// generic text in expr.value until resolution/mangling composes the link name.

use lexer_keywords;

export strip_all_spaces_inst/1;
export compose_instantiated_fn_name/2;
export fn_names_equivalent/2;
export resolve_call_fn_name/2;
export decl_name_matches/2;
export fn_base_name_before_brackets/1;
export link_name_to_asm_symbol/1;

fn strip_all_spaces_inst_from_run_end(s: string, j: int64, n: int64) -> int64 {
    case j >= n of {
        true -> j;
        false -> case substring(s, j, j + 1) == " " of {
            true -> j;
            false -> strip_all_spaces_inst_from_run_end(s, j + 1, n)
        }
    }
}

fn strip_all_spaces_inst_from(s: string, i: int64, acc: string) -> string {
    case i >= length_bytes(s) of {
        true -> acc;
        false -> case substring(s, i, i + 1) == " " of {
            true -> strip_all_spaces_inst_from(s, i + 1, acc);
            false -> {
                n: int64 <- length_bytes(s);
                e: int64 <- strip_all_spaces_inst_from_run_end(s, i, n);
                strip_all_spaces_inst_from(s, e, concat(acc, substring(s, i, e)))
            }
        }
    }
}

fn strip_all_spaces_inst(s: string) -> string {
    strip_all_spaces_inst_from(s, 0, "")
}

fn compose_instantiated_fn_name(base: string, generic_value: string) -> string {
    case length_bytes(generic_value) == 0 of {
        true -> base;
        false -> concat(base, concat("[", concat(strip_all_spaces_inst(generic_value), "]")))
    }
}

fn fn_names_equivalent(a: string, b: string) -> boolean {
    strip_all_spaces_inst(a) == strip_all_spaces_inst(b)
}

fn resolve_call_fn_name(base: string, generic_value: string) -> string {
    compose_instantiated_fn_name(base, generic_value)
}

fn fn_base_name_before_brackets(name: string) -> string {
    fn_base_name_scan(name, 0, 0)
}

fn fn_base_name_scan(s: string, i: int64, depth: int64) -> string {
    case i >= length_bytes(s) of {
        true -> s;
        false -> string {
            c: string <- substring(s, i, i + 1);
            case c == "[" of {
                true -> case depth == 0 of {
                    true -> substring(s, 0, i);
                    false -> fn_base_name_scan(s, i + 1, depth + 1)
                };
                false -> case c == "]" of {
                    true -> fn_base_name_scan(s, i + 1, depth - 1);
                    false -> fn_base_name_scan(s, i + 1, depth)
                }
            }
        }
    }
}

// Phase 0.4: bracketed call targets require exact instantiation spelling (add_edge[mem(normal)]
// must not match add_edge[int64, mem(normal)]). Unbracketed targets (module@empty) keep
// base-name matching so context resolution can pick the overload by arity and types.
fn decl_name_matches(decl_name: string, target_name: string) -> boolean {
    case fn_names_equivalent(decl_name, target_name) of {
        true -> true;
        false -> case fn_name_has_bracket_instantiation(target_name) of {
            true -> false;
            false -> fn_base_name_before_brackets(decl_name) == fn_base_name_before_brackets(target_name)
        }
    }
}

// Map source bracket instantiation names to assembler-safe global labels. Any byte outside
// [A-Za-z0-9_] becomes "_": the bracket text carries "[", ",", "(", "?" (ref?), "|", ":" and
// more, and GNU as rejects "?" in a symbol even though the Mach-O assembler tolerates it.
// Must stay identical to overload_mangle@type_slug_char.
fn link_slug_char(c: string) -> string {
    case lexer_keywords@is_identifier_char(c) of {
        true -> c;
        false -> "_"
    }
}

fn link_slug_scan(s: string, i: int64, acc: string) -> string {
    case i >= length_bytes(s) of {
        true -> acc;
        false -> string {
            ch: string <- substring(s, i, i + 1);
            mapped: string <- link_slug_char(ch);
            link_slug_scan(s, i + 1, concat(acc, mapped))
        }
    }
}

fn fn_name_has_bracket_instantiation(name: string) -> boolean {
    fn_name_has_bracket_scan(name, 0)
}

fn fn_name_has_bracket_scan(s: string, i: int64) -> boolean {
    case i >= length_bytes(s) of {
        true -> false;
        false -> case substring(s, i, i + 1) == "[" of {
            true -> true;
            false -> fn_name_has_bracket_scan(s, i + 1)
        }
    }
}

fn link_name_to_asm_symbol(name: string) -> string {
    case fn_name_has_bracket_instantiation(name) of {
        true -> link_slug_scan(name, 0, "");
        false -> name
    }
}
