// Cast-mediated FFI worker placement (silica_ffi_wrapper_specification.md §4): external_danger sequences,
// dangerous_* module calls, and cast-only client behaviors. Phase 5 — compile-time validation only.

use parser_ast;
use sir_ast;
use diagnostics_core;
use type_checker_core;

export validate_program_ffi_placement/1;
export collect_spawn_behavior_names/1;
export collect_ffi_worker_names/1;

fn dangerous_prefix() -> string {
    "dangerous_"
}

fn is_dangerous_module_name(name: string) -> boolean {
    pref: string <- dangerous_prefix();
    case length_bytes(name) >= length_bytes(pref) of {
        false -> false;
        true -> substring(name, 0, length_bytes(pref)) == pref
    }
}

fn trim_leading_actor_from(s: string, i: int64) -> string {
    case i >= length_bytes(s) of {
        true -> "";
        false -> case substring(s, i, i + 1) == " " of {
            true -> trim_leading_actor_from(s, i + 1);
            false -> substring(s, i, length_bytes(s))
        }
    }
}

fn trim_leading_actor(s: string) -> string {
    trim_leading_actor_from(s, 0)
}

fn behavior_return_is_call_only(return_type: string) -> boolean {
    t: string <- trim_leading_actor(return_type);
    case length_bytes(t) >= 8 of {
        false -> false;
        true -> substring(t, 0, 8) == "(:reply,"
    }
}

fn behavior_return_is_cast_only(return_type: string) -> boolean {
    t: string <- trim_leading_actor(return_type);
    case length_bytes(t) >= 11 of {
        false -> false;
        true -> substring(t, 0, 11) == "(:no_reply,"
    }
}

fn effect_list_has_external_danger(effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> boolean {
    case effects.is_nil of {
        true -> false;
        false -> case effects.head.name == "external_danger" of {
            true -> true;
            false -> effect_list_has_external_danger(effects.tail)
        }
    }
}

fn is_spawn_behavior_call(name: string) -> boolean {
    base: string <- type_checker_core@user_call_base_function_name(name);
    case base == "spawn" of {
        true -> true;
        false -> case base == "spawn_linked" of {
            true -> true;
            false -> base == "spawn_registered"
        }
    }
}

fn is_spawn_dangerous_behavior_call(name: string) -> boolean {
    base: string <- type_checker_core@user_call_base_function_name(name);
    case base == "spawn_dangerous" of {
        true -> true;
        false -> base == "spawn_dangerous_registered"
    }
}

fn expr_contains_spawn_dangerous_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    case expr.root < 0 of {
        true -> false;
        false -> {
            node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
            case node.kind < 0 of {
                true -> false;
                false -> case node.kind == 4 of {
                    true -> {
                        case is_spawn_dangerous_behavior_call(node.name) of {
                            true -> true;
                            false -> expr_contains_spawn_dangerous_pair(parser_ast@expr_at(expr, node.inner), parser_ast@expr_at(expr, node.right_expr))
                        }
                    };
                    false -> expr_contains_spawn_dangerous_pair(parser_ast@expr_at(expr, node.inner), parser_ast@expr_at(expr, node.right_expr))
                }
            }
        }
    }
}

fn expr_contains_spawn_dangerous_pair(inner: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, right: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    case expr_contains_spawn_dangerous_call(inner) of {
        true -> true;
        false -> expr_contains_spawn_dangerous_call(right)
    }
}

fn spawn_behavior_expr(call_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(call_expr);
    right_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(call_expr, node.right_expr);
    right_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(right_e);
    parser_ast@expr_at(right_e, right_node.inner)
}

fn append_unique_sir_string(items: List[string, mem(normal)], s: string) -> List[string, mem(normal)] {
    case length_bytes(s) == 0 of {
        true -> items;
        false -> case sir_ast@sir_string_list_contains(items, s) of {
            true -> items;
            false -> sir_ast@cons_sir_string(s, items)
        }
    }
}

fn collect_spawn_dangerous_behavior_names_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case expr.root < 0 of {
        true -> acc;
        false -> {
            node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
            case node.kind < 0 of {
                true -> acc;
                false -> case node.kind == 4 of {
                    true -> {
                        next: List[string, mem(normal)] <- case is_spawn_dangerous_behavior_call(node.name) of {
                            true -> {
                                beh: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- spawn_behavior_expr(expr);
                                beh_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(beh);
                                case beh_node.kind == 1 of {
                                    true -> append_unique_sir_string(acc, beh_node.name);
                                    false -> acc
                                }
                            };
                            false -> acc
                        };
                        collect_spawn_dangerous_behavior_names_pair(parser_ast@expr_at(expr, node.inner), parser_ast@expr_at(expr, node.right_expr), next)
                    };
                    false -> collect_spawn_dangerous_behavior_names_pair(parser_ast@expr_at(expr, node.inner), parser_ast@expr_at(expr, node.right_expr), acc)
                }
            }
        }
    }
}

fn collect_spawn_dangerous_behavior_names_pair(inner: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, right: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    mid: List[string, mem(normal)] <- collect_spawn_dangerous_behavior_names_expr(inner, acc);
    collect_spawn_dangerous_behavior_names_expr(right, mid)
}

fn collect_spawn_dangerous_behavior_names_from_decls(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[string, mem(normal)] {
    case decls.is_nil of {
        true -> sir_ast@nil_sir_strings();
        false -> case decls.head.tag == 0 of {
            true -> collect_spawn_dangerous_behavior_names_expr(decls.head.body, collect_spawn_dangerous_behavior_names_from_decls(decls.tail));
            false -> collect_spawn_dangerous_behavior_names_from_decls(decls.tail)
        }
    }
}

fn collect_spawn_behavior_names_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case expr.root < 0 of {
        true -> acc;
        false -> {
            node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
            case node.kind < 0 of {
                true -> acc;
                false -> case node.kind == 4 of {
                    true -> {
                        next: List[string, mem(normal)] <- case is_spawn_behavior_call(node.name) of {
                            true -> {
                                beh: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- spawn_behavior_expr(expr);
                                beh_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(beh);
                                case beh_node.kind == 1 of {
                                    true -> append_unique_sir_string(acc, beh_node.name);
                                    false -> acc
                                }
                            };
                            false -> acc
                        };
                        collect_spawn_behavior_names_pair(parser_ast@expr_at(expr, node.inner), parser_ast@expr_at(expr, node.right_expr), next)
                    };
                    false -> collect_spawn_behavior_names_pair(parser_ast@expr_at(expr, node.inner), parser_ast@expr_at(expr, node.right_expr), acc)
                }
            }
        }
    }
}

fn collect_spawn_behavior_names_pair(inner: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, right: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    mid: List[string, mem(normal)] <- collect_spawn_behavior_names_expr(inner, acc);
    collect_spawn_behavior_names_expr(right, mid)
}

fn collect_spawn_behavior_names_from_decls(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[string, mem(normal)] {
    case decls.is_nil of {
        true -> sir_ast@nil_sir_strings();
        false -> case decls.head.tag == 0 of {
            true -> collect_spawn_behavior_names_expr(decls.head.body, collect_spawn_behavior_names_from_decls(decls.tail));
            false -> collect_spawn_behavior_names_from_decls(decls.tail)
        }
    }
}

fn statement_chain_has_external_danger_sequence(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    case expr.root < 0 of {
        true -> false;
        false -> {
            node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
            case node.kind < 0 of {
                true -> false;
                false -> case node.kind == 11 of {
                    true -> effect_list_has_external_danger(node.sequence_effects);
                    false -> case node.kind == 6 of {
                        true -> statement_chain_has_external_danger_sequence(parser_ast@expr_at(expr, node.right_expr));
                        false -> case node.kind == 10 of {
                            true -> statement_chain_has_external_danger_sequence(parser_ast@expr_at(expr, node.right_expr));
                            false -> false
                        }
                    }
                }
            }
        }
    }
}

fn build_ffi_worker_names_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], spawn_names: List[string, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case decls.is_nil of {
        true -> acc;
        false -> case decls.head.tag == 0 of {
            true -> {
                next_acc: List[string, mem(normal)] <- case sir_ast@sir_string_list_contains(spawn_names, decls.head.name) of {
                    false -> acc;
                    true -> case statement_chain_has_external_danger_sequence(decls.head.body) of {
                        false -> acc;
                        true -> append_unique_sir_string(acc, decls.head.name)
                    }
                };
                build_ffi_worker_names_loop(decls.tail, spawn_names, next_acc)
            };
            false -> build_ffi_worker_names_loop(decls.tail, spawn_names, acc)
        }
    }
}

fn program_uses_dangerous_module_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> boolean {
    case decls.is_nil of {
        true -> false;
        false -> case decls.head.tag == 2 of {
            true -> case is_dangerous_module_name(decls.head.parameters.head.name) of {
                true -> true;
                false -> program_uses_dangerous_module_params(decls.head.parameters.tail)
            };
            false -> program_uses_dangerous_module_loop(decls.tail)
        }
    }
}

fn program_uses_dangerous_module_params(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> boolean {
    case params.is_nil of {
        true -> false;
        false -> case is_dangerous_module_name(params.head.name) of {
            true -> true;
            false -> program_uses_dangerous_module_params(params.tail)
        }
    }
}

fn program_uses_dangerous_module(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> boolean {
    program_uses_dangerous_module_loop(decls)
}

fn expr_contains_cast_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    case expr.root < 0 of {
        true -> false;
        false -> {
            node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
            case node.kind < 0 of {
                true -> false;
                false -> case node.kind == 4 of {
                    true -> {
                        base: string <- type_checker_core@user_call_base_function_name(node.name);
                        case base == "cast" of {
                            true -> true;
                            false -> case base == "cast_registered" or base == "cast_dangerous_registered" of {
                                true -> true;
                                false -> expr_contains_cast_pair(parser_ast@expr_at(expr, node.inner), parser_ast@expr_at(expr, node.right_expr))
                            }
                        }
                    };
                    false -> expr_contains_cast_pair(parser_ast@expr_at(expr, node.inner), parser_ast@expr_at(expr, node.right_expr))
                }
            }
        }
    }
}

fn expr_contains_cast_pair(inner: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, right: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    case expr_contains_cast_call(inner) of {
        true -> true;
        false -> expr_contains_cast_call(right)
    }
}

fn is_dangerous_qualified_call(name: string) -> boolean {
    case type_checker_core@call_name_is_module_qualified(name) of {
        false -> false;
        true -> {
            (qmod: string, _: string) <- type_checker_core@split_module_qualified_call_name(name);
            is_dangerous_module_name(qmod)
        }
    }
}

// Spec 4.5 covers raw bindings, the adapters over them and helper functions in dangerous_* modules as
// well as qualified calls. When the unit being compiled is itself a dangerous_* module (an application
// that declares its own foreign bindings), an UNQUALIFIED call from main or from a spawned behaviour to
// one of the unit's own functions that reaches foreign work -- a foreign binding (tag 9), or a function
// whose body calls a binding, a dangerous_* qualified function or another such function -- is under the
// same E4042 rule as a qualified call. The module's helpers may still call each other (the adapter
// shape), and a helper that performs no foreign work is not restricted.
fn is_guarded_local_call(name: string, guarded_local_fns: List[string, mem(normal)]) -> boolean {
    case type_checker_core@call_name_is_module_qualified(name) of {
        true -> false;
        false -> sir_ast@sir_string_list_contains(guarded_local_fns, type_checker_core@user_call_base_function_name(name))
    }
}

fn program_module_is_dangerous(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> boolean {
    case decls.is_nil of {
        true -> false;
        false -> case decls.head.tag == 4 of {
            true -> is_dangerous_module_name(decls.head.name);
            false -> program_module_is_dangerous(decls.tail)
        }
    }
}

fn collect_unit_foreign_binding_names(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case decls.is_nil of {
        true -> acc;
        false -> case decls.head.tag == 9 of {
            true -> collect_unit_foreign_binding_names(decls.tail, append_unique_sir_string(acc, decls.head.name));
            false -> collect_unit_foreign_binding_names(decls.tail, acc)
        }
    }
}

fn expr_reaches_foreign_work(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, guarded: List[string, mem(normal)]) -> boolean {
    case expr.root < 0 of {
        true -> false;
        false -> {
            node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
            case node.kind < 0 of {
                true -> false;
                false -> case node.kind == 4 of {
                    false -> expr_reaches_foreign_work_pair(parser_ast@expr_at(expr, node.inner), parser_ast@expr_at(expr, node.right_expr), guarded);
                    true -> case is_dangerous_qualified_call(node.name) or is_guarded_local_call(node.name, guarded) of {
                        true -> true;
                        false -> expr_reaches_foreign_work_pair(parser_ast@expr_at(expr, node.inner), parser_ast@expr_at(expr, node.right_expr), guarded)
                    }
                }
            }
        }
    }
}

fn expr_reaches_foreign_work_pair(inner: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, right: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, guarded: List[string, mem(normal)]) -> boolean {
    case expr_reaches_foreign_work(inner, guarded) of {
        true -> true;
        false -> expr_reaches_foreign_work(right, guarded)
    }
}

// One pass: add every function whose body reaches foreign work through what is guarded so far.
fn grow_guarded_names(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], guarded: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case decls.is_nil of {
        true -> guarded;
        false -> case decls.head.tag == 0 of {
            false -> grow_guarded_names(decls.tail, guarded);
            true -> case sir_ast@sir_string_list_contains(guarded, decls.head.name) of {
                true -> grow_guarded_names(decls.tail, guarded);
                false -> case expr_reaches_foreign_work(decls.head.body, guarded) of {
                    true -> grow_guarded_names(decls.tail, append_unique_sir_string(guarded, decls.head.name));
                    false -> grow_guarded_names(decls.tail, guarded)
                }
            }
        }
    }
}

fn count_sir_strings(xs: List[string, mem(normal)]) -> int64 {
    case xs.is_nil of {
        true -> 0;
        false -> 1 + count_sir_strings(xs.tail)
    }
}

// Fixpoint of grow_guarded_names: helpers calling helpers calling a binding are all guarded.
fn guarded_local_fns_fixpoint(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], guarded: List[string, mem(normal)]) -> List[string, mem(normal)] {
    grown: List[string, mem(normal)] <- grow_guarded_names(decls, guarded);
    case count_sir_strings(grown) == count_sir_strings(guarded) of {
        true -> grown;
        false -> guarded_local_fns_fixpoint(decls, grown)
    }
}

fn collect_unit_fn_names(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    guarded_local_fns_fixpoint(decls, collect_unit_foreign_binding_names(decls, acc))
}

// main and every spawned behaviour are the application side; only they are held to the rule for local calls.
fn guarded_fns_for_decl(decl_name: string, entry_fns: List[string, mem(normal)], unit_fns: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case decl_name == "main" of {
        true -> unit_fns;
        false -> case sir_ast@sir_string_list_contains(entry_fns, decl_name) of {
            true -> unit_fns;
            false -> sir_ast@nil_sir_strings()
        }
    }
}

fn is_ffi_worker_fn(current_fn: string, ffi_worker_names: List[string, mem(normal)]) -> boolean {
    case length_bytes(current_fn) == 0 of {
        true -> false;
        false -> sir_ast@sir_string_list_contains(ffi_worker_names, current_fn)
    }
}

fn sequence_body_flag(has_ed: boolean, prev: int64) -> int64 {
    case has_ed of {
        true -> 1;
        false -> prev
    }
}

fn print_placement_error(code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string) -> int64 {
    _: int8 <- diagnostics_core@print_compiler_error("ModuleError", code, loc, msg, "sect4");
    1
}

fn validate_expr_placement(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, current_fn: string, lambda_depth: int64, in_external_danger_body: int64, ffi_worker_names: List[string, mem(normal)], guarded_local_fns: List[string, mem(normal)]) -> int64 {
    case expr.root < 0 of {
        true -> 0;
        false -> {
            node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
            case node.kind < 0 of {
                true -> 0;
                false -> case node.kind == 11 of {
                    true -> {
                        has_ed: boolean <- effect_list_has_external_danger(node.sequence_effects);
                        placement_st: int64 <- case has_ed of {
                            true -> case is_ffi_worker_fn(current_fn, ffi_worker_names) of {
                                false -> case expr_contains_spawn_dangerous_pair(parser_ast@expr_at(expr, node.inner), parser_ast@expr_at(expr, node.right_expr)) of {
                                    true -> print_placement_error("E4047", node.location, "sequence blocks that call spawn_dangerous must not declare external_danger. The external_danger effect is valid only inside the FFI worker behavior passed to spawn_dangerous (spec 4.4)");
                                    false -> print_placement_error("E4041", node.location, "external_danger sequence blocks are only valid directly inside the cast-only behavior function installed by spawn_dangerous for an FFI worker actor (spec 4.6)")
                                };
                                true -> case lambda_depth > 0 of {
                                    true -> print_placement_error("E4041", node.location, "external_danger sequence blocks are only valid directly inside the cast-only behavior function installed by spawn_dangerous for an FFI worker actor (spec 4.6)");
                                    false -> 0
                                }
                            };
                            false -> 0
                        };
                        case placement_st == 0 of {
                            false -> placement_st;
                            true -> {
                                body_flag: int64 <- sequence_body_flag(has_ed, in_external_danger_body);
                                inner_st: int64 <- validate_expr_placement(parser_ast@expr_at(expr, node.inner), current_fn, lambda_depth, body_flag, ffi_worker_names, guarded_local_fns);
                                case inner_st == 0 of {
                                    false -> inner_st;
                                    true -> validate_expr_placement(parser_ast@expr_at(expr, node.right_expr), current_fn, lambda_depth, in_external_danger_body, ffi_worker_names, guarded_local_fns)
                                }
                            }
                        }
                    };
                    false -> case node.kind == 991 of {
                        true -> validate_expr_placement(parser_ast@expr_at(expr, node.inner), current_fn, lambda_depth + 1, in_external_danger_body, ffi_worker_names, guarded_local_fns);
                        false -> case node.kind == 4 of {
                            true -> {
                                danger_st: int64 <- case is_dangerous_qualified_call(node.name) or is_guarded_local_call(node.name, guarded_local_fns) of {
                                    false -> 0;
                                    true -> case in_external_danger_body == 1 of {
                                        false -> print_placement_error("E4042", node.location, "Calls to dangerous_* module functions must appear in the sequence portion of sequence proc[external_danger] ... produces pure ... end inside an FFI worker actor behavior (spec 4.5)");
                                        true -> case is_ffi_worker_fn(current_fn, ffi_worker_names) of {
                                            false -> print_placement_error("E4042", node.location, "Calls to dangerous_* module functions must appear in the sequence portion of sequence proc[external_danger] ... produces pure ... end inside an FFI worker actor behavior (spec 4.5)");
                                            true -> 0
                                        }
                                    }
                                };
                                case danger_st == 0 of {
                                    false -> danger_st;
                                    true -> validate_expr_placement_pair(parser_ast@expr_at(expr, node.inner), parser_ast@expr_at(expr, node.right_expr), current_fn, lambda_depth, in_external_danger_body, ffi_worker_names, guarded_local_fns)
                                }
                            };
                            false -> validate_expr_placement_pair(parser_ast@expr_at(expr, node.inner), parser_ast@expr_at(expr, node.right_expr), current_fn, lambda_depth, in_external_danger_body, ffi_worker_names, guarded_local_fns)
                        }
                    }
                }
            }
        }
    }
}

fn validate_expr_placement_pair(inner: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, right: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, current_fn: string, lambda_depth: int64, in_external_danger_body: int64, ffi_worker_names: List[string, mem(normal)], guarded_local_fns: List[string, mem(normal)]) -> int64 {
    first: int64 <- validate_expr_placement(inner, current_fn, lambda_depth, in_external_danger_body, ffi_worker_names, guarded_local_fns);
    case first == 0 of {
        false -> first;
        true -> validate_expr_placement(right, current_fn, lambda_depth, in_external_danger_body, ffi_worker_names, guarded_local_fns)
    }
}

fn validate_decls_placement_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], ffi_worker_names: List[string, mem(normal)], entry_fns: List[string, mem(normal)], unit_fns: List[string, mem(normal)]) -> int64 {
    case decls.is_nil of {
        true -> 0;
        false -> case decls.head.tag == 0 of {
            true -> {
                body_st: int64 <- validate_expr_placement(decls.head.body, decls.head.name, 0, 0, ffi_worker_names, guarded_fns_for_decl(decls.head.name, entry_fns, unit_fns));
                case body_st == 0 of {
                    false -> body_st;
                    true -> validate_decls_placement_loop(decls.tail, ffi_worker_names, entry_fns, unit_fns)
                }
            };
            false -> validate_decls_placement_loop(decls.tail, ffi_worker_names, entry_fns, unit_fns)
        }
    }
}

fn validate_foreign_work_client_behaviors_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], spawn_names: List[string, mem(normal)], ffi_workers: List[string, mem(normal)], uses_dangerous: boolean) -> int64 {
    case decls.is_nil of {
        true -> 0;
        false -> case decls.head.tag == 0 of {
            true -> {
                is_spawn: boolean <- sir_ast@sir_string_list_contains(spawn_names, decls.head.name);
                is_worker: boolean <- sir_ast@sir_string_list_contains(ffi_workers, decls.head.name);
                client_st: int64 <- case uses_dangerous of {
                    false -> 0;
                    true -> case is_spawn of {
                        false -> 0;
                        true -> case is_worker of {
                            true -> 0;
                            false -> case expr_contains_cast_call(decls.head.body) of {
                                false -> 0;
                                true -> case behavior_return_is_cast_only(decls.head.return_type_name) of {
                                    false -> case behavior_return_is_call_only(decls.head.return_type_name) of {
                                        true -> print_placement_error("E4040", decls.head.location, "Actors that initiate foreign work must use cast-only behaviors (spec 4.3)");
                                        false -> 0
                                    };
                                    true -> 0
                                }
                            }
                        }
                    }
                };
                case client_st == 0 of {
                    false -> client_st;
                    true -> validate_foreign_work_client_behaviors_loop(decls.tail, spawn_names, ffi_workers, uses_dangerous)
                }
            };
            false -> validate_foreign_work_client_behaviors_loop(decls.tail, spawn_names, ffi_workers, uses_dangerous)
        }
    }
}

fn validate_program_ffi_placement(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> int64 {
    spawn_names: List[string, mem(normal)] <- collect_spawn_behavior_names(program);
    ffi_workers: List[string, mem(normal)] <- collect_ffi_worker_names(program);
    uses_dangerous: boolean <- program_uses_dangerous_module(program.declarations);
    entry_fns: List[string, mem(normal)] <- merge_sir_string_lists(spawn_names, ffi_workers);
    unit_fns: List[string, mem(normal)] <- case program_module_is_dangerous(program.declarations) of {
        true -> collect_unit_fn_names(program.declarations, sir_ast@nil_sir_strings());
        false -> sir_ast@nil_sir_strings()
    };
    placement_st: int64 <- validate_decls_placement_loop(program.declarations, ffi_workers, entry_fns, unit_fns);
    case placement_st == 0 of {
        false -> placement_st;
        true -> validate_foreign_work_client_behaviors_loop(program.declarations, spawn_names, ffi_workers, uses_dangerous)
    }
}

fn collect_spawn_behavior_names(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> List[string, mem(normal)] {
    collect_spawn_behavior_names_from_decls(program.declarations)
}

fn find_atom_field_in_record_chain(field_chain: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, field_name: string) -> string {
    case field_chain.root < 0 of {
        true -> "";
        false -> {
            node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(field_chain);
            case node.kind == 21 of {
                false -> "";
                true -> case node.name == field_name of {
                    true -> {
                        inner_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(field_chain, node.inner);
                        inner_n: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(inner_e);
                        case inner_n.kind == 5 of {
                            true -> inner_n.value;
                            false -> ""
                        }
                    };
                    false -> find_atom_field_in_record_chain(parser_ast@expr_at(field_chain, node.right_expr), field_name)
                }
            }
        }
    }
}

fn find_fn_ref_name_in_record_chain(field_chain: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, field_name: string) -> string {
    case field_chain.root < 0 of {
        true -> "";
        false -> {
            node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(field_chain);
            case node.kind == 21 of {
                false -> "";
                true -> case node.name == field_name of {
                    true -> {
                        inner_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(field_chain, node.inner);
                        inner_n: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(inner_e);
                        case inner_n.kind == 1 of {
                            true -> inner_n.name;
                            false -> ""
                        }
                    };
                    false -> find_fn_ref_name_in_record_chain(parser_ast@expr_at(field_chain, node.right_expr), field_name)
                }
            }
        }
    }
}

fn collect_static_dangerous_child_behavior_names_expr(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case expr.root < 0 of {
        true -> acc;
        false -> {
            node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
            case node.kind < 0 of {
                true -> acc;
                false -> {
                    next: List[string, mem(normal)] <- case node.kind == 21 and find_atom_field_in_record_chain(expr, "flavor") == ":dangerous" of {
                        true -> append_unique_sir_string(acc, find_fn_ref_name_in_record_chain(expr, "behavior"));
                        false -> acc
                    };
                    collect_static_dangerous_child_behavior_names_pair(parser_ast@expr_at(expr, node.inner), parser_ast@expr_at(expr, node.right_expr), next)
                }
            }
        }
    }
}

fn collect_static_dangerous_child_behavior_names_pair(inner: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, right: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    mid: List[string, mem(normal)] <- collect_static_dangerous_child_behavior_names_expr(inner, acc);
    collect_static_dangerous_child_behavior_names_expr(right, mid)
}

fn collect_static_dangerous_child_behavior_names_from_decls(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[string, mem(normal)] {
    case decls.is_nil of {
        true -> sir_ast@nil_sir_strings();
        false -> case decls.head.tag == 0 of {
            true -> collect_static_dangerous_child_behavior_names_expr(decls.head.body, collect_static_dangerous_child_behavior_names_from_decls(decls.tail));
            false -> collect_static_dangerous_child_behavior_names_from_decls(decls.tail)
        }
    }
}

fn merge_sir_string_lists(acc: List[string, mem(normal)], items: List[string, mem(normal)]) -> List[string, mem(normal)] {
    case items.is_nil of {
        true -> acc;
        false -> merge_sir_string_lists(append_unique_sir_string(acc, items.head), items.tail)
    }
}

fn collect_ffi_worker_names(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> List[string, mem(normal)] {
    spawn_dangerous_names: List[string, mem(normal)] <- collect_spawn_dangerous_behavior_names_from_decls(program.declarations);
    spawn_behavior_names: List[string, mem(normal)] <- collect_spawn_behavior_names_from_decls(program.declarations);
    static_dangerous_child_names: List[string, mem(normal)] <- collect_static_dangerous_child_behavior_names_from_decls(program.declarations);
    merged_dangerous_names: List[string, mem(normal)] <- merge_sir_string_lists(spawn_dangerous_names, static_dangerous_child_names);
    merged_spawn_names: List[string, mem(normal)] <- merge_sir_string_lists(merged_dangerous_names, spawn_behavior_names);
    build_ffi_worker_names_loop(program.declarations, merged_spawn_names, sir_ast@nil_sir_strings())
}
