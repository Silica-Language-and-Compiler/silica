// Silica-side FFI ABI checker (silica_ffi_wrapper_specification.md §5–§8, §13): validate foreign
// declaration types and sidecar result contracts without parsing C. Phase 7 — post type-check.

use parser_ast;
use diagnostics_core;
use ffi_sidecar_loader;

export validate_program_ffi_abi/1;

fn max_foreign_silica_args() -> int64 {
    8
}

fn is_whitespace_char(c: string) -> boolean {
    c == " " or c == "\t" or c == "\n" or c == "\r"
}

fn trim_leading_from(s: string, pos: int64) -> string {
    case pos >= length_bytes(s) of {
        true -> "";
        false -> {
            c: string <- substring(s, pos, pos + 1);
            case is_whitespace_char(c) of {
                true -> trim_leading_from(s, pos + 1);
                false -> substring(s, pos, length_bytes(s))
            }
        }
    }
}

fn trim_trailing_from(s: string, pos: int64) -> string {
    case pos < 0 of {
        true -> "";
        false -> {
            c: string <- substring(s, pos, pos + 1);
            case is_whitespace_char(c) of {
                true -> trim_trailing_from(s, pos - 1);
                false -> substring(s, 0, pos + 1)
            }
        }
    }
}

fn trim_type_text(type_text: string) -> string {
    lead: string <- trim_leading_from(type_text, 0);
    trim_trailing_from(lead, length_bytes(lead) - 1)
}

fn string_starts_with(s: string, prefix: string) -> boolean {
    case length_bytes(s) >= length_bytes(prefix) of {
        false -> false;
        true -> substring(s, 0, length_bytes(prefix)) == prefix
    }
}

fn type_text_contains_at(s: string, needle: string, i: int64, n: int64, m: int64) -> boolean {
    case i + m > n of {
        true -> false;
        false -> case substring(s, i, i + m) == needle of {
            true -> true;
            false -> type_text_contains_at(s, needle, i + 1, n, m)
        }
    }
}

fn type_text_contains(s: string, needle: string) -> boolean {
    m: int64 <- length_bytes(needle);
    n: int64 <- length_bytes(s);
    case m == 0 of {
        true -> true;
        false -> type_text_contains_at(s, needle, 0, n, m)
    }
}

fn is_scalar_abi_type(type_text: string) -> boolean {
    t: string <- trim_type_text(type_text);
    case t == "int8" of {
        true -> true;
        false -> case t == "int16" of {
            true -> true;
            false -> case t == "int32" of {
                true -> true;
                false -> case t == "int64" of {
                    true -> true;
                    false -> case t == "uint8" of {
                        true -> true;
                        false -> case t == "uint16" of {
                            true -> true;
                            false -> case t == "uint32" of {
                                true -> true;
                                false -> case t == "uint64" of {
                                    true -> true;
                                    false -> case t == "float32" of {
                                        true -> true;
                                        false -> case t == "float64" of {
                                            true -> true;
                                            false -> t == "boolean"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn is_record_abi_type(type_text: string) -> boolean {
    t: string <- trim_type_text(type_text);
    case length_bytes(t) >= 2 of {
        false -> false;
        true -> substring(t, 0, 1) == "{" and substring(t, length_bytes(t) - 1, length_bytes(t)) == "}"
    }
}

fn is_foreign_type_disallowed(type_text: string) -> boolean {
    t: string <- trim_type_text(type_text);
    case t == "string" of {
        true -> true;
        false -> case t == "void" of {
            true -> true;
            false -> case t == "actor_ref" of {
                true -> true;
                false -> case t == "atom" of {
                    true -> true;
                    false -> case string_starts_with(t, "ref(") of {
                        true -> true;
                        false -> case string_starts_with(t, "buf(") of {
                            true -> true;
                            false -> case string_starts_with(t, "atomic_ref(") of {
                                true -> true;
                                false -> case string_starts_with(t, "List[") of {
                                    true -> true;
                                    false -> case string_starts_with(t, "region(") of {
                                        true -> true;
                                        false -> case string_starts_with(t, "void ") of {
                                            true -> true;
                                            false -> false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn is_foreign_type_allowed(type_text: string) -> boolean {
    case is_foreign_type_disallowed(type_text) of {
        true -> false;
        false -> case is_scalar_abi_type(type_text) of {
            true -> true;
            false -> is_record_abi_type(type_text)
        }
    }
}

fn count_params(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> int64 {
    case params.is_nil of {
        true -> 0;
        false -> 1 + count_params(params.tail)
    }
}

fn params_have_string_type(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> boolean {
    case params.is_nil of {
        true -> false;
        false -> case trim_type_text(params.head.type_name) == "string" of {
            true -> true;
            false -> params_have_string_type(params.tail)
        }
    }
}

fn params_have_ptr_len_pair(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> boolean {
    // List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] is stored in reverse lexical order (last parameter at head).
    case params.is_nil of {
        true -> false;
        false -> case params.tail.is_nil of {
            true -> false;
            false -> case trim_type_text(params.tail.head.type_name) == "uint8" and trim_type_text(params.head.type_name) == "uint64" of {
                true -> true;
                false -> params_have_ptr_len_pair(params.tail)
            }
        }
    }
}

fn fn_decl_has_string_param(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> boolean {
    params_have_string_type(decl.parameters)
}

fn fn_decl_has_string_return(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> boolean {
    trim_type_text(decl.return_type_name) == "string"
}

fn return_type_has_ptr_len_fields(return_type: string) -> boolean {
    case type_text_contains(return_type, "text_ptr") of {
        true -> type_text_contains(return_type, "text_len");
        false -> case type_text_contains(return_type, "_ptr") of {
            true -> type_text_contains(return_type, "_len");
            false -> false
        }
    }
}

fn remove_spaces_from_type_text_loop(s: string, i: int64, acc: string) -> string {
    case i >= length_bytes(s) of {
        true -> acc;
        false -> {
            ch: string <- substring(s, i, i + 1);
            case is_whitespace_char(ch) of {
                true -> remove_spaces_from_type_text_loop(s, i + 1, acc);
                false -> remove_spaces_from_type_text_loop(s, i + 1, concat(acc, ch))
            }
        }
    }
}

fn normalize_type_text_for_field_match(type_text: string) -> string {
    trimmed: string <- trim_type_text(type_text);
    remove_spaces_from_type_text_loop(trimmed, 0, "")
}

fn return_type_is_tagged_result_shape(return_type: string) -> boolean {
    norm: string <- normalize_type_text_for_field_match(return_type);
    case type_text_contains(norm, "tag:") of {
        true -> case type_text_contains(norm, "value:") of {
            true -> type_text_contains(norm, "error_code:");
            false -> false
        };
        false -> false
    }
}

fn print_abi_type_error(code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string) -> int64 {
    _: int8 <- diagnostics_core@print_compiler_error("TypeError", code, loc, msg, "sect8");
    1
}

fn validate_param_types_loop(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], loc: { file: string, line: int64, column: int64, offset: int64 }) -> int64 {
    sequence
        result: int64 <- case params of {
            []: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] -> 0;
            [head: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, tail: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]] -> case trim_type_text(head.type_name) == "string" of {
                true -> print_abi_type_error("E2110", head.location, "raw foreign c_wrapper bindings must use pointer-plus-length arguments instead of Silica string (spec 6.1)");
                false -> case is_foreign_type_allowed(head.type_name) of {
                    false -> print_abi_type_error("E2112", head.location, "foreign c_wrapper declaration uses a disallowed Silica-facing type; use fixed-width scalars, boolean, or inline non-recursive records (spec 5.4–5.5)");
                    true -> validate_param_types_loop(tail, loc)
                }
            };
            _: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] -> 0
        }
    produces
        pure result
    end
}

fn validate_foreign_return_type(return_type: string, loc: { file: string, line: int64, column: int64, offset: int64 }) -> int64 {
    case trim_type_text(return_type) == "string" of {
        true -> print_abi_type_error("E2110", loc, "raw foreign c_wrapper bindings must not return Silica string directly; use pointer-plus-length fields in a result record (spec 6.1)");
        false -> case is_foreign_type_allowed(return_type) of {
            false -> print_abi_type_error("E2112", loc, "foreign c_wrapper declaration uses a disallowed Silica-facing return type (spec 5.4–5.5)");
            true -> 0
        }
    }
}

fn validate_sidecar_result_shape(result_kind: string, return_type: string, loc: { file: string, line: int64, column: int64, offset: int64 }) -> int64 {
    kind: string <- trim_type_text(result_kind);
    ret: string <- trim_type_text(return_type);
    case kind == "scalar" of {
        true -> case is_scalar_abi_type(ret) of {
            false -> print_abi_type_error("E2113", loc, "sidecar result: scalar requires a scalar foreign return type (spec 13.2)");
            true -> 0
        };
        false -> case kind == "tagged_result" of {
            true -> case return_type_is_tagged_result_shape(ret) of {
                false -> print_abi_type_error("E2113", loc, "sidecar result: tagged_result requires { tag: int64, value: int64, error_code: int64 } return shape (spec 9.1–9.2)");
                true -> 0
            };
            false -> case kind == "struct" of {
                true -> case is_record_abi_type(ret) of {
                    false -> print_abi_type_error("E2113", loc, "sidecar result: struct requires an inline record foreign return type (spec 6.8)");
                    true -> 0
                };
                false -> 0
            }
        }
    }
}

fn validate_one_foreign_decl(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, default_paths: List[string, mem(normal)]) -> int64 {
    arg_count: int64 <- count_params(decl.parameters);
    case arg_count > max_foreign_silica_args() of {
        true -> print_abi_type_error("E2111", decl.location, "foreign c_wrapper declarations may have at most eight Silica-level arguments after lowering (spec 6.1)");
        false -> {
            param_st: int64 <- validate_param_types_loop(decl.parameters, decl.location);
            case param_st == 0 of {
                false -> param_st;
                true -> {
                    ret_st: int64 <- validate_foreign_return_type(decl.return_type_name, decl.return_type_location);
                    case ret_st == 0 of {
                        false -> ret_st;
                        true -> {
                            paths: List[string, mem(normal)] <- ffi_sidecar_loader@sidecar_paths_for_foreign_decl(decl, default_paths);
                            sym: string <- ffi_sidecar_loader@foreign_symbol_from_decl(decl);
                            (found: boolean, result_kind: string) <- ffi_sidecar_loader@lookup_sidecar_wrapper_result_kind(paths, sym);
                            case found of {
                                false -> 0;
                                true -> validate_sidecar_result_shape(result_kind, decl.return_type_name, decl.return_type_location)
                            }
                        }
                    }
                }
            }
        }
    }
}

fn module_has_foreign_ptr_len_binding(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> boolean {
    case decls.is_nil of {
        true -> false;
        false -> case decls.head.tag == 9 of {
            true -> case params_have_ptr_len_pair(decls.head.parameters) of {
                true -> true;
                false -> module_has_foreign_ptr_len_binding(decls.tail)
            };
            false -> module_has_foreign_ptr_len_binding(decls.tail)
        }
    }
}

fn module_has_foreign_ptr_len_return(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> boolean {
    case decls.is_nil of {
        true -> false;
        false -> case decls.head.tag == 9 of {
            true -> case return_type_has_ptr_len_fields(decls.head.return_type_name) of {
                true -> true;
                false -> module_has_foreign_ptr_len_return(decls.tail)
            };
            false -> module_has_foreign_ptr_len_return(decls.tail)
        }
    }
}

fn expr_calls_named_fn(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, fn_name: string) -> boolean {
    case expr.root < 0 of {
        true -> false;
        false -> {
            node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
            case node.kind < 0 of {
                true -> false;
                false -> case node.kind == 4 of {
                    true -> case node.name == fn_name of {
                        true -> true;
                        false -> case expr_calls_named_fn(parser_ast@expr_at(expr, node.inner), fn_name) of {
                            true -> true;
                            false -> expr_calls_named_fn(parser_ast@expr_at(expr, node.right_expr), fn_name)
                        }
                    };
                    false -> case expr_calls_named_fn(parser_ast@expr_at(expr, node.inner), fn_name) of {
                        true -> true;
                        false -> expr_calls_named_fn(parser_ast@expr_at(expr, node.right_expr), fn_name)
                    }
                }
            }
        }
    }
}

fn adapter_body_calls_any_foreign_raw(body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> boolean {
    sequence
        result: boolean <- case decls of {
            []: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] -> false;
            [head: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, tail: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]] -> case head.tag == 9 of {
                true -> case expr_calls_named_fn(body, head.name) of {
                    true -> true;
                    false -> adapter_body_calls_any_foreign_raw(body, tail)
                };
                false -> adapter_body_calls_any_foreign_raw(body, tail)
            };
            _: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] -> false
        }
    produces
        pure result
    end
}

fn validate_adapter_two_layer(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> int64 {
    case adapter_body_calls_any_foreign_raw(decl.body, decls) of {
        false -> 0;
        true -> case fn_decl_has_string_param(decl) of {
            false -> case fn_decl_has_string_return(decl) of {
                true -> case module_has_foreign_ptr_len_return(decls) of {
                    false -> print_abi_type_error("E2114", decl.return_type_location, "adapter wrapper returning string requires a raw foreign binding whose result record exposes pointer-plus-length fields (spec 6.1)");
                    true -> 0
                };
                false -> 0
            };
            true -> case module_has_foreign_ptr_len_binding(decls) of {
                false -> print_abi_type_error("E2114", decl.location, "adapter wrapper with string parameter requires a raw foreign binding using uint8 pointer plus uint64 length arguments (spec 6.1)");
                true -> case fn_decl_has_string_return(decl) of {
                    true -> case module_has_foreign_ptr_len_return(decls) of {
                        false -> print_abi_type_error("E2114", decl.return_type_location, "adapter wrapper returning string requires a raw foreign binding whose result record exposes pointer-plus-length fields (spec 6.1)");
                        true -> 0
                    };
                    false -> 0
                }
            }
        }
    }
}

fn validate_decls_abi_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], all_decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], default_paths: List[string, mem(normal)]) -> int64 {
    sequence
        result: int64 <- case decls of {
            []: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] -> 0;
            [head: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, tail: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]] -> case head.tag == 9 of {
                true -> {
                    st: int64 <- validate_one_foreign_decl(head, default_paths);
                    case st == 0 of {
                        false -> st;
                        true -> validate_decls_abi_loop(tail, all_decls, default_paths)
                    }
                };
                false -> case head.tag == 0 of {
                    true -> {
                        ad_st: int64 <- validate_adapter_two_layer(head, all_decls);
                        case ad_st == 0 of {
                            false -> ad_st;
                            true -> validate_decls_abi_loop(tail, all_decls, default_paths)
                        }
                    };
                    false -> validate_decls_abi_loop(tail, all_decls, default_paths)
                }
            };
            _: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] -> 0
        }
    produces
        pure result
    end
}

fn validate_program_ffi_abi(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> int64 {
    sequence
        default_paths: List[string, mem(normal)] <- ffi_sidecar_loader@collect_module_default_sidecar_lexemes_from_program(program.declarations);
        result: int64 <- validate_decls_abi_loop(program.declarations, program.declarations, default_paths)
    produces
        pure result
    end
}
