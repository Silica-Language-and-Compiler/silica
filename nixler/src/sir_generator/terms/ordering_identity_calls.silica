// Ordering identity built-in calls to SIR prim terms (Layer 1 §7.2).

use sir_ast;
use types;
use parser_ast;

export is_ordering_identity_builtin/1;
export build_ordering_identity_prim_from_sir/4;
export is_fn_bind_type/1;
export is_lifted_lambda_identifier/1;
export ordering_env_binding_name/1;
export context_has_ordering_env_binding/2;
export build_ordering_env_zero/0;
export build_ordering_env_init/1;
export wrap_fn_let_with_ordering_env/6;
export prepare_fn_binding_context/4;
export build_fn_binding_lets/5;
export build_ordering_env_for_fn_operand/2;

fn is_ordering_identity_builtin(call_name: string) -> boolean {
    call_name == "ordering_identity_fresh_env" or call_name == "ordering_identity_materialize" or call_name == "ordering_identity_same" or call_name == "ordering_identity_bundle_make"
}

fn is_fn_bind_type(type_str: string) -> boolean {
    t: string <- type_str;
    case length_bytes(t) >= 3 and substring(t, 0, 3) == "fn(" of {
        true -> true;
        false -> case length_bytes(t) >= 4 and substring(t, 0, 4) == "fn (" of {
            true -> true;
            false -> false
        }
    }
}

fn is_lifted_lambda_identifier(name: string) -> boolean {
    lifted_lambda_sub_at(name, 0)
}

fn lifted_lambda_sub_at(m: string, i: int64) -> boolean {
    case i + 6 > length_bytes(m) of {
        true -> false;
        false -> case substring(m, i, i + 6) == ".__lam" of {
            true -> true;
            false -> lifted_lambda_sub_at(m, i + 1)
        }
    }
}

fn ordering_env_binding_name(bind_name: string) -> string {
    concat(bind_name, ".__oid_env")
}

// SIR generator keeps a type_name string env (not type_checker_core's type_id env).
fn sir_env_has_name(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], name: string) -> boolean {
    case env.is_nil of {
        true -> false;
        false -> case env.head.name == name of {
            true -> true;
            false -> sir_env_has_name(env.tail, name)
        }
    }
}

fn sir_env_add_symbol(env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], source_module: string) -> List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] {
    sequence proc[mem(normal)]
        entry: { name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string } <- { name: name, type_name: type_name, declared_effects: declared_effects, is_effect_alias: false, source_module: source_module };
        result: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- prepend[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)](entry, env)
    produces
        pure result
    end
}

fn context_has_ordering_env_binding(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, bind_name: string) -> boolean {
    env_name: string <- ordering_env_binding_name(bind_name);
    sir_env_has_name(context.env, env_name)
}

fn build_ordering_env_zero() -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_ast@make_sir_term(0, "int64", "0", "", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
}

fn build_ordering_env_init(use_fresh: boolean) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case use_fresh of {
        true -> sir_ast@make_sir_term(6, "int64", "[]", "ordering_identity_fresh_env", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
        false -> build_ordering_env_zero()
    }
}

fn rhs_is_lambda_identifier(rhs_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(rhs_expr);
    case node.kind == 1 of {
        true -> is_lifted_lambda_identifier(node.name);
        false -> false
    }
}

fn needs_ordering_env_binding(bind_type: string, bind_name: string, rhs_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    case is_fn_bind_type(bind_type) of {
        false -> false;
        true -> case length_bytes(bind_name) == 1 and substring(bind_name, 0, 1) == "_" of {
            true -> false;
            false -> true
        }
    }
}

fn use_fresh_ordering_env_for_rhs(rhs_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    rhs_is_lambda_identifier(rhs_expr)
}

fn build_ordering_env_for_fn_operand(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, fn_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(fn_expr);
    case node.kind == 1 of {
        true -> case context_has_ordering_env_binding(context, node.name) of {
            true -> {
                env_name: string <- ordering_env_binding_name(node.name);
                prefixed: string <- concat("%", env_name);
                sir_ast@make_sir_term(1, "int64", "", prefixed, sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term())
            };
            false -> build_ordering_env_zero()
        };
        false -> build_ordering_env_zero()
    }
}

fn prepare_fn_binding_context(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, bind_name: string, bind_type: string, rhs_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } {
    case needs_ordering_env_binding(bind_type, bind_name, rhs_expr) of {
        false -> {
            new_env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- sir_env_add_symbol(context.env, bind_name, bind_type, parser_ast@empty_effect_name_list(), "");
            { env: new_env }
        };
        true -> {
            env_name: string <- ordering_env_binding_name(bind_name);
            env_symbols: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- sir_env_add_symbol(context.env, env_name, "int64", parser_ast@empty_effect_name_list(), "");
            fn_symbols: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] <- sir_env_add_symbol(env_symbols, bind_name, bind_type, parser_ast@empty_effect_name_list(), "");
            { env: fn_symbols }
        }
    }
}

fn build_fn_binding_lets(bind_name: string, bind_type: string, rhs_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rhs_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, inner_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    bind_type_sir: string <- types@type_name_to_sir(bind_type);
    fn_prefixed: string <- concat("%", bind_name);
    fn_let: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- sir_ast@make_sir_term(2, bind_type_sir, "", fn_prefixed, rhs_sir, inner_sir);
    case needs_ordering_env_binding(bind_type, bind_name, rhs_expr) of {
        false -> fn_let;
        true -> {
            env_name: string <- ordering_env_binding_name(bind_name);
            env_prefixed: string <- concat("%", env_name);
            env_init: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_ordering_env_init(use_fresh_ordering_env_for_rhs(rhs_expr));
            sir_ast@make_sir_term(2, "int64", "", env_prefixed, env_init, fn_let)
        }
    }
}

fn wrap_fn_let_with_ordering_env(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, bind_name: string, bind_type: string, rhs_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, rhs_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, inner_sir: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> ({ nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }) {
    new_context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- prepare_fn_binding_context(context, bind_name, bind_type, rhs_expr);
    let_term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- build_fn_binding_lets(bind_name, bind_type, rhs_expr, rhs_sir, inner_sir);
    (let_term, new_context)
}

fn build_ordering_identity_prim_from_sir(call_name: string, arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, expected_type: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_type: string <- types@type_name_to_sir(expected_type);
    case call_name of {
        "ordering_identity_fresh_env" -> sir_ast@make_sir_term(6, sir_type, "[]", "ordering_identity_fresh_env", sir_ast@dummy_sir_term(), sir_ast@dummy_sir_term());
        "ordering_identity_materialize" -> sir_ast@make_sir_term(6, sir_type, "[]", "ordering_identity_make", arg1, arg2);
        "ordering_identity_same" -> sir_ast@make_sir_term(6, sir_type, "[]", "ordering_identity_same", arg1, arg2);
        "ordering_identity_bundle_make" -> sir_ast@make_sir_term(6, sir_type, "[]", "ordering_identity_bundle_make", arg1, arg2);
        _: string -> sir_ast@make_sir_term(6, sir_type, "[]", call_name, arg1, arg2)
    }
}
