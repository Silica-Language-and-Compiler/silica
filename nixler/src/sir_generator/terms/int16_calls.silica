// Function call expression to SIR term ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } kind 4, extension)
// Built-in I/O: print_int16(int16:x), print_uint16(uint16:x) -> call(atom, main.print_*, [arg], [device_io])
// Effect set carried on SIR handle.value per sir_design_spec §5.2.5

use sir_ast;

export build_print_int16_from_sir/2;

fn qual_name(name: string) -> string {
    concat("main.", name)
}

// Effect sets for built-in functions (spec §9.1.1, §9.3.1)
fn builtin_call_effects(call_name: string) -> string {
    case call_name of {
        "print_int16" -> "[device_io]";
        "print_uint16" -> "[device_io]";
        _: string -> "[]"
    }
}

// Build SIR call term from call name and already-converted arg SIR term
fn build_print_int16_from_sir(call_name: string, arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case call_name == "print_int16" of {
        true -> {
            callee: string <- qual_name(call_name);
            eff: string <- builtin_call_effects(call_name);
            sir_ast@make_sir_term(4, "atom", eff, callee, arg, sir_ast@dummy_sir_term())
        };
        false -> case call_name == "print_uint16" of {
            true -> {
                callee: string <- qual_name(call_name);
                eff: string <- builtin_call_effects(call_name);
                sir_ast@make_sir_term(4, "atom", eff, callee, arg, sir_ast@dummy_sir_term())
            };
            false -> sir_ast@dummy_sir_term()
        }
    }
}
