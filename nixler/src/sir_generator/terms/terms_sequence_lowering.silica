// Sequence block -> nested lets SIR lowering (open recursion callbacks).

use collection_constructor_calls;
use ordering_identity_calls;
use sir_ast;
use tuple_decompose;
use type_checker_expressions_helpers;
use type_checker_tuple_decompose_helpers;
use types;
use terms_helpers;
use terms_tuple_lowering;

export lower_sequence_block_in_body/7;
export lower_sequence_block_with_expected/5;

fn lower_sequence_block_with_expected(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    lower_sequence_body_to_lets(context, type_checker_expressions_helpers@expr_child_inner(expr), type_checker_expressions_helpers@expr_child_right(expr), { expected_type: expected_type, bound_name: "", bound_type: "", in_body: false }, lower_expected, lower_in_body)
}

fn lower_sequence_block_in_body(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, bound_name: string, bound_type: string, expected_type: string, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    lower_sequence_body_to_lets(context, type_checker_expressions_helpers@expr_child_inner(expr), type_checker_expressions_helpers@expr_child_right(expr), { expected_type: expected_type, bound_name: bound_name, bound_type: bound_type, in_body: true }, lower_expected, lower_in_body)
}

fn lower_sequence_body_to_lets(context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, body_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, result_expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, opts: { expected_type: string, bound_name: string, bound_type: string, in_body: boolean }, lower_expected: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, lower_in_body: fn({ env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] }, { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, string, string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    case type_checker_expressions_helpers@expr_kind(body_expr) == -1 of {
        true -> case opts.in_body of {
            true -> lower_in_body(context, result_expr, opts.bound_name, opts.bound_type, opts.expected_type);
            false -> lower_expected(context, result_expr, opts.expected_type)
        };
        false -> case type_checker_expressions_helpers@expr_kind(body_expr) == 6 of {
            true -> {
                rhs: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case opts.in_body of {
                    true -> lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(body_expr), opts.bound_name, opts.bound_type, type_checker_expressions_helpers@expr_value(body_expr));
                    false -> lower_expected(context, type_checker_expressions_helpers@expr_child_inner(body_expr), type_checker_expressions_helpers@expr_value(body_expr))
                };
                case collection_constructor_calls@is_collection_constructor_let_in(context.env, type_checker_expressions_helpers@expr_value(body_expr), type_checker_expressions_helpers@expr_child_inner(body_expr)) == 1 of {
                    true -> {
                        bind_context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- { env: terms_helpers@sir_env_add_symbol(context.env, type_checker_expressions_helpers@expr_name(body_expr), type_checker_expressions_helpers@expr_value(body_expr)) };
                        inner_body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_sequence_body_to_lets(bind_context, type_checker_expressions_helpers@expr_child_right(body_expr), result_expr, { expected_type: opts.expected_type, bound_name: type_checker_expressions_helpers@expr_name(body_expr), bound_type: type_checker_expressions_helpers@expr_value(body_expr), in_body: true }, lower_expected, lower_in_body);
                        collection_constructor_calls@build_collection_constructor_lets(bind_context, type_checker_expressions_helpers@expr_name(body_expr), type_checker_expressions_helpers@expr_value(body_expr), type_checker_expressions_helpers@expr_child_inner(body_expr), rhs, inner_body)
                    };
                    false -> {
                        bind_context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- ordering_identity_calls@prepare_fn_binding_context(context, type_checker_expressions_helpers@expr_name(body_expr), type_checker_expressions_helpers@expr_value(body_expr), type_checker_expressions_helpers@expr_child_inner(body_expr));
                        inner_body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_sequence_body_to_lets(bind_context, type_checker_expressions_helpers@expr_child_right(body_expr), result_expr, { expected_type: opts.expected_type, bound_name: type_checker_expressions_helpers@expr_name(body_expr), bound_type: type_checker_expressions_helpers@expr_value(body_expr), in_body: true }, lower_expected, lower_in_body);
                        ordering_identity_calls@build_fn_binding_lets(type_checker_expressions_helpers@expr_name(body_expr), type_checker_expressions_helpers@expr_value(body_expr), type_checker_expressions_helpers@expr_child_inner(body_expr), rhs, inner_body)
                    }
                }
            };
            false -> case type_checker_expressions_helpers@expr_kind(body_expr) == 10 of {
                true -> {
                    rhs_type_infer: string <- terms_tuple_lowering@sir_tuple_decompose_rhs_type(body_expr, context);
                    rhs_type: string <- case length_bytes(rhs_type_infer) < 2 or substring(rhs_type_infer, 0, 1) != "(" of {
                        true -> type_checker_tuple_decompose_helpers@build_pattern_type_from_bindings(type_checker_expressions_helpers@expr_pattern_bindings(body_expr));
                        false -> rhs_type_infer
                    };
                    case length_bytes(rhs_type) < 2 or substring(rhs_type, 0, 1) != "(" of {
                        true -> sir_ast@dummy_sir_term();
                        false -> {
                            filled_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)] <- tuple_decompose@tuple_decompose_filled_bindings(body_expr, rhs_type);
                            rhs_term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case opts.in_body of {
                                true -> lower_in_body(context, type_checker_expressions_helpers@expr_child_inner(body_expr), opts.bound_name, opts.bound_type, rhs_type);
                                false -> lower_expected(context, type_checker_expressions_helpers@expr_child_inner(body_expr), rhs_type)
                            };
                            extended_context: { env: List[{ name: string, type_name: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)] } <- terms_helpers@add_bindings_to_context(context, filled_bindings);
                            body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- lower_sequence_body_to_lets(extended_context, type_checker_expressions_helpers@expr_child_right(body_expr), result_expr, { expected_type: opts.expected_type, bound_name: "", bound_type: "", in_body: true }, lower_expected, lower_in_body);
                            tuple_decompose@build_decompose_lets(rhs_term, filled_bindings, body, context, rhs_type)
                        }
                    }
                };
                false -> {
                    rhs: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case opts.in_body of {
                        true -> lower_in_body(context, body_expr, opts.bound_name, opts.bound_type, opts.expected_type);
                        false -> lower_expected(context, body_expr, opts.expected_type)
                    };
                    result: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case opts.in_body of {
                        true -> lower_in_body(context, result_expr, opts.bound_name, opts.bound_type, opts.expected_type);
                        false -> lower_expected(context, result_expr, opts.expected_type)
                    };
                    sir_ast@make_sir_term(2, types@type_name_to_sir(opts.expected_type), "", "%_", rhs, result)
                }
            }
        }
    }
}

