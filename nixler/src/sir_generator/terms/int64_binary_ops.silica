// Binary operator expression to SIR term ({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } kind 3, extension)
// Arithmetic: +, -, *, /, % -> prim(add, sub, mul, div, rem)
// Comparison: <, >, <=, >=, ==, != -> prim(lt, gt, le, ge, eq, ne)

use sir_ast;
use types;

export build_prim_from_sir/3;

fn op_to_prim_and_type(op: string) -> (string, string) {
    case op of {
        "+" -> ("add", "int64");
        "-" -> ("sub", "int64");
        "*" -> ("mul", "int64");
        "/" -> ("div", "int64");
        "%" -> ("rem", "int64");
        "<" -> ("lt", "bool");
        ">" -> ("gt", "bool");
        "<=" -> ("le", "bool");
        ">=" -> ("ge", "bool");
        "!=" -> ("nq", "bool");
        "==" -> ("eq", "bool");
        "and" -> ("and", "bool");
        "or" -> ("or", "bool");
        _: string -> ("", "int64")
    }
}

fn build_prim_from_sir(op_lexeme: string, left: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, right: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    (prim_op: string, result_type: string) <- op_to_prim_and_type(op_lexeme);
    sir_type: string <- types@type_name_to_sir(result_type);
    sir_ast@make_sir_term(6, sir_type, "", prim_op, left, right)
}
