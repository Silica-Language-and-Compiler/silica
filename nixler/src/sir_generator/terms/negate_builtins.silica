// Built-in negate_<primitive>/1 — lowers to unary prim(neg, ...) per sir_design_spec §7.1
// Signed integers and floats only (no unsigned integers, no unit). Kept separate from print/call helpers.

use sir_ast;
use types;

export is_negate_builtin/1;
export negate_arg_type/1;
export build_negate_from_sir/2;

fn negate_arg_type(name: string) -> string {
    case name of {
        "negate_int8" -> "int8";
        "negate_int16" -> "int16";
        "negate_int32" -> "int32";
        "negate_int64" -> "int64";
        "negate_float16" -> "float16";
        "negate_float32" -> "float32";
        "negate_float64" -> "float64";
        _: string -> ""
    }
}

fn is_negate_builtin(name: string) -> boolean {
    length_bytes(negate_arg_type(name)) > 0
}

fn build_negate_from_sir(call_name: string, arg: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    num_type: string <- negate_arg_type(call_name);
    sir_type: string <- types@type_name_to_sir(num_type);
    sir_ast@make_sir_term(6, sir_type, "", "neg", arg, sir_ast@dummy_sir_term())
}
