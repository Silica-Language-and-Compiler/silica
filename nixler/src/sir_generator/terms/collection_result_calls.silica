// Collection result and comparator built-in calls to SIR prim terms (Layer 1 §7.7).

use sir_ast;
use types;

export is_collection_result_builtin/1;
export build_collection_result_prim_from_sir/3;

fn is_collection_result_builtin(call_name: string) -> boolean {
    call_name == "comparator_result_valid" or call_name == "comparator_result_validate"
}

fn build_collection_result_prim_from_sir(call_name: string, arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, expected_type: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_type: string <- types@type_name_to_sir(expected_type);
    sir_ast@make_sir_term(6, sir_type, "[]", call_name, arg1, sir_ast@dummy_sir_term())
}
