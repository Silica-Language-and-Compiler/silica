// Checked int64 arithmetic built-in calls to SIR prim terms (Layer 1 §7.8).

use sir_ast;
use types;

export is_checked_int64_builtin/1;
export is_checked_int64_unary_builtin/1;
export build_checked_int64_prim_from_sir/4;

fn is_checked_int64_builtin(call_name: string) -> boolean {
    call_name == "checked_int64_add" or call_name == "checked_int64_mul" or call_name == "checked_int64_add1" or call_name == "checked_int64_byte_size"
}

fn is_checked_int64_unary_builtin(call_name: string) -> boolean {
    call_name == "checked_int64_add1"
}

fn build_checked_int64_prim_from_sir(call_name: string, arg1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, arg2: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, expected_type: string) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    sir_type: string <- types@type_name_to_sir(expected_type);
    sir_ast@make_sir_term(6, sir_type, "[]", call_name, arg1, arg2)
}
