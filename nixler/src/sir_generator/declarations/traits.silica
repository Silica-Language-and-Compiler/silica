// Trait-related declarations (silica-specification §3.4.8): tags 5–7 on parser_ast.{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }.
// Tag 0 (provided methods, impl fn, ordinary fn) stays in functions.silica.

use parser_ast;
use sir_ast;
use types;
use effect_serializer;
use functions;
use type_checker_traits;

export collect_export_trait_names/1;
export collect_marker_impl_types/1;
export collect_required_trait_method_sigs/1;
export collect_supervisor_impl_types/1;
export collect_failure_reporter_impl_types/1;
export collect_supervisor_phase_e/1;

// Phase E: `fn init(_: ActorState) -> (supervisor_flags, List[child_spec,…])` — SIR of return type, keyed by
// each `impl T for Supervisor` (same `init` is duplicated per marker when multiple markers; rare).
fn is_supervisor_init_for_phase_e(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> boolean {
    case decl.tag == 0 of {
        false -> false;
        true -> case decl.name == "init" of {
            false -> false;
            true -> case decl.parameters.is_nil of {
                true -> false;
                false -> case decl.parameters.tail.is_nil of {
                    false -> false;
                    true -> type_checker_traits@trim_type_text(decl.parameters.head.type_name) == "ActorState"
                }
            }
        }
    }
}

fn find_supervisor_init_decl_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> (boolean, { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) {
    case decls.is_nil of {
        true -> (false, parser_ast@dummy_decl());
        false -> case is_supervisor_init_for_phase_e(decls.head) of {
            true -> (true, decls.head);
            false -> find_supervisor_init_decl_loop(decls.tail)
        }
    }
}

fn build_supervisor_phase_e_rows_for_types(sup_types: List[string, mem(normal)], ret_sir: string, ret_type_name: string) -> List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)] {
    case sup_types.is_nil of {
        true -> sir_ast@nil_supervisor_phase_e();
        false -> {
            row: { actor_type: string, init_return_sir: string, init_return_type_name: string } <- { actor_type: sup_types.head, init_return_sir: ret_sir, init_return_type_name: ret_type_name };
            sir_ast@cons_supervisor_phase_e(row, build_supervisor_phase_e_rows_for_types(sup_types.tail, ret_sir, ret_type_name))
        }
    }
}

fn collect_supervisor_phase_e(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)] {
    sup_types: List[string, mem(normal)] <- collect_supervisor_impl_types(decls);
    case sup_types.is_nil of {
        true -> sir_ast@nil_supervisor_phase_e();
        false -> {
            (found: boolean, init_d: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) <- find_supervisor_init_decl_loop(decls);
            case found of {
                false -> sir_ast@nil_supervisor_phase_e();
                true -> {
                    ret_sir: string <- types@type_name_to_sir(init_d.return_type_name);
                    ret_type_name: string <- type_checker_traits@trim_type_text(init_d.return_type_name);
                    build_supervisor_phase_e_rows_for_types(sup_types, ret_sir, ret_type_name)
                }
            }
        }
    }
}

fn collect_export_trait_names_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[string, mem(normal)] {
    case decls.is_nil of {
        true -> sir_ast@nil_sir_strings();
        false -> case decls.head.tag == 5 of {
            true -> sir_ast@cons_sir_string(decls.head.name, collect_export_trait_names_loop(decls.tail));
            false -> collect_export_trait_names_loop(decls.tail)
        }
    }
}

fn collect_export_trait_names(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[string, mem(normal)] {
    collect_export_trait_names_loop(decls)
}

fn collect_marker_impl_types_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[string, mem(normal)] {
    case decls.is_nil of {
        true -> sir_ast@nil_sir_strings();
        false -> case decls.head.tag == 6 of {
            true -> sir_ast@cons_sir_string(decls.head.return_type_name, collect_marker_impl_types_loop(decls.tail));
            false -> collect_marker_impl_types_loop(decls.tail)
        }
    }
}

fn collect_marker_impl_types(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[string, mem(normal)] {
    collect_marker_impl_types_loop(decls)
}

// §15.4.13 / supervisors plan Phase D: `impl ActorType for Supervisor;` ({ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } tag 6) — extract concrete actor type T for runtime supervisor flag (exit ingress / init table).
fn for_supervisor_impl_suffix() -> string {
    " for Supervisor"
}

fn for_supervisor_phase_a_impl_suffix() -> string {
    " for SupervisorPhaseA"
}

fn packed_for_supervisor_suffix() -> string {
    "forSupervisor"
}

fn packed_for_supervisor_phase_a_suffix() -> string {
    "forSupervisorPhaseA"
}

fn string_ends_with_suffix(s: string, suf: string) -> boolean {
    ls: int64 <- length_bytes(s);
    lf: int64 <- length_bytes(suf);
    case ls < lf of { true -> false; false -> substring(s, ls - lf, ls) == suf }
}

fn drop_ws_chars_from(s: string, i: int64, acc: string) -> string {
    case i >= length_bytes(s) of {
        true -> acc;
        false -> {
            ch: string <- substring(s, i, i + 1);
            case ch == " " or ch == "\t" or ch == "\n" or ch == "\r" of {
                true -> drop_ws_chars_from(s, i + 1, acc);
                false -> drop_ws_chars_from(s, i + 1, concat(acc, ch))
            }
        }
    }
}

fn type_name_before_for_supervisor_impl(s: string) -> string {
    t: string <- type_checker_traits@trim_type_text(s);
    packed: string <- drop_ws_chars_from(t, 0, "");
    case string_ends_with_suffix(packed, packed_for_supervisor_phase_a_suffix()) of {
        true -> substring(packed, 0, length_bytes(packed) - length_bytes(packed_for_supervisor_phase_a_suffix()));
        false -> case string_ends_with_suffix(packed, packed_for_supervisor_suffix()) of {
            true -> substring(packed, 0, length_bytes(packed) - length_bytes(packed_for_supervisor_suffix()));
            false -> {
                suf: string <- for_supervisor_impl_suffix();
                case string_ends_with_suffix(t, suf) of {
                    true -> type_checker_traits@trim_type_text(substring(t, 0, length_bytes(t) - length_bytes(suf)));
                    false -> case string_ends_with_suffix(t, for_supervisor_phase_a_impl_suffix()) of {
                        true -> type_checker_traits@trim_type_text(substring(t, 0, length_bytes(t) - length_bytes(for_supervisor_phase_a_impl_suffix())));
                        false -> ""
                    }
                }
            }
        }
    }
}

fn collect_supervisor_impl_types_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[string, mem(normal)] {
    case decls.is_nil of {
        true -> sir_ast@nil_sir_strings();
        false -> case decls.head.tag == 6 of {
            true -> {
                actor_ty: string <- type_name_before_for_supervisor_impl(decls.head.return_type_name);
                case length_bytes(actor_ty) > 0 of {
                    true -> sir_ast@cons_sir_string(actor_ty, collect_supervisor_impl_types_loop(decls.tail));
                    false -> collect_supervisor_impl_types_loop(decls.tail)
                }
            };
            false -> collect_supervisor_impl_types_loop(decls.tail)
        }
    }
}

fn collect_supervisor_impl_types(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[string, mem(normal)] {
    collect_supervisor_impl_types_loop(decls)
}

// §15.4.13.4 / supervisors plan Phase F: `impl ActorType for FailureReporter;` ({ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } tag 6) — concrete actor type for root FailureReporter bootstrap (unwind / handle_report).
fn for_failure_reporter_impl_suffix() -> string {
    " for FailureReporter"
}

fn type_name_before_for_failure_reporter_impl(s: string) -> string {
    t: string <- type_checker_traits@trim_type_text(s);
    suf: string <- for_failure_reporter_impl_suffix();
    case string_ends_with_suffix(t, suf) of {
        false -> "";
        true -> {
            lf: int64 <- length_bytes(suf);
            type_checker_traits@trim_type_text(substring(t, 0, length_bytes(t) - lf))
        }
    }
}

fn collect_failure_reporter_impl_types_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[string, mem(normal)] {
    case decls.is_nil of {
        true -> sir_ast@nil_sir_strings();
        false -> case decls.head.tag == 6 of {
            true -> {
                actor_ty: string <- type_name_before_for_failure_reporter_impl(decls.head.return_type_name);
                case length_bytes(actor_ty) > 0 of {
                    true -> sir_ast@cons_sir_string(actor_ty, collect_failure_reporter_impl_types_loop(decls.tail));
                    false -> collect_failure_reporter_impl_types_loop(decls.tail)
                }
            };
            false -> collect_failure_reporter_impl_types_loop(decls.tail)
        }
    }
}

fn collect_failure_reporter_impl_types(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[string, mem(normal)] {
    collect_failure_reporter_impl_types_loop(decls)
}

fn required_sig_from_decl(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> { name: string, param_names: string, param_types: string, return_type: string, effects: string } {
    pnames: string <- functions@param_names_from_list(decl.parameters);
    ptypes: string <- functions@param_types_from_list(decl.parameters);
    ret_sir: string <- types@type_name_to_sir(decl.return_type_name);
    eff: string <- case decl.declared_effects.is_nil of {
        true -> "[]";
        false -> effect_serializer@serialize_effects(decl.declared_effects)
    };
    { name: decl.name, param_names: pnames, param_types: ptypes, return_type: ret_sir, effects: eff }
}

fn collect_required_trait_method_sigs_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)] {
    case decls.is_nil of {
        true -> sir_ast@nil_required_method_sigs();
        false -> case decls.head.tag == 7 of {
            true -> {
                sig: { name: string, param_names: string, param_types: string, return_type: string, effects: string } <- required_sig_from_decl(decls.head);
                sir_ast@cons_required_method_sig(sig, collect_required_trait_method_sigs_loop(decls.tail))
            };
            false -> collect_required_trait_method_sigs_loop(decls.tail)
        }
    }
}

fn collect_required_trait_method_sigs(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)] {
    collect_required_trait_method_sigs_loop(decls)
}
