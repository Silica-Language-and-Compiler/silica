fn find_atom_field_in_record_chain(field_chain: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, field_name: string) -> string {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(field_chain);
    case node.kind == 21 of {
        false -> "";
        true -> case node.name == field_name of {
            true -> {
                inner_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(field_chain, node.inner);
                inner_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(inner_e);
                case inner_node.kind == 5 of {
                    true -> inner_node.value;
                    false -> ""
                }
            };
            false -> find_atom_field_in_record_chain(parser_ast@expr_at(field_chain, node.right_expr), field_name)
        }
    }
}

fn find_fn_ref_name_in_record_chain(field_chain: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, field_name: string) -> string {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(field_chain);
    case node.kind == 21 of {
        false -> "";
        true -> case node.name == field_name of {
            true -> {
                inner_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(field_chain, node.inner);
                inner_node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(inner_e);
                case inner_node.kind == 1 of {
                    true -> inner_node.name;
                    false -> ""
                }
            };
            false -> find_fn_ref_name_in_record_chain(parser_ast@expr_at(field_chain, node.right_expr), field_name)
        }
    }
}

fn find_field_location_in_record_chain(field_chain: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, field_name: string) -> { file: string, line: int64, column: int64, offset: int64 } {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(field_chain);
    case node.kind == 21 of {
        false -> parser_ast@zero_location();
        true -> case node.name == field_name of {
            true -> node.location;
            false -> find_field_location_in_record_chain(parser_ast@expr_at(field_chain, node.right_expr), field_name)
        }
    }
}

fn find_fn_return_type_in_decls(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], fn_name: string) -> string {
    case decls.is_nil of {
        true -> "";
        false -> case decls.head.tag == 0 and decls.head.name == fn_name of {
            true -> decls.head.return_type_name;
            false -> find_fn_return_type_in_decls(decls.tail, fn_name)
        }
    }
}

fn starts_with_dangerous_prefix(s: string) -> boolean {
    length_bytes(s) >= 11 and substring(s, 0, 11) == ":dangerous_"
}

fn validate_dangerous_child_spec_record(field_chain: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    flavor: string <- find_atom_field_in_record_chain(field_chain, "flavor");
    case flavor == ":dangerous" of {
        false -> type_checker_core@type_check_ok();
        true -> {
            id_val: string <- find_atom_field_in_record_chain(field_chain, "id");
            case starts_with_dangerous_prefix(id_val) of {
                false -> {
                    id_loc: { file: string, line: int64, column: int64, offset: int64 } <- find_field_location_in_record_chain(field_chain, "id");
                    type_checker_core@type_check_err(
                        "E2094",
                        id_loc,
                        concat(concat("child_spec with flavor :dangerous requires id starting with :dangerous_; got ", id_val), " (§15.4.13.2)"),
                        "sect15.4.13.2"
                    )
                };
                true -> {
                    beh_fn_name: string <- find_fn_ref_name_in_record_chain(field_chain, "behavior");
                    case length_bytes(beh_fn_name) == 0 of {
                        true -> type_checker_core@type_check_ok();
                        false -> {
                            ret_type: string <- find_fn_return_type_in_decls(decls, beh_fn_name);
                            case length_bytes(ret_type) == 0 of {
                                true -> type_checker_core@type_check_ok();
                                false -> case type_checker_expressions_actors@behavior_return_is_cast_only(ret_type) of {
                                    true -> type_checker_core@type_check_ok();
                                    false -> {
                                        beh_loc: { file: string, line: int64, column: int64, offset: int64 } <- find_field_location_in_record_chain(field_chain, "behavior");
                                        type_checker_core@type_check_err(
                                            "E2095",
                                            beh_loc,
                                            "child_spec with flavor :dangerous requires a cast-type behavior returning (:no_reply, State); reply-type behaviors are not allowed for dangerous children (§15.4.13.2)",
                                            "sect15.4.13.2"
                                        )
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn is_child_spec_record_chain(field_chain: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    length_bytes(find_atom_field_in_record_chain(field_chain, "agent_type")) > 0
        and length_bytes(find_atom_field_in_record_chain(field_chain, "flavor")) > 0
}

fn supervisor_walk_validate_dangerous_flavor_constraints(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
    case node.kind < 0 of {
        true -> type_checker_core@type_check_ok();
        false -> {
            cross: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- case node.kind == 21 and node.name == "id" of {
                true -> case is_child_spec_record_chain(expr) of {
                    true -> validate_dangerous_child_spec_record(expr, decls);
                    false -> type_checker_core@type_check_ok()
                };
                false -> type_checker_core@type_check_ok()
            };
            case cross.is_ok of {
                false -> cross;
                true -> case node.kind == 991 of {
                    true -> supervisor_walk_validate_dangerous_flavor_constraints(parser_ast@expr_at(expr, node.inner), decls);
                    false -> case node.kind == 992 of {
                        true -> type_checker_core@type_check_ok();
                        false -> {
                            inner_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(expr, node.inner);
                            right_e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(expr, node.right_expr);
                            rin: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- supervisor_walk_validate_dangerous_flavor_constraints(inner_e, decls);
                            case rin.is_ok of {
                                false -> rin;
                                true -> supervisor_walk_validate_dangerous_flavor_constraints(right_e, decls)
                            }
                        }
                    }
                }
            }
        }
    }
}

fn validate_supervisor_init_body_dangerous_flavor_constraints_if_needed(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, all_decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], decls_for_lookup: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case program_has_impl_for_supervisor(all_decls) of {
        false -> type_checker_core@type_check_ok();
        true -> case decl.name == "init" of {
            false -> type_checker_core@type_check_ok();
            true -> case init_decl_has_one_parameter(decl) of {
                false -> type_checker_core@type_check_ok();
                true -> supervisor_walk_validate_dangerous_flavor_constraints(decl.body, decls_for_lookup)
            }
        }
    }
}

// §20.3.1 "Supervised children with the same id": an `id` that appears twice in one supervisor's init
// child list is E2235 DuplicateChildId, reported at the second occurrence, where the list is a literal
// the compiler can see (a kind-20 list literal whose elements are child_spec records). Each literal is
// checked on its own, so the same id in two arms of a case is not a duplicate.
fn child_ids_nil() -> List[{ id: string, loc: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ id: string, loc: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- empty[{ id: string, loc: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]()
    produces
        pure result
    end
}

fn child_ids_cons(entry: { id: string, loc: { file: string, line: int64, column: int64, offset: int64 } }, rest: List[{ id: string, loc: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ id: string, loc: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[{ id: string, loc: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- prepend[{ id: string, loc: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)](entry, rest)
    produces
        pure result
    end
}

fn child_names_nil() -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[string, mem(normal)] <- empty[string, mem(normal)]()
    produces
        pure result
    end
}

fn child_names_cons(name: string, rest: List[string, mem(normal)]) -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[string, mem(normal)] <- prepend[string, mem(normal)](name, rest)
    produces
        pure result
    end
}

fn child_names_contain(names: List[string, mem(normal)], name: string) -> boolean {
    case names.is_nil of {
        true -> false;
        false -> case names.head == name of {
            true -> true;
            false -> child_names_contain(names.tail, name)
        }
    }
}

// One element of a list literal: its child_spec id, when it is a child_spec record with one.
fn child_ids_add_element(elem: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, acc: List[{ id: string, loc: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ id: string, loc: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(elem);
    case node.kind == 21 and is_child_spec_record_chain(elem) of {
        false -> acc;
        true -> {
            id_val: string <- find_atom_field_in_record_chain(elem, "id");
            case length_bytes(id_val) == 0 of {
                true -> acc;
                false -> child_ids_cons({ id: id_val, loc: find_field_location_in_record_chain(elem, "id") }, acc)
            }
        }
    }
}

// The spine of a list literal is right-nested (parser constraint_extract_expr_lits.silica): a pair
// node (kind 20, name ",") holds an element in inner and the rest in right_expr; the last right_expr
// is the last element itself; the literal's root is a kind-20 node whose name is not "," (its value
// is the List type only when the literal carries a `: List[...]` suffix). The ids come back
// last-first (consed); child_ids_reverse restores source order for first_repeated_child_id.
fn child_ids_in_spine(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, idx: int64, acc: List[{ id: string, loc: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ id: string, loc: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case idx < 0 of {
        true -> acc;
        false -> {
            at: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(expr, idx);
            node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(at);
            case node.kind == 20 and node.name == "," of {
                true -> child_ids_in_spine(expr, node.right_expr, child_ids_add_element(parser_ast@expr_at(expr, node.inner), acc));
                false -> child_ids_add_element(at, acc)
            }
        }
    }
}

fn child_ids_reverse(ids: List[{ id: string, loc: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], acc: List[{ id: string, loc: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> List[{ id: string, loc: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] {
    case ids.is_nil of {
        true -> acc;
        false -> child_ids_reverse(ids.tail, child_ids_cons(ids.head, acc))
    }
}

fn first_repeated_child_id(ids: List[{ id: string, loc: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], seen: List[string, mem(normal)]) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case ids.is_nil of {
        true -> type_checker_core@type_check_ok();
        false -> case child_names_contain(seen, ids.head.id) of {
            true -> type_checker_core@type_check_err(
                "E2235",
                ids.head.loc,
                concat(concat("child_spec id ", ids.head.id), " appears twice in this supervisor's init child list; a child is registered under its id, and a name is held by one actor or supervisor (§20.3.1)"),
                "sect20.3.1"
            );
            false -> first_repeated_child_id(ids.tail, child_names_cons(ids.head.id, seen))
        }
    }
}

// A list literal root (kind 20, name not ","): the elements of this one literal.
fn check_child_spec_list_literal(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
    first: List[{ id: string, loc: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- child_ids_add_element(parser_ast@expr_at(expr, node.inner), child_ids_nil());
    all_ids: List[{ id: string, loc: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- child_ids_in_spine(expr, node.right_expr, first);
    first_repeated_child_id(child_ids_reverse(all_ids, child_ids_nil()), child_names_nil())
}

fn supervisor_walk_validate_duplicate_child_ids(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(expr);
    case node.kind < 0 of {
        true -> type_checker_core@type_check_ok();
        false -> {
            here: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- case node.kind == 20 and node.name != "," of {
                true -> check_child_spec_list_literal(expr);
                false -> type_checker_core@type_check_ok()
            };
            case here.is_ok of {
                false -> here;
                true -> case node.kind == 991 of {
                    true -> supervisor_walk_validate_duplicate_child_ids(parser_ast@expr_at(expr, node.inner));
                    false -> case node.kind == 992 of {
                        true -> type_checker_core@type_check_ok();
                        false -> {
                            rin: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- supervisor_walk_validate_duplicate_child_ids(parser_ast@expr_at(expr, node.inner));
                            case rin.is_ok of {
                                false -> rin;
                                true -> supervisor_walk_validate_duplicate_child_ids(parser_ast@expr_at(expr, node.right_expr))
                            }
                        }
                    }
                }
            }
        }
    }
}

fn validate_supervisor_init_body_duplicate_child_ids_if_needed(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, all_decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)]) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case program_has_impl_for_supervisor(all_decls) of {
        false -> type_checker_core@type_check_ok();
        true -> case decl.name == "init" of {
            false -> type_checker_core@type_check_ok();
            true -> case init_decl_has_one_parameter(decl) of {
                false -> type_checker_core@type_check_ok();
                true -> supervisor_walk_validate_duplicate_child_ids(decl.body)
            }
        }
    }
}
