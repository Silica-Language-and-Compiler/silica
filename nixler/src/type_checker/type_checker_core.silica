// Type checker core - type context, type-check result, symbol table
// Shared by type checker capabilities and runner.
// Seed-legal: inline records + List (no named struct / type alias).
// Phase 2+3: symbol rows carry type_id (int64) + surface_type; context owns interner.

use parser_ast;
use instantiated_fn_name;
use lexer_core;
use type_interner;

