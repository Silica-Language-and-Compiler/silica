    }
}

fn cc_registered_message(op: string, d: string, what: string, name: string) -> string {
    case op == "c" of {
        true -> concat(concat(concat(concat(concat(concat(concat("cannot ", what), "() to "), name), ": every actor registered under that name that this build can see is call-only (behaviour "), cc_beh_text(d)), "returns (:reply, ...))"), "; use call_registered() to reach it (§16.1.2, §16.2.6.3, §16.2.6.4)");
        false -> concat(concat(concat(concat(concat(concat(concat("cannot ", what), "() "), name), ": every actor registered under that name that this build can see is cast-only (behaviour "), cc_beh_text(d)), "returns (:no_reply, ...))"), "; use cast_registered() to reach it (§16.1.1, §16.2.6.2, §16.2.6.4)")
    }
}

// Apply the demands that behaviour bd (R/C<module@name>) makes on its parameter idx ("0" message,
// "1" state) to the descriptor given there.
fn cc_beh_apply(world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: stri