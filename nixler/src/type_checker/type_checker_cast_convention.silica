    }
}

// Apply callee `key`'s summary at this call: its demands on the arguments, then its result.
fn cc_apply_summary(world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, key: string, args: List[{ key: string, val: string }, mem(normal)], st: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string }) -> { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } {
    s1: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_summary(world, parsed, key, st);
    summary: string <- s1.res;
    bar: int64 <- cc_index_of(summary, "|", 0);
    ret: string <- case bar < 0 of {
        true -> "";
        false -> substring(summary, 0, bar)
    };
    demands: string <- case bar < 0 of {
        true -> "";
        false -> cc_after(summary, bar)
    };
    s2: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_apply_demands(s1, demands, args, node.location, node.name, "arg");
    case s2.err of {
        true -> s2;
        false -> cc_set_res(s2, cc_subst(ret, args))
    }
}

// demands ",cS1/fpeer,kS0," read against args.
fn cc_apply_demands(st: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string }, s: string, args: List[{ key: string, val: string }, mem(normal)], loc: { file: string, line: int64, column: int64, offset: int64 }, callee: string, where_kind: string) -> { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } {
    case st.err or length_bytes(s) < 2 of {
        true -> st;
        false -> {
            rest: string <- substring(s, 1, length_bytes(s));
            end_i: int64 <- cc_index_of(rest, ",", 0);
            item: string <- case end_i < 0 of {
                true -> rest;
                false -> substring(rest, 0, end_i)
            };
            after: string <- case end_i < 0 of {
                true -> "";
                false -> substring(rest, end_i, length_bytes(rest))
            };
            st2: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- case length_bytes(item) < 2 of {
                true -> st;
                false -> cc_apply_one(st, cc_first(item), cc_rest(item), args, loc, callee, where_kind)
            };
            cc_apply_demands(st2, after, args, loc, callee, where_kind)
        }
    }
}

fn cc_apply_one(st: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string }, op: string, path: string, args: List[{ key: string, val: string }, mem(normal)], loc: { file: string, line: int64, column: int64, offset: int64 }, callee: string, where_kind: string) -> { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } {
    v: string <- cc_subst_path(path, args);
    fv: string <- cc_first(v);
    case (op == "c" and fv == "R") or (op == "k" and fv == "C") of {
        true -> cc_fail(st, cc_op_code(op), loc, cc_demand_message(op, v, path, callee, where_kind));
        false -> case fv == "S" of {
            true -> cc_add_demands_set(st, op, v);
            false -> st
        }
    }
}

fn cc_where_text(path: string, callee: string, where_kind: string) -> string {
    slash: int64 <- cc_index_of(path, "/", 0);
    idx: string <- case slash < 0 of {
        true -> substring(path, 1, length_bytes(path));
        false -> substring(path, 1, slash)
    };
    steps: string <- case slash < 0 of {
        true -> "";
        false -> concat(concat(" (at ", cc_steps_text(substring(path, slash, length_bytes(path)))), ")")
    };
    case where_kind of {
        "arg" -> concat(concat(concat(concat("argument ", cc_itoa(string_parse@string_to_int64(idx) + 1)), steps), " of "), callee);
        "state" -> concat(concat(concat("the initial state", steps), " of an actor running "), callee);
        "msg" -> concat(concat(concat("the message", steps), " sent to an actor running "), callee);
        _: string -> concat(concat(concat("the state", steps), " that "), concat(callee, " returns"))
    }
}

fn cc_demand_message(op: string, v: string, path: string, callee: string, where_kind: string) -> string {
    where: string <- cc_where_text(path, callee, where_kind);
    case op == "c" of {
        true -> concat(concat(concat(concat(concat(concat(concat("cannot cast() to a call-only actor: ", where), " is an actor whose behaviour "), cc_beh_text(v)), "returns (:reply, ...), and "), callee), " casts to it"), "; use a call to reach it (§16.1.2, §16.2.6.3, §16.2.6.4)");
        false -> concat(concat(concat(concat(concat(concat(concat("cannot call() a cast-only actor: ", where), " is an actor whose behaviour "), cc_beh_text(v)), "returns (:no_reply, ...), and "), callee), " calls it"), "; use a cast to reach it (§16.1.1, §16.2.6.2, §16.2.6.4)")
    }
}

// --- summaries ------------------------------------------------------------------------------------

// Summary of module@function, memoised in st.memo; st.res holds it on return.
fn cc_summary(world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], key: string, st: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string }) -> { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } {
    known: string <- cc_get(st.memo, key);
    case known of {
        "!" -> cc_compute_summary(world, parsed, key, st);
        "?" -> cc_set_res(st, "|");
        _: string -> cc_set_res(st, known)
    }
}

// The state a behaviour's result carries: element 2 of (:reply, R, S), element 1 of (:no_reply, S).
fn cc_returned_state(self_r: string, res: string) -> string {
    case cc_first(self_r) of {
        "R" -> cc_proj1(res, "t", "2");
        "C" -> cc_proj1(res, "t", "1");
        _: string -> ""
    }
}

// A behaviour's state demands also hold for the state it returns: apply them to that state until
// no new demand appears (at most `rounds` times).
fn cc_behaviour_state_loop(st: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string }, decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, ret_state: string, rounds: int64) -> { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } {
    case rounds <= 0 or st.err or length_bytes(ret_state) == 0 of {
        true -> st;
        false -> {
            before: string <- st.castp;
            s1: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_apply_demands(st, before, cc_kv_cons("1", ret_state, cc_kv_nil()), decl.location, decl.name, "ret");
            case s1.castp == before of {
                true -> s1;
                false -> cc_behaviour_state_loop(s1, decl, ret_state, rounds - 1)
            }
        }
    }
}

fn cc_compute_summary(world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], key: string, st: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string }) -> { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } {
    callee_module: string <- cc_module_of(key, "");
    callee_fn: string <- cc_function_of(key);
    (found: boolean, decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) <- cc_find_fn(world, callee_module, callee_fn);
    case found of {
        false -> { env: st.env, memo: cc_kv_cons(key, "|", st.memo), regs: st.regs, regs_built: st.regs_built, sigs: st.sigs, castp: st.castp, args: st.args, err: st.err, code: st.code, loc: st.loc, msg: st.msg, report: st.report, self_r: st.self_r, res: "|" };
        true -> {
            self_r: string <- cc_self_desc(callee_module, decl);
            sub: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- { env: cc_param_env(decl.parameters, cc_params_len(decl.parameters), cc_kv_nil()), memo: cc_kv_cons(key, "?", st.memo), regs: st.regs, regs_built: st.regs_built, sigs: st.sigs, castp: ",", args: st.args, err: false, code: st.code, loc: st.loc, msg: "", report: false, self_r: self_r, res: "" };
            walked: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_walk(world, parsed, callee_module, decl.body, sub);
            out: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_behaviour_state_loop(walked, decl, cc_returned_state(self_r, walked.res), 4);
            ret: string <- walked.res;
            summary: string <- concat(concat(ret, "|"), out.castp);
            { env: st.env, memo: cc_kv_cons(key, summary, out.memo), regs: out.regs, regs_built: out.regs_built, sigs: st.sigs, castp: st.castp, args: st.args, err: st.err, code: st.code, loc: st.loc, msg: st.msg, report: st.report, self_r: st.self_r, res: summary }
        }
    }
}

// True when e can hold an error: a send, a spawn, a child spec, or a call of a function with a summary.
fn cc_mentions(sigs: List[{ key: string, val: string }, mem(normal)], e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    case e.root < 0 of {
        true -> false;
        false -> {
            node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(e);
            case node.kind == 992 of {
                true -> false;
                false -> case (node.kind == 4 and length_bytes(node.name) > 0 and (cc_is_send_name(node.name) or cc_is_spawn_with_behaviour(node.name) or cc_has(sigs, node.name))) or (node.kind == 21 and node.name == "behavior") of {
                    true -> true;
                    false -> case cc_mentions(sigs, parser_ast@expr_at(e, node.inner)) of {
                        true -> true;
                        false -> cc_mentions(sigs, parser_ast@expr_at(e, node.right_expr))
                    }
                }
            }
        }
    }
}

fn cc_is_send_name(name: string) -> boolean {
    case name of {
        "cast" -> true;
        "call" -> true;
        "call_with_timeout" -> true;
        "cast_registered" -> true;
        "call_registered" -> true;
        "send_after" -> true;
        "register_failure_reporter" -> true;
        _: string -> false
    }
}

// --- entry ----------------------------------------------------------------------------------------

fn cc_check_decls(world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], module_name: string, decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], st: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string }) -> { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } {
    case decls.is_nil or st.err of {
        true -> st;
        false -> case decls.head.body.root >= 0 and cc_mentions(st.sigs, decls.head.body) of {
            false -> cc_check_decls(world, parsed, module_name, decls.tail, st);
            true -> {
                d: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- decls.head;
                self_r: string <- cc_self_desc(module_name, d);
                start: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- { env: cc_param_env(d.parameters, cc_params_len(d.parameters), cc_kv_nil()), memo: st.memo, regs: st.regs, regs_built: st.regs_built, sigs: st.sigs, castp: ",", args: st.args, err: false, code: st.code, loc: st.loc, msg: "", report: true, self_r: self_r, res: "" };
                walked: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_walk(world, parsed, module_name, d.body, start);
                out: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_behaviour_state_loop(walked, d, cc_returned_state(self_r, walked.res), 4);
                cc_check_decls(world, parsed, module_name, decls.tail, out)
            }
        }
    }
}

// E2237 at the first cast to a reference the compiler knows to be call-only, E2238 at the first call
// to one it knows to be cast-only. `parsed` is every parsed unit of the build (for registered names).
