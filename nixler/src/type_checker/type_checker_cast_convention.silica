            s1: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_scoped(world, parsed, module_name, parser_ast@expr_at(e, node.inner), st);
            acc2: string <- case acc == "!" of {
                true -> s1.res;
                false -> cc_agree(acc, s1.res)
            };
            r: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(e, node.right_expr);
            rn: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(r);
            case r.root < 0 or s1.err of {
                true -> cc_set_res(s1, cc_list_result(acc2));
                false -> case rn.kind == 20 and rn.name == "," of {
                    true -> cc_walk_list(world, parsed, module_name, r, s1, acc2);
                    false -> {
                        s2: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_scoped(world, parsed, module_name, r, s1);
                        cc_set_res(s2, cc_list_result(cc_agree(acc2, s2.res)))
                    }
                }
            }
        }
    }
}

fn cc_list_result(acc: string) -> string {
    case acc == "!" of {
        true -> "E";
        false -> cc_wrap_list(acc)
    }
}

