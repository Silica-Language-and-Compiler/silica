            s1: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_ensure_regs(world, parsed, st);
            d: string <- cc_reg_desc(s1.regs, name_n.value, "!");
            f: string <- cc_first(d);
            case (op == "c" and f == "R") or (op == "k" and f == "C") of {
                true -> cc_fail(s1, cc_op_code(op), node.location, cc_registered_message(op, d, node.name, name_n.value));
