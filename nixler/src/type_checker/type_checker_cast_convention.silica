    node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(e);
    case e.root < 0 or node.kind != 21 or st.err of {
        true -> cc_set_res(st, cc_wrap_record(acc));
        false -> {
            s1: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_scoped(world, parsed, module_name, parser_ast@expr_at(e, node.inner), st);
            acc2: string <- case length_bytes(s1.res) > 0 of {
                true -> cc_join_items(acc, concat(concat(node.name, "="), s1.res));
                false -> acc
            };
            cc_walk_record_fields(world, parsed, module_name, parser_ast@expr_at(e, node.right_expr), s1, acc2)
        }
    }
}

// Case arms: kind 17 list (inner = kind 18 arm, right = next 17 or the last arm); an arm's pattern
// is its value and its body its right subtree. st.res carries the agreement so far ("!" before the
// first arm); scrut is the scrutinee's descriptor.
