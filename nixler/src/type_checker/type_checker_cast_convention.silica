    beh: string <- cc_rest(bd);
    case length_bytes(given) == 0 or length_bytes(beh) == 0 or (cc_first(bd) != "R" and cc_first(bd) != "C") or cc_has(st.sigs, beh) == false of {
        true -> st;
        false -> {
            s1: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_summary(world, parsed, beh, st);
            summary: string <- s1.res;
            bar: int64 <- cc_index_of(summary, "|", 0);
            demands: string <- case bar < 0 of {
                true -> "";
                false -> cc_after(summary, bar)
            };
            cc_apply_demands(s1, demands, cc_kv_cons(idx, given, cc_kv_nil()), loc, cc_function_of(beh), where_kind)
