    s1: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_scoped(world, parsed, module_name, parser_ast@expr_at(e, node.inner), st);
    env2: List[{ key: string, val: string }, mem(normal)] <- cc_bind_decompose(node.pattern_bindings, s1.res, st.env);
    cc_walk(world, parsed, module_name, parser_ast@expr_at(e, node.right_expr), cc_set_res(cc_set_env(s1, env2), ""))
}

// --- calls ----------------------------------------------------------------------------------------

// Walk a call's arguments in order; st.args holds their descriptors (key: decimal index) on return.
fn cc_walk_args(world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], module_name: string, e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, st: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string }) -> { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } {
    case node.inner < 0 of {
        true -> { env: st.env, memo: st.memo, regs: st.regs, regs_built: st.regs_built, sigs: st.sigs, castp: st.castp, args: cc_kv_nil(), err: st.err, code: st.code, loc: st.loc, msg: st.msg, report: st.report, self_r: st.self_r, res: st.res };
        false -> cc_walk_args_from(world, parsed, module_name, e, 0, st, cc_kv_nil())
    }
}

fn cc_args_add(acc: List[{ key: string, val: string }, mem(normal)], k: int64, d: string) -> List[{ key: string, val: string }, mem(normal)] {
    case length_bytes(d) == 0 of {
        true -> acc;
        false -> cc_kv_cons(cc_itoa(k), d, acc)
    }
}

// pair: the call node itself or a "" pair node; inner = argument k, right = the rest.
fn cc_walk_args_from(world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], module_name: string, pair: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, k: int64, st: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string }, acc: List[{ key: string, val: string }, mem(normal)]) -> { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } {
    pn: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(pair);
    s1: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_scoped(world, parsed, module_name, parser_ast@expr_at(pair, pn.inner), st);
    acc1: List[{ key: string, val: string }, mem(normal)] <- cc_args_add(acc, k, s1.res);
    r: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 } <- parser_ast@expr_at(pair, pn.right_expr);
    case r.root < 0 or s1.err of {
        true -> { env: s1.env, memo: s1.memo, regs: s1.regs, regs_built: s1.regs_built, sigs: s1.sigs, castp: s1.castp, args: acc1, err: s1.err, code: s1.code, loc: s1.loc, msg: s1.msg, report: s1.report, self_r: s1.self_r, res: s1.res };
        false -> {
            rn: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(r);
            case rn.kind == 4 and rn.name == "" and rn.inner >= 0 of {
                true -> cc_walk_args_from(world, parsed, module_name, r, k + 1, s1, acc1);
                false -> {
                    s2: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_scoped(world, parsed, module_name, r, s1);
                    { env: s2.env, memo: s2.memo, regs: s2.regs, regs_built: s2.regs_built, sigs: s2.sigs, castp: s2.castp, args: cc_args_add(acc1, k + 1, s2.res), err: s2.err, code: s2.code, loc: s2.loc, msg: s2.msg, report: s2.report, self_r: s2.self_r, res: s2.res }
                }
            }
        }
    }
}

fn cc_is_spawn_with_behaviour(name: string) -> boolean {
    case name of {
        "spawn" -> true;
        "spawn_registered" -> true;
        "spawn_linked" -> true;
        "spawn_affinity_performance_cores" -> true;
        "spawn_affinity_efficiency_cores" -> true;
        _: string -> false
    }
}

fn cc_walk_call(world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], module_name: string, e: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, st: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string }) -> { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } {
    sa: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_walk_args(world, parsed, module_name, e, node, st);
    args: List[{ key: string, val: string }, mem(normal)] <- sa.args;
    s2: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_set_res(sa, "");
    case s2.err or length_bytes(node.name) == 0 of {
        true -> s2;
        false -> case node.name of {
            "cast" -> cc_send(world, parsed, node, cc_lookup(args, "0"), cc_lookup(args, "1"), "c", s2);
            "send_after" -> cc_send(world, parsed, node, cc_lookup(args, "1"), cc_lookup(args, "2"), "c", s2);
            "call" -> cc_send(world, parsed, node, cc_lookup(args, "0"), cc_lookup(args, "1"), "k", s2);
            "call_with_timeout" -> cc_send(world, parsed, node, cc_lookup(args, "0"), cc_lookup(args, "1"), "k", s2);
            "register_failure_reporter" -> cc_reporter(node, cc_lookup(args, "0"), s2);
            "cast_registered" -> cc_send_registered(world, parsed, e, node, cc_lookup(args, "1"), "c", s2);
            "call_registered" -> cc_send_registered(world, parsed, e, node, cc_lookup(args, "1"), "k", s2);
            "self" -> cc_set_res(s2, s2.self_r);
            "spawn_state_machine" -> cc_set_res(s2, "Cstate_machine");
            "empty" -> cc_set_res(s2, "E");
            "prepend" -> cc_set_res(s2, cc_list_prepend(cc_lookup(args, "0"), cc_lookup(args, "1")));
            "remove_head" -> cc_set_res(s2, cc_lookup(args, "0"));
            "head" -> cc_set_res(s2, cc_proj1(cc_lookup(args, "0"), "f", "head"));
            "list_at" -> cc_set_res(s2, cc_proj1(cc_lookup(args, "0"), "f", "head"));
            "list_nth" -> cc_set_res(s2, cc_proj1(cc_lookup(args, "0"), "f", "head"));
            _: string -> case cc_is_spawn_with_behaviour(node.name) of {
                true -> {
                    bd: string <- cc_beh_desc(world, parsed, module_name, cc_arg_at(e, 1));
                    s3: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_beh_apply(world, parsed, bd, "1", cc_lookup(args, "0"), node.location, "state", s2);
                    cc_set_res(s3, bd)
                };
                false -> {
                    key: string <- cc_key(module_name, node.name);
                    case cc_has(s2.sigs, key) of {
                        true -> cc_apply_summary(world, parsed, node, key, args, s2);
                        false -> s2
                    }
                }
            }
        }
    }
}

fn cc_beh_text(d: string) -> string {
    case length_bytes(cc_rest(d)) == 0 of {
        true -> "";
        false -> concat(cc_rest(d), " ")
    }
}

fn cc_direct_message(op: string, d: string, what: string) -> string {
    case op == "c" of {
        true -> concat(concat(concat(concat(concat("cannot ", what), "() to a call-only actor: its behaviour "), cc_beh_text(d)), "returns (:reply, ...)"), "; use a call to reach it (§16.1.2, §16.2.6.3, §16.2.6.4)");
        false -> concat(concat(concat(concat(concat("cannot ", what), "() a cast-only actor: its behaviour "), cc_beh_text(d)), "returns (:no_reply, ...)"), "; use a cast to reach it (§16.1.1, §16.2.6.2, §16.2.6.4)")
    }
}

fn cc_op_code(op: string) -> string {
    case op == "c" of {
        true -> "E2237";
        false -> "E2238"
    }
}

// A cast (op "c") or call (op "k") through a reference with descriptor d carrying message msg.
fn cc_send(world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], parsed: List[{ path: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, l