        false -> {
            node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] } <- parser_ast@expr_root_node(arms);
            case node.kind == 17 of {
                true -> {
                    s1: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_walk_arm(world, parsed, module_name, parser_ast@expr_at(arms, node.inner), scrut, st);
                    cc_walk_arms(world, parsed, module_name, parser_ast@expr_at(arms, node.right_expr), scrut, s1)
                };
                false -> {
                    s1: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } <- cc_walk_arm(world, parsed, module_name, arms, scrut, st);
                    cc_set_res(s1, cc_agree_first(s1.res))
