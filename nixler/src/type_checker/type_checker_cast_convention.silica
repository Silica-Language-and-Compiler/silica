fn cc_reporter(node: { kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, d: string, st: { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string }) -> { env: List[{ key: string, val: string }, mem(normal)], memo: List[{ key: string, val: string }, mem(normal)], regs: List[{ key: string, val: string }, mem(normal)], regs_built: boolean, sigs: List[{ key: string, val: string }, mem(normal)], castp: string, args: List[{ key: string, val: string }, mem(normal)], err: boolean, code: string, loc: { file: string, line: int64, column: int64, offset: int64 }, msg: string, report: boolean, self_r: string, res: string } {
    case cc_first(d) of {
        "R" -> cc_fail(st, "E2237", node.location, concat(concat("register_failure_reporter needs a cast-only actor: failure reports are delivered by cast, but this actor's behaviour ", cc_beh_text(d)), "returns (:reply, ...); give the reporter a (:no_reply, State) behaviour (§15.4.13.4, §16.2.6.3)"));
        "S" -> cc_set_res(cc_add_demands_set(st, "c", d), "");
        _: string -> cc_set_res(st, "")
    }
}

