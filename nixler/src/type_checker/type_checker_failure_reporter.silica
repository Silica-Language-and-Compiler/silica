// Supervisors Phase F (design_documents/supervisors_implementation_development_plan.md): type-level
// validation for `export trait FailureReporter` per silica-specification §15.4.13.4. Mirrors
// module_checker::validate_failure_reporter_trait_required_shape; emitted here so the type checker
// enforces the contract without relying on module-check ordering alone.

use parser_ast;
use type_checker_core;
use type_checker_traits;

export check_failure_reporter_export_trait/1;

fn program_exports_trait_named(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], trait_id: string) -> boolean {
    case decls.is_nil of {
        true -> false;
        false -> case decls.head.tag == 5 of {
            true -> case decls.head.name == trait_id of {
                true -> true;
                false -> program_exports_trait_named(decls.tail, trait_id)
            };
            false -> program_exports_trait_named(decls.tail, trait_id)
        }
    }
}

fn count_tag7_declarations(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], acc: int64) -> int64 {
    case decls.is_nil of {
        true -> acc;
        false -> case decls.head.tag == 7 of {
            true -> count_tag7_declarations(decls.tail, acc + 1);
            false -> count_tag7_declarations(decls.tail, acc)
        }
    }
}

fn list_param_length_decl(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> int64 {
    case params.is_nil of {
        true -> 0;
        false -> 1 + list_param_length_decl(params.tail)
    }
}

fn find_tag7_by_name(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], method_name: string) -> (boolean, { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) {
    case decls.is_nil of {
        true -> (false, parser_ast@dummy_decl());
        false -> case decls.head.tag == 7 of {
            true -> case decls.head.name == method_name of {
                true -> (true, decls.head);
                false -> find_tag7_by_name(decls.tail, method_name)
            };
            false -> find_tag7_by_name(decls.tail, method_name)
        }
    }
}

fn is_ascii_upper_alpha(c: string) -> boolean {
    c == "A" or c == "B" or c == "C" or c == "D" or c == "E" or c == "F" or c == "G" or c == "H" or
    c == "I" or c == "J" or c == "K" or c == "L" or c == "M" or c == "N" or c == "O" or c == "P" or
    c == "Q" or c == "R" or c == "S" or c == "T" or c == "U" or c == "V" or c == "W" or c == "X" or
    c == "Y" or c == "Z"
}

fn ascii_lower_of(c: string) -> string {
    case is_ascii_upper_alpha(c) of {
        true -> case c of {
            "A" -> "a";
            "B" -> "b";
            "C" -> "c";
            "D" -> "d";
            "E" -> "e";
            "F" -> "f";
            "G" -> "g";
            "H" -> "h";
            "I" -> "i";
            "J" -> "j";
            "K" -> "k";
            "L" -> "l";
            "M" -> "m";
            "N" -> "n";
            "O" -> "o";
            "P" -> "p";
            "Q" -> "q";
            "R" -> "r";
            "S" -> "s";
            "T" -> "t";
            "U" -> "u";
            "V" -> "v";
            "W" -> "w";
            "X" -> "x";
            "Y" -> "y";
            "Z" -> "z";
            _: string -> c
        };
        false -> c
    }
}

fn strings_equal_ascii_ignore_case(a: string, b: string) -> boolean {
    case length_bytes(a) == length_bytes(b) of {
        false -> false;
        true -> strings_eq_ic_loop(a, b, 0, length_bytes(a))
    }
}

fn strings_eq_ic_loop(a: string, b: string, i: int64, n: int64) -> boolean {
    case i >= n of {
        true -> true;
        false -> {
            ca: string <- substring(a, i, i + 1);
            cb: string <- substring(b, i, i + 1);
            case ascii_lower_of(ca) == ascii_lower_of(cb) of {
                true -> strings_eq_ic_loop(a, b, i + 1, n);
                false -> false
            }
        }
    }
}

fn failure_reporter_region_dump_return_ok(ret: string) -> boolean {
    r: string <- type_checker_traits@trim_type_text(ret);
    case r == "int" of {
        true -> true;
        false -> r == "int64"
    }
}

fn failure_reporter_dumps_ty_delete_ascii_spaces(s: string) -> string {
    case length_bytes(s) == 0 of {
        true -> "";
        false -> {
            c: string <- substring(s, 0, 1);
            rest: string <- substring(s, 1, length_bytes(s));
            case c == " " of {
                true -> failure_reporter_dumps_ty_delete_ascii_spaces(rest);
                false -> concat(c, failure_reporter_dumps_ty_delete_ascii_spaces(rest))
            }
        }
    }
}

fn failure_reporter_handle_report_dumps_type_ok(ty: string) -> boolean {
    n: string <- failure_reporter_dumps_ty_delete_ascii_spaces(type_checker_traits@trim_type_text(ty));
    case strings_equal_ascii_ignore_case(n, "[(atom,bytes)]") of {
        true -> true;
        false -> case strings_equal_ascii_ignore_case(n, "list[(atom,bytes),normal]") of {
            true -> true;
            false -> strings_equal_ascii_ignore_case(n, "list[(atom,bytes),mem(normal)]")
        }
    }
}

// §15.4.13.4: exactly two required methods with canonical parameter and return types.
fn check_failure_reporter_export_trait(program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)] <- program.declarations;
    case program_exports_trait_named(decls, "FailureReporter") of {
        false -> type_checker_core@type_check_ok();
        true -> {
            n_req: int64 <- count_tag7_declarations(decls, 0);
            case n_req == 2 of {
                false -> type_checker_core@type_check_err("E2090", program.location, "export trait FailureReporter must declare exactly two required methods: region_dump_limit and handle_report (supervisors plan Phase F; spec §15.4.13.4)", "sect15.4.13.4");
                true -> {
                    (f_rdl: boolean, rdl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) <- find_tag7_by_name(decls, "region_dump_limit");
                    (f_hr: boolean, hr: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) <- find_tag7_by_name(decls, "handle_report");
                    case f_rdl of {
                        false -> type_checker_core@type_check_err("E2090", program.location, "FailureReporter trait must declare required method region_dump_limit() -> int (spec §15.4.13.4)", "sect15.4.13.4");
                        true -> case f_hr of {
                            false -> type_checker_core@type_check_err("E2090", program.location, "FailureReporter trait must declare required method handle_report(report: String, region_dumps: [(atom, Bytes)]) -> :ok (spec §15.4.13.4)", "sect15.4.13.4");
                            true -> case list_param_length_decl(rdl.parameters) == 0 of {
                                false -> type_checker_core@type_check_err("E2090", rdl.location, "FailureReporter region_dump_limit must take no parameters (spec §15.4.13.4)", "sect15.4.13.4");
                                true -> case length_bytes(type_checker_traits@trim_type_text(rdl.return_type_name)) > 0 of {
                                    false -> type_checker_core@type_check_err("E2090", rdl.return_type_location, "FailureReporter region_dump_limit must declare return type int (spec §15.4.13.4)", "sect15.4.13.4");
                                    true -> case failure_reporter_region_dump_return_ok(rdl.return_type_name) of {
                                        false -> type_checker_core@type_check_err("E2090", rdl.return_type_location, "FailureReporter region_dump_limit must return int or int64 (spec §15.4.13.4)", "sect15.4.13.4");
                                        true -> case list_param_length_decl(hr.parameters) == 2 of {
                                            false -> type_checker_core@type_check_err("E2090", hr.location, "FailureReporter handle_report must take exactly two parameters (spec §15.4.13.4)", "sect15.4.13.4");
                                            true -> {
                                                p0: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- hr.parameters.head;
                                                p1: { name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- hr.parameters.tail.head;
                                                t0: string <- type_checker_traits@trim_type_text(p0.type_name);
                                                case strings_equal_ascii_ignore_case(t0, "string") of {
                                                    false -> type_checker_core@type_check_err("E2090", p0.location, "FailureReporter handle_report first parameter must have type String (spec §15.4.13.4)", "sect15.4.13.4");
                                                    true -> case failure_reporter_handle_report_dumps_type_ok(p1.type_name) of {
                                                        false -> type_checker_core@type_check_err("E2090", p1.location, "FailureReporter handle_report second parameter must have type [(atom, Bytes)] (spec §15.4.13.4)", "sect15.4.13.4");
                                                        true -> case length_bytes(type_checker_traits@trim_type_text(hr.return_type_name)) > 0 of {
                                                            false -> type_checker_core@type_check_err("E2090", hr.return_type_location, "FailureReporter handle_report must declare return type :ok (spec §15.4.13.4)", "sect15.4.13.4");
                                                            true -> case type_checker_traits@trim_type_text(hr.return_type_name) == ":ok" of {
                                                                false -> type_checker_core@type_check_err("E2090", hr.return_type_location, "FailureReporter handle_report must return :ok (spec §15.4.13.4)", "sect15.4.13.4");
                                                                true -> type_checker_core@type_check_ok()
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
