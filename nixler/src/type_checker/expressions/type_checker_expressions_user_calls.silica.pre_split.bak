// User-defined and qualified call checking; trait/dispatch helpers.
// Open-recursive via check_surface / check_typed callbacks (no circular use).

use parser_ast;
use type_checker_core;
use type_interner;
use type_checker_expressions_helpers;
use type_checker_tuple_decompose_helpers;
use type_checker_memory_regions;
use type_checker_recursive_tuples;
use type_checker_lists;
use type_checker_collections;
use type_checker_expressions_actors;
use type_checker_supervisor;
use type_checker_record_types;
use type_checker_traits;
use type_checker_callee_env;
use type_checker_expressions_identifiers;
use type_checker_expressions_float32_calls;
use type_checker_expressions_string_calls;
use string_parse;
use instantiated_fn_name;
use type_checker_expressions_call_builtins;
use type_checker_expressions_actor_concurrency;
use type_checker_expressions_bindings;

export check_call/6;
export check_user_defined_call/6;
export dispatch_actual_fits_impl_parameter/3;
export find_tag0_decl_for_qualified_call/6;
export find_function_decl_by_name_arity_call/3;
export qualified_call_first_arg_matches_decl/3;
export recv_type_for_trait_link_mangle/3;
export check_collection_trait_let/7;

fn first_at_in_expr_call_name(s: string, i: int64) -> int64 {
    case i >= len(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "@" of {
            true -> i;
            false -> first_at_in_expr_call_name(s, i + 1)
        }
    }
}

fn check_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], check_surface: fn({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, string, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }), check_typed: fn({ nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, int64, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    // Module-qualified calls (spec §19.3.2): use first_at in this TU. Routing via
    // type_checker_core@call_name_is_module_qualified misclassified on bootstrap (deep builtin chain / stack).
    // Supervisors Phase A: `spawn` / `spawn_linked` are intrinsics (§15.4.8.3); module@spawn_linked must type-check like the unqualified form.
    case first_at_in_expr_call_name(type_checker_expressions_helpers@expr_name(expr), 0) >= 0 of {
        true -> {
            base: string <- type_checker_core@user_call_base_function_name(type_checker_expressions_helpers@expr_name(expr));
            case base == "spawn" or base == "spawn_dangerous" or base == "spawn_registered" or base == "spawn_dangerous_registered" or base == "spawn_registered_supervisor" or base == "spawn_linked" or base == "call_supervisor" or base == "add_child" or base == "link" or base == "monitor" or base == "demonitor" or base == "supervision_ingress_enqueue" or base == "supervision_wait_and_drain_one" or base == "failure_reason_tag" or base == "failure_reason_atom" or base == "failure_agent_type" or base == "failure_release" or base == "start_child" or base == "child_table_first_ref" or base == "child_table_row_ref" or base == "kill_abnormal" or base == "wait_for_exit" or base == "get_registry_actor" or base == "get_pid_registry" or base == "call_registered" or base == "cast_registered" or base == "cast_dangerous_registered" of {
                true -> type_checker_expressions_actor_concurrency@check_actor_concurrency_call(expr, expected_type, context, world, check_surface, check_typed);
                false -> check_user_defined_call(expr, expected_type, context, world, check_surface, check_typed)
            }
        };
        false -> type_checker_expressions_call_builtins@check_call_builtins_dispatch(expr, expected_type, context, world, check_surface, check_typed, check_user_defined_call)
    }
}

// User-defined function call: lookup in symbol table, parse function type "(T1,T2) -> R", check args and result
// Top-level `->` only: parameter types may contain nested `fn(...) -> ...`; naive substring match on ` -> ` splits there first.
fn outer_arrow_token_pos_call(func_type: string) -> int64 {
    type_checker_expressions_identifiers@find_arrow_idf(func_type, 0, 0, 0, 0)
}

fn trim_trailing_spaces_user_call_from(s: string, i: int64) -> string {
    case i <= 0 of {
        true -> "";
        false -> case substring(s, i - 1, i) == " " of {
            true -> trim_trailing_spaces_user_call_from(s, i - 1);
            false -> substring(s, 0, i)
        }
    }
}

fn trim_trailing_spaces_user_call(s: string) -> string {
    trim_trailing_spaces_user_call_from(s, len(s))
}

fn params_part_before_outer_arrow_call(func_type: string) -> string {
    arrow_at: int64 <- outer_arrow_token_pos_call(func_type);
    case arrow_at < 0 of {
        true -> "";
        false -> trim_trailing_spaces_user_call(trim_leading_user_call(substring(func_type, 0, arrow_at)))
    }
}

fn is_function_type_user_call(type_str: string) -> bool {
    outer_arrow_token_pos_call(type_str) >= 0
}

// Find first comma at depth 0 (top level). Respects parentheses, brackets, and braces in type strings
// so that a single tuple parameter like (int64, int64), ref(R, Space, T), or { x: int64, y: int64 } counts as 1 param.
fn find_top_level_comma_user_call(s: string, i: int64, depth: int64) -> int64 {
    case i >= len(s) of {
        true -> len(s);
        false -> case substring(s, i, i + 1) == "(" or substring(s, i, i + 1) == "[" or substring(s, i, i + 1) == "{" of {
            true -> find_top_level_comma_user_call(s, i + 1, depth + 1);
            false -> case substring(s, i, i + 1) == ")" or substring(s, i, i + 1) == "]" or substring(s, i, i + 1) == "}" of {
                true -> case depth <= 0 of {
                    true -> len(s);
                    false -> find_top_level_comma_user_call(s, i + 1, depth - 1)
                };
                false -> case substring(s, i, i + 1) == "," of {
                    true -> case depth == 0 of {
                        true -> i;
                        false -> find_top_level_comma_user_call(s, i + 1, depth)
                    };
                    false -> find_top_level_comma_user_call(s, i + 1, depth)
                }
            }
        }
    }
}

fn trim_leading_user_call(s: string) -> string {
    trim_leading_user_call_from(s, 0)
}

fn trim_leading_user_call_from(s: string, i: int64) -> string {
    case i >= len(s) of {
        true -> "";
        false -> case substring(s, i, i + 1) == " " of {
            true -> trim_leading_user_call_from(s, i + 1);
            false -> substring(s, i, len(s))
        }
    }
}

fn parse_function_param_count(func_type: string) -> int64 {
    arrow_pos: int64 <- outer_arrow_token_pos_call(func_type);
    case arrow_pos < 0 of {
        true -> 0;
        false -> {
            params_part: string <- params_part_before_outer_arrow_call(func_type);
            case len(params_part) < 1 of {
                true -> 0;
                false -> case substring(params_part, 0, 1) == "(" and substring(params_part, len(params_part) - 1, len(params_part)) == ")" of {
                    true -> {
                        inner: string <- trim_leading_user_call(substring(params_part, 1, len(params_part) - 1));
                        case len(inner) == 0 of {
                            true -> 0;
                            false -> parse_param_count_inner(inner)
                        }
                    };
                    false -> {
                        inner_np: string <- trim_leading_user_call(params_part);
                        case len(inner_np) == 0 of {
                            true -> 0;
                            false -> parse_param_count_inner(inner_np)
                        }
                    }
                }
            }
        }
    }
}

fn parse_param_count_inner(inner: string) -> int64 {
    comma1: int64 <- find_top_level_comma_user_call(inner, 0, 0);
    case comma1 >= len(inner) of {
        true -> 1;
        false -> {
            rest: string <- trim_leading_user_call(substring(inner, comma1 + 1, len(inner)));
            case len(rest) == 0 of {
                true -> 2;
                false -> 1 + parse_param_count_inner(rest)
            }
        }
    }
}

fn parse_function_return_type(func_type: string) -> string {
    arrow_pos: int64 <- outer_arrow_token_pos_call(func_type);
    case arrow_pos < 0 of {
        true -> "";
        false -> trim_leading_user_call(substring(func_type, arrow_pos + 2, len(func_type)))
    }
}

fn get_params_inner_from_func_type(func_type: string) -> string {
    arrow_pos: int64 <- outer_arrow_token_pos_call(func_type);
    case arrow_pos < 0 of {
        true -> "";
        false -> {
            params_part: string <- params_part_before_outer_arrow_call(func_type);
            case len(params_part) < 1 of {
                true -> "";
                false -> case substring(params_part, 0, 1) == "(" and substring(params_part, len(params_part) - 1, len(params_part)) == ")" of {
                    true -> trim_leading_user_call(substring(params_part, 1, len(params_part) - 1));
                    false -> trim_leading_user_call(params_part)
                }
            }
        }
    }
}

fn get_first_param_type(params_inner: string) -> (string, string) {
    case len(params_inner) == 0 of {
        true -> ("", "");
        false -> {
            comma_pos: int64 <- find_top_level_comma_user_call(params_inner, 0, 0);
            case comma_pos >= len(params_inner) of {
                true -> (trim_leading_user_call(params_inner), "");
                false -> {
                    first: string <- trim_leading_user_call(substring(params_inner, 0, comma_pos));
                    rest: string <- trim_leading_user_call(substring(params_inner, comma_pos + 1, len(params_inner)));
                    (first, rest)
                }
            }
        }
    }
}

// Args after the first: kind-4 chain nodes only; anything else (non--1, non-4) does not add args (avoids counting 2 for a single-arg call when the tail is not dummy).
fn count_additional_call_args_user_call(er: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> int64 {
    case type_checker_expressions_helpers@expr_kind(er) == -1 of {
        true -> 0;
        false -> case type_checker_expressions_helpers@expr_kind(er) == 4 of {
            true -> 1 + count_additional_call_args_user_call(type_checker_expressions_helpers@expr_child_right(er));
            false -> 0
        }
    }
}

fn count_call_args_user_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> int64 {
    case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(expr)) == -1 of {
        true -> 0;
        false -> 1 + count_additional_call_args_user_call(type_checker_expressions_helpers@expr_child_right(expr))
    }
}

// Local helper (same as type_checker_modules / type_checker_callee_env list_param_length). Avoid importing type_checker_modules (declarations_functions → … → expressions cycle).
fn list_param_length_call(ps: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> int64 {
    case ps.is_nil of {
        true -> 0;
        false -> 1 + list_param_length_call(ps.tail)
    }
}

// First tag-0 match with same name/arity (legacy fallback when receiver type is unknown or no overload fits).
fn find_function_decl_by_name_arity_call(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], fn_name: string, arity: int64) -> (bool, { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) {
    case decls.is_nil of {
        true -> (false, parser_ast@dummy_decl());
        false -> case decls.head.tag == 0 of {
            true -> case instantiated_fn_name@decl_name_matches(decls.head.name, fn_name) and list_param_length_call(decls.head.parameters) == arity of {
                true -> (true, decls.head);
                false -> find_function_decl_by_name_arity_call(decls.tail, fn_name, arity)
            };
            false -> find_function_decl_by_name_arity_call(decls.tail, fn_name, arity)
        }
    }
}

