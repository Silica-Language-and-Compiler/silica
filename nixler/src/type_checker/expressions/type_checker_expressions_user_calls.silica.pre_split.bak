fn param_types_str_from_params(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> string {
    case params.is_nil of {
        true -> "";
        false -> case params.tail.is_nil of {
            true -> params.head.type_name;
            false -> concat(concat(param_types_str_from_params(params.tail), ","), params.head.type_name)
        }
    }
}

fn build_function_type_for_decl_call(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> string {
    params_str: string <- param_types_str_from_params(decl.parameters);
    case decl.parameters.is_nil of {
        true -> concat("() -> ", decl.return_type_name);
        false -> concat(concat(concat("(", params_str), ") -> "), decl.return_type_name)
    }
}

fn inferred_types_concat_comma(bucket: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> string {
    case bucket.is_nil of {
        true -> "";
        false -> case bucket.tail.is_nil of {
            true -> bucket.head.type_name;
            false -> concat(concat(bucket.head.type_name, ","), inferred_types_concat_comma(bucket.tail))
        }
    }
}

fn call_site_actual_matches_formal(inferred: string, formal: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> bool {
    fin: string <- type_checker_traits@trim_type_text(inferred);
    fdecl: string <- type_checker_traits@trim_type_text(formal);
    case fin == fdecl of {
        true -> true;
        false -> case call_site_record_types_compatible(fin, fdecl, world) of {
            true -> true;
            false -> case type_checker_collections@is_collection_trait_type(fin) of {
                true -> type_checker_collections@collection_type_fits_concrete_record(fin, fdecl, world);
                false -> case type_checker_collections@is_collection_trait_type(fdecl) of {
                    true -> type_checker_collections@collection_type_fits_concrete_record(fdecl, fin, world);
                    false -> case type_checker_tuple_decompose_helpers@types_equal_surface(fin, fdecl) of {
                        true -> true;
                        false -> case type_checker_expressions_identifiers@function_types_compatible(fin, fdecl) of {
                            true -> true;
                            false -> case type_checker_lists@formal_type_accepts_actual(fin, fdecl, world) of {
                                true -> true;
                                false -> type_checker_traits@actual_type_satisfies_trait_expectation(fin, fdecl, world)
                            }
                        }
                    }
                }
            }
        }
    }
}

fn call_site_record_types_compatible(actual: string, formal: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> bool {
    case type_checker_record_types@record_type_starts(actual) of {
        false -> false;
        true -> case type_checker_record_types@record_type_starts(formal) of {
            false -> false;
            true -> {
                nformal: int64 <- type_checker_record_types@count_record_fields(formal);
                nactual: int64 <- type_checker_record_types@count_record_fields(actual);
                case nformal == nactual of {
                    false -> false;
                    true -> {
                        inner: string <- type_checker_record_types@record_case_inner_body(formal);
                        call_site_record_fields_match_loop(inner, actual, world)
                    }
                }
            }
        }
    }
}

fn call_site_record_fields_match_loop(rem: string, actual: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> bool {
    case len(rem) == 0 of {
        true -> true;
        false -> {
            (seg: string, rest: string) <- type_checker_record_types@record_case_field_step(rem);
            (fname: string, ftype: string) <- type_checker_record_types@record_field_segment_name_sub(seg);
            case len(fname) == 0 of {
                true -> false;
                false -> {
                    atype: string <- type_checker_record_types@find_field_type_in_record(actual, fname);
                    case len(atype) == 0 of {
                        true -> false;
                        false -> case type_checker_lists@formal_type_accepts_actual(atype, ftype, world) of {
                            false -> false;
                            true -> call_site_record_fields_match_loop(rest, actual, world)
                        }
                    }
                }
            }
        }
    }
}

// Widen/narrow: integer literal infers as int64; impl may take int32 etc.
fn replace_int64_with_int32_in_type_text_loop(s: string, i: int64, out: string) -> string {
    case i >= len(s) of {
        true -> out;
        false -> case i + 5 <= len(s) and substring(s, i, i + 5) == "int64" of {
            true -> replace_int64_with_int32_in_type_text_loop(s, i + 5, concat(out, "int32"));
            false -> replace_int64_with_int32_in_type_text_loop(s, i + 1, concat(out, substring(s, i, i + 1)))
        }
    }
}

fn struct_literal_inferred_matches_impl_record(actual: string, impl_param: string) -> bool {
    a: string <- type_checker_traits@trim_type_text(actual);
    p: string <- type_checker_traits@trim_type_text(impl_param);
    case len(a) > 0 of {
        false -> false;
        true -> case substring(a, 0, 1) == "{" of {
            false -> false;
            true -> {
                relaxed: string <- replace_int64_with_int32_in_type_text_loop(a, 0, "");
                type_checker_tuple_decompose_helpers@types_equal_surface(relaxed, p)
            }
        }
    }
}

fn dispatch_actual_fits_impl_parameter(actual: string, impl_param: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> bool {
    case call_site_actual_matches_formal(actual, impl_param, world) of {
        true -> true;
        false -> {
            a: string <- type_checker_traits@trim_type_text(actual);
            p: string <- type_checker_traits@trim_type_text(impl_param);
            case type_checker_collections@is_collection_trait_type(a) of {
                true -> type_checker_collections@collection_type_fits_impl_parameter(a, p, world);
                false -> case a == "int64" of {
                    true -> p == "int8" or p == "int16" or p == "int32" or p == "uint8" or p == "uint16" or p == "uint32";
                    false -> case type_checker_lists@formal_type_accepts_actual(a, p, world) of {
                        true -> true;
                        false -> struct_literal_inferred_matches_impl_record(actual, impl_param)
                    }
                }
            }
        }
    }
}

// Tag-0 decl whose first parameter is not the trait Self type (skip e.g. provided fn double_area(s: Shape)).
fn impl_first_param_if_concrete_impl(trait_self: string, d: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> string {
    case d.tag == 0 of {
        false -> "";
        true -> case d.parameters.is_nil of {
            true -> "";
            false -> {
                source_params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] <- parser_ast@list_param_reverse_with_acc(d.parameters, parser_ast@nil_list_param());
                p0: string <- type_checker_traits@trim_type_text(source_params.head.type_name);
                ts: string <- type_checker_traits@trim_type_text(trait_self);
                case p0 == ts of {
                    true -> "";
                    false -> p0
                }
            }
        }
    }
}

fn gather_trait_dispatch_candidates_loop(decls: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], trait_self: string, inferred_actual: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)], cand0: string, cand_count: int64) -> (int64, string) {
