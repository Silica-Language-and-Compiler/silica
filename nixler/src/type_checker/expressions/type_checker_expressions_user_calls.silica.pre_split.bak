            case pf of {
                false -> check_user_call_args_recursive(expr, params_use, expected_type, return_type, context, expr, world, check_surface);
                true -> {
                    recv_ty: string <- case ac > 0 of {
                        true -> type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@expr_child_inner(expr), context);
                        false -> ""
                    };
                    (pfd: bool, callee_decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) <- find_qualified_call_resolved_declaration(pprog, fn_id, type_checker_expressions_helpers@expr_value(expr), ac, recv_ty, type_checker_expressions_helpers@expect_surf(context, expected_type), world);
                    case pfd of {
                        false -> check_user_call_args_recursive(expr, params_use, expected_type, return_type, context, expr, world, check_surface);
                        true -> case callee_decl.tag == 0 of {
                            false -> check_user_call_args_recursive(expr, params_use, expected_type, return_type, context, expr, world, check_surface);
                                true -> case params_use != params_inner of {
                                true -> {
                                    chk_args: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- check_user_call_args_recursive(expr, params_use, expected_type, resolved_return, context, expr, world, check_surface);
                                    case chk_args.is_ok of {
                                        false -> chk_args;
                                        true -> check_user_call_result_user_call(expr, expected_type, resolved_return, context, world)
                                    }
                                };
                                false -> {
                                    // Collection bind types must witness ItemType/KeyType/ValueType inside
                                    // constructor formals (e.g. OrderedMap[...] <- wbt_map@empty({...})).
                                    col_ctx: string <- case type_checker_collections@is_collection_trait_type(type_checker_expressions_helpers@expect_surf(context, expected_type)) of {
                                        true -> type_checker_expressions_helpers@expect_surf(context, expected_type);
                                        false -> ""
