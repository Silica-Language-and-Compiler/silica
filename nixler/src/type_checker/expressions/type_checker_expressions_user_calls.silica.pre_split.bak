                                    (inf_ok: { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, inf_left: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) <- infer_trait_site_call_args_walk(expr, params_lr, context, world, expr, pprog, trait_arg_walk_state(col_ctx, "", 0));
