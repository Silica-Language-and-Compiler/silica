next_id: int64, seq_nil_id: int64 } }, List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, rec), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: bool, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } proc[DeviceIO] {
    func_type_canon: string <- type_checker_expressions_identifiers@normalize_fn_type_idf(func_type);
    expected_arg_count: int64 <- parse_function_param_count(func_type_canon);
    params_inner: string <- get_params_inner_from_func_type(func_type_canon);
    return_type: string <- parse_function_return_type(func_type_canon);
    arg_count: int64 <- count_call_args_user_call(expr);
    case callee_type_from_world of {
        true -> check_user_defined_world_call_with_inference(expr, expected_type, context, params_inner, return_type, world, check_surface, check_typed);
                false -> case arg_count != expected_arg_count of {
        true -> case expected_arg_count == 2 and arg_count == 1 and params_inner_is_ptr_len_pair(params_inner) of {
            true -> {
                (r_str, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), "string", context, world);
                case r_str.is_ok of {
                    false -> r_str;
                    true -> check_user_call_result_user_call(expr, expected_type, return_type, context, world)
                }
            };
            false -> case expected_arg_count == 1 of {
            true -> case arg_count == 2 of {
                true -> case len(params_inner) >= 2 of {
                    true -> case substring(params_inner, 0, 1) == "(" of {
                        true -> case substring(params_inner, len(params_inner) - 1, len(params_inner)) == ")" of {
                            true -> check_user_call_two_args_as_tuple(expr, params_inner, expected_type, return_type, context, world, check_surface, check_typed);
                            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat(type_checker_expressions_helpers@expr_name(expr), " argument count mismatch"), "sect6")
                        };
                        false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat(type_checker_expressions_helpers@expr_name(expr), " argument count mismatch"), "sect6")
                    };
                    false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat(type_checker_expressions_helpers@expr_name(expr), " argument count mismatch"), "sect6")
                };
                false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat(type_checker_expressions_helpers@expr_name(expr), " argument count mismatch"), "sect6")
            };
            false -> case expected_arg_count == 2 of {
                true -> case arg_count == 1 of {
                    true -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(expr)) == 9 of {
                        true -> check_user_call_one_tuple_as_two_args(expr, params_inner, expected_type, return_type, context, world, check_surface, check_typed);
                        false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat(type_checker_expressions_helpers@expr_name(expr), " argument count mismatch"), "sect6")
                    };
                    false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat(type_checker_expressions_helpers@expr_name(expr), " argument count mismatch"), "sect6")
                };
                false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat(type_checker_expressions_helpers@expr_name(expr), " argument count mismatch"), "sect6")
            }
            }
        };
        false -> check_user_call_args_recursive(expr, params_inner, expected_type, return_type, context, expr, world, check_surface)
        }
    }
}

