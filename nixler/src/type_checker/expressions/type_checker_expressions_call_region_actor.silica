// Region, actor-concurrency, list-primitive, and spawn-affinity builtin calls.
// Open-recursive via check_surface / check_typed callbacks (no circular use).

use type_checker_core;
use type_checker_expressions_helpers;
use type_checker_memory_regions;
use type_checker_lists;
use type_checker_expressions_region_builtins;
use type_checker_expressions_actor_concurrency;
use type_checker_expressions_list_primitives;
use type_checker_expressions_actor_spawn;

export is_region_actor_list_name/1;
export check_region_actor_list/6;

fn is_region_actor_list_name(n: string) -> boolean {
    case type_checker_memory_regions@is_region_builtin_call(n) of {
        true -> true;
        false -> case type_checker_expressions_actor_concurrency@is_actor_concurrency_builtin(n) of {
            true -> true;
            false -> case type_checker_lists@is_list_primitive_name(n) of {
                true -> true;
                false -> case n == "core_id" or n == "core_set" or n == "stack_policy" of {
                    true -> true;
                    false -> false
                }
            }
        }
    }
}

fn check_region_actor_list(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64