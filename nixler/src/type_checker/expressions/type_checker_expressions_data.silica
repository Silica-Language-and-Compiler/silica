em(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    lit_t: string <- case length_bytes(type_checker_expressions_helpers@expr_value(expr)) > 0 of {
        true -> type_checker_expressions_helpers@expr_value(expr);
        false -> type_checker_expressions_helpers@expect_surf(context, expected_type)
    };
    case length_bytes(lit_t) == 0 of {
        true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "list literal requires a typed binding (name: List[T, S] <- [...])", "list");
        false -> {
            case type_checker_lists@list_types_compatible(type_checker_expressions_helpers@expect_surf(context, expected_type), lit_t) of {
                false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat(concat(concat(concat("list literal type ", lit_t), " does not match expected "), type_checker_expressions_helpers@expect_surf(context, expected_type)), ""), "list");
                true -> {
                    (_ok: boolean, elem_t: string, _: string) <- type_checker_lists@parse_list_type_params(lit_t);
                    case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(expr)) == -1 of {
                        true -> type_checker_core@type_check_ok();
                        false -> check_list_elem_tree(expr, elem_t, context, world, check_surface, check_typed)
                    }
                }
            }
        }
    }
}

