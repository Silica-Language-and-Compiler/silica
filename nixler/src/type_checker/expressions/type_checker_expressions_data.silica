        false -> case type_checker_expressions_helpers@expr_kind(expr) == 21 of {
            false -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "ill-formed struct literal (expected kind 21)", "sect3");
            true -> {
                ft: string <- type_checker_record_types@find_field_type_in_record(record_type, type_checker_expressions_helpers@expr_name(expr));
                case length_bytes(ft) == 0 of {
                    true -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat(concat("field ", type_checker_expressions_helpers@expr_name(expr)), " is not part of the record type"), "sect3");
                    false -> {
                        (r1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), ft, context, world);
                        case r1.is_ok of {
                            false -> r1;
                            true -> check_struct_literal_chain(type_checker_expressions_helpers@expr_child_right(expr), record_type, context, world, check_surface, check_typed)
                        }
                    }
                }
            }
        }
    }
}

