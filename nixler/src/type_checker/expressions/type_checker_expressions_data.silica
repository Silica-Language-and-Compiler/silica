ng }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
        true -> check_struct_literal_discard_chain(expr, context, world, check_surface, check_typed);
        false -> {
            exp_rec: string <- type_checker_record_types@expand_named_topology_type(type_checker_expressions_helpers@expect_surf(context, expected_type));
            // An expected inline sum type with record variants (`:none | { id: uint32 }`,
            // silica-specification §3.4.2, §15.4.8): the literal builds the variant its fields name.
            exp_sum: boolean <- type_checker_tuple_decompose_helpers@case_sum_bar_depth0(type_checker_expressions_helpers@expect_surf(context, expected_type), 0, 0) >= 0;
            rec_expected: string <- case exp_sum of {
                true -> type_checker_tuple_decompose_helpers@struct_literal_sum_variant(expr, type_checker_expressions_helpers@expect_surf(context, expected_type));
                false -> case length_bytes(exp_rec) > 0 of { true -> exp_rec; false -> type_checker_expressions_helpers@expect_surf(context, expected_type) }
            };
            case type_checker_record_types@record_type_starts(rec_expected) of {
                false -> case exp_sum of {
                    true -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat("record literal matches no variant of ", type_checker_expressions_helpers@expect_surf(context, expected_type)), "sect3");
                    false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat(concat("expected record type, got ", type_checker_expressions_helpers@expect_surf(context, expected_type)), ""), "sect3")
                };
                true -> {
                    n_type: int64 <- type_checker_record_types@count_record_fields(rec_expected);
                    n_lit: int64 <- count_struct_chain_nodes(expr);
                    case n_type == n_lit of {
                        false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), "struct literal field count does not match record type", "sect3");
                        true -> check_struct_literal_chain(expr, rec_expected, context, world, check_surface, check_typed)
                    }
                }
            }
        }
    }
}

fn field_collection_fits(field_type: string, expected: string, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> boolean {
    case type_checker_collections@is_collection_trait_type(expected) and type_checker_collections@collection_type_fits_concrete_record(expected, field_type, world) of {
        true -> true;
        false -> type_checker_collections@is_collection_trait_type(field_type) and type_checker_collections@collection_type_fits_concrete_record(field_type, expected, world)
    }
}

