 }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } })) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    base_t: string <- type_checker_tuple_decompose_helpers@infer_expr_type(type_checker_expressions_helpers@expr_child_inner(expr), context);
    case length_bytes(base_t) == 0 of {
        true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), "cannot infer type of field access base", "sect3");
        false -> {
            exp_base: string <- type_checker_record_types@expand_named_topology_type(base_t);
            rec_base: string <- case length_bytes(exp_base) > 0 of { true -> exp_base; false -> base_t };
            case type_checker_record_types@record_type_starts(rec_base) of {
                true -> check_field_access_field_type(expr, base_t, type_checker_record_types@find_field_type_in_record(rec_base, type_checker_expressions_helpers@expr_name(expr)), expected_type, context, world, check_surface, check_typed);
                false -> {
                    list_ft: string <- type_checker_lists@list_field_access_type(rec_base, type_checker_expressions_helpers@expr_name(expr));
                    case length_bytes(list_ft) == 0 of {
                        true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat(concat("field access base must be record, List[T, S], or topology type (cpu_topology, core_info, ...), got ", base_t), ""), "sect3");
                        false -> check_field_access_field_type(expr, base_t, list_ft, expected_type, context, world, check_surface, check_typed)
                    }
                }
            }
        }
    }
}
