    case type_checker_expressions_helpers@expr_kind(expr) == 20 of {
        true -> {
            (r1, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), elem_type, context, world);
            case r1.is_ok of {
                false -> r1;
                true -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == -1 of {
                    true -> type_checker_core@type_check_ok();
                    // Spine pairs carry name ","; a kind-20 node without it in the right slot is the last
                    // element and itself a list literal (`[[1], [2, 3]]`), checked as one element.
                    false -> case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(expr)) == 20 and type_checker_expressions_helpers@expr_name(type_checker_expressions_helpers@expr_child_right(expr)) != "," of {
                        true -> {
                            (r2, _) <- check_surface(type_checker_expressions_helpers@expr_child_right(expr), elem_type, context, world);
                            r2
                        };
                        false -> check_list_elem_tree(type_checker_expressions_helpers@expr_child_right(expr), elem_type, context, world, check_surface, check_typed)
                    }
                }
            }
        };
        false -> {
                        (r, _) <- check_surface(expr, elem_type, context, world);
                        r
                    }
    }
}
fn count_struct_chain_nodes(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> int64 {
    case type_checker_expressions_helpers@expr_kind(expr) == -1 or type_checker_expressions_helpers@expr_kind(expr) == 999 of {
        true -> 0;
        false -> case type_checker_expressions_helpers@expr_kind(expr) == 21 of {
            true -> 1 + count_struct_chain_nodes(type_checker_expressions_helpers@expr_child_right(expr));
            false -> 0
        }
    }
}

