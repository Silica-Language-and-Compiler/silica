    case length_bytes(ft) == 0 of {
        true -> type_checker_core@type_check_err("E2005", type_checker_expressions_helpers@expr_loc(expr), concat(concat("no field ", type_checker_expressions_helpers@expr_name(expr)), " on this type"), "sect3");
        false -> {
            (rbase, _) <- check_surface(type_checker_expressions_helpers@expr_child_inner(expr), base_t, context, world);
            case rbase.is_ok of {
                false -> rbase;
                true -> case type_interner@node_kind(context.interner, expected_type) == type_interner@kind_discard() of {
                    true -> type_checker_core@type_check_ok();
                    false -> case type_checker_tuple_decompose_helpers@types_equal_surface(ft, type_checker_expressions_helpers@expect_surf(context, expected_type)) of {
                        true -> type_checker_core@type_check_ok();
                        false -> case type_checker_expressions_identifiers@function_types_compatible(ft, type_checker_expressions_helpers@expect_surf(context, expected_type)) of {
                            true -> type_checker_core@type_check_ok();
                            false -> case type_checker_lists@formal_type_accepts_actual(ft, type_checker_expressions_helpers@expect_surf(context, expected_type), world) of {
                                true -> type_checker_core@type_check_ok();
                                false -> case type_checker_core@surface_matches_type_id(context, ft, expected_type) of {
                                    true -> type_checker_core@type_check_ok();
                                    false -> case type_checker_expressions_identifiers@ident_fallback_ok_i(ft, type_checker_expressions_helpers@expect_surf(context, expected_type)) of {
                                        1 -> type_checker_core@type_check_ok();
                                        // A field holding the generated concrete record of a collection meets a
                                        // bracket-typed expectation (SearchTree[T, mem(S)], OrderedSet[...], ...) or
                                        // the reverse, exactly as an identifier does (identifiers module): the record
                                        // is that collection's concrete type (search_tree_trait.md §2, §4).
                                        _: int64 -> case field_collection_fits(ft, type_checker_expressions_helpers@expect_surf(context, expected_type), world) of {
                                            true -> type_checker_core@type_check_ok();
                                            false -> type_checker_core@type_check_err("E2003", type_checker_expressions_helpers@expr_loc(expr), concat(concat(concat(concat("field has type ", ft), ", expected "), type_checker_expressions_helpers@expect_surf(context, expected_type)), ""), "sect3")
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

