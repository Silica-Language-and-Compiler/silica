                    case body_ok.is_ok of {
                        false -> body_ok;
                        true -> type_checker_expressions_user_call_check_args_result@check_user_call_result_user_call(expr, expected_type, type_checker_tuple_decompose_helpers@call_lifetime_subst_return(expr, params_inner_inf, return_type, type_checker_expressions_helpers@expect_surf(context, expected_type), context), context, world)
                    }
                }
            }
