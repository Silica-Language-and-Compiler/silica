            chk_args: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- type_checker_expressions_user_call_check_args@check_user_call_args_recursive(expr, params_inner_inf, expected_type, return_type, context, expr, world, check_surface);
