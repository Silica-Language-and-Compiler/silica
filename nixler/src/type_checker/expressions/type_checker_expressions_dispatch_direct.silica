// Thin kind dispatcher: literals, identifiers, atoms, boolean, string literal, parse errors.
// No open-recursion callbacks. Kind 1 uses a local true/false name check so this unit
// does not load the case/tuple/list/struct expression leaves.

use type_checker_core;
use type_checker_expressions_helpers;
use type_checker_expressions_literals;
use type_checker_expressions_identifiers;
use type_checker_expressions_atoms;
use type_checker_expressions_string_calls;
use boolean_type_checker_expressions;

export check_direct/4;

fn is_true_or_false_identifier(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> boolean {
    case length_bytes(type_checker_expressions_helpers@expr_name(expr)) of {
        4 -> case substring(type_checker_expressions_helpers@expr_name(expr), 0, 1) of {
            "t" -> case substring(type_checker_expressions_helpers@expr_name(expr), 1, 2) of {
                "r" -> case substring(type_checker_expressions_helpers@expr_name(expr), 2, 3) of {
                    "u" -> case substring(type_checker_expressions_helpers@expr_name(expr), 3, 4) of { "e" -> true; _: string -> false };
                    _: string -> false
                };
                _: string -> false
            };
            _: string -> false
        };
        5 -> case substring(type_checker_expressions_helpers@expr_name(expr), 0, 1) of {
            "f" -> case substring(type_checker_expressions_helpers@expr_name(expr), 1, 2) of {
                "a" -> case substring(type_checker_expressions_helpers@expr_name(expr), 2, 3) of {
                    "l" -> case substring(type_checker_expressions_helpers@expr_name(expr), 3, 4) of {
                        "s" -> case substring(type_checker_expressions_helpers@expr_name(expr), 4, 5) of { "e" -> true; _: string -> false };
                        _: string -> false
                    };
                    _: string -> false
                };
                _: string -> false
            };
            _: string -> false
        };
        _: int64 -> false
    }
}

fn check_direct(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, expected_type: int64, context: { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }, world: List[{ module_name: string, program: { declarations: List[{ tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], location: { file: string, line: int64, column: int64, offset: int64 } } }, mem(normal)]) -> ({ is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string }, { env: List[{ name: string, type_id: int64, surface_type: string, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], is_effect_alias: boolean, source_module: string }, mem(normal)], interner: { nodes: List[{ kind: int64, arg_a: int64, arg_b: int64, arg_c: int64, buf_size_is_name: boolean }, mem(normal)], by_key: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, names: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, name_lexemes: List[string, mem(normal)], next_id: int64, seq_nil_id: int64 } }) {
    case type_checker_expressions_helpers@expr_kind(expr) of {
        0 -> type_checker_expressions_literals@check_expr(expr, expected_type, context, world);
        1 -> case is_true_or_false_identifier(expr) of {
            true -> boolean_type_checker_expressions@check_expr(expr, expected_type, context, world);
            false -> type_checker_expressions_identifiers@check_expr(expr, expected_type, context, world)
        };
        5 -> type_checker_expressions_atoms@check_expr(expr, expected_type, context, world);
        7 -> boolean_type_checker_expressions@check_expr(expr, expected_type, context, world);
        8 -> (type_checker_expressions_string_calls@check_string_literal(expr, expected_type, context), context);
        996 -> (type_checker_core@type_check_err("E1040", type_checker_expressions_helpers@expr_loc(expr), "expected ';' after this statement before the next statement", "sect3"), context);
        995 -> (type_checker_core@type_check_err("E1000", type_checker_expressions_helpers@expr_loc(expr), "There is an uncategorized syntactic defect in the code you are working on.", "sect3"), context);
        997 -> (type_checker_core@type_check_err("E1041", type_checker_expressions_helpers@expr_loc(expr), "the last expression in this block must not be followed by ';'", "sect3"), context);
        _: int64 -> (type_checker_core@type_check_ok(), context)
    }
}
