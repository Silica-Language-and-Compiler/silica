// String/arity helpers for user-defined call checking (no open-recursion callbacks).

use parser_ast;
use type_checker_core;
use type_interner;
use type_checker_expressions_helpers;
use type_checker_tuple_decompose_helpers;
use type_checker_memory_regions;
use type_checker_recursive_tuples;
use type_checker_lists;
use type_checker_collections;
use type_checker_expressions_actors;
use type_checker_supervisor;
use type_checker_record_types;
use type_checker_traits;
use type_checker_callee_env;
use type_checker_expressions_identifiers;
use type_checker_expressions_float32_calls;
use type_checker_expressions_string_calls;
use string_parse;
use instantiated_fn_name;

export build_function_type_for_decl_call/1;
export count_call_args_user_call/1;
export find_top_level_comma_user_call/3;
export first_at_in_expr_call_name/2;
export get_first_param_type/1;
export get_params_inner_from_func_type/1;
export inferred_types_concat_comma/1;
export is_function_type_user_call/1;
export list_param_length_call/1;
export params_inner_is_ptr_len_pair/1;
export parse_function_param_count/1;
export parse_function_return_type/1;
export return_type_has_ptr_len_out_fields/1;
export trim_leading_user_call/1;

fn first_at_in_expr_call_name(s: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "@" of {
            true -> i;
            false -> first_at_in_expr_call_name(s, i + 1)
        }
    }
}

fn outer_arrow_token_pos_call(func_type: string) -> int64 {
    type_checker_expressions_identifiers@callee_outer_arrow_idf(func_type)
}

fn trim_trailing_spaces_user_call_from(s: string, i: int64) -> string {
    case i <= 0 of {
        true -> "";
        false -> case substring(s, i - 1, i) == " " of {
            true -> trim_trailing_spaces_user_call_from(s, i - 1);
            false -> substring(s, 0, i)
        }
    }
}

fn trim_trailing_spaces_user_call(s: string) -> string {
    trim_trailing_spaces_user_call_from(s, length_bytes(s))
}

fn params_part_before_outer_arrow_call(func_type: string) -> string {
    arrow_at: int64 <- outer_arrow_token_pos_call(func_type);
    case arrow_at < 0 of {
        true -> "";
        false -> trim_trailing_spaces_user_call(trim_leading_user_call(substring(func_type, 0, arrow_at)))
    }
}

fn is_function_type_user_call(type_str: string) -> boolean {
    outer_arrow_token_pos_call(type_str) >= 0
}

// Find first comma at depth 0 (top level). Respects parentheses, brackets, and braces in type strings
// so that a single tuple parameter like (int64, int64), ref(R, Space, T), or { x: int64, y: int64 } counts as 1 param.

fn find_top_level_comma_user_call(s: string, i: int64, depth: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> length_bytes(s);
        false -> case substring(s, i, i + 1) == "(" or substring(s, i, i + 1) == "[" or substring(s, i, i + 1) == "{" of {
            true -> find_top_level_comma_user_call(s, i + 1, depth + 1);
            false -> case substring(s, i, i + 1) == ")" or substring(s, i, i + 1) == "]" or substring(s, i, i + 1) == "}" of {
                true -> case depth <= 0 of {
                    true -> length_bytes(s);
                    false -> find_top_level_comma_user_call(s, i + 1, depth - 1)
                };
                false -> case substring(s, i, i + 1) == "," of {
                    true -> case depth == 0 of {
                        true -> i;
                        false -> find_top_level_comma_user_call(s, i + 1, depth)
                    };
                    false -> find_top_level_comma_user_call(s, i + 1, depth)
                }
            }
        }
    }
}

fn trim_leading_user_call(s: string) -> string {
    trim_leading_user_call_from(s, 0)
}

fn trim_leading_user_call_from(s: string, i: int64) -> string {
    case i >= length_bytes(s) of {
        true -> "";
        false -> case substring(s, i, i + 1) == " " of {
            true -> trim_leading_user_call_from(s, i + 1);
            false -> substring(s, i, length_bytes(s))
        }
    }
}

fn parse_function_param_count(func_type: string) -> int64 {
    arrow_pos: int64 <- outer_arrow_token_pos_call(func_type);
    case arrow_pos < 0 of {
        true -> 0;
        false -> {
            params_part: string <- params_part_before_outer_arrow_call(func_type);
            case length_bytes(params_part) < 1 of {
                true -> 0;
                false -> case substring(params_part, 0, 1) == "(" and substring(params_part, length_bytes(params_part) - 1, length_bytes(params_part)) == ")" of {
                    true -> {
                        inner: string <- trim_leading_user_call(substring(params_part, 1, length_bytes(params_part) - 1));
                        case length_bytes(inner) == 0 of {
                            true -> 0;
                            false -> parse_param_count_inner(inner)
                        }
                    };
                    false -> {
                        inner_np: string <- trim_leading_user_call(params_part);
                        case length_bytes(inner_np) == 0 of {
                            true -> 0;
                            false -> parse_param_count_inner(inner_np)
                        }
                    }
                }
            }
        }
    }
}

fn parse_param_count_inner(inner: string) -> int64 {
    comma1: int64 <- find_top_level_comma_user_call(inner, 0, 0);
    case comma1 >= length_bytes(inner) of {
        true -> 1;
        false -> {
            rest: string <- trim_leading_user_call(substring(inner, comma1 + 1, length_bytes(inner)));
            case length_bytes(rest) == 0 of {
                true -> 2;
                false -> 1 + parse_param_count_inner(rest)
            }
        }
    }
}

fn parse_function_return_type(func_type: string) -> string {
    arrow_pos: int64 <- outer_arrow_token_pos_call(func_type);
    case arrow_pos < 0 of {
        true -> "";
        false -> trim_leading_user_call(substring(func_type, arrow_pos + 2, length_bytes(func_type)))
    }
}

fn get_params_inner_from_func_type(func_type: string) -> string {
    arrow_pos: int64 <- outer_arrow_token_pos_call(func_type);
    case arrow_pos < 0 of {
        true -> "";
        false -> {
            params_part: string <- params_part_before_outer_arrow_call(func_type);
            case length_bytes(params_part) < 1 of {
                true -> "";
                false -> case substring(params_part, 0, 1) == "(" and substring(params_part, length_bytes(params_part) - 1, length_bytes(params_part)) == ")" of {
                    true -> trim_leading_user_call(substring(params_part, 1, length_bytes(params_part) - 1));
                    false -> trim_leading_user_call(params_part)
                }
            }
        }
    }
}

fn get_first_param_type(params_inner: string) -> (string, string) {
    case length_bytes(params_inner) == 0 of {
        true -> ("", "");
        false -> {
            comma_pos: int64 <- find_top_level_comma_user_call(params_inner, 0, 0);
            case comma_pos >= length_bytes(params_inner) of {
                true -> (trim_leading_user_call(params_inner), "");
                false -> {
                    first: string <- trim_leading_user_call(substring(params_inner, 0, comma_pos));
                    rest: string <- trim_leading_user_call(substring(params_inner, comma_pos + 1, length_bytes(params_inner)));
                    (first, rest)
                }
            }
        }
    }
}

// Args after the first: kind-4 chain nodes only; anything else (non--1, non-4) does not add args (avoids counting 2 for a single-arg call when the tail is not dummy).

fn count_additional_call_args_user_call(er: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> int64 {
    case type_checker_expressions_helpers@expr_kind(er) == -1 of {
        true -> 0;
        false -> case type_checker_expressions_helpers@expr_kind(er) == 4 of {
            true -> 1 + count_additional_call_args_user_call(type_checker_expressions_helpers@expr_child_right(er));
            false -> 0
        }
    }
}

fn count_call_args_user_call(expr: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }) -> int64 {
    case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(expr)) == -1 of {
        true -> 0;
        false -> 1 + count_additional_call_args_user_call(type_checker_expressions_helpers@expr_child_right(expr))
    }
}

// Local helper (same as type_checker_modules / type_checker_callee_env list_param_length). Avoid importing type_checker_modules (declarations_functions → … → expressions cycle).

fn list_param_length_call(ps: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> int64 {
    case ps.is_nil of {
        true -> 0;
        false -> 1 + list_param_length_call(ps.tail)
    }
}

// First tag-0 match with same name/arity (legacy fallback when receiver type is unknown or no overload fits).

fn param_types_str_from_params(params: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> string {
    case params.is_nil of {
        true -> "";
        false -> case params.tail.is_nil of {
            true -> params.head.type_name;
            false -> concat(concat(param_types_str_from_params(params.tail), ","), params.head.type_name)
        }
    }
}

fn build_function_type_for_decl_call(decl: { tag: int64, name: string, parameters: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)], return_type_name: string, return_type_location: { file: string, line: int64, column: int64, offset: int64 }, location: { file: string, line: int64, column: int64, offset: int64 }, body: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, declared_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }) -> string {
    params_str: string <- param_types_str_from_params(decl.parameters);
    case decl.parameters.is_nil of {
        true -> concat("() -> ", decl.return_type_name);
        false -> concat(concat(concat("(", params_str), ") -> "), decl.return_type_name)
    }
}

fn inferred_types_concat_comma(bucket: List[{ name: string, type_name: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)]) -> string {
    case bucket.is_nil of {
        true -> "";
        false -> case bucket.tail.is_nil of {
            true -> bucket.head.type_name;
            false -> concat(concat(bucket.head.type_name, ","), inferred_types_concat_comma(bucket.tail))
        }
    }
}

fn return_type_text_contains_at(s: string, needle: string, i: int64, n: int64, m: int64) -> boolean {
    case i + m > n of {
        true -> false;
        false -> case substring(s, i, i + m) == needle of {
            true -> true;
            false -> return_type_text_contains_at(s, needle, i + 1, n, m)
        }
    }
}

fn return_type_text_contains(s: string, needle: string) -> boolean {
    m: int64 <- length_bytes(needle);
    n: int64 <- length_bytes(s);
    case m == 0 of {
        true -> true;
        false -> return_type_text_contains_at(s, needle, 0, n, m)
    }
}

fn return_type_has_ptr_len_out_fields(return_type: string) -> boolean {
    ret: string <- trim_leading_user_call(return_type);
    case return_type_text_contains(ret, "text_ptr") of {
        true -> return_type_text_contains(ret, "text_len");
        false -> case return_type_text_contains(ret, "_ptr") of {
            true -> return_type_text_contains(ret, "_len");
            false -> false
        }
    }
}

fn params_inner_is_ptr_len_pair(params_inner: string) -> boolean {
    (first_param: string, rest_params: string) <- get_first_param_type(params_inner);
    (second_param: string, rest_rest: string) <- get_first_param_type(rest_params);
    case length_bytes(rest_rest) > 0 of {
        true -> false;
        false -> trim_leading_user_call(first_param) == "uint8" and trim_leading_user_call(second_param) == "uint64"
    }
}

