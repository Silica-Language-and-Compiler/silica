fn check_case_boolean_exhaustive(branches: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, scrutinee_type: string, case_loc: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case scrutinee_type == "boolean" of {
        false -> type_checker_core@type_check_ok();
        true -> {
            cov: { has_true: int64, has_false: int64, has_wild: int64 } <- type_checker_tuple_decompose_helpers@case_scan_bool_coverage(branches, scrutinee_type);
            case type_checker_tuple_decompose_helpers@case_bool_coverage_ok(cov) of {
                true -> type_checker_core@type_check_ok();
                false -> type_checker_core@type_check_err("E2005", case_loc, "case on boolean must cover true and false or include a wildcard branch (_ : boolean)", "sect3")
            }
        }
    }
}

fn case_scalar_catchall_required(scrutinee_type: string) -> boolean {
    case scrutinee_type of {
        "int8" -> true;
        "int16" -> true;
        "int32" -> true;
        "int64" -> true;
        "uint8" -> true;
        "uint16" -> true;
        "uint32" -> true;
        "uint64" -> true;
        "string" -> true;
        _: string -> false
    }
}

fn case_branch_is_scalar_catchall(branch: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, scrutinee_type: string) -> boolean {
    pi: { is_valid: boolean, pattern_kind: int64, bool_lit: boolean, str_lit: string, int_lit_str: string, bind_name: string, bind_type: string, list_tail_name: string, list_tail_type: string } <- type_checker_tuple_decompose_helpers@case_parse_pattern(type_checker_expressions_helpers@expr_value(branch));
    case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_inner(branch)) < 0 of {
        false -> false;
        true -> case pi.pattern_kind of {
            2 -> type_checker_tuple_decompose_helpers@types_equal_surface(pi.bind_type, scrutinee_type);
            3 -> type_checker_tuple_decompose_helpers@types_equal_surface(pi.bind_type, scrutinee_type);
            _: int64 -> false
        }
    }
}

fn case_scalar_no_catchall_err(scrutinee_type: string, case_loc: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    type_checker_core@type_check_err("E2008", case_loc, concat(concat(concat(concat("case over ", scrutinee_type), " has no catch-all arm; add `_: "), scrutinee_type), " -> ...` as the last arm"), "sect3.6.3")
}

fn check_case_scalar_catchall_list(branches: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, scrutinee_type: string, case_loc: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_expressions_helpers@expr_kind(branches) == 17 of {
        false -> case_scalar_no_catchall_err(scrutinee_type, case_loc);
        true -> {
            is_catchall: boolean <- case_branch_is_scalar_catchall(type_checker_expressions_helpers@expr_child_inner(branches), scrutinee_type);
            case type_checker_expressions_helpers@expr_kind(type_checker_expressions_helpers@expr_child_right(branches)) == -1 of {
                true -> case is_catchall of {
                    true -> type_checker_core@type_check_ok();
                    false -> case_scalar_no_catchall_err(scrutinee_type, case_loc)
                };
                false -> case is_catchall of {
                    true -> type_checker_core@type_check_err("E2008", case_loc, concat(concat(concat(concat("case over ", scrutinee_type), " has a catch-all arm that is not last; move `_: "), scrutinee_type), " -> ...` to the last arm"), "sect3.6.3");
                    false -> check_case_scalar_catchall_list(type_checker_expressions_helpers@expr_child_right(branches), scrutinee_type, case_loc)
                }
            }
        }
    }
}

fn check_case_scalar_catchall(branches: { nodes: List[{ kind: int64, value: string, name: string, location: { file: string, line: int64, column: int64, offset: int64 }, inner: int64, right_expr: int64, pattern_bindings: List[{ name: string, path: string, type_str: string }, mem(normal)], sequence_effects: List[{ name: string, parameter: string, location: { file: string, line: int64, column: int64, offset: int64 } }, mem(normal)] }, mem(normal)], root: int64 }, scrutinee_type: string, case_loc: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case case_scalar_catchall_required(scrutinee_type) of {
        false -> type_checker_core@type_check_ok();
        true -> check_case_scalar_catchall_list(branches, scrutinee_type, case_loc)
    }
}

