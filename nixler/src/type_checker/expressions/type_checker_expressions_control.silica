fn case_integer_scrutinee(surface: string) -> boolean {
    case surface of {
        "int8" -> true;
        "int16" -> true;
        "int32" -> true;
        "int64" -> true;
        "uint8" -> true;
        "uint16" -> true;
        "uint32" -> true;
        "uint64" -> true;
        _: string -> false
    }
}

// An integer literal pattern must lie within the scrutinee's range (spec §6, E2011: the check a
// literal expression gets). A tuple or record pattern is walked with the element and field types of
// the variant it matched; a pattern that can never match is rejected at the arm.
fn case_pattern_int_literal_ranges(pi: { is_valid: boolean, pattern_kind: int64, bool_lit: boolean, str_lit: string, int_lit_str: string, bind_name: string, bind_type: string, list_tail_name: string, list_tail_type: string }, scrutinee_type: string, loc: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    st: string <- type_checker_record_types@strip_spaces_rt(scrutinee_type);
    case pi.pattern_kind of {
        4 -> case string_parse@is_integer_literal_text(pi.int_lit_str) and case_integer_scrutinee(st) of {
            true -> type_checker_expressions_literals@check_numeric_literal_against_integer_kind(pi.int_lit_str, loc, true, st);
            false -> type_checker_core@type_check_ok()
        };
        9 -> case_tuple_pattern_int_literal_ranges(pi.bind_type, type_checker_record_types@strip_spaces_rt(type_checker_tuple_decompose_helpers@case_tuple_variant_for_pattern(pi.bind_type, scrutinee_type)), loc);
        8 -> case_record_fields_int_literal_ranges(type_checker_record_types@record_case_inner_body(pi.bind_type), type_checker_tuple_decompose_helpers@case_record_variant_for_pattern(pi.bind_type, scrutinee_type), loc);
        _: int64 -> type_checker_core@type_check_ok()
    }
}

fn case_tuple_pattern_int_literal_ranges(pat_str: string, tuple_type: string, loc: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case type_checker_tuple_decompose_helpers@case_is_tuple_pattern_form(pat_str) and type_checker_tuple_decompose_helpers@case_is_tuple_pattern_form(tuple_type) of {
        false -> type_checker_core@type_check_ok();
        true -> {
            p_inner: string <- substring(pat_str, 1, length_bytes(pat_str) - 1);
            s_inner: string <- substring(tuple_type, 1, length_bytes(tuple_type) - 1);
            pn: int64 <- type_checker_tuple_decompose_helpers@case_count_tuple_elems(p_inner);
            case pn == type_checker_tuple_decompose_helpers@case_count_tuple_elems(s_inner) of {
                false -> type_checker_core@type_check_ok();
                true -> case_tuple_elems_int_literal_ranges(p_inner, s_inner, 0, pn, loc)
            }
        }
    }
}

fn case_tuple_elems_int_literal_ranges(p_inner: string, s_inner: string, idx: int64, n: int64, loc: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    case idx >= n of {
        true -> type_checker_core@type_check_ok();
        false -> {
            r: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- case_pattern_int_literal_ranges(type_checker_tuple_decompose_helpers@case_parse_pattern(type_checker_tuple_decompose_helpers@case_tuple_elem_at(p_inner, idx)), type_checker_tuple_decompose_helpers@case_tuple_elem_at(s_inner, idx), loc);
            case r.is_ok of {
                false -> r;
                true -> case_tuple_elems_int_literal_ranges(p_inner, s_inner, idx + 1, n, loc)
            }
        }
    }
}

fn case_record_fields_int_literal_ranges(rem: string, record_type: string, loc: { file: string, line: int64, column: int64, offset: int64 }) -> { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } {
    r: string <- type_checker_record_types@strip_spaces_rt(rem);
    case length_bytes(r) == 0 of {
        true -> type_checker_core@type_check_ok();
        false -> {
            (seg: string, rest: string) <- type_checker_record_types@record_case_field_step(r);
            (fname: string, sub: string) <- type_checker_record_types@record_field_segment_name_sub(seg);
            fty: string <- type_checker_record_types@find_field_type_in_record(record_type, fname);
            case length_bytes(fty) == 0 of {
                true -> type_checker_core@type_check_ok();
                false -> {
                    fr: { is_ok: boolean, error_code: string, error_location: { file: string, line: int64, column: int64, offset: int64 }, error_message: string, spec_section: string } <- case_pattern_int_literal_ranges(type_checker_tuple_decompose_helpers@case_parse_record_field_subpat(sub, fty), fty, loc);
                    case fr.is_ok of {
                        false -> fr;
                        true -> case_record_fields_int_literal_ranges(rest, record_type, loc)
                    }
                }
            }
        }
    }
}

