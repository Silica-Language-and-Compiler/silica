// Recursion runtime hooks for the AArch64 emitter (compiler/design_documents/recursion_implementation.md).
// Emits optional .bss, assembly comments, and trampoline/fuel scaffolding — no license text.
// The fuel and trampoline phases (p3, p6) are not implemented (compiler/design_documents/recursion_implementation.md, Implementation status): the stubs below are placeholders only.

use sir_ast;

export module_uses_tail_calls/1;
export main_kind5_body_uses_non_tail_call/4;
export emit_recursion_bss_section/0;
export emit_recursion_phase_header_comment/0;
export emit_fuel_backedge_stub_comment/0;
export emit_trampoline_fallback_stub/0;
export emit_stack_trace_hook_comment/0;


// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes)
    produces
        pure result
    end
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
        }
    }
}


fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len(nodes);
            case idx >= n of {
                true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
                false -> {
                    e: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- list_nth(nodes, n - 1 - idx);
                    { kind: e.kind, type_name: e.type_name, value: e.value, name: e.name, inner: e.inner, right_expr: e.right_expr }
                }
            }
        }
    }
}


fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case term.root < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> sir_term_node_at(term.nodes, term.root)
    }
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

// Phase 3 — preemption: fuel / reductions (optional linker/runtime fills symbols).
fn emit_recursion_bss_section() -> string {
    l1: string <- concat(".balign 8\n", ".lcomm silica_frame_depth, 8\n");
    l2: string <- concat(l1, ".lcomm silica_frame_max, 8\n");
    l3: string <- concat(l2, ".lcomm silica_fuel, 8\n");
    l4: string <- concat(l3, ".lcomm silica_saved_pc, 8\n");
    concat(".bss\n", l4)
}

fn emit_recursion_phase_header_comment() -> string {
    concat(
        "    // --- recursion phases (recursion_implementation.jsonld) ---\n",
        concat(
            "    // p1: explicit frame fields; p2: push/dispatch/pop; p3: fuel on back-edges\n",
            "    // p4: PC/source map hooks; p5: tail BR (see emit_tail_call_body); p6: trampoline fallback\n"
        )
    )
}

// Phase 3: placeholder for SUBS fuel / branch to yield (runtime wires silica_fuel).
fn emit_fuel_backedge_stub_comment() -> string {
    "    // p3 fuel: LDR X9,=silica_fuel / SUBS / B.EQ silica_yield (optional)\n"
}

// Phase 6: when BR tail is unavailable, BL to a trampoline that dispatches without growing LR chain.
fn emit_trampoline_fallback_stub() -> string {
    concat(
        "    // p6 trampoline fallback (optional):\n",
        concat(
            "    // silica_trampoline_dispatch: load target from frame / BR X8\n",
            "    // never rely on unbounded native recursion for general calls\n"
        )
    )
}

// Phase 4: stack trace / frame identity (debug runtime consumes symbols).
fn emit_stack_trace_hook_comment() -> string {
    "    // p4 observability: frame -> (fn id, source id) map; filter trampoline frames\n"
}

fn is_main_entry(name: string) -> boolean {
    case name of {
        "main" -> true;
        "main.main" -> true;
        "main.m" -> true;
        _: string -> false
    }
}

fn sir_find_function_by_name(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], name: string) -> { name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string } {
    case fns.is_nil of {
        true -> sir_ast@dummy_sir_function();
        false -> case fns.head.name == name of {
            true -> fns.head;
            false -> sir_find_function_by_name(fns.tail, name)
        }
    }
}

// Callee function can reach itself via call graph (direct, tail, or via helpers e.g. ack -> ack_nonzero -> ack).
fn callee_reaches_self_via_calls(all_functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], callee: string) -> boolean {
    target_fn: { name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string } <- sir_find_function_by_name(all_functions, callee);
    case length_bytes(target_fn.name) == 0 of {
        true -> false;
        false -> reachable_from_term_tree_for_target(all_functions, target_fn.body, callee, 0, 24)
    }
}

fn reachable_from_term_tree_for_target(all_functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, target: string, depth: int64, max_depth: int64) -> boolean {
    case depth > max_depth of {
        true -> false;
        false -> case term.root < 0 of {
            true -> false;
            false -> case sir_term_root_node(term).kind == 4 or sir_term_root_node(term).kind == 5 of {
                true -> {
                    hits_target: boolean <- sir_term_root_node(term).name == target;
                    via_body: boolean <- case hits_target of {
                        true -> true;
                        false -> {
                            next_fn: { name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string } <- sir_find_function_by_name(all_functions, sir_term_root_node(term).name);
                            case length_bytes(next_fn.name) == 0 of {
                                true -> false;
                                false -> reachable_from_term_tree_for_target(all_functions, next_fn.body, target, depth + 1, max_depth)
                            }
                        }
                    };
                    case via_body of {
                        true -> true;
                        false -> {
                            li: boolean <- case sir_term_at(term, sir_term_root_node(term).inner).root < 0 of {
                                true -> false;
                                false -> reachable_from_term_tree_for_target(all_functions, sir_term_at(term, sir_term_root_node(term).inner), target, depth + 1, max_depth)
                            };
                            ri: boolean <- case sir_term_at(term, sir_term_root_node(term).right_expr).root < 0 of {
                                true -> false;
                                false -> reachable_from_term_tree_for_target(all_functions, sir_term_at(term, sir_term_root_node(term).right_expr), target, depth + 1, max_depth)
                            };
                            li or ri
                        }
                    }
                };
                false -> {
                    l2: boolean <- case sir_term_at(term, sir_term_root_node(term).inner).root < 0 of {
                        true -> false;
                        false -> reachable_from_term_tree_for_target(all_functions, sir_term_at(term, sir_term_root_node(term).inner), target, depth + 1, max_depth)
                    };
                    r2: boolean <- case sir_term_at(term, sir_term_root_node(term).right_expr).root < 0 of {
                        true -> false;
                        false -> reachable_from_term_tree_for_target(all_functions, sir_term_at(term, sir_term_root_node(term).right_expr), target, depth + 1, max_depth)
                    };
                    l2 or r2
                }
            }
        }
    }
}

// main + kind 5: BLR when callee is not on a self-reach cycle (plain add); BR when it is (factorial, sum_to, ack). Float main always BLR.
fn main_kind5_body_uses_non_tail_call(name: string, return_type: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, all_functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case sir_term_root_node(body).kind == 5 of {
        false -> false;
        true -> case is_main_entry(name) of {
            false -> false;
            true -> case return_type == "float32" or return_type == "float64" or return_type == "float16" of {
                true -> true;
                false -> case callee_reaches_self_via_calls(all_functions, sir_term_root_node(body).name) of {
                    true -> false;
                    false -> true
                }
            }
        }
    }
}

fn module_uses_tail_calls_functions(fns: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)], all_functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)]) -> boolean {
    case fns.is_nil of {
        true -> false;
        false -> case sir_term_root_node(fns.head.body).kind == 5 of {
            true -> case main_kind5_body_uses_non_tail_call(fns.head.name, fns.head.return_type, fns.head.body, all_functions) of {
                true -> module_uses_tail_calls_functions(fns.tail, all_functions);
                false -> true
            };
            false -> module_uses_tail_calls_functions(fns.tail, all_functions)
        }
    }
}

fn module_uses_tail_calls(sir_mod: { module_name: string, used_modules: List[string, mem(normal)], exports: List[{ fn_name: string, arity: string }, mem(normal)], export_trait_names: List[string, mem(normal)], marker_impl_types: List[string, mem(normal)], supervisor_impl_types: List[string, mem(normal)], supervisor_phase_e: List[{ actor_type: string, init_return_sir: string, init_return_type_name: string }, mem(normal)], failure_reporter_impl_types: List[string, mem(normal)], required_method_sigs: List[{ name: string, param_names: string, param_types: string, return_type: string, effects: string }, mem(normal)], runtime_dependencies: List[string, mem(normal)], is_dangerous_module: boolean, wrapper_meta_paths: List[string, mem(normal)], foreign_bindings: List[{ local_name: string, c_symbol: string, meta_path: string, return_type: string, param_names: string, param_types: string }, mem(normal)], link_libraries: List[string, mem(normal)], functions: List[{ name: string, return_type: string, effects: string, body: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, param_names: string, param_types: string }, mem(normal)] }) -> boolean {
    module_uses_tail_calls_functions(sir_mod.functions, sir_mod.functions)
}
