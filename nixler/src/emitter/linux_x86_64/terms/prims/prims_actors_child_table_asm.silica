// Phase E e3a — linked-list child table (Option B): no contiguous buffer / realloc.
// Anchors in the supervisor's supervision block (ACB +216, silica_rt_sb_require; item I of
// actor_memory_budget_plan.md): SB +24 head (first node ptr), +32 len (i64 row count / list length),
// +40 sync_failure_reported (0/1; root cap-breach reports synchronously, later thread exit skips duplicate).
// An actor without a block has no table; start_child and materialize make one for the running actor.
// Node size 128 B: payload 80 B (same row layout as e3a), next ptr @ +80 (0 = end), the supervision block @ +88
// (sb_child_done finds it there; the child's reference keeps the node alive), the child's spawner record
// @ +96 (position + 1) / +104 (next child number), kept across the child's restarts (spec §15.1.4,
// §15.4.12.1), the current child's identity @ +112 (what call_supervisor answers with), and @ +120 the
// carrier actors parked for this row's exit_done (linked through ACB #456; silica_rt_row_wait in
// prims_actors_carrier_asm.silica, emptied by the child's exit_done store).
// Offsets in row payload: +0 child_ref, +8 id atom, +16 agent_type, +24 start.0, +32 start.1, +40 restart atom,
// +48 shutdown i64, +56 exit_done, +64 flavor atom (:plain | :dangerous), +72 supervisor_start_trampoline (0 for worker).
// exit_done is a generation word: the identity (ACB #408) of the last child of the row that ended, stored
// as that child's last act (silica_rt_row_exit_done_store) and never cleared; every wait on it is for
// one identity (silica_rt_row_wait), so a stale value from an earlier incarnation never satisfies a
// wait and no party clears what another still waits for.
// Phase E e3f tombstone: child_ref==0 means inactive; len stays high-water for :rest_for_one ordering.
//
// The restart protocol (one for the supervisor's own dispatch, a draining caller and parked carrier
// actors; prims_actors_carrier_asm.silica holds the primitives): the supervision block's restart
// token (#120) has one holder at a time; only the holder dequeues the ingress and runs
// maybe_restart, so no two cascades overlap. The supervisor is a carrier actor (every actor but a
// dangerous one is): its own dispatch takes the token as it dequeues a notice (LBB1_wait), serves the
// notice in the behaviour's place on its own stack (LBB1_ingress_no_beh: maybe_restart, whose
// cascade waits and respawn waits park the supervisor while its carrier runs on, the stopped
// siblings and the new children among them, on this or any carrier), and releases the token when
// the node is served; it skips the ingress while another holder has the token (the release signals
// its mailbox when notices remain). A dying carrier actor never drains anything in its exit path
// (its supervisor's dispatch restarts it); a dying DANGEROUS row child, on its own thread, handles
// only its own notice, and only when it is first (silica_rt_supervisor_drain_own_exit), and never
// waits in its exit path. Every other drainer (kill_abnormal, the call_supervisor operations, a
// supervisor replying to a call from its standard mailbox) goes through
// silica_rt_supervisor_drain_ingress / _drain_hold: a row child of the supervisor never takes the
// token (the cascade it would run could stop the child itself) but waits until the token is free and
// the ingress empty; every stop goes through silica_rt_actor_stop, which also ends a wait the
// stopped actor is parked or spinning in (a killer stopped by the cascade of the death it caused
// returns from kill_abnormal at once). Exactly one cascade holder at a time, with parks where the
// thread-per-actor runtime blocked.
//
// linux_x86_64 (Intel syntax; RUNTIME_GUIDE.md): arguments X0..X4 arrive in rdi rsi rdx rcx r8 and every
// result leaves in rdi (C results arrive in rax). What the AArch64 text kept in x19..x28 lives in the
// frame slots [rbp - 8] .. [rbp - 80] (x19 = [rbp - 8], x20 = [rbp - 16], ... x28 = [rbp - 80]) because
// nothing but rbp/rsp survives a call; x14/x15 in materialize are [rbp - 88]/[rbp - 96]. Temporaries
// x8 x9 x10 x11 x12 use r8 r9 r10 r11 rcx (caller-saved, never live across a call, as on AArch64).
// Frames are `push rbp; mov rbp, rsp; sub rsp, N` (N = 80, or 96 for materialize) and `leave; ret`.
// silica_rt_tls_actor_set_from_x19 takes the ACB in rdi on this target (its AArch64 x19 is a slot here).

use atom_table;
use prims_list;

export emit_child_table_runtime_asm/1;

// Spine link offset for init/1 static List[child_spec] chunks; must match prims_list chunk_data_bytes.
fn child_spec_init_list_chunk_data_bytes() -> int64 {
    prims_list@chunk_data_bytes("{ id: atom, agent_type: atom, initial_state: int64, behavior: fn, restart: atom, shutdown: int64, flavor: atom }")
}

// Atoms are int64 indices (§4.1.7); strcmp on row/ACB atom fields was never valid.
// e4b: row.restart dispatch over (perm, trans). rdi = restart atom, [rbp - 80] (x28) = reason_tag (0=:normal, !=0=abnormal).
//   :permanent → always restart.
//   :transient → restart iff reason_tag != 0; on :normal exit, fall through to tombstone.
//   anything else (e.g. :temporary, missing atom) → tombstone (no restart).
fn maybe_restart_policy_dispatch(perm_idx: int64, trans_idx: int64) -> string {
    perm_cmp: string <- case perm_idx < 0 of {
        true -> "";
        false -> concat(concat("	cmp	rdi, ", atom_table@int64_to_decimal_string(perm_idx)), "\n	je	Lmr_can_restart\n")
    };
    trans_cmp: string <- case trans_idx < 0 of {
        true -> "";
        false -> concat(concat("	cmp	rdi, ", atom_table@int64_to_decimal_string(trans_idx)), "\n	je	Lmr_check_transient\n")
    };
    fall: string <- "	jmp	Lmr_tombstone_done\n";
    trans_block: string <- case trans_idx < 0 of {
        true -> "";
        false -> "Lmr_check_transient:\n	cmp	QWORD PTR [rbp - 80], 0\n	je	Lmr_tombstone_done\n"
    };
    label_can: string <- "Lmr_can_restart:\n";
    concat(concat(concat(concat(perm_cmp, trans_cmp), fall), trans_block), label_can)
}

fn maybe_restart_strat_eq_branch(idx: int64, dest: string) -> string {
    case idx < 0 of {
        true -> "";
        false -> concat(concat(concat("	cmp	rdi, ", atom_table@int64_to_decimal_string(idx)), "\n	je	"), concat(dest, "\n"))
    }
}

fn child_table_rt_asm_chunk_0() -> string {
    "	.text
# --- Phase E e3a Option B: linked-list child table ---
# silica_rt_child_table_free: X0=ACB* — walk nodes (+80 next), free each, clear anchors.
# silica_rt_child_table_ensure_min_cap: X0=ACB*, X1=min node count — X0=0 ok, 1 OOM. Appends 128 B nodes (80 B row + links) until count >= X1.
	.globl	silica_rt_child_table_free
	.p2align	2
silica_rt_child_table_free:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	r8, QWORD PTR [rdi + 216]
	test	r8, r8
	jz	Lct_free_none
	call	silica_rt_sup_shutdown_children
# An actor parked for this supervisor's restart token (block +128) re-checks and finds it ended.
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rax + 216]
	add	rdi, 128
	call	silica_rt_wait_list_wake
# The rows and the block outlive this actor while a linked child still holds a reference: the
# child's last act is its row's exit_done store (sb_child_done), after its own teardown. This
# actor's teardown drops its reference; the last one frees the rows and the block (sb_unref).
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rax + 216]
	mov	QWORD PTR [rax + 216], 0
	call	silica_rt_sb_unref
Lct_free_none:
	leave
	ret
# silica_rt_sup_shutdown_children(rdi = a supervisor that has ended: alive (+152) is 0): the
# coordinated shutdown of its live children (spec §15.4.8.4, §15.4.12.2), last row first, one at a
# time. Each row is tombstoned before its child is told (maybe_restart no longer finds it, and a
# child waiting for its replacement stops waiting); a child with shutdown 0 is killed (reason tag 1,
# as kill_abnormal), one with shutdown > 0 ends with (:explicit, :shutdown). On the hosts a child
# ends at its next dispatch boundary in both cases: a dispatch in progress runs to completion, and
# the shutdown time is not enforced. The wait is for the row's exit_done, the child's last act, so
# its registered name (§20.3.1) is gone before this returns and a restarted supervisor can register
# its children again. It runs only as the supervisor's own dispatch, on the supervisor's own stack
# (its exit path: deliver_exit, and again, idempotent, child_table_free; maybe_restart's
# synchronous root report, silica_rt_sup_on_own_dispatch), where the wait for each child parks
# the supervisor and its carrier runs on (a child bound to the same carrier can only end that
# way): a wait on another actor's stack could wait on that actor itself. A row holding the
# running actor itself is skipped all the same. The block
# is held (+112) for the walk, so the rows outlive a concurrent teardown of the supervisor.
# Frame: [rbp-8] supervisor, [rbp-16] block, [rbp-24] running actor, [rbp-32] rows left,
# [rbp-40] row, [rbp-48] the child, held, [rbp-56] its identity (x25), [rbp-64] 1 when it is a
# carrier actor (x26).
	.globl	silica_rt_sup_shutdown_children
	.p2align	4
silica_rt_sup_shutdown_children:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	rax, QWORD PTR [rdi + 216]
	mov	QWORD PTR [rbp - 16], rax
	test	rax, rax
	jz	Lssc_ret
	lock add	QWORD PTR [rax + 112], 1
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 24], rdi
	xor	ecx, ecx
	mov	rax, QWORD PTR [rbp - 16]
	mov	rax, QWORD PTR [rax + 24]
Lssc_count:
	test	rax, rax
	jz	Lssc_counted
	add	rcx, 1
	mov	rax, QWORD PTR [rax + 80]
	jmp	Lssc_count
Lssc_counted:
	mov	QWORD PTR [rbp - 32], rcx
Lssc_next:
	mov	rcx, QWORD PTR [rbp - 32]
	test	rcx, rcx
	jz	Lssc_unref
	sub	rcx, 1
	mov	QWORD PTR [rbp - 32], rcx
	mov	rax, QWORD PTR [rbp - 16]
	mov	rax, QWORD PTR [rax + 24]
Lssc_walk:
	test	rcx, rcx
	jz	Lssc_at
	mov	rax, QWORD PTR [rax + 80]
	sub	rcx, 1
	jmp	Lssc_walk
Lssc_at:
	mov	QWORD PTR [rbp - 40], rax
	mov	r8, QWORD PTR [rax]
	test	r8, r8
	jz	Lssc_next
	cmp	r8, QWORD PTR [rbp - 24]
	je	Lssc_next
	mov	QWORD PTR [rax], 0
# The identity the wait is for (row +112) is read before the stop; the child may already be ending
# (its identity no longer resolves: no stop, only the wait for its exit_done).
	mov	rdi, QWORD PTR [rax + 112]
	mov	QWORD PTR [rbp - 56], rdi
	mov	QWORD PTR [rbp - 64], 0
	call	silica_rt_ref_hold
	mov	QWORD PTR [rbp - 48], rdi
	test	rdi, rdi
	jz	Lssc_wait
	mov	rcx, QWORD PTR [rbp - 40]
	cmp	QWORD PTR [rcx + 48], 0
	jle	Lssc_kill
	mov	esi, 4
	mov	rdx, QWORD PTR [rip + silica_rt_shutdown_atom]
	jmp	Lssc_stop
Lssc_kill:
# shutdown 0: killed as by kill_abnormal, failure_reason (:explicit, :killed) (§15.4.11.2, §15.4.12.2)
	mov	esi, 4
	mov	rdx, QWORD PTR [rip + silica_rt_killed_atom]
Lssc_stop:
	mov	rdi, QWORD PTR [rbp - 48]
	call	silica_rt_actor_stop
	mov	QWORD PTR [rbp - 64], rdi
	mov	rdi, QWORD PTR [rbp - 48]
	call	silica_rt_acb_release
Lssc_wait:
# The wait is for the row's exit_done to carry the child's identity (its last act): a carrier
# actor on its own stack parks for it, anything else spins (prims_actors_carrier_asm.silica).
	mov	rdi, QWORD PTR [rbp - 40]
	mov	rsi, QWORD PTR [rbp - 56]
	mov	rdx, QWORD PTR [rbp - 64]
	xor	ecx, ecx
	call	silica_rt_row_wait
	jmp	Lssc_next
Lssc_unref:
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_sb_unref
Lssc_ret:
	leave
	ret
# Supervision-block lifetime. SB +112 counts references: the owning actor's (sb_require) and one per
# linked child started from a row (actor_spawn_linked_row, taken before the child's thread exists).
# Each row node keeps its block at +88. A child can outlive its supervisor, and its final row store
# comes after it has freed itself, so neither the owner's teardown nor the child may free the rows
# alone: whoever drops the last reference frees every row node and then the block.
	.globl	silica_rt_sb_unref
	.p2align	4
silica_rt_sb_unref:
# rdi = supervision block or 0: drop one reference.
	test	rdi, rdi
	jz	Lsbu_ret
	mov	rax, -1
	lock xadd	QWORD PTR [rdi + 112], rax
	cmp	rax, 1
	jne	Lsbu_ret
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
# Notices still in the ingress (front list #0, rear list #8; node +0 = next) go with the block: an
# exit notice (+24 == 0) gives back its payload and its hold on the ended child.
	mov	rax, QWORD PTR [rdi]
	mov	QWORD PTR [rdi], 0
Lsbu_free_ingress:
	test	rax, rax
	jnz	Lsbu_free_node
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rdi + 8]
	mov	QWORD PTR [rdi + 8], 0
	test	rax, rax
	jz	Lsbu_rows
Lsbu_free_node:
	mov	QWORD PTR [rbp - 16], rax
	cmp	DWORD PTR [rax + 24], 0
	jne	Lsbu_free_node_only
	mov	rdi, QWORD PTR [rax + 8]
	call	silica_rt_exit_payload_free
Lsbu_free_node_only:
	mov	rdi, QWORD PTR [rbp - 16]
	mov	rax, QWORD PTR [rdi]
	mov	QWORD PTR [rbp - 16], rax
	call	free
	mov	rax, QWORD PTR [rbp - 16]
	jmp	Lsbu_free_ingress
Lsbu_rows:
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rdi + 24]
Lsbu_free_row:
	test	rax, rax
	jz	Lsbu_free_block
	mov	rdi, rax
	mov	rax, QWORD PTR [rax + 80]
	mov	QWORD PTR [rbp - 16], rax
	call	free
	mov	rax, QWORD PTR [rbp - 16]
	jmp	Lsbu_free_row
Lsbu_free_block:
	mov	rdi, QWORD PTR [rbp - 8]
	call	free
	leave
Lsbu_ret:
	ret
	.globl	silica_rt_sb_child_done
	.p2align	4
silica_rt_sb_child_done:
# rdi = the ended child's row (0: not a row child), rsi = its identity. Its last two acts, after its
# ACB is gone: the row's exit_done = its identity (a cascade stop or kill_abnormal waits for it; a
# carrier actor parked for it is made ready: silica_rt_row_exit_done_store), then its block
# reference. Frame: [rbp-8] the block.
	test	rdi, rdi
	jz	Lscd_ret
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	rax, QWORD PTR [rdi + 88]
	mov	QWORD PTR [rbp - 8], rax
	call	silica_rt_row_exit_done_store
	mov	rdi, QWORD PTR [rbp - 8]
	leave
	jmp	silica_rt_sb_unref
Lscd_ret:
	ret
	.globl	silica_rt_child_table_ensure_min_cap
	.p2align	2
silica_rt_child_table_ensure_min_cap:
# X0=ACB* X1=min_nodes. Returns X0=0 success, 1 OOM.
# [rbp - 8] ACB (x19), [rbp - 16] min (x20), [rbp - 24] head (x21), [rbp - 32] count (x22), [rbp - 40] cursor (x23),
# [rbp - 48] new node (x24), [rbp - 56] tail cursor (x25), [rbp - 64] tail next (x26).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	cmp	rsi, 0
	jle	Lct_ens_ok
Lct_ens_retry:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	rax, QWORD PTR [rax + 24]
	mov	QWORD PTR [rbp - 24], rax
	mov	QWORD PTR [rbp - 32], 0
	mov	QWORD PTR [rbp - 40], rax
Lct_count_loop:
	mov	rax, QWORD PTR [rbp - 40]
	test	rax, rax
	jz	Lct_count_done
	add	QWORD PTR [rbp - 32], 1
	mov	rax, QWORD PTR [rax + 80]
	mov	QWORD PTR [rbp - 40], rax
	jmp	Lct_count_loop
Lct_count_done:
	mov	rax, QWORD PTR [rbp - 32]
	cmp	rax, QWORD PTR [rbp - 16]
	jae	Lct_ens_ok
	mov	edi, 1
	mov	esi, 128
	call	calloc
	mov	rdi, rax
	test	rdi, rdi
	jz	Lct_ens_fail
	mov	QWORD PTR [rbp - 48], rdi
	mov	QWORD PTR [rdi + 80], 0
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	QWORD PTR [rdi + 88], rax
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	rax, QWORD PTR [rax + 24]
	mov	QWORD PTR [rbp - 24], rax
	test	rax, rax
	jnz	Lct_link_at_tail
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	QWORD PTR [rax + 24], rdi
	jmp	Lct_ens_retry
Lct_link_at_tail:
	mov	QWORD PTR [rbp - 56], rax
Lct_find_tail:
	mov	rax, QWORD PTR [rbp - 56]
	mov	rcx, QWORD PTR [rax + 80]
	mov	QWORD PTR [rbp - 64], rcx
	test	rcx, rcx
	jz	Lct_found_tail
	mov	QWORD PTR [rbp - 56], rcx
	jmp	Lct_find_tail
Lct_found_tail:
	mov	rcx, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rax + 80], rcx
	jmp	Lct_ens_retry
Lct_ens_ok:
	xor	edi, edi
	leave
	ret
Lct_ens_fail:
	mov	edi, 1
	leave
	ret
"
}

fn child_table_rt_spawn_child_row_by_flavor_asm(danger_idx: int64) -> string {
    danger_cmp: string <- case danger_idx < 0 of {
        true -> "";
        false -> concat(concat("	mov	rax, QWORD PTR [rbp - 8]\n	mov	r9, QWORD PTR [rax + 64]\n	cmp	r9, ", atom_table@int64_to_decimal_string(danger_idx)), "\n	je	Lsscr_register_dangerous\n")
    };
    // X6 (r14) of the spawn: 1 for a :dangerous row (it keeps a thread of its own; every other row
    // child is a carrier actor, item N). r14 passes through silica_rt_actor_spawn_linked_row untouched.
    danger_flag: string <- case danger_idx < 0 of {
        true -> "	xor	r14d, r14d\n";
        false -> concat(concat("	mov	r9, QWORD PTR [rdi + 64]\n	xor	r14d, r14d\n	cmp	r9, ", atom_table@int64_to_decimal_string(danger_idx)), "\n	sete	r14b\n")
    };
    danger_reg: string <- case danger_idx < 0 of {
        true -> "";
        false -> "Lsscr_register_dangerous:\n	mov	rdi, QWORD PTR [rbp - 24]\n	mov	rdi, QWORD PTR [rdi + 408]\n	mov	rax, QWORD PTR [rbp - 8]\n	mov	rsi, QWORD PTR [rax + 8]\n	call	silica_rt_register_dangerous_actor_named\n	jmp	Lsscr_register_plain\n"
    };
    pre: string <- "	.globl	silica_rt_supervisor_spawn_child_row_by_flavor
	.p2align	2
silica_rt_supervisor_spawn_child_row_by_flavor:
# X0 = row, X1 = supervisor ACB -> X0 = the row's new child (0 when no thread could be made). Every
# start of a row's child comes here (materialize, start_child, respawn_row). The spawn returns the
# child held for this spawner (#392). The row takes the reference; the child's id is registered
# (§20.3.1) unless the child has already ended (and dropped again if it ended meanwhile: a name never
# names an ended actor); a notice the child parked at #400, because it ended before this commit, is
# enqueued now that the row holds the child, so maybe_restart finds it. Then the spawner lets go.
# [rbp - 8] row (x19), [rbp - 16] supervisor (x20), [rbp - 24] child (x21).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
";
    pre2: string <- "	mov	rcx, rdi
	mov	rdi, QWORD PTR [rcx + 24]
	mov	rsi, QWORD PTR [rcx + 32]
	mov	rdx, QWORD PTR [rcx + 16]
	mov	r8, QWORD PTR [rcx + 72]
	mov	r9, QWORD PTR [rbp - 16]
	call	silica_rt_actor_spawn_linked_row
	mov	QWORD PTR [rbp - 24], rdi
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax], rdi
	test	rdi, rdi
	jz	Lsscr_done
	cmp	DWORD PTR [rdi + 152], 0
	je	Lsscr_commit
";
    mid: string <- "Lsscr_register_plain:
	mov	rdi, QWORD PTR [rbp - 24]
	mov	rdi, QWORD PTR [rdi + 408]
	mov	rax, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rax + 8]
	call	silica_rt_register_actor_named
	mfence
	mov	rdi, QWORD PTR [rbp - 24]
	cmp	DWORD PTR [rdi + 152], 0
	jne	Lsscr_commit
	call	silica_rt_registry_forget_actor
Lsscr_commit:
	mov	rdi, QWORD PTR [rbp - 24]
	mov	eax, 1
	xchg	QWORD PTR [rdi + 400], rax
	cmp	rax, 1
	jbe	Lsscr_let_go
	mov	rdi, QWORD PTR [rbp - 16]
	mov	rsi, rax
	call	silica_rt_sup_enqueue_exit
Lsscr_let_go:
	mov	rdi, QWORD PTR [rbp - 24]
	call	silica_rt_acb_release
Lsscr_done:
	mov	rdi, QWORD PTR [rbp - 24]
	leave
	ret
";
    concat(concat(concat(concat(concat(pre, danger_flag), pre2), danger_cmp), mid), danger_reg)
}

// Phase E e3b: silica_rt_supervisor_materialize_init_children
// X0=ACB*, X1=tuple_ptr (init return: flags record pointer in slot 0 -- shape word at +0, fields at +8..+31 -- children list head at +8).
// Walks the list-literal handle of child_spec records (shape word plus 56 B of fields, then the hidden
// supervisor_start_trampoline at +64 in each child_spec element).
// Payload layout matches emitter value-flat record: id@0, agent@8, start@(16,24), restart@32, shutdown@40, flavor@48.
// For each child_spec: spawn_linked(start.0, start.1, agent_type, row_ptr), append a linked row node (88 B; 80 B payload).
// Stores strategy atom, allowed_restart_count, and restarts_time_frame at SB#56/#64/#72 (the supervision
// block at ACB#216, silica_rt_sb_require; actor_memory_budget_plan.md item I) for
// restart strategy dispatch (e3d) and frequency cap (e3e). Current record emission returns a pointer
// to the supervisor_flags record in tuple slot 0 and the child list in slot 24; keep a flat fallback
// for older generated tuple shapes where slot 0 is the strategy atom directly.
// Slots: [rbp - 8] ACB (x19), [rbp - 16] list cursor / remaining count (x20), [rbp - 24] chunk (x21),
// [rbp - 32] start.0 (x22), [rbp - 40] start.1 (x23), [rbp - 48] agent (x24), [rbp - 56] id (x25),
// [rbp - 64] restart (x26), [rbp - 72] shutdown (x27), [rbp - 80] row (x28), [rbp - 88] chunk offset (x14),
// [rbp - 96] element (x15). x14/x15 are slots because they are live across calls.
fn child_table_rt_asm_chunk_1(danger_idx: int64, list_chunk_bytes: int64) -> string {
    pre: string <- "	.globl	silica_rt_supervisor_materialize_init_children
	.p2align	2
silica_rt_supervisor_materialize_init_children:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	call	silica_rt_sb_require
	mov	rsi, QWORD PTR [rbp - 16]
	mov	r8, QWORD PTR [rsi]
	cmp	r8, 4096
	jb	Lmat_pre_flags_flat
	mov	QWORD PTR [rbp - 96], 8
	mov	r9, QWORD PTR [r8 + 8]
	mov	QWORD PTR [rdi + 56], r9
	mov	r9, QWORD PTR [r8 + 16]
	mov	QWORD PTR [rdi + 64], r9
	mov	r9, QWORD PTR [r8 + 24]
	mov	QWORD PTR [rdi + 72], r9
	jmp	Lmat_pre_flags_done
Lmat_pre_flags_flat:
	mov	QWORD PTR [rbp - 96], 24
	mov	QWORD PTR [rdi + 56], r8
	mov	r9, QWORD PTR [rsi + 8]
	mov	QWORD PTR [rdi + 64], r9
	mov	r9, QWORD PTR [rsi + 16]
	mov	QWORD PTR [rdi + 72], r9
Lmat_pre_flags_done:
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rax, rsi
	add	rax, QWORD PTR [rbp - 96]
	mov	QWORD PTR [rbp - 88], rax
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 16], rax
	test	rax, rax
	jz	Lmat_done
	mov	rcx, QWORD PTR [rax + 8]
	mov	QWORD PTR [rbp - 24], rcx
	mov	rcx, QWORD PTR [rax + 16]
	mov	QWORD PTR [rbp - 88], rcx
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 16], rax
Lmat_loop:
	cmp	QWORD PTR [rbp - 16], 0
	je	Lmat_done
	mov	rax, QWORD PTR [rbp - 24]
	test	rax, rax
	jz	Lmat_done
	add	rax, QWORD PTR [rbp - 88]
	mov	QWORD PTR [rbp - 96], rax
	mov	rcx, QWORD PTR [rax + 24]
	mov	QWORD PTR [rbp - 32], rcx
	mov	rcx, QWORD PTR [rax + 32]
	mov	QWORD PTR [rbp - 40], rcx
	mov	rcx, QWORD PTR [rax + 16]
	mov	QWORD PTR [rbp - 48], rcx
	mov	rcx, QWORD PTR [rax + 8]
	mov	QWORD PTR [rbp - 56], rcx
	mov	rcx, QWORD PTR [rax + 40]
	mov	QWORD PTR [rbp - 64], rcx
	mov	rcx, QWORD PTR [rax + 48]
	mov	QWORD PTR [rbp - 72], rcx
# §20.3.1: a child whose id a live actor or supervisor already holds is not started, and init
# fails with :language_error (the supervisor is the current actor while its start trampoline runs).
	mov	rdi, QWORD PTR [rbp - 56]
	call	silica_rt_registry_name_held
	test	rax, rax
	jz	Lmat_id_free
	call	silica_rt_registry_name_taken
Lmat_id_free:
# Phase E e4f + Option B: ensure one more list node, then walk `len` links from head for stable row ptr (no realloc).
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rdi + 216]
	mov	rsi, QWORD PTR [rsi + 32]
	add	rsi, 1
	call	silica_rt_child_table_ensure_min_cap
	test	rdi, rdi
	jnz	Lmat_done
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	rcx, QWORD PTR [rax + 24]
	mov	r9, QWORD PTR [rax + 32]
	mov	r10, r9
Lmat_walk_row:
	test	r10, r10
	jz	Lmat_walk_row_done
	mov	rcx, QWORD PTR [rcx + 80]
	sub	r10, 1
	jmp	Lmat_walk_row
Lmat_walk_row_done:
	mov	QWORD PTR [rbp - 80], rcx
";
    post: string <- concat("    mov QWORD PTR [rcx], 0\n    mov rax, QWORD PTR [rbp - 56]\n    mov QWORD PTR [rcx + 8], rax\n    mov rax, QWORD PTR [rbp - 48]\n    mov QWORD PTR [rcx + 16], rax\n    mov rax, QWORD PTR [rbp - 32]\n    mov QWORD PTR [rcx + 24], rax\n    mov rax, QWORD PTR [rbp - 40]\n    mov QWORD PTR [rcx + 32], rax\n    mov rax, QWORD PTR [rbp - 64]\n    mov QWORD PTR [rcx + 40], rax\n    mov rax, QWORD PTR [rbp - 72]\n    mov QWORD PTR [rcx + 48], rax\n    mov rax, QWORD PTR [rbp - 96]\n    mov r9, QWORD PTR [rax + 56]\n    mov QWORD PTR [rcx + 64], r9\n    mov r9, QWORD PTR [rax + 64]\n    mov QWORD PTR [rcx + 72], r9\n", "    mov rdi, QWORD PTR [rbp - 80]\n    mov rsi, QWORD PTR [rbp - 8]\n    call silica_rt_supervisor_spawn_child_row_by_flavor\n");
    list_chunk_s: string <- atom_table@int64_to_decimal_string(list_chunk_bytes);
    tail_pre: string <- "	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	add	QWORD PTR [rax + 32], 1
	mov	rax, QWORD PTR [rbp - 24]
	mov	rax, QWORD PTR [rax + ";
    tail_post: string <- "]
	mov	QWORD PTR [rbp - 24], rax
	mov	QWORD PTR [rbp - 88], 0
	sub	QWORD PTR [rbp - 16], 1
	jmp	Lmat_loop
Lmat_done:
	leave
	ret
";
    tail: string <- concat(concat(tail_pre, list_chunk_s), tail_post);
    concat(concat(pre, post), tail)
}

// Phase E e3b2: silica_rt_supervisor_start_child
// X0 = child_spec record pointer (shape word@+0, id@+8, agent_type@+16, start.0@+24, start.1@+32, restart@+40, shutdown@+48,
// flavor@+48; hidden supervisor_start_trampoline@+56).
// Layout matches `silica_rt_supervisor_materialize_init_children` (cons payload) so the compiler can build a single
// stack record and pass it to either path. (Earlier comment claimed +40/+48 — that 72 B layout never matched the
// emitter's value-flat record_make output; e4b corrects this to the canonical +32/+40 used elsewhere.)
// Reads current-actor TLS for supervisor ACB. spawn_linked(start.0, start.1, agent_type, row_ptr).
// Reuses the first e3f tombstone row (child_ref==0) or appends a linked row node (88 B) to the child table.
// Returns actor_ref (new child) in X0.
// Slots: [rbp - 8] supervisor ACB (x19), [rbp - 16] spec, then the new child (x20), [rbp - 24] id (x21),
// [rbp - 32] agent (x22), [rbp - 40] start.0 (x23), [rbp - 48] start.1 (x24), [rbp - 56] restart (x25),
// [rbp - 64] shutdown (x26), [rbp - 72] row (x27), [rbp - 80] appended flag (x28).
fn child_table_rt_asm_chunk_2(danger_idx: int64) -> string {
    pre: string <- "	.globl	silica_rt_supervisor_start_child
	.p2align	2
silica_rt_supervisor_start_child:
# The builtin start_child(spec): the supervisor is the thread's current actor (the supervisor's own
# init or behaviour). rsi = 0 asks the body to read it.
	xor	esi, esi
	jmp	silica_rt_supervisor_start_child_in
	.globl	silica_rt_supervisor_start_child_in
	.p2align	2
silica_rt_supervisor_start_child_in:
# rdi = child_spec, rsi = the supervisor (0 = the thread's current actor). supervisor_add_child
# names it, so that a call_supervisor :add_child from any actor leaves that actor the current
# one (supervisor_handle_notice).
# Phase E e4f: the frame also keeps x27 (row_ptr) and x28 (appended flag) so we can
# locate / allocate the table row first, then call spawn_linked with X3 = row_ptr.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 16], rdi
	mov	QWORD PTR [rbp - 8], rsi
	mov	rax, QWORD PTR [rdi + 8]
	mov	QWORD PTR [rbp - 24], rax
	mov	rax, QWORD PTR [rdi + 16]
	mov	QWORD PTR [rbp - 32], rax
	mov	rax, QWORD PTR [rdi + 24]
	mov	QWORD PTR [rbp - 40], rax
	mov	rax, QWORD PTR [rdi + 32]
	mov	QWORD PTR [rbp - 48], rax
	mov	rax, QWORD PTR [rdi + 40]
	mov	QWORD PTR [rbp - 56], rax
	mov	rax, QWORD PTR [rdi + 48]
	mov	QWORD PTR [rbp - 64], rax
	mov	rdi, QWORD PTR [rbp - 24]
	call	silica_rt_registry_name_held
	test	rax, rax
	jnz	Lsc_id_taken
Lsc_tls_prep:
	cmp	QWORD PTR [rbp - 8], 0
	jne	Lsc_have_sup
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 8], rdi
Lsc_have_sup:
# Phase E e4f + Option B: tombstone scan / append on singly-linked row nodes (+80).
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_sb_require
	mov	r8, QWORD PTR [rdi + 24]
	mov	r9, QWORD PTR [rdi + 32]
	xor	r10d, r10d
Lsc_reuse_loop:
	cmp	r10, r9
	jae	Lsc_append_new
	mov	QWORD PTR [rbp - 72], r8
	mov	r11, r10
Lsc_walk_reuse:
	test	r11, r11
	jz	Lsc_reuse_at_row
	mov	rax, QWORD PTR [rbp - 72]
	mov	rax, QWORD PTR [rax + 80]
	mov	QWORD PTR [rbp - 72], rax
	sub	r11, 1
	jmp	Lsc_walk_reuse
Lsc_reuse_at_row:
	mov	rax, QWORD PTR [rbp - 72]
	mov	rcx, QWORD PTR [rax]
	test	rcx, rcx
	jz	Lsc_use_reuse_row
	add	r10, 1
	jmp	Lsc_reuse_loop
Lsc_append_new:
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rdi + 216]
	mov	rsi, QWORD PTR [rsi + 32]
	add	rsi, 1
	call	silica_rt_child_table_ensure_min_cap
	test	rdi, rdi
	jnz	Lsc_id_taken
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	r8, QWORD PTR [rax + 24]
	mov	r9, QWORD PTR [rax + 32]
	mov	QWORD PTR [rbp - 72], r8
	mov	r11, r9
Lsc_walk_append:
	test	r11, r11
	jz	Lsc_append_at_row
	mov	rax, QWORD PTR [rbp - 72]
	mov	rax, QWORD PTR [rax + 80]
	mov	QWORD PTR [rbp - 72], rax
	sub	r11, 1
	jmp	Lsc_walk_append
Lsc_append_at_row:
	mov	QWORD PTR [rbp - 80], 1
	jmp	Lsc_post_row
Lsc_use_reuse_row:
	mov	QWORD PTR [rbp - 80], 0
Lsc_post_row:
	mov	rax, QWORD PTR [rbp - 16]
	mov	r8, QWORD PTR [rax + 64]
	mov	rcx, QWORD PTR [rbp - 72]
	mov	QWORD PTR [rcx + 72], r8
";
    post: string <- concat("    mov r9, QWORD PTR [rax + 56]\n    mov QWORD PTR [rcx], 0\n    mov rax, QWORD PTR [rbp - 24]\n    mov QWORD PTR [rcx + 8], rax\n    mov rax, QWORD PTR [rbp - 32]\n    mov QWORD PTR [rcx + 16], rax\n    mov rax, QWORD PTR [rbp - 40]\n    mov QWORD PTR [rcx + 24], rax\n    mov rax, QWORD PTR [rbp - 48]\n    mov QWORD PTR [rcx + 32], rax\n    mov rax, QWORD PTR [rbp - 56]\n    mov QWORD PTR [rcx + 40], rax\n    mov rax, QWORD PTR [rbp - 64]\n    mov QWORD PTR [rcx + 48], rax\n    mov QWORD PTR [rcx + 64], r9\n    mov QWORD PTR [rcx + 96], 0\n    mov QWORD PTR [rcx + 104], 0\n", "    mov rdi, QWORD PTR [rbp - 72]\n    mov rsi, QWORD PTR [rbp - 8]\n    call silica_rt_supervisor_spawn_child_row_by_flavor\n    mov QWORD PTR [rbp - 16], rdi\n");
    tail: string <- "	cmp	QWORD PTR [rbp - 80], 0
	je	Lsc_done
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	add	QWORD PTR [rax + 32], 1
	jmp	Lsc_done
Lsc_id_taken:
	mov	QWORD PTR [rbp - 16], 0
Lsc_done:
# The answer is the new child's identity (row +112, §15.1.4); no child is the all-ones identity.
	mov	rdi, -1
	cmp	QWORD PTR [rbp - 16], 0
	je	Lsc_ret
	mov	rax, QWORD PTR [rbp - 72]
	mov	rdi, QWORD PTR [rax + 112]
Lsc_ret:
	leave
	ret
";
    concat(concat(pre, post), tail)
}

// Phase D: call_supervisor(..., { op: :add_child, child: spec }) uses the same row allocation
// and supervised spawn path as start_child, but takes the supervisor ref explicitly because
// public supervisor calls are made by ordinary actors/main, not from inside the supervisor thread.
fn child_table_rt_asm_chunk_2b() -> string {
    "	.p2align	2
# silica_rt_supervisor_handle_notice(rdi = supervisor, rsi = its ingress node, rdx = the exit notice
# payload): maybe_restart on the draining actor's stack, then the payload (and its hold on the
# ended child) and the node go. The thread's current actor stays the drainer (or none, for main):
# the supervisor is passed to maybe_restart (rsi) and from there to every row walk and respawn
# (respawn_row, spawn_child_row_by_flavor, actor_spawn_linked_row r9, which also names the
# supervisor's stack policy for the child), so nothing attributed to the current actor during
# the drain (a failure of the drainer, a fault's report, a park decision, self()) names the
# supervisor. Until 2026-10-20 the supervisor was installed as the current actor here for the
# duration (and in add_child), which made a respawn's wait for a child supervisor's start spin
# instead of park (spawn_wait_started read the current actor) and would have failed the
# supervisor, on the drainer's stack, for a failure of the drainer.
# [rbp-8] supervisor (x24), [rbp-16] node (x22), [rbp-24] payload (x21).
silica_rt_supervisor_handle_notice:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 48
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdx
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rbp - 24]
	call	silica_rt_supervisor_restart_and_report
	mov	rdi, QWORD PTR [rbp - 24]
	call	silica_rt_exit_payload_free
	mov	rdi, QWORD PTR [rbp - 16]
	call	free
	leave
	ret
# silica_rt_supervisor_drain_run(rdi = a supervisor whose restart token the caller holds): every
# node in the ingress is dequeued (under the supervisor's lock) and handled; one that is not an
# exit notice (+24 != 0, a trial hook's message) is dropped here, the supervisor's own dispatch runs
# those. [rbp-8] supervisor (x19), [rbp-16] node (x20), [rbp-24] payload (x21).
	.p2align	2
silica_rt_supervisor_drain_run:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
Lsdrain_loop:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rdi + 216]
	mov	QWORD PTR [rbp - 16], 0
	test	rdi, rdi
	jz	Lsdrain_empty
	call	silica_rt_q_dequeue_locked
	mov	QWORD PTR [rbp - 16], rdi
	test	rdi, rdi
	jz	Lsdrain_empty
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	r9d, DWORD PTR [rax + 16]
	test	r9d, r9d
	jz	Lsdrain_depth_done
	sub	r9d, 1
	mov	DWORD PTR [rax + 16], r9d
Lsdrain_depth_done:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rax, QWORD PTR [rbp - 16]
	mov	r9d, DWORD PTR [rax + 24]
	test	r9d, r9d
	jnz	Lsdrain_free_msg
	mov	rcx, QWORD PTR [rax + 8]
	mov	QWORD PTR [rbp - 24], rcx
	test	rcx, rcx
	jz	Lsdrain_free_msg
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rbp - 16]
	mov	rdx, rcx
	call	silica_rt_supervisor_handle_notice
	jmp	Lsdrain_loop
Lsdrain_free_msg:
	mov	rdi, QWORD PTR [rbp - 16]
	call	free
	jmp	Lsdrain_loop
Lsdrain_empty:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	leave
	ret
# silica_rt_supervisor_drain_ingress(rdi = supervisor, rsi = the actor draining; 0 = main): the
# restart protocol's entry for everyone but the supervisor's own dispatch and a dying row child. The
# restart token (block #120, silica_rt_sup_restart_acquire) is taken, every notice is dequeued and
# handled, and the token is released: a notice that arrives after that is the supervisor's own
# dispatch's (signalled at the enqueue and again by the release). A row child of this supervisor
# never takes the token (the cascade it would run could stop the child itself): it waits until the
# token is free and the ingress empty, so the supervisor's dispatch does the restarts. Returns when every
# notice that was in the ingress at entry has been handled by some holder, or at once when the
# supervisor has ended or the draining actor was ended meanwhile.
# [rbp-8] supervisor (x19), [rbp-16] 1 = take the token (x20).
	.p2align	2
silica_rt_supervisor_drain_ingress:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	mov	edx, 1
	test	rsi, rsi
	jz	Lsdi_acquire
	cmp	QWORD PTR [rsi + 192], rdi
	jne	Lsdi_acquire
	cmp	QWORD PTR [rsi + 208], 4096
	jb	Lsdi_acquire
	xor	edx, edx
Lsdi_acquire:
	mov	QWORD PTR [rbp - 16], rdx
	call	silica_rt_sup_restart_acquire
	cmp	rdi, 1
	jne	Lsdi_ret
	cmp	QWORD PTR [rbp - 16], 0
	je	Lsdi_ret
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_supervisor_drain_run
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_sup_restart_release
Lsdi_ret:
	leave
	ret
# silica_rt_supervisor_drain_hold(rdi = supervisor, rsi = the actor draining; 0 = main) -> rdi = 1
# when the caller holds the restart token after draining (the operations that stop or respawn
# rows, terminate_child and restart_child, hold it across their work and release it after), 0 when
# the supervisor has ended or has no block, or the caller was ended while it waited (nothing
# drained, nothing held). A row child of this supervisor never drains (the rule of
# drain_ingress: a pending notice's cascade could stop the child itself, and it would then wait
# for its own exit): it takes the token only once the ingress is empty (acquire mode 2) and holds
# it with nothing to drain. [rbp-8] supervisor (x19).
	.p2align	2
silica_rt_supervisor_drain_hold:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 16
	mov	QWORD PTR [rbp - 8], rdi
	mov	edx, 1
	test	rsi, rsi
	jz	Lsdh_acquire
	cmp	QWORD PTR [rsi + 192], rdi
	jne	Lsdh_acquire
	cmp	QWORD PTR [rsi + 208], 4096
	jb	Lsdh_acquire
	mov	edx, 2
Lsdh_acquire:
	call	silica_rt_sup_restart_acquire
	cmp	rdi, 1
	jne	Lsdh_no
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_supervisor_drain_run
	mov	edi, 1
	jmp	Lsdh_ret
Lsdh_no:
	xor	edi, edi
Lsdh_ret:
	leave
	ret
# silica_rt_supervisor_drain_own_exit(rdi = supervisor, rsi = a DANGEROUS row child in its exit path,
# on its own thread): the child restarts itself when it can. If the token is free and its own exit
# notice is the first in the ingress, it takes the token, handles that one notice (maybe_restart:
# under :one_for_all or :rest_for_one the cascade stops its siblings, never its own row, and
# respawns them) and releases. Otherwise it leaves the ingress to the supervisor's own dispatch:
# another holder is at work, or notices precede its own and a restart it ran could stop this very
# actor. A carrier actor never comes here: its supervisor's dispatch restarts it.
# [rbp-8] supervisor (x19), [rbp-16] the child (x20), [rbp-24] node (x21), [rbp-32] payload (x22).
	.p2align	2
silica_rt_supervisor_drain_own_exit:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	call	silica_rt_sup_restart_try
	test	rdi, rdi
	jz	Lsdo_ret
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	rdi, QWORD PTR [rax + 216]
	test	rdi, rdi
	jz	Lsdo_unlock
	call	silica_rt_q_dequeue_locked
	mov	QWORD PTR [rbp - 24], rdi
	test	rdi, rdi
	jz	Lsdo_unlock
	cmp	DWORD PTR [rdi + 24], 0
	jne	Lsdo_put_back
	mov	rcx, QWORD PTR [rdi + 8]
	mov	QWORD PTR [rbp - 32], rcx
	test	rcx, rcx
	jz	Lsdo_put_back
	mov	rax, QWORD PTR [rcx]
	cmp	rax, QWORD PTR [rbp - 16]
	jne	Lsdo_put_back
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	r9d, DWORD PTR [rax + 16]
	test	r9d, r9d
	jz	Lsdo_depth_done
	sub	r9d, 1
	mov	DWORD PTR [rax + 16], r9d
Lsdo_depth_done:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rbp - 24]
	mov	rdx, QWORD PTR [rbp - 32]
	call	silica_rt_supervisor_handle_notice
	jmp	Lsdo_release
Lsdo_put_back:
# Not this actor's notice: back to the front, in its place (the front list is the queue's head).
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	rcx, QWORD PTR [rbp - 24]
	mov	r9, QWORD PTR [rax]
	mov	QWORD PTR [rcx], r9
	mov	QWORD PTR [rax], rcx
Lsdo_unlock:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
Lsdo_release:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_sup_restart_release
Lsdo_ret:
	leave
	ret
	.globl	silica_rt_supervisor_add_child
	.p2align	2
silica_rt_supervisor_add_child:
# rdi = the supervisor's reference: resolved and held for the body (silica_rt_sup_ref_call; an ended
# supervisor raises actor_not_found).
	lea	r10, [rip + silica_rt_supervisor_add_child_acb]
	jmp	silica_rt_sup_ref_call
	.globl	silica_rt_supervisor_add_child_acb
	.p2align	2
silica_rt_supervisor_add_child_acb:
# X0 = supervisor ACB, X1 = child_spec -> X0 = the new child. [rbp - 8] TLS handoff (x19),
# [rbp - 16] supervisor, then the child (x20), [rbp - 24] spec (x21), [rbp - 32] caller's TLS actor (x22).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 16], rdi
	mov	QWORD PTR [rbp - 24], rsi
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 32], rdi
	mov	rsi, rdi
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_supervisor_drain_ingress
# §20.3.1: an id a live actor or supervisor already holds starts no child; the actor that asked for
# the add fails with (:explicit, :duplicate_child_id). In main (no current actor) it is the
# language-level failure of §15.4.5.5: the atom's name on standard error, exit status 1.
	mov	rax, QWORD PTR [rbp - 24]
	mov	rdi, QWORD PTR [rax + 8]
	call	silica_rt_registry_name_held
	test	rax, rax
	jnz	Ladd_child_duplicate
# The supervisor is named to start_child (rsi) and stays off the thread's current actor, as in
# supervisor_handle_notice: the asking actor remains what a failure or a park is attributed to.
	mov	rdi, QWORD PTR [rbp - 24]
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_supervisor_start_child_in
	leave
	ret
Ladd_child_duplicate:
	mov	rdi, QWORD PTR [rbp - 32]
	test	rdi, rdi
	jz	Ladd_child_duplicate_main
	lea	rax, [rip + silica_rt_duplicate_child_id_atom]
	mov	rsi, QWORD PTR [rax]
	call	silica_rt_actor_fail_current
Ladd_child_duplicate_main:
	mov	edi, 2
	lea	rsi, [rip + L_silica_duplicate_child_id_msg]
	mov	edx, 19
	mov	eax, 1
	syscall
	mov	edi, 1
	call	exit
	jmp	Ladd_child_duplicate_main
"
}

// Phase E e3d+e3e+e4b: silica_rt_supervisor_maybe_restart
// X0 = dead child_ref, X1 = supervisor ACB, X2 = reason_tag (0=:normal default; !=0 abnormal — e4b).
// Scans linked child row list for matching child_ref. child_ref==0 is an e3f tombstone. If found, dispatches by
// row.restart policy (e4b): :permanent always restarts; :transient restarts iff reason_tag != 0; anything else
// tombstones. On restart, checks restart-frequency cap (ACB#304 max_restarts, #312 time_frame, #320 count,
// #328 window_start; if both max_restarts and time_frame are 0, cap is unlimited; max_restarts 0 with a
// non-zero frame means no restarts are allowed and the first restart attempt breaches). On cap breach, terminates
// the supervisor (alive=0 → Phase C link propagation). Otherwise dispatches by strategy (ACB#296):
//   :one_for_one  — respawn only the dead child
//   :one_for_all  — kill all other children, then respawn all
//   :rest_for_one — kill children after dead child, then respawn dead + rest
// Kill = lock mutex, alive=0, signal cond, unlock mutex on each sibling ACB.
// perm_idx / trans_idx / ofa_idx / rfo_idx: module atom table indices for :permanent, :transient, :one_for_all, :rest_for_one.
// Slots: [rbp - 8] dead child (x19), [rbp - 16] supervisor (x20), [rbp - 24] head (x21), [rbp - 32] len (x22),
// [rbp - 40] index (x23), [rbp - 48] row (x24), [rbp - 56] now / loop index (x25), [rbp - 64] sibling row (x26),
// [rbp - 72] sibling child (x27), [rbp - 80] reason_tag (x28), [rbp - 88] the identity of the sibling
// being stopped (read before the stop; what the row's exit_done must carry).
fn child_table_rt_asm_chunk_3(perm_idx: int64, trans_idx: int64, ofa_idx: int64, rfo_idx: int64) -> string {
        mr_head: string <- "	.p2align	2
silica_rt_supervisor_drop_pending_exit:
# X0 = supervisor ACB, X1 = child ACB. [rbp - 8] ACB (x19), [rbp - 16] child (x20), [rbp - 24] payload (x21),
# [rbp - 32] node (x22), [rbp - 40] queue anchor (x23), [rbp - 48] previous node (x24).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	test	rax, rax
	jz	Ldpe_not_found
	mov	QWORD PTR [rbp - 40], rax
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 32], rax
	mov	QWORD PTR [rbp - 48], 0
Ldpe_front_loop:
	mov	rax, QWORD PTR [rbp - 32]
	test	rax, rax
	jz	Ldpe_scan_rear
	mov	r8, QWORD PTR [rax + 8]
	test	r8, r8
	jz	Ldpe_front_next
	mov	r9, QWORD PTR [r8]
	cmp	r9, QWORD PTR [rbp - 16]
	je	Ldpe_remove
Ldpe_front_next:
	mov	QWORD PTR [rbp - 48], rax
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 32], rax
	jmp	Ldpe_front_loop
Ldpe_scan_rear:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	add	rax, 8
	mov	QWORD PTR [rbp - 40], rax
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 32], rax
	mov	QWORD PTR [rbp - 48], 0
Ldpe_rear_loop:
	mov	rax, QWORD PTR [rbp - 32]
	test	rax, rax
	jz	Ldpe_not_found
	mov	r8, QWORD PTR [rax + 8]
	test	r8, r8
	jz	Ldpe_rear_next
	mov	r9, QWORD PTR [r8]
	cmp	r9, QWORD PTR [rbp - 16]
	je	Ldpe_remove
Ldpe_rear_next:
	mov	QWORD PTR [rbp - 48], rax
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 32], rax
	jmp	Ldpe_rear_loop
Ldpe_remove:
	mov	r10, QWORD PTR [rax]
	mov	rcx, QWORD PTR [rbp - 48]
	test	rcx, rcx
	jz	Ldpe_remove_head
	mov	QWORD PTR [rcx], r10
	jmp	Ldpe_removed_link
Ldpe_remove_head:
	mov	rcx, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rcx], r10
Ldpe_removed_link:
	mov	QWORD PTR [rbp - 24], r8
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	mov	r11d, DWORD PTR [rax + 16]
	test	r11d, r11d
	jz	Ldpe_depth_done
	sub	r11d, 1
	mov	DWORD PTR [rax + 16], r11d
Ldpe_depth_done:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rdi, QWORD PTR [rbp - 24]
	call	silica_rt_exit_payload_free
	mov	rdi, QWORD PTR [rbp - 32]
	call	free
	jmp	Ldpe_done
Ldpe_not_found:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
Ldpe_done:
	leave
	ret
	.globl	silica_rt_supervisor_maybe_restart
	.p2align	2
silica_rt_supervisor_maybe_restart:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 96
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 80], rdx
	mov	rcx, QWORD PTR [rsi + 216]
	test	rcx, rcx
	jz	Lmr_done
# A supervisor that has ended restarts and tombstones nothing: its children are being shut down
# (silica_rt_sup_shutdown_children) and its rows go with it.
	cmp	DWORD PTR [rsi + 152], 0
	je	Lmr_done
	mov	rax, QWORD PTR [rcx + 24]
	mov	QWORD PTR [rbp - 24], rax
	test	rax, rax
	jz	Lmr_done
	mov	rax, QWORD PTR [rcx + 32]
	mov	QWORD PTR [rbp - 32], rax
	test	rax, rax
	jz	Lmr_done
	mov	QWORD PTR [rbp - 40], 0
Lmr_scan:
	mov	rax, QWORD PTR [rbp - 40]
	cmp	rax, QWORD PTR [rbp - 32]
	jae	Lmr_done
	mov	rcx, QWORD PTR [rbp - 24]
	mov	r10, rax
Lmr_walk_scan:
	test	r10, r10
	jz	Lmr_scan_at_row
	mov	rcx, QWORD PTR [rcx + 80]
	sub	r10, 1
	jmp	Lmr_walk_scan
Lmr_scan_at_row:
	mov	QWORD PTR [rbp - 48], rcx
	mov	r8, QWORD PTR [rcx]
	cmp	r8, QWORD PTR [rbp - 8]
	jne	Lmr_next
	mov	rdi, QWORD PTR [rcx + 40]
";
        mr_policy: string <- maybe_restart_policy_dispatch(perm_idx, trans_idx);
        mr_freq: string <- "	mov	rax, QWORD PTR [rbp - 16]
	mov	rax, QWORD PTR [rax + 216]
	mov	r8, QWORD PTR [rax + 64]
	mov	r9, QWORD PTR [rax + 72]
	mov	r10, r8
	or	r10, r9
	jz	Lmr_freq_ok
	test	r8, r8
	jz	Lmr_freq_escalate
	xor	edi, edi
	call	time
	mov	QWORD PTR [rbp - 56], rax
	mov	rcx, QWORD PTR [rbp - 16]
	mov	rcx, QWORD PTR [rcx + 216]
	mov	r8, QWORD PTR [rcx + 88]
	test	r8, r8
	jz	Lmr_freq_first
	mov	r9, QWORD PTR [rcx + 72]
	mov	r10, rax
	sub	r10, r8
	cmp	r10, r9
	ja	Lmr_freq_reset
	mov	r8, QWORD PTR [rcx + 80]
	add	r8, 1
	mov	r9, QWORD PTR [rcx + 64]
	cmp	r8, r9
	ja	Lmr_freq_escalate
	mov	QWORD PTR [rcx + 80], r8
	jmp	Lmr_freq_ok
Lmr_freq_first:
Lmr_freq_reset:
	mov	rcx, QWORD PTR [rbp - 16]
	mov	rcx, QWORD PTR [rcx + 216]
	mov	rax, QWORD PTR [rbp - 56]
	mov	QWORD PTR [rcx + 88], rax
	mov	r8d, 1
	mov	QWORD PTR [rcx + 80], r8
	mov	r9, QWORD PTR [rcx + 64]
	cmp	r8, r9
	ja	Lmr_freq_escalate
	jmp	Lmr_freq_ok
Lmr_freq_escalate:
# The breach ends the supervisor abnormally (§15.4.13.2): reason tag 4, (:explicit, breach atom), as
# supervisor_fail_duplicate_child_id; its parent applies its own restart rules to it.
	mov	rcx, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rcx + 232], 4
	lea	rax, [rip + silica_rt_restart_breach_atom]
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rcx + 384], rax
# Claim sync_failure_reported BEFORE mark-dead+signal. Otherwise actor_thread_main can
# observe alive==0, take LBB1_exit, and emit a duplicate root failure banner/note.
	mov	rcx, QWORD PTR [rbp - 16]
	mov	r8, QWORD PTR [rcx + 192]
	test	r8, r8
	jnz	Lmr_freq_escalate_mark_dead
# The synchronous report (children shut down first) is made only by the supervisor's own dispatch,
# on its own stack. Elsewhere (a dying dangerous child draining the ingress in its exit path, a
# kill_abnormal or call_supervisor caller) the wait for the children could wait on the drainer
# itself: a child blocked in kill_abnormal waits for the dying child's exit_done. The supervisor
# is then only marked ended; its own exit path shuts the children down and reports (deliver_exit,
# as for any root actor). The test is the carrier's running actor, not the thread's current
# actor: a drain on another actor's stack runs this with the supervisor installed as the current
# actor (supervisor_drain_ingress). silica_rt_sup_on_own_dispatch, prims_actors_carrier_asm.
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_sup_on_own_dispatch
	test	rdi, rdi
	jz	Lmr_freq_escalate_mark_dead
	mov	rcx, QWORD PTR [rbp - 16]
	mov	rdx, QWORD PTR [rcx + 216]
	mov	r8, QWORD PTR [rdx + 40]
	test	r8, r8
	jnz	Lmr_freq_escalate_mark_dead
	mov	QWORD PTR [rdx + 40], 1
	lea	rdi, [rcx + 16]
	call	silica_rt_lock_lock
	mov	rcx, QWORD PTR [rbp - 16]
	mov	DWORD PTR [rcx + 152], 0
	mov	rdi, rcx
	call	silica_rt_actor_mail_signal
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 16
	call	silica_rt_lock_unlock
# The children are shut down before the root's report goes out, so their reports precede it (the
# FailureReporter may end the program on the root's).
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_sup_shutdown_children
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_root_report_and_note
	jmp	Lmr_found_kept
Lmr_freq_escalate_mark_dead:
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rcx, QWORD PTR [rbp - 16]
	mov	DWORD PTR [rcx + 152], 0
	mov	rdi, rcx
	call	silica_rt_actor_mail_signal
	mov	rdi, QWORD PTR [rbp - 16]
	add	rdi, 16
	call	silica_rt_lock_unlock
	jmp	Lmr_found_kept
Lmr_freq_ok:
	mov	rax, QWORD PTR [rbp - 16]
	mov	rax, QWORD PTR [rax + 216]
	mov	rdi, QWORD PTR [rax + 56]
";
        mr_ofa: string <- maybe_restart_strat_eq_branch(ofa_idx, "Lmr_ofa_kill");
        mr_rfo: string <- maybe_restart_strat_eq_branch(rfo_idx, "Lmr_rfo_kill");
        mr_b_ofo: string <- "	jmp	Lmr_ofo
";
        mr_tail: string <- "Lmr_ofo:
# Phase E e4f: pass row_ptr (x24) as X3 so the new child's actor_thread_main can flag
# this row's exit_done on its own teardown; clear stale exit_done from prior incarnation.
# Every restart respawns through silica_rt_supervisor_respawn_row (§20.3.1: a name another actor
# took since the child ended fails the supervisor instead, and a result of 1 ends the restart).
	mov	rdi, QWORD PTR [rbp - 48]
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_supervisor_respawn_row
	test	rdi, rdi
	jnz	Lmr_found_kept
	jmp	Lmr_found_restarted
Lmr_ofa_kill:
	mov	QWORD PTR [rbp - 56], 0
Lmr_ofa_kill_loop:
	mov	rax, QWORD PTR [rbp - 56]
	cmp	rax, QWORD PTR [rbp - 32]
	jae	Lmr_ofa_spawn
	cmp	rax, QWORD PTR [rbp - 40]
	je	Lmr_ofa_kill_next
	mov	rcx, QWORD PTR [rbp - 24]
	mov	r10, rax
Lmr_ofa_kill_walk_idx:
	test	r10, r10
	jz	Lmr_ofa_kill_at_idx
	mov	rcx, QWORD PTR [rcx + 80]
	sub	r10, 1
	jmp	Lmr_ofa_kill_walk_idx
Lmr_ofa_kill_at_idx:
	mov	QWORD PTR [rbp - 64], rcx
	mov	rcx, QWORD PTR [rcx]
	mov	QWORD PTR [rbp - 72], rcx
	test	rcx, rcx
	jz	Lmr_ofa_kill_next
# Sequential stop (spec §15.4.12.2): the sibling is ended (reason kept: the supervisor's own stop)
# and this row's exit_done is waited for, with the identity read before the stop (row +112), so
# two teardowns never overlap; the supervisor in its own dispatch, or a carrier actor draining the
# ingress, parks for it on its own stack; main and a dangerous actor's thread spin
# (prims_actors_carrier_asm.silica, silica_rt_row_wait). The holder of the restart token is never
# a row this cascade stops (child_table header), so the wait cannot be for the holder itself.
	mov	rax, QWORD PTR [rbp - 64]
	mov	rax, QWORD PTR [rax + 112]
	mov	QWORD PTR [rbp - 88], rax
	mov	rdi, rcx
	xor	esi, esi
	xor	edx, edx
	call	silica_rt_actor_stop
	mov	rdx, rdi
	mov	rdi, QWORD PTR [rbp - 64]
	mov	rsi, QWORD PTR [rbp - 88]
	xor	ecx, ecx
	call	silica_rt_row_wait
Lmr_ofa_kill_next:
	add	QWORD PTR [rbp - 56], 1
	jmp	Lmr_ofa_kill_loop
Lmr_ofa_spawn:
	mov	QWORD PTR [rbp - 56], 0
Lmr_ofa_spawn_loop:
# Phase E e4f: per-user-spec sequential start — spawn_linked itself spins on the new
# child's ACB[+288] before returning, so iteration k cannot proceed until child k's
# thread has finished its TLS init / first-schedule. Children come up in list order,
# one at a time, after every cascaded stop has retired.
	mov	rax, QWORD PTR [rbp - 56]
	cmp	rax, QWORD PTR [rbp - 32]
	jae	Lmr_found_restarted
	mov	rcx, QWORD PTR [rbp - 24]
	mov	r10, rax
Lmr_ofa_spawn_walk_idx:
	test	r10, r10
	jz	Lmr_ofa_spawn_at_idx
	mov	rcx, QWORD PTR [rcx + 80]
	sub	r10, 1
	jmp	Lmr_ofa_spawn_walk_idx
Lmr_ofa_spawn_at_idx:
	mov	QWORD PTR [rbp - 64], rcx
	mov	r8, QWORD PTR [rcx]
	test	r8, r8
	jz	Lmr_ofa_spawn_next
	mov	rdi, rcx
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_supervisor_respawn_row
	test	rdi, rdi
	jnz	Lmr_found_kept
Lmr_ofa_spawn_next:
	add	QWORD PTR [rbp - 56], 1
	jmp	Lmr_ofa_spawn_loop
Lmr_rfo_kill:
	mov	rax, QWORD PTR [rbp - 40]
	add	rax, 1
	mov	QWORD PTR [rbp - 56], rax
Lmr_rfo_kill_loop:
	mov	rax, QWORD PTR [rbp - 56]
	cmp	rax, QWORD PTR [rbp - 32]
	jae	Lmr_rfo_spawn
	mov	rcx, QWORD PTR [rbp - 24]
	mov	r10, rax
Lmr_rfo_kill_walk_idx:
	test	r10, r10
	jz	Lmr_rfo_kill_at_idx
	mov	rcx, QWORD PTR [rcx + 80]
	sub	r10, 1
	jmp	Lmr_rfo_kill_walk_idx
Lmr_rfo_kill_at_idx:
	mov	QWORD PTR [rbp - 64], rcx
	mov	rcx, QWORD PTR [rcx]
	mov	QWORD PTR [rbp - 72], rcx
	test	rcx, rcx
	jz	Lmr_rfo_kill_next
# Sequential stop, as the :one_for_all loop above: stop, then the wait for this row's exit_done to
# carry the identity read before the stop.
	mov	rax, QWORD PTR [rbp - 64]
	mov	rax, QWORD PTR [rax + 112]
	mov	QWORD PTR [rbp - 88], rax
	mov	rdi, rcx
	xor	esi, esi
	xor	edx, edx
	call	silica_rt_actor_stop
	mov	rdx, rdi
	mov	rdi, QWORD PTR [rbp - 64]
	mov	rsi, QWORD PTR [rbp - 88]
	xor	ecx, ecx
	call	silica_rt_row_wait
	mov	rdi, QWORD PTR [rbp - 16]
	mov	rsi, QWORD PTR [rbp - 72]
	call	silica_rt_supervisor_drop_pending_exit
	mov	rcx, QWORD PTR [rbp - 64]
# Tombstone the row only after the child has fully exited so Lmr_rfo_spawn does not run
# with a stale child_ref in the slot.
	mov	QWORD PTR [rcx], 0
Lmr_rfo_kill_next:
	add	QWORD PTR [rbp - 56], 1
	jmp	Lmr_rfo_kill_loop
Lmr_rfo_spawn:
	mov	rax, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rbp - 56], rax
Lmr_rfo_spawn_loop:
# Phase E e4f: per-user-spec sequential start — children come up in list order, one
# at a time. spawn_linked blocks on each new child's ACB[+288] (set in actor_thread_main
# right after TLS init / trampoline) so iteration k+1 can never run alongside iteration k.
	mov	rax, QWORD PTR [rbp - 56]
	cmp	rax, QWORD PTR [rbp - 32]
	jae	Lmr_found_restarted
	mov	rcx, QWORD PTR [rbp - 24]
	mov	r10, rax
Lmr_rfo_spawn_walk_idx:
	test	r10, r10
	jz	Lmr_rfo_spawn_at_idx
	mov	rcx, QWORD PTR [rcx + 80]
	sub	r10, 1
	jmp	Lmr_rfo_spawn_walk_idx
Lmr_rfo_spawn_at_idx:
	mov	QWORD PTR [rbp - 64], rcx
	mov	rdi, rcx
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_supervisor_respawn_row
	test	rdi, rdi
	jnz	Lmr_found_kept
Lmr_rfo_spawn_next:
	add	QWORD PTR [rbp - 56], 1
	jmp	Lmr_rfo_spawn_loop
Lmr_next:
	add	QWORD PTR [rbp - 40], 1
	jmp	Lmr_scan
Lmr_tombstone_done:
	mov	rax, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rax], 0
# The decision is made: rdi = the row, rsi = restarted (the escalation paths and a failed respawn
# arrive at Lmr_found_kept: the child was not restarted).
Lmr_found_kept:
	mov	rdi, QWORD PTR [rbp - 48]
	xor	esi, esi
	leave
	ret
Lmr_found_restarted:
	mov	rdi, QWORD PTR [rbp - 48]
	mov	esi, 1
	leave
	ret
Lmr_done:
	xor	edi, edi
	xor	esi, esi
	leave
	ret
";
        concat(concat(concat(concat(concat(mr_head, mr_policy), mr_freq), mr_ofa), mr_rfo), concat(mr_b_ofo, mr_tail))
}

// Phase E e4a/e4b trial accessor: silica_rt_child_table_first_ref
// Returns the actor_ref (child ACB pointer) of the first LIVE row in the current actor's linked child table.
// No arguments. Reads TLS for current actor, loads table pointer from ACB#256. e4b: skips tombstoned rows
// (child_ref==0) so callers see the next live child after a :transient/:temporary no-restart leaves a hole.
// Returns 0 if table is empty, null, or contains only tombstones.
fn child_table_rt_asm_chunk_4() -> string {
    "	.globl	silica_rt_child_table_first_ref
	.p2align	2
silica_rt_child_table_first_ref:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 8], rdi
	mov	rax, QWORD PTR [rdi + 216]
	test	rax, rax
	jz	Lctfr_empty
	mov	rax, QWORD PTR [rax + 24]
	mov	QWORD PTR [rbp - 16], rax
	test	rax, rax
	jz	Lctfr_empty
	mov	rcx, rax
Lctfr_scan:
	mov	rdi, QWORD PTR [rcx]
	test	rdi, rdi
	jnz	Lctfr_found
	mov	rcx, QWORD PTR [rcx + 80]
	test	rcx, rcx
	jz	Lctfr_empty
	jmp	Lctfr_scan
Lctfr_found:
	mov	rdi, QWORD PTR [rcx + 112]
	jmp	Lctfr_done
Lctfr_empty:
	mov	rdi, -1
Lctfr_done:
	leave
	ret
"
}

// Phase E e4f: silica_rt_child_table_row_ref — 0-based row index (list walk order).
// (materialize / start_child order). X0 = index (i64; negative or >= len ⇒ 0). Returns child_ref at that row
// (may be 0 for tombstones). Does not skip rows (trials compare stable row indices to first_ref).
fn child_table_rt_asm_chunk_5() -> string {
    "	.globl	silica_rt_child_table_row_ref
	.p2align	2
silica_rt_child_table_row_ref:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	call	silica_rt_tls_current_actor_get
	mov	QWORD PTR [rbp - 16], rdi
	mov	r8, QWORD PTR [rdi + 216]
	test	r8, r8
	jz	Lctrr_empty
	mov	r9, QWORD PTR [r8 + 32]
	mov	r8, QWORD PTR [r8 + 24]
	test	r8, r8
	jz	Lctrr_empty
	test	r9, r9
	jz	Lctrr_empty
	mov	rax, QWORD PTR [rbp - 8]
	cmp	rax, 0
	jl	Lctrr_empty
	cmp	rax, r9
	jae	Lctrr_empty
	mov	r11, r8
	mov	rcx, rax
Lctrr_walk:
	test	rcx, rcx
	jz	Lctrr_at
	mov	r11, QWORD PTR [r11 + 80]
	test	r11, r11
	jz	Lctrr_empty
	sub	rcx, 1
	jmp	Lctrr_walk
Lctrr_at:
	mov	rdi, QWORD PTR [r11]
	test	rdi, rdi
	jz	Lctrr_empty
	mov	rdi, QWORD PTR [r11 + 112]
	jmp	Lctrr_done
Lctrr_empty:
	mov	rdi, -1
Lctrr_done:
	leave
	ret
"
}

