        ofa_branch: string <- case ofa_idx < 0 of {
            true -> "";
            false -> concat(concat("	mov	rax, QWORD PTR [rbp - 8]\n	mov	rax, QWORD PTR [rax + 216]\n	mov	r8, QWORD PTR [rax + 56]\n	cmp	r8, ", atom_table@int64_to_decimal_string(ofa_idx)), "\n	je	Lsrestart_ofa\n")
