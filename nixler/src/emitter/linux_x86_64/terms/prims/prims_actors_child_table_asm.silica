# A row child of this supervisor naming its own row (its row, ACB #208, still holds it and bears
# the id) would stop itself and wait for an exit only it can complete: answered at once with -2,
# which the lowering turns into the error reply (tag :error, error :language_error), and nothing
# is stopped. Anything else (main, a sibling, an unrelated actor, the supervisor) goes on.
	test	rdi, rdi
	jz	Lsterm_not_self
	mov	rax, QWORD PTR [rbp - 8]
	cmp	QWORD PTR [rdi + 192], rax
	jne	Lsterm_not_self
	mov	rcx, QWORD PTR [rdi + 208]
	cmp	rcx, 4096
	jb	Lsterm_not_self
	cmp	QWORD PTR [rcx], rdi
	jne	Lsterm_not_self
	mov	rax, QWORD PTR [rcx + 8]
	cmp	rax, QWORD PTR [rbp - 16]
	je	Lsterm_self
Lsterm_not_self:
	mov	rsi, rdi
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_supervisor_drain_hold
	test	rdi, rdi
	jz	Lsterm_done
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	test	rax, rax
	jz	Lsbh_10
	mov	rax, QWORD PTR [rax + 24]
Lsbh_10:
	mov	QWORD PTR [rbp - 40], rax
Lsterm_find:
	mov	rax, QWORD PTR [rbp - 40]
	test	rax, rax
	jz	Lsterm_release
	mov	rcx, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 32], rcx
	test	rcx, rcx
	jz	Lsterm_next
	mov	r8, QWORD PTR [rax + 8]
	cmp	r8, QWORD PTR [rbp - 16]
	jne	Lsterm_next
	mov	QWORD PTR [rax], 0
	mov	r8, QWORD PTR [rax + 112]
	mov	QWORD PTR [rbp - 48], r8
	mov	rdi, rcx
	xor	esi, esi
	xor	edx, edx
	call	silica_rt_actor_stop
# The wait is for the row's exit_done to carry the stopped child's identity: a carrier actor parks
# for it, anything else spins (prims_actors_carrier_asm.silica).
	mov	rdx, rdi
	mov	rdi, QWORD PTR [rbp - 40]
	mov	rsi, QWORD PTR [rbp - 48]
	xor	ecx, ecx
	call	silica_rt_row_wait
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rbp - 32]
	call	silica_rt_supervisor_drop_pending_exit
	mov	rax, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rax], 0
	jmp	Lsterm_release
Lsterm_next:
	mov	rax, QWORD PTR [rax + 80]
	mov	QWORD PTR [rbp - 40], rax
	jmp	Lsterm_find
Lsterm_release:
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_sup_restart_release
Lsterm_done:
	xor	edi, edi
	jmp	Lsterm_ret
Lsterm_self:
	mov	rdi, -2
Lsterm_ret:
	leave
	ret
	.globl	silica_rt_supervisor_remove_child
	.p2align	2
silica_rt_supervisor_remove_child:
# rdi = the supervisor's reference: resolved and held for the body (silica_rt_sup_ref_call; an ended
# supervisor raises actor_not_found).
	lea	r10, [rip + silica_rt_supervisor_remove_child_acb]
	jmp	silica_rt_sup_ref_call
	.globl	silica_rt_supervisor_remove_child_acb
	.p2align	2
silica_rt_supervisor_remove_child_acb:
	push	rbp
	mov	rbp, rsp
	call	silica_rt_supervisor_terminate_child_acb
	leave
	ret
	.globl	silica_rt_supervisor_restart_child
	.p2align	2
silica_rt_supervisor_restart_child:
# rdi = the supervisor's reference: resolved and held for the body (silica_rt_sup_ref_call; an ended
# supervisor raises actor_not_found).
	lea	r10, [rip + silica_rt_supervisor_restart_child_acb]
	jmp	silica_rt_sup_ref_call
	.globl	silica_rt_supervisor_restart_child_acb
	.p2align	2
silica_rt_supervisor_restart_child_acb:
# [rbp - 8] ACB (x19), [rbp - 16] id (x20), [rbp - 24] 1 while the restart token is held (x21),
# [rbp - 32] child (x22), [rbp - 40] row (x23), [rbp - 48] row cursor (x24), [rbp - 56] the stopped
# child's identity (x25 / x23 in the :one_for_all loop), [rbp - 72] the result (x27),
# [rbp - 80] restarted child for :one_for_all (x28).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], 0
# The restart token is held across the stops and the respawns (no cascade runs meanwhile;
# [rbp - 24] = 1 while held); 0 = the supervisor has ended, has no block, or this caller was ended
# while it waited: no child.
	call	silica_rt_tls_current_actor_get
# A row child of this supervisor (its row, ACB #208, still holds it) whose restart would stop its
# own row, its own id named or, under :one_for_all, any row's id that exists (the group it is in
# is stopped and respawned), would wait for an exit only it can complete: answered at once with
# -2, the error reply (tag :error, error :language_error), and nothing is stopped. An id no row
# bears keeps its answer (-1, no child); anything else (main, a sibling, an unrelated actor, the
# supervisor) goes on.
	test	rdi, rdi
	jz	Lsrestart_not_self
	mov	rax, QWORD PTR [rbp - 8]
	cmp	QWORD PTR [rdi + 192], rax
	jne	Lsrestart_not_self
	mov	rcx, QWORD PTR [rdi + 208]
	cmp	rcx, 4096
	jb	Lsrestart_not_self
	cmp	QWORD PTR [rcx], rdi
	jne	Lsrestart_not_self
	mov	rax, QWORD PTR [rcx + 8]
	cmp	rax, QWORD PTR [rbp - 16]
	je	Lsrestart_self
", ofa_self_branch), "Lsrestart_not_self:
	mov	rsi, rdi
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_supervisor_drain_hold
	mov	QWORD PTR [rbp - 24], rdi
	test	rdi, rdi
	jz	Lsrestart_none
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	test	rax, rax
	jz	Lsbh_11
	mov	rax, QWORD PTR [rax + 24]
Lsbh_11:
	mov	QWORD PTR [rbp - 40], rax
Lsrestart_find:
	mov	rax, QWORD PTR [rbp - 40]
	test	rax, rax
	jz	Lsrestart_none
	mov	r8, QWORD PTR [rax + 8]
	cmp	r8, QWORD PTR [rbp - 16]
	jne	Lsrestart_next
"), ofa_branch), "	mov	rax, QWORD PTR [rbp - 40]
	mov	rcx, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 32], rcx
	test	rcx, rcx
	jz	Lsrestart_spawn
	mov	QWORD PTR [rax], 0
	mov	r8, QWORD PTR [rax + 112]
	mov	QWORD PTR [rbp - 56], r8
	mov	rdi, rcx
	xor	esi, esi
	xor	edx, edx
	call	silica_rt_actor_stop
	mov	rdx, rdi
	mov	rdi, QWORD PTR [rbp - 40]
	mov	rsi, QWORD PTR [rbp - 56]
	xor	ecx, ecx
	call	silica_rt_row_wait
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rbp - 32]
	call	silica_rt_supervisor_drop_pending_exit
	mov	rax, QWORD PTR [rbp - 40]
	mov	QWORD PTR [rax], 0
Lsrestart_spawn:
	mov	rdi, QWORD PTR [rbp - 40]
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_supervisor_respawn_row
	mov	rax, QWORD PTR [rbp - 40]
	mov	rdi, QWORD PTR [rax]
	test	rdi, rdi
	jz	Lsrestart_none
	mov	rdi, QWORD PTR [rax + 112]
	jmp	Lsrestart_done
Lsrestart_ofa:
	mov	QWORD PTR [rbp - 80], -1
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	test	rax, rax
	jz	Lsbh_12
	mov	rax, QWORD PTR [rax + 24]
Lsbh_12:
	mov	QWORD PTR [rbp - 48], rax
Lsrestart_ofa_kill_loop:
	mov	rax, QWORD PTR [rbp - 48]
	test	rax, rax
	jz	Lsrestart_ofa_spawn_begin
	mov	rcx, QWORD PTR [rax]
	mov	QWORD PTR [rbp - 32], rcx
	test	rcx, rcx
	jz	Lsrestart_ofa_kill_next
	mov	QWORD PTR [rax], 0
	mov	r8, QWORD PTR [rax + 112]
	mov	QWORD PTR [rbp - 56], r8
	mov	rdi, rcx
	xor	esi, esi
	xor	edx, edx
	call	silica_rt_actor_stop
	mov	rdx, rdi
	mov	rdi, QWORD PTR [rbp - 48]
	mov	rsi, QWORD PTR [rbp - 56]
	xor	ecx, ecx
	call	silica_rt_row_wait
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rbp - 32]
	call	silica_rt_supervisor_drop_pending_exit
	mov	rax, QWORD PTR [rbp - 48]
	mov	QWORD PTR [rax], 0
Lsrestart_ofa_kill_next:
	mov	rax, QWORD PTR [rbp - 48]
	mov	rax, QWORD PTR [rax + 80]
	mov	QWORD PTR [rbp - 48], rax
	jmp	Lsrestart_ofa_kill_loop
Lsrestart_ofa_spawn_begin:
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	test	rax, rax
	jz	Lsbh_13
	mov	rax, QWORD PTR [rax + 24]
Lsbh_13:
	mov	QWORD PTR [rbp - 48], rax
Lsrestart_ofa_spawn_loop:
	mov	rax, QWORD PTR [rbp - 48]
	test	rax, rax
	jz	Lsrestart_ofa_done
	mov	rdi, rax
	mov	rsi, QWORD PTR [rbp - 8]
	call	silica_rt_supervisor_respawn_row
	test	rdi, rdi
	jnz	Lsrestart_ofa_done
	mov	rax, QWORD PTR [rbp - 48]
	mov	r8, QWORD PTR [rax + 8]
	cmp	r8, QWORD PTR [rbp - 16]
	jne	Lsrestart_ofa_spawn_next
	mov	r8, QWORD PTR [rax]
	test	r8, r8
	jz	Lsrestart_ofa_spawn_next
	mov	r8, QWORD PTR [rax + 112]
	mov	QWORD PTR [rbp - 80], r8
Lsrestart_ofa_spawn_next:
	mov	rax, QWORD PTR [rbp - 48]
	mov	rax, QWORD PTR [rax + 80]
	mov	QWORD PTR [rbp - 48], rax
	jmp	Lsrestart_ofa_spawn_loop
Lsrestart_ofa_done:
	mov	rdi, QWORD PTR [rbp - 80]
	jmp	Lsrestart_done
Lsrestart_next:
	mov	rax, QWORD PTR [rbp - 40]
	mov	rax, QWORD PTR [rax + 80]
	mov	QWORD PTR [rbp - 40], rax
	jmp	Lsrestart_find
Lsrestart_none:
	mov	rdi, -1
	jmp	Lsrestart_done
Lsrestart_self:
	mov	rdi, -2
Lsrestart_done:
	mov	QWORD PTR [rbp - 72], rdi
	cmp	QWORD PTR [rbp - 24], 0
	je	Lsrestart_ret
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_sup_restart_release
Lsrestart_ret:
	mov	rdi, QWORD PTR [rbp - 72]
	leave
	ret
")
}

// §20.3.1 duplicate child ids at run time. The atom :duplicate_child_id is appended to the runtime
// atom table (atom_table@build_runtime_atom_table) so it exists even when the program never spells
// it; its index is published as silica_rt_duplicate_child_id_atom for the add_child path above.
// The atom of the failure_reason (:explicit, atom) a supervisor ends with when its restart intensity is
// exceeded (§15.4.13.2: it terminates, propagating the failure; reason tag 4). One word, loaded by
// maybe_restart (Lmr_freq_escalate); emit_child_table_runtime_asm picks the atom.
fn child_table_rt_restart_breach_atom_chunk(breach_idx: int64) -> string {
    concat(concat("	.data
	.p2align	3
	.globl	silica_rt_restart_breach_atom
silica_rt_restart_breach_atom:
	.quad	", atom_table@int64_to_decimal_string(breach_idx)), "
")
}

fn child_table_rt_duplicate_child_id_chunk(dup_idx: int64, shutdown_idx: int64, killed_idx: int64) -> string {
    concat(concat(concat(concat(concat(concat("	.data
	.p2align	3
	.globl	silica_rt_shutdown_atom
silica_rt_shutdown_atom:
	.quad	", atom_table@int64_to_decimal_string(shutdown_idx)), "
	.globl	silica_rt_killed_atom
silica_rt_killed_atom:
	.quad	"), atom_table@int64_to_decimal_string(killed_idx)), "
	.globl	silica_rt_duplicate_child_id_atom
silica_rt_duplicate_child_id_atom:
	.quad	"), atom_table@int64_to_decimal_string(dup_idx)), "
	.section .rodata
L_silica_duplicate_child_id_msg:
	.asciz	\"duplicate_child_id\\n\"
	.text
# silica_rt_supervisor_fail_duplicate_child_id(rdi = supervisor ACB): a restart found the child's name
# held by another live actor or supervisor (§20.3.1). The supervisor fails with failure_reason
# (:explicit, :duplicate_child_id) the way a restart-intensity breach ends it (maybe_restart): a root
# supervisor is reported here, claiming the supervision block's sync_failure_reported so its own thread
# does not report again, and the root note follows; a supervised one is marked dead and its thread
# delivers the exit, carrying this reason, to its parent, which applies its own restart rules.
# Frame: [rbp - 8] supervisor (x19), [rbp - 16] 1 when this call reports (x20).
	.globl	silica_rt_supervisor_fail_duplicate_child_id
	.p2align	2
silica_rt_supervisor_fail_duplicate_child_id:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rdi + 232], 4
	lea	rax, [rip + silica_rt_duplicate_child_id_atom]
	mov	rax, QWORD PTR [rax]
	mov	QWORD PTR [rdi + 384], rax
	mov	QWORD PTR [rbp - 16], 0
	mov	r8, QWORD PTR [rdi + 192]
	test	r8, r8
	jnz	Lfdc_mark_dead
# The synchronous report only as the supervisor's own dispatch (maybe_restart, Lmr_freq_escalate).
	call	silica_rt_sup_on_own_dispatch
	test	rdi, rdi
	jz	Lfdc_mark_dead
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rdx, QWORD PTR [rdi + 216]
	test	rdx, rdx
	jz	Lfdc_mark_dead
	mov	r8, QWORD PTR [rdx + 40]
	test	r8, r8
	jnz	Lfdc_mark_dead
	mov	QWORD PTR [rdx + 40], 1
	mov	QWORD PTR [rbp - 16], 1
Lfdc_mark_dead:
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_lock
	mov	rcx, QWORD PTR [rbp - 8]
	mov	DWORD PTR [rcx + 152], 0
	mov	rdi, rcx
	call	silica_rt_actor_mail_signal
	mov	rdi, QWORD PTR [rbp - 8]
	add	rdi, 16
	call	silica_rt_lock_unlock
	mov	rax, QWORD PTR [rbp - 16]
	test	rax, rax
	jz	Lfdc_done
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_sup_shutdown_children
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_root_report_and_note
Lfdc_done:
	leave
	ret
# silica_rt_supervisor_respawn_row(rdi = row, rsi = supervisor ACB) -> rdi = 0 when the row's child was
# started, 1 when the row's id is held by a live actor or supervisor: no child is started under a name
# it does not hold, the row is a tombstone and the supervisor has failed (above). Every restart path respawns through this;
# the first start of a child (materialize, start_child) keeps its own rule.
# Frame: [rbp - 8] row (x19), [rbp - 16] supervisor (x20).
	.globl	silica_rt_supervisor_respawn_row
	.p2align	2
silica_rt_supervisor_respawn_row:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	rdi, QWORD PTR [rdi + 8]
	call	silica_rt_registry_name_held
	test	rax, rax
	jnz	Lrsr_taken
	mov	rdi, QWORD PTR [rbp - 8]
	mov	rsi, QWORD PTR [rbp - 16]
	call	silica_rt_supervisor_spawn_child_row_by_flavor
	xor	edi, edi
	jmp	Lrsr_done
Lrsr_taken:
	mov	rax, QWORD PTR [rbp - 8]
	mov	QWORD PTR [rax], 0
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_supervisor_fail_duplicate_child_id
	mov	edi, 1
Lrsr_done:
	leave
	ret
")
}

// Exit reports to a report sink (spec §15.4.10.5). The supervision block's #96 holds the sink's
// identity (0: none), set by call_supervisor { op: :set_report_sink, sink: ref } and inherited by a
// child supervisor from its supervisor when it is spawned (prims_actors_runtime_asm.silica, the
// Lsp1_no_sb site of spawn_linked_row) until it names its own. After every exit notice the holder of
// the restart token handles (supervisor_handle_notice), the report record below is cast to the sink.
// The words: +0 the exit_report shape ({child,child_id,failure_reason,restarted,new_child} as the
// program spells it, 0 when no unit of the build has the record), then the failure_reason atoms
// :normal, :language_error, :memory_fault, :explicit, :unknown, :foreign_fault.
fn child_table_rt_exit_report_chunk(shape_idx: int64, normal_idx: int64, lang_idx: int64, mem_idx: int64, explicit_idx: int64, unknown_idx: int64, foreign_idx: int64) -> string {
    words: string <- concat("	.data
	.p2align	3
	.globl	silica_rt_exit_report_words
silica_rt_exit_report_words:
	.quad	", concat(atom_table@int64_to_decimal_string(shape_idx), concat("
	.quad	", concat(atom_table@int64_to_decimal_string(normal_idx), concat("
	.quad	", concat(atom_table@int64_to_decimal_string(lang_idx), concat("
	.quad	", concat(atom_table@int64_to_decimal_string(mem_idx), concat("
	.quad	", concat(atom_table@int64_to_decimal_string(explicit_idx), concat("
	.quad	", concat(atom_table@int64_to_decimal_string(unknown_idx), concat("
	.quad	", concat(atom_table@int64_to_decimal_string(foreign_idx), "
"))))))))))))));
    concat(words, "	.text
# silica_rt_sup_exit_report_send(rdi = the row, rsi = 1 when its child was restarted, rdx = the exit
# notice payload, rcx = the ended child's identity, r8 = the sink's identity): builds the exit_report
# of §15.4.10.5 -- shape word, child, child_id, failure_reason, restarted, new_child, one word each,
# the layout the emitter gives { child: actor_ref, child_id: atom, failure_reason: ..., restarted:
# boolean, new_child: actor_ref } -- and casts it to the sink (silica_rt_actor_cast_flagged through
# silica_rt_ref_call: a sink that has ended, or is call-only, gets nothing and the report is
# dropped). failure_reason is the one-word sum of §15.4.11.2: the atom for tags 0, 2, 3 and 5, a
# pointer to the tagged pair (:explicit, atom) for tag 4 (the notice's atom; the pair sits in the
# record's own block at +48). Since 2026-10-23 no exit carries tag 1 (a division by zero is 2,
# :language_error; a kill is 4 with :killed): a tag 1 is :unknown. new_child is the row's current
# child (+112) when restarted, else the ended child. The record is the receiver's once enqueued
# (node +32 = 2: silica_rt_owned_record_release frees it after the sink's dispatch). The record is the receiver's once enqueued; a dropped report goes back here.
# Frame: [rbp-8] row, [rbp-16] restarted, [rbp-24] payload, [rbp-32] identity, [rbp-40] sink,
# [rbp-48] the reason word (the pair's atom while the pair is allocated), [rbp-56] the record.
	.globl	silica_rt_supervisor_restart_and_report
	.p2align	2
silica_rt_supervisor_restart_and_report:
# rdi = the supervisor, rsi = an exit notice payload (child at +0, held; reason tag at +8): the restart
# decision (maybe_restart) and then, when the notice was matched to a row and a sink is named for
# the supervisor (block #96, inherited or its own), the exit report of §15.4.10.5, cast after the
# decision and never waited for. Every handler of a notice comes through here: the supervisor's own
# dispatch (LBB1_ingress_no_beh), the drainers (supervisor_handle_notice) and the trial hook
# supervision_wait_and_drain_one. Exits handled before a sink was named are not reported.
# [rbp-8] supervisor, [rbp-16] payload, [rbp-24] the ended child's identity (ACB #408, read before
# the decision, which may give the row a new child).
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	rax, QWORD PTR [rsi]
	mov	rax, QWORD PTR [rax + 408]
	mov	QWORD PTR [rbp - 24], rax
	mov	rax, QWORD PTR [rbp - 16]
	mov	rdi, QWORD PTR [rax]
	mov	rsi, QWORD PTR [rbp - 8]
	mov	rdx, QWORD PTR [rax + 8]
	call	silica_rt_supervisor_maybe_restart
	test	rdi, rdi
	jz	Lrar_done
	mov	rax, QWORD PTR [rbp - 8]
	mov	rax, QWORD PTR [rax + 216]
	test	rax, rax
	jz	Lrar_done
	mov	r8, QWORD PTR [rax + 96]
	test	r8, r8
	jz	Lrar_done
	mov	rdx, QWORD PTR [rbp - 16]
	mov	rcx, QWORD PTR [rbp - 24]
	call	silica_rt_sup_exit_report_send
Lrar_done:
	leave
	ret
	.globl	silica_rt_sup_exit_report_send
	.p2align	2
silica_rt_sup_exit_report_send:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 64
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdx
	mov	QWORD PTR [rbp - 32], rcx
	mov	QWORD PTR [rbp - 40], r8
# One 64-byte block: the record (48 B) and, at +48, the pair (:explicit, atom) when the reason is
# one, so the receiver's release frees one block (silica_rt_owned_record_release; the cast is
# made with flag 2, node +32).
	mov	edi, 64
	call	malloc
	test	rax, rax
	jz	Lers_done
	mov	QWORD PTR [rbp - 56], rax
	lea	r11, [rip + silica_rt_exit_report_words]
	mov	rdx, QWORD PTR [rbp - 24]
	mov	rcx, QWORD PTR [rdx + 8]
	test	rcx, rcx
	jz	Lers_normal
	cmp	rcx, 2
	je	Lers_language_error
	cmp	rcx, 3
	je	Lers_memory_fault
	cmp	rcx, 5
	je	Lers_foreign_fault
	cmp	rcx, 4
	je	Lers_explicit
	mov	r9, QWORD PTR [r11 + 40]
	jmp	Lers_reason_done
Lers_normal:
	mov	r9, QWORD PTR [r11 + 8]
	jmp	Lers_reason_done
Lers_language_error:
	mov	r9, QWORD PTR [r11 + 16]
	jmp	Lers_reason_done
Lers_memory_fault:
	mov	r9, QWORD PTR [r11 + 24]
	jmp	Lers_reason_done
Lers_foreign_fault:
	mov	r9, QWORD PTR [r11 + 48]
	jmp	Lers_reason_done
Lers_explicit:
	mov	r9, QWORD PTR [r11 + 32]
	mov	QWORD PTR [rax + 48], r9
	mov	r10, QWORD PTR [rdx + 16]
	mov	QWORD PTR [rax + 56], r10
	lea	r9, [rax + 48]
Lers_reason_done:
	mov	r8, QWORD PTR [r11]
	mov	QWORD PTR [rax], r8
	mov	r8, QWORD PTR [rbp - 32]
	mov	QWORD PTR [rax + 8], r8
	mov	rcx, QWORD PTR [rbp - 8]
	mov	r8, QWORD PTR [rcx + 8]
	mov	QWORD PTR [rax + 16], r8
	mov	QWORD PTR [rax + 24], r9
	mov	r8, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rax + 32], r8
	mov	r9, QWORD PTR [rbp - 32]
	test	r8, r8
	jz	Lers_new_child
	mov	r9, QWORD PTR [rcx + 112]
Lers_new_child:
	mov	QWORD PTR [rax + 40], r9
	mov	rdi, QWORD PTR [rbp - 40]
	mov	rsi, rax
	mov	edx, 2
	lea	r10, [rip + silica_rt_actor_cast_flagged]
	call	silica_rt_ref_call
	cmp	rdi, 1
	je	Lers_done
# Dropped (no sink, an ended or call-only sink, no memory): the block goes back here.
	mov	rdi, QWORD PTR [rbp - 56]
	call	free
Lers_done:
	leave
	ret
# silica_rt_owned_record_begin(rdi = the node, rsi = the receiving ACB): the arena position when the
# dispatch of an owned record (node +32 = 2: an exit report) begins, noted in the node (+40 the
# arena block, +48 its bump) for the release below. Leaf.
	.globl	silica_rt_owned_record_begin
	.p2align	2
silica_rt_owned_record_begin:
	mov	rax, QWORD PTR [rsi + 160]
	mov	QWORD PTR [rdi + 40], rax
	mov	rax, QWORD PTR [rsi + 176]
	mov	QWORD PTR [rdi + 48], rax
	ret
# silica_rt_owned_record_release(rdi = the node, rsi = the ACB whose behaviour just returned): the
# record (node +8; the pair (:explicit, atom) it may hold is inside it, at +48) goes back unless
# the behaviour kept it: it is the new state (ACB word 0) or a word of what the behaviour
# allocated in its arena since the dispatch began names the record or the pair (a state or a cell
# holding r.failure_reason). The rule of silica_rt_report_release: anything uncertain keeps it, a
# missed free leaks one record, a wrong one corrupts. A behaviour that sends the record on sends a
# copy (copy-on-send, term_message_copy: a parameter is never moved), so no escape is tracked.
# Leaf apart from the tail jump to free.
	.globl	silica_rt_owned_record_release
	.p2align	2
silica_rt_owned_record_release:
	mov	rax, QWORD PTR [rdi + 8]
	test	rax, rax
	jz	Lorr_ret
	lea	r9, [rax + 48]
	mov	r10, QWORD PTR [rsi]
	cmp	r10, rax
	je	Lorr_ret
	cmp	r10, r9
	je	Lorr_ret
	mov	r11, QWORD PTR [rdi + 40]
	mov	rcx, QWORD PTR [rsi + 160]
	mov	rdx, QWORD PTR [rdi + 48]
	mov	r8, QWORD PTR [rsi + 176]
	cmp	r11, rcx
	je	Lorr_scan
	test	r11, r11
	jnz	Lorr_ret
	test	rcx, rcx
	jz	Lorr_free
	lea	rdx, [rcx + 16]
Lorr_scan:
	cmp	rdx, r8
	jae	Lorr_free
	mov	r10, QWORD PTR [rdx]
	add	rdx, 8
	cmp	r10, rax
	je	Lorr_ret
	cmp	r10, r9
	je	Lorr_ret
	jmp	Lorr_scan
Lorr_free:
	mov	rdi, rax
	jmp	free
Lorr_ret:
	ret
	.globl	silica_rt_supervisor_set_report_sink
	.p2align	2
silica_rt_supervisor_set_report_sink:
# rdi = the supervisor's reference (resolved and held by silica_rt_sup_ref_call; an ended supervisor
# raises actor_not_found), rsi = the sink's reference -> rdi = 0, or -2 (the error reply) when the
# sink names no live actor or a call-only one (§15.4.10.5: the sink is a cast-only actor).
	lea	r10, [rip + silica_rt_supervisor_set_report_sink_acb]
	jmp	silica_rt_sup_ref_call
	.globl	silica_rt_supervisor_set_report_sink_acb
	.p2align	2
silica_rt_supervisor_set_report_sink_acb:
# [rbp-8] supervisor, [rbp-16] sink, [rbp-24] the sink's alive word, [rbp-32] its convention.
	push	rbp
	mov	rbp, rsp
	sub	rsp, 32
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
# Exits already in the ingress are handled first (§15.4.9.4), before the sink is named, so they are
# not reported (§15.4.10.5).
	call	silica_rt_tls_current_actor_get
	mov	rsi, rdi
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_supervisor_drain_ingress
	mov	rdi, QWORD PTR [rbp - 16]
	call	silica_rt_ref_hold
	test	rdi, rdi
	jz	Lsrs_bad
	mov	eax, DWORD PTR [rdi + 152]
	mov	QWORD PTR [rbp - 24], rax
	mov	rax, QWORD PTR [rdi + 432]
	mov	QWORD PTR [rbp - 32], rax
	call	silica_rt_acb_release
	cmp	QWORD PTR [rbp - 24], 0
	je	Lsrs_bad
	cmp	QWORD PTR [rbp - 32], 1
	je	Lsrs_bad
	mov	rdi, QWORD PTR [rbp - 8]
	call	silica_rt_sb_require
	mov	rax, QWORD PTR [rbp - 16]
	mov	QWORD PTR [rdi + 96], rax
	xor	edi, edi
	leave
	ret
Lsrs_bad:
	mov	rdi, -2
	leave
	ret
")
}

fn emit_child_table_runtime_asm(table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }) -> string {
        // Match const_atoms.silica / rodata: first-added order, not bst_lookup_string alone.
        p: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":permanent");
        t: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":transient");
        o: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":one_for_all");
        r: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":rest_for_one");
        d: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":dangerous");
        dup: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":duplicate_child_id");
        // (:explicit, :shutdown): a child ended by its supervisor's orderly shutdown (§15.4.12.2).
        sd: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":shutdown");
        // (:explicit, :killed): a child ended by kill_abnormal or by a shutdown-0 stop (§15.4.11.2, §15.4.12.2).
        kd: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":killed");
        // The restart-intensity breach reason (§15.4.13.2). The ONE place the atom is chosen: a dedicated
        // runtime atom is this lexeme plus an add_atom in atom_table.silica build_runtime_atom_table.
        brk: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":restart_intensity_breach");
        list_chunk: int64 <- child_spec_init_list_chunk_data_bytes();
        // The exit report of §15.4.10.5: its record shape (as the program spells the record; 0 when none
        // does) and the failure_reason atoms it may carry (child_table_rt_exit_report_chunk).
        er_shape_raw: int64 <- atom_table@lexeme_to_index_first_added_order(table, "{child,child_id,failure_reason,restarted,new_child}");
        er_shape: int64 <- case er_shape_raw < 0 of { true -> 0; false -> er_shape_raw };
        er_normal: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":normal");
        er_lang: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":language_error");
        er_mem: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":memory_fault");
        er_explicit: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":explicit");
        er_unknown: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":unknown");
        er_foreign: int64 <- atom_table@lexeme_to_index_first_added_order(table, ":foreign_fault");
        er_chunk: string <- child_table_rt_exit_report_chunk(er_shape, er_normal, er_lang, er_mem, er_explicit, er_unknown, er_foreign);
        concat(concat(concat(concat(concat(concat(concat(concat(concat(child_table_rt_asm_chunk_0(), child_table_rt_spawn_child_row_by_flavor_asm(d)), child_table_rt_asm_chunk_1(d, list_chunk)), child_table_rt_asm_chunk_2(d)), child_table_rt_asm_chunk_2b()), concat(child_table_rt_restart_breach_atom_chunk(brk), child_table_rt_duplicate_child_id_chunk(dup, sd, kd))), child_table_rt_asm_chunk_3(p, t, o, r)), child_table_rt_asm_chunk_4()), child_table_rt_asm_chunk_5()), concat(child_table_rt_asm_chunk_6(o), er_chunk))
}
