// Checked int64 runtime helpers (Layer 1 §7.8), Linux x86-64: rdi rsi in; ok in edi, value in rsi.

export emit_checked_int64_runtime_asm/0;

fn emit_checked_int64_runtime_asm() -> string {
    add_fn: string <- "    .globl silica_rt_checked_i64_add\nsilica_rt_checked_i64_add:\n    mov rdx, rdi\n    add rdx, rsi\n    setno al\n    movzx edi, al\n    mov esi, 0\n    cmovno rsi, rdx\n    ret\n";
    add1_fn: string <- "    .globl silica_rt_checked_i64_add1\nsilica_rt_checked_i64_add1:\n    mov rdx, rdi\n    add rdx, 1\n    setno al\n    movzx edi, al\n    mov esi, 0\n    cmovno rsi, rdx\n    ret\n";
    mul_fn: string <- "    .globl silica_rt_checked_i64_mul\nsilica_rt_checked_i64_mul:\n    mov rdx, rdi\n    imul rdx, rsi\n    setno al\n    movzx edi, al\n    mov esi, 0\n    cmovno rsi, rdx\n    ret\n";
    concat(concat(add_fn, add1_fn), mul_fn)
}

// linux_x86_64 runtime shims (Linux, glibc, x86-64). Linked once per executable through
// __silica_runtime.sams (prims_actors_runtime_asm@emit_actor_runtime_helpers appends this chunk).
//
// The actor runtime was written against Darwin libSystem. The apple_silicon_mac call sites survive
// unchanged in this tree except for the callee name; each Darwin-only entry point resolves here.
// Every shim takes its arguments in rdi rsi rdx rcx r8 (X0..X4) and answers in rdi (edi for a W0
// result), like every other silica_rt_* routine; C library results arrive in rax and are moved.
//
//   silica_rt_lock_lock / silica_rt_lock_unlock  <- os_unfair_lock_lock / os_unfair_lock_unlock
//       futex mutex on the same 4-byte word (0 = free, 1 = held, 2 = held with waiters):
//       `lock cmpxchg` fast path, futex(2) slow path.
//   silica_rt_futex_wait / silica_rt_futex_wake  <- __ulock_wait / __ulock_wake
//       futex(2) FUTEX_WAIT_PRIVATE (128) / FUTEX_WAKE_PRIVATE (129). Same argument order as ulock:
//       wait(op, addr, expected, timeout=0), wake(op, addr, 0). One waiter is woken, as on Darwin.
//   silica_rt_sysctlbyname                       <- sysctlbyname
//       The hw.* names the topology code asks for, answered from sysconf(3), `cpuid` and constants
//       (table below). x86 has no HWCAP: the ARM-only feature names answer 0, FEAT_AES answers the
//       AES-NI bit, and the x86 feature names (hw.optional.x86.*) answer their cpuid bits. All cores
//       report as performance cores; there is one perf level.
//   silica_rt_pthread_mach_thread_np             <- pthread_mach_thread_np   (identity)
//   silica_rt_thread_policy_set                  <- thread_policy_set
//       THREAD_AFFINITY_POLICY tag -> pthread_setaffinity_np with a 128-byte cpu_set_t. Tag 0 clears
//       (all CPUs), a tag below the CPU count pins to that CPU, the 'E'/'P' cluster tags are accepted
//       and ignored.
//   silica_rt_pthread_set_qos_class_np           <- pthread_set_qos_class_np (no-op, returns 0)
//
// Linux x86-64 syscall numbers used: futex = 202 (args rdi rsi rdx r10 r8 r9; clobbers rcx, r11).
// sysconf names: _SC_PAGESIZE 30, _SC_NPROCESSORS_ONLN 84, _SC_PHYS_PAGES 85, _SC_LEVEL1_DCACHE_SIZE 188,
// _SC_LEVEL2_CACHE_SIZE 191, _SC_LEVEL3_CACHE_SIZE 194. cpuid bits: leaf 1 ecx 25 AES, 28 AVX, 29 F16C;
// leaf 7 ebx 5 AVX2, 8 BMI2. hw.logicalcpu and hw.perflevel0.logicalcpu (the carrier count and the
// P-core count of item N, prims_actors_carrier_asm.silica) both answer sysconf(_SC_NPROCESSORS_ONLN);
// hw.perflevel1.logicalcpu is 0 (no efficiency cores on this target).

export emit_linux_rt_shims_asm/0;

fn linux_shims_locks() -> string {
    "	.text
# silica_rt_lock_lock(rdi = lock word). Fast path CAS 0 -> 1; slow path swaps in 2 and futex-waits while 2.
	.globl	silica_rt_lock_lock
	.p2align	4
silica_rt_lock_lock:
Lsrl_fast:
	xor	eax, eax
	mov	r10d, 1
	lock cmpxchg	DWORD PTR [rdi], r10d
	jne	Lsrl_slow
	ret
Lsrl_slow:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
Lsrl_swap:
	mov	r10d, 2
	xchg	DWORD PTR [rdi], r10d
	test	r10d, r10d
	jz	Lsrl_owned
	mov	esi, 128
	mov	edx, 2
	xor	r10d, r10d
	xor	r8d, r8d
	xor	r9d, r9d
	mov	eax, 202
	syscall
	mov	rdi, QWORD PTR [rbp - 8]
	jmp	Lsrl_swap
Lsrl_owned:
	leave
	ret
# silica_rt_lock_unlock(rdi = lock word). Decrement; if it was 2 (waiters), store 0 and wake one.
	.globl	silica_rt_lock_unlock
	.p2align	4
silica_rt_lock_unlock:
	mov	eax, -1
	lock xadd	DWORD PTR [rdi], eax
	cmp	eax, 1
	je	Lsru_done
	mov	DWORD PTR [rdi], 0
	mov	esi, 129
	mov	edx, 1
	xor	r10d, r10d
	xor	r8d, r8d
	xor	r9d, r9d
	mov	eax, 202
	syscall
Lsru_done:
	ret
# silica_rt_futex_wait(edi = op (ignored), rsi = addr, edx = expected, ecx = timeout (0 only)).
	.globl	silica_rt_futex_wait
	.p2align	4
silica_rt_futex_wait:
	mov	rdi, rsi
	mov	esi, 128
	xor	r10d, r10d
	xor	r8d, r8d
	xor	r9d, r9d
	mov	eax, 202
	syscall
	mov	rdi, rax
	ret
# silica_rt_futex_wake(edi = op (ignored), rsi = addr, rdx = 0). Wakes one waiter.
	.globl	silica_rt_futex_wake
	.p2align	4
silica_rt_futex_wake:
	mov	rdi, rsi
	mov	esi, 129
	mov	edx, 1
	xor	r10d, r10d
	xor	r8d, r8d
	xor	r9d, r9d
	mov	eax, 202
	syscall
	mov	rdi, rax
	ret
"
}

fn linux_shims_sysctl() -> string {
    "	.section .rodata
Lsys_n_pl0cpu:
	.asciz	\"hw.perflevel0.physicalcpu\"
Lsys_n_logicalcpu:
	.asciz	\"hw.logicalcpu\"
Lsys_n_pl0lcpu:
	.asciz	\"hw.perflevel0.logicalcpu\"
Lsys_n_pl1lcpu:
	.asciz	\"hw.perflevel1.logicalcpu\"
Lsys_n_pl1cpu:
	.asciz	\"hw.perflevel1.physicalcpu\"
Lsys_n_nperf:
	.asciz	\"hw.nperflevels\"
Lsys_n_memsize:
	.asciz	\"hw.memsize\"
Lsys_n_cls:
	.asciz	\"hw.cachelinesize\"
Lsys_n_l1d:
	.asciz	\"hw.l1dcachesize\"
Lsys_n_l2:
	.asciz	\"hw.l2cachesize\"
Lsys_n_l3:
	.asciz	\"hw.l3cachesize\"
Lsys_n_pl0l1d:
	.asciz	\"hw.perflevel0.l1dcachesize\"
Lsys_n_pl0l2:
	.asciz	\"hw.perflevel0.l2cachesize\"
Lsys_n_pl1l1d:
	.asciz	\"hw.perflevel1.l1dcachesize\"
Lsys_n_pl1l2:
	.asciz	\"hw.perflevel1.l2cachesize\"
Lsys_n_neon:
	.asciz	\"hw.optional.neon\"
Lsys_n_crc:
	.asciz	\"hw.optional.armv8_crc32\"
Lsys_n_arm64:
	.asciz	\"hw.optional.arm64\"
Lsys_n_lse:
	.asciz	\"hw.optional.arm.FEAT_LSE\"
Lsys_n_sha512:
	.asciz	\"hw.optional.arm.FEAT_SHA512\"
Lsys_n_sha256:
	.asciz	\"hw.optional.arm.FEAT_SHA256\"
Lsys_n_aes:
	.asciz	\"hw.optional.arm.FEAT_AES\"
Lsys_n_advsimd:
	.asciz	\"hw.optional.AdvSIMD\"
Lsys_n_x86aes:
	.asciz	\"hw.optional.x86.AES\"
Lsys_n_x86avx:
	.asciz	\"hw.optional.x86.AVX\"
Lsys_n_x86f16c:
	.asciz	\"hw.optional.x86.F16C\"
Lsys_n_x86avx2:
	.asciz	\"hw.optional.x86.AVX2\"
Lsys_n_x86bmi2:
	.asciz	\"hw.optional.x86.BMI2\"
	.section .data.rel.ro,\"aw\",@progbits
	.p2align	3
# rows: name, kind, arg. kind 0 constant arg; 1 sysconf(arg); 2 cpuid leaf 1 ecx bit arg;
# 3 physical memory bytes; 4 cpuid leaf 7 ebx bit arg. x86 has no HWCAP: ARM-only features are 0.
Lsys_table:
	.quad	Lsys_n_pl0cpu, 1, 84
	.quad	Lsys_n_logicalcpu, 1, 84
	.quad	Lsys_n_pl0lcpu, 1, 84
	.quad	Lsys_n_pl1lcpu, 0, 0
	.quad	Lsys_n_pl1cpu, 0, 0
	.quad	Lsys_n_nperf, 0, 1
	.quad	Lsys_n_memsize, 3, 0
	.quad	Lsys_n_cls, 0, 64
	.quad	Lsys_n_l1d, 1, 188
	.quad	Lsys_n_l2, 1, 191
	.quad	Lsys_n_l3, 1, 194
	.quad	Lsys_n_pl0l1d, 1, 188
	.quad	Lsys_n_pl0l2, 1, 191
	.quad	Lsys_n_pl1l1d, 0, 0
	.quad	Lsys_n_pl1l2, 0, 0
	.quad	Lsys_n_neon, 0, 0
	.quad	Lsys_n_crc, 0, 0
	.quad	Lsys_n_arm64, 0, 0
	.quad	Lsys_n_lse, 0, 0
	.quad	Lsys_n_sha512, 0, 0
	.quad	Lsys_n_sha256, 0, 0
	.quad	Lsys_n_aes, 2, 25
	.quad	Lsys_n_advsimd, 0, 0
	.quad	Lsys_n_x86aes, 2, 25
	.quad	Lsys_n_x86avx, 2, 28
	.quad	Lsys_n_x86f16c, 2, 29
	.quad	Lsys_n_x86avx2, 4, 5
	.quad	Lsys_n_x86bmi2, 4, 8
	.quad	0, 0, 0
	.text
# silica_rt_sysctlbyname(rdi = name, rsi = oldp, rdx = oldlenp, rcx = newp, r8 = newlen) -> edi (0 ok, -1 unknown).
# *oldlenp is read and written as a 32-bit count (callers store it with a 32-bit store); 8-byte slots get
# the full value, 4-byte slots the low word.
# Frame slots: [rbp-8] name (X19) / phys pages, [rbp-16] oldp (X20), [rbp-24] oldlenp (X21),
# [rbp-32] table row (X22), [rbp-40] rbx across cpuid.
	.globl	silica_rt_sysctlbyname
	.p2align	4
silica_rt_sysctlbyname:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 80
	mov	QWORD PTR [rbp - 8], rdi
	mov	QWORD PTR [rbp - 16], rsi
	mov	QWORD PTR [rbp - 24], rdx
	lea	rax, [rip + Lsys_table]
	mov	QWORD PTR [rbp - 32], rax
Lsys_scan:
	mov	rax, QWORD PTR [rbp - 32]
	mov	rdi, QWORD PTR [rax]
	test	rdi, rdi
	jz	Lsys_fail
	mov	rsi, QWORD PTR [rbp - 8]
	call	Lsys_streq
	test	edi, edi
	jnz	Lsys_found
	add	QWORD PTR [rbp - 32], 24
	jmp	Lsys_scan
Lsys_found:
	mov	rax, QWORD PTR [rbp - 32]
	mov	r10, QWORD PTR [rax + 8]
	mov	rdi, QWORD PTR [rax + 16]
	cmp	r10, 1
	je	Lsys_sysconf
	cmp	r10, 2
	je	Lsys_cpuid
	cmp	r10, 3
	je	Lsys_memsize
	cmp	r10, 4
	je	Lsys_cpuid
	jmp	Lsys_store
Lsys_sysconf:
	call	sysconf
	xor	edi, edi
	test	rax, rax
	cmovns	rdi, rax
	jmp	Lsys_store
Lsys_cpuid:
# rdi = bit index, r10 = kind (2: leaf 1 ecx, 4: leaf 7 ebx). cpuid writes eax ebx ecx edx.
	mov	r8, rdi
	mov	QWORD PTR [rbp - 40], rbx
	mov	eax, 1
	cmp	r10, 4
	jne	Lsys_cpuid_go
	mov	eax, 7
Lsys_cpuid_go:
	xor	ecx, ecx
	cpuid
	cmp	r10, 4
	jne	Lsys_cpuid_ecx
	mov	eax, ebx
	jmp	Lsys_cpuid_bit
Lsys_cpuid_ecx:
	mov	eax, ecx
Lsys_cpuid_bit:
	mov	rbx, QWORD PTR [rbp - 40]
	mov	ecx, r8d
	shr	eax, cl
	and	eax, 1
	mov	rdi, rax
	jmp	Lsys_store
Lsys_memsize:
	mov	edi, 85
	call	sysconf
	mov	QWORD PTR [rbp - 8], rax
	mov	edi, 30
	call	sysconf
	imul	rax, QWORD PTR [rbp - 8]
	mov	rdi, rax
Lsys_store:
	mov	rsi, QWORD PTR [rbp - 16]
	test	rsi, rsi
	jz	Lsys_ok
	mov	rdx, QWORD PTR [rbp - 24]
	test	rdx, rdx
	jz	Lsys_fail
	mov	r10d, DWORD PTR [rdx]
	cmp	r10d, 8
	jae	Lsys_store8
	cmp	r10d, 4
	jb	Lsys_fail
	mov	DWORD PTR [rsi], edi
	mov	DWORD PTR [rdx], 4
	jmp	Lsys_ok
Lsys_store8:
	mov	QWORD PTR [rsi], rdi
	mov	DWORD PTR [rdx], 8
Lsys_ok:
	xor	edi, edi
	jmp	Lsys_ret
Lsys_fail:
	mov	rdi, -1
Lsys_ret:
	leave
	ret
# Lsys_streq(rdi, rsi = NUL-terminated strings) -> edi = 1 when equal.
Lsys_streq:
	movzx	eax, BYTE PTR [rdi]
	movzx	r10d, BYTE PTR [rsi]
	inc	rdi
	inc	rsi
	cmp	eax, r10d
	jne	Lsys_streq_ne
	test	eax, eax
	jnz	Lsys_streq
	mov	edi, 1
	ret
Lsys_streq_ne:
	xor	edi, edi
	ret
"
}

fn linux_shims_threads() -> string {
    "	.text
	.globl	silica_rt_pthread_mach_thread_np
	.p2align	4
silica_rt_pthread_mach_thread_np:
	ret
	.globl	silica_rt_pthread_set_qos_class_np
	.p2align	4
silica_rt_pthread_set_qos_class_np:
	xor	edi, edi
	ret
# silica_rt_thread_policy_set(rdi = pthread_t, esi = flavor, rdx = &tag, ecx = count) -> edi.
# Frame: [rbp-8] pthread_t (X19), [rbp-16] tag (W20); cpu_set_t (128 B) at [rsp .. rsp+128).
	.globl	silica_rt_thread_policy_set
	.p2align	4
silica_rt_thread_policy_set:
	push	rbp
	mov	rbp, rsp
	sub	rsp, 208
	mov	QWORD PTR [rbp - 8], rdi
	mov	eax, DWORD PTR [rdx]
	mov	QWORD PTR [rbp - 16], rax
	mov	rdi, rsp
	xor	esi, esi
	mov	edx, 128
	call	memset
	mov	edi, 84
	call	sysconf
	cmp	rax, 1
	jl	Ltps_ok
	mov	r10d, 1024
	cmp	rax, r10
	cmovbe	r10, rax
	movsxd	r11, DWORD PTR [rbp - 16]
	test	r11, r11
	jz	Ltps_all
	cmp	r11, r10
	jae	Ltps_ok
	mov	rax, r11
	shr	rax, 6
	mov	ecx, r11d
	and	ecx, 63
	mov	r8d, 1
	shl	r8, cl
	or	QWORD PTR [rsp + rax*8], r8
	jmp	Ltps_apply
Ltps_all:
	xor	r11d, r11d
Ltps_all_loop:
	cmp	r11, r10
	jae	Ltps_apply
	mov	rax, r11
	shr	rax, 6
	mov	ecx, r11d
	and	ecx, 63
	mov	r8d, 1
	shl	r8, cl
	or	QWORD PTR [rsp + rax*8], r8
	inc	r11
	jmp	Ltps_all_loop
Ltps_apply:
	mov	rdi, QWORD PTR [rbp - 8]
	mov	esi, 128
	mov	rdx, rsp
	call	pthread_setaffinity_np
	mov	rdi, rax
	jmp	Ltps_ret
Ltps_ok:
	xor	edi, edi
Ltps_ret:
	leave
	ret
"
}

fn emit_linux_rt_shims_asm() -> string {
    concat(concat(linux_shims_locks(), linux_shims_sysctl()), linux_shims_threads())
}
