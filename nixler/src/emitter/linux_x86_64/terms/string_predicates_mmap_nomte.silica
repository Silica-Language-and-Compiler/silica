// String predicate helpers: starts_with / ends_with / contains.
// Resolve SilicaString (tag -1) or C-string the same way as L_string_eq_helper.
// X0 = rdi = haystack, X1 = rsi = needle; W0 = edi = 0/1. Spec §5.3.3. Hand-written x86-64 leaves:
// X19-X23 -> rbx r12 r13 r14 r15 (pushed), X24 -> r8, X25-X27 -> r9 r10 r11, W28 -> ecx; contains
// keeps its inner count in rdi (X0) and its byte temps in esi/edx (W1/W2).

export emit_string_starts_with_helper/0;
export emit_string_ends_with_helper/0;
export emit_string_contains_helper/0;

fn emit_string_starts_with_helper() -> string {
    "L_string_starts_with_helper:\n    push rbp\n    mov rbp, rsp\n    push rbx\n    push r12\n    push r13\n    push r14\n    push r15\n    mov rbx, rdi\n    mov r12, rsi\n    test rbx, rbx\n    jz Lsw_false\n    test r12, r12\n    jz Lsw_false\n    mov rsi, QWORD PTR [rbx]\n    not rsi\n    cmp rsi, 1\n    ja Lsw_bad\n    mov r13, QWORD PTR [rbx + 8]\n    mov r14, QWORD PTR [rbx + 16]\n    mov rsi, QWORD PTR [r12]\n    not rsi\n    cmp rsi, 1\n    ja Lsw_bad\n    mov r15, QWORD PTR [r12 + 8]\n    mov r8, QWORD PTR [r12 + 16]\nLsw_n2_done:\n    test r8, r8\n    jz Lsw_true\n    cmp r8, r14\n    ja Lsw_false\n    mov r9, r13\n    mov r10, r15\n    mov r11, r8\nLsw_cloop:\n    movzx ecx, BYTE PTR [r9]\n    add r9, 1\n    movzx eax, BYTE PTR [r10]\n    add r10, 1\n    cmp ecx, eax\n    jne Lsw_false\n    sub r11, 1\n    jne Lsw_cloop\nLsw_true:\n    mov edi, 1\n    jmp Lsw_exit\nLsw_false:\n    xor edi, edi\nLsw_exit:\n    pop r15\n    pop r14\n    pop r13\n    pop r12\n    pop rbx\n    pop rbp\n    ret\n\nLsw_bad:\n    ud2\n"
}

fn emit_string_ends_with_helper() -> string {
    "L_string_ends_with_helper:\n    push rbp\n    mov rbp, rsp\n    push rbx\n    push r12\n    push r13\n    push r14\n    push r15\n    mov rbx, rdi\n    mov r12, rsi\n    test rbx, rbx\n    jz Lew_false\n    test r12, r12\n    jz Lew_false\n    mov rsi, QWORD PTR [rbx]\n    not rsi\n    cmp rsi, 1\n    ja Lew_bad\n    mov r13, QWORD PTR [rbx + 8]\n    mov r14, QWORD PTR [rbx + 16]\n    mov rsi, QWORD PTR [r12]\n    not rsi\n    cmp rsi, 1\n    ja Lew_bad\n    mov r15, QWORD PTR [r12 + 8]\n    mov r8, QWORD PTR [r12 + 16]\nLew_n2_done:\n    test r8, r8\n    jz Lew_true\n    cmp r8, r14\n    ja Lew_false\n    mov r9, r14\n    sub r9, r8\n    add r9, r13\n    mov r10, r15\n    mov r11, r8\nLew_cloop:\n    movzx ecx, BYTE PTR [r9]\n    add r9, 1\n    movzx eax, BYTE PTR [r10]\n    add r10, 1\n    cmp ecx, eax\n    jne Lew_false\n    sub r11, 1\n    jne Lew_cloop\nLew_true:\n    mov edi, 1\n    jmp Lew_exit\nLew_false:\n    xor edi, edi\nLew_exit:\n    pop r15\n    pop r14\n    pop r13\n    pop r12\n    pop rbx\n    pop rbp\n    ret\n\nLew_bad:\n    ud2\n"
}

fn emit_string_contains_helper() -> string {
    "L_string_contains_helper:\n    push rbp\n    mov rbp, rsp\n    push rbx\n    push r12\n    push r13\n    push r14\n    push r15\n    mov rbx, rdi\n    mov r12, rsi\n    test rbx, rbx\n    jz Lsc_false\n    test r12, r12\n    jz Lsc_false\n    mov rsi, QWORD PTR [rbx]\n    not rsi\n    cmp rsi, 1\n    ja Lsc_bad\n    mov r13, QWORD PTR [rbx + 8]\n    mov r14, QWORD PTR [rbx + 16]\n    mov rsi, QWORD PTR [r12]\n    not rsi\n    cmp rsi, 1\n    ja Lsc_bad\n    mov r15, QWORD PTR [r12 + 8]\n    mov r8, QWORD PTR [r12 + 16]\nLsc_n2_done:\n    test r8, r8\n    jz Lsc_true\n    cmp r8, r14\n    ja Lsc_false\n    mov r9, r14\n    sub r9, r8\n    add r9, 1\n    mov r10, r13\nLsc_outer:\n    mov r11, r10\n    mov rcx, r15\n    mov rdi, r8\nLsc_inner:\n    movzx esi, BYTE PTR [r11]\n    add r11, 1\n    movzx edx, BYTE PTR [rcx]\n    add rcx, 1\n    cmp esi, edx\n    jne Lsc_next\n    sub rdi, 1\n    jne Lsc_inner\n    jmp Lsc_true\nLsc_next:\n    add r10, 1\n    sub r9, 1\n    jne Lsc_outer\n    jmp Lsc_false\nLsc_true:\n    mov edi, 1\n    jmp Lsc_exit\nLsc_false:\n    xor edi, edi\nLsc_exit:\n    pop r15\n    pop r14\n    pop r13\n    pop r12\n    pop rbx\n    pop rbp\n    ret\n\nLsc_bad:\n    ud2\n"
}
