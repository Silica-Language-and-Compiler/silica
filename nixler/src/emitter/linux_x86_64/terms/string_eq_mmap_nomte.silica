// L_string_eq_helper: hand-written x86-64 leaf. Matches io.rs get_string_data_and_length + silica_string_equals
// (SilicaString tag -1 at offset 0, data at +8, length at +16; else null-terminated C string, cap 1MiB).
// X0/X1 = rdi/rsi = pointers; W0 = edi = 0/1. No external runtime. Register map (both helpers):
// X19-X23 -> rbx r12 r13 r14 r15 (pushed, SysV callee-saved style), X24 -> r8, X25-X27 -> r9 r10 r11,
// W28 -> ecx, the second byte temp (W0 / W1) -> eax / esi.
//
// L_string_cmp_helper: same resolve rules; unsigned byte lexicographic order, then shorter prefix first.
// X0/X1 = rdi/rsi = pointers; W0 = edi = -1 (lt) / 0 (eq) / 1 (gt). Used by string lt/gt/le/ge/eq/nq prims.

export emit_string_eq_helper/0;
export emit_string_cmp_helper/0;

fn emit_string_eq_helper() -> string {
    "L_string_eq_helper:\n    push rbp\n    mov rbp, rsp\n    push rbx\n    push r12\n    push r13\n    push r14\n    push r15\n    mov rbx, rdi\n    mov r12, rsi\n    test rbx, rbx\n    jz Leq_anull\n    test r12, r12\n    jz Leq_neq\n    mov rsi, QWORD PTR [rbx]\n    not rsi\n    cmp rsi, 1\n    ja Leq_bad\n    mov r13, QWORD PTR [rbx + 8]\n    mov r14, QWORD PTR [rbx + 16]\n    mov rsi, QWORD PTR [r12]\n    not rsi\n    cmp rsi, 1\n    ja Leq_bad\n    mov r15, QWORD PTR [r12 + 8]\n    mov r8, QWORD PTR [r12 + 16]\nLeq_n2_done:\n    cmp r14, r8\n    jne Leq_neq\n    test r14, r14\n    jz Leq_yes\n    mov r9, r13\n    mov r10, r15\n    mov r11, r14\nLeq_cloop:\n    movzx ecx, BYTE PTR [r9]\n    add r9, 1\n    movzx eax, BYTE PTR [r10]\n    add r10, 1\n    cmp ecx, eax\n    jne Leq_neq\n    sub r11, 1\n    jne Leq_cloop\nLeq_yes:\n    mov edi, 1\n    jmp Leq_exit\nLeq_anull:\n    test r12, r12\n    jz Leq_yes\n    jmp Leq_neq\nLeq_neq:\n    xor edi, edi\nLeq_exit:\n    pop r15\n    pop r14\n    pop r13\n    pop r12\n    pop rbx\n    pop rbp\n    ret\nLeq_bad:\n    ud2\n"
}

fn emit_string_cmp_helper() -> string {
    "L_string_cmp_helper:\n    push rbp\n    mov rbp, rsp\n    push rbx\n    push r12\n    push r13\n    push r14\n    push r15\n    mov rbx, rdi\n    mov r12, rsi\n    test rbx, rbx\n    jz Lcmp_anull\n    test r12, r12\n    jz Lcmp_gt\n    mov rsi, QWORD PTR [rbx]\n    not rsi\n    cmp rsi, 1\n    ja Lcmp_bad\n    mov r13, QWORD PTR [rbx + 8]\n    mov r14, QWORD PTR [rbx + 16]\n    mov rsi, QWORD PTR [r12]\n    not rsi\n    cmp rsi, 1\n    ja Lcmp_bad\n    mov r15, QWORD PTR [r12 + 8]\n    mov r8, QWORD PTR [r12 + 16]\nLcmp_n2_done:\n    mov r9, r14\n    cmp r9, r8\n    jbe Lcmp_minok\n    mov r9, r8\nLcmp_minok:\n    test r9, r9\n    jz Lcmp_len\n    mov r10, r13\n    mov r11, r15\nLcmp_cloop:\n    movzx ecx, BYTE PTR [r10]\n    add r10, 1\n    movzx esi, BYTE PTR [r11]\n    add r11, 1\n    cmp ecx, esi\n    jb Lcmp_lt\n    ja Lcmp_gt\n    sub r9, 1\n    jne Lcmp_cloop\nLcmp_len:\n    cmp r14, r8\n    je Lcmp_eq\n    jb Lcmp_lt\n    jmp Lcmp_gt\nLcmp_anull:\n    test r12, r12\n    jz Lcmp_eq\nLcmp_lt:\n    mov edi, -1\n    jmp Lcmp_exit\nLcmp_gt:\n    mov edi, 1\n    jmp Lcmp_exit\nLcmp_eq:\n    xor edi, edi\nLcmp_exit:\n    pop r15\n    pop r14\n    pop r13\n    pop r12\n    pop rbx\n    pop rbp\n    ret\nLcmp_bad:\n    ud2\n"
}
