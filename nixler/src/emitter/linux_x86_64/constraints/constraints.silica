// Constraint helpers for immediates (sir_emitter_pattern_spec §5). The ranges keep their AArch64
// meaning so the emitter's decisions (literal pool or not) are the same on every target; on x86-64
// emit_wide_imm is a single 64-bit immediate move through x86_isa.

use x86_isa;

export fits_imm12/1;
export fits_imm12_signed/1;
export fits_mov_imm/1;
export emit_wide_imm/2;

// ADD/SUB 12-bit unsigned: 0 <= k < 4096
fn fits_imm12(k: int64) -> boolean {
    (k >= 0) and (k < 4096)
}

// Some signed immediates: -4096 <= k < 4096
fn fits_imm12_signed(k: int64) -> boolean {
    (k >= -4096) and (k < 4096)
}

// MOV dest, #k: fits if encodable as single MOVZ (16-bit) or logical immediate.
// Conservative: -65536 <= k <= 65535 uses MOV; larger magnitudes need literal pool.
fn fits_mov_imm(k: int64) -> boolean {
    (k >= 0 - 65536) and (k <= 65535)
}

// Wide constant from its decimal text (the MOVZ/MOVK sequence on AArch64): one immediate move; a W
// destination takes the low word.
fn emit_wide_imm(dest: string, value: string) -> string {
    x86_isa@x86_movi_text(dest, value)
}
