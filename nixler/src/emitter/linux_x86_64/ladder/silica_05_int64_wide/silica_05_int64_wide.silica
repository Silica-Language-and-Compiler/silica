// ESP32-S3 port early app 05: int64 arithmetic across the 32-bit boundary -- carries into the high
// word, 64-bit multiply, divide and remainder, and comparisons that differ only in the high word.
fn flag(b: boolean) -> int64 {
    case b of {
        true -> 1;
        false -> 0
    }
}

fn main() -> atom {
    sequence proc[device_io]
        a: int64 <- 3000000000;
        b: int64 <- a * 3;
        c: int64 <- b / 7;
        d: int64 <- b % 7;
        e: int64 <- 4294967295 + 1;
        f: int64 <- e - 2;
        g: int64 <- flag(e > f);
        h: int64 <- flag(4294967296 < 4294967297);
        pb: atom <- print_int64(b);
        println();
        pc: atom <- print_int64(c);
        println();
        pd: atom <- print_int64(d);
        println();
        pe: atom <- print_int64(e);
        println();
        pf: atom <- print_int64(f);
        println();
        pg: atom <- print_int64(g);
        println();
        ph: atom <- print_int64(h);
        println()
    produces pure :ok end
}
