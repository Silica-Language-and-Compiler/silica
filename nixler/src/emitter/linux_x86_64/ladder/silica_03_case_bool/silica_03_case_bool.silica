// ESP32-S3 port early app 03: comparisons, booleans, and/or, nested case.
// classify(-5) = 1, classify(0) = 2, classify(7) = 3, classify(200) = 4; in_range checks and/or.
fn classify(x: int64) -> int64 {
    case x < 0 of {
        true -> 1;
        false -> case x == 0 of {
            true -> 2;
            false -> case x <= 100 of {
                true -> 3;
                false -> 4
            }
        }
    }
}

fn in_range(x: int64, lo: int64, hi: int64) -> boolean {
    x >= lo and x <= hi
}

fn outside(x: int64, lo: int64, hi: int64) -> boolean {
    x < lo or x > hi
}

fn bool_to_int(b: boolean) -> int64 {
    case b of {
        true -> 1;
        false -> 0
    }
}

fn main() -> int64 {
    c: int64 <- classify(-5) * 1000 + classify(0) * 100 + classify(7) * 10 + classify(200);
    r: int64 <- bool_to_int(in_range(5, 1, 10)) + bool_to_int(in_range(11, 1, 10)) * 2 + bool_to_int(outside(0, 1, 10)) * 4;
    // c = 1234, r = 1 + 0 + 4 = 5; status (1234 + 5) % 256 = 215
    (c + r) % 256
}
