// ESP32-S3 port early app 07: recursion depth. 2000 nested non-tail calls exercise register-window
// spills and the runtime stack (64 KB) on every level; the result checks nothing was lost.
fn sum_to(n: int64) -> int64 {
    case n == 0 of {
        true -> 0;
        false -> n + sum_to(n - 1)
    }
}

fn main() -> atom {
    sequence proc[device_io]
        print_int64(sum_to(2000));
        println()
    produces pure :ok end
}
