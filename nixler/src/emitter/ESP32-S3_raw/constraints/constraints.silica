// Constraint helpers for AArch64 immediates (sir_emitter_pattern_spec §5)
// Used as guards in prim emission; no prims yet, so stubs for extensibility
// emit_wide_imm: MOVZ/MOVK only — never MOV dest, #large (assembler rejects non-logical immediates).

use atom_table;
use string_parse;
use xt_isa;

export fits_imm12/1;
export fits_imm12_signed/1;
export fits_mov_imm/1;
export emit_wide_imm/2;

// ADD/SUB 12-bit unsigned: 0 <= k < 4096
fn fits_imm12(k: int64) -> boolean {
    (k >= 0) and (k < 4096)
}

// Some signed immediates: -4096 <= k < 4096
fn fits_imm12_signed(k: int64) -> boolean {
    (k >= -4096) and (k < 4096)
}

// MOV dest, #k: fits if encodable as single MOVZ (16-bit) or logical immediate.
// Conservative: -65536 <= k <= 65535 uses MOV; larger magnitudes need literal pool.
fn fits_mov_imm(k: int64) -> boolean {
    (k >= 0 - 65536) and (k <= 65535)
}

fn u16_0(n: int64) -> int64 {
    n % 65536
}

fn u16_1(n: int64) -> int64 {
    (n / 65536) % 65536
}

fn u16_2(n: int64) -> int64 {
    (n / 4294967296) % 65536
}

fn u16_3(n: int64) -> int64 {
    n / 281474976710656
}

fn dest_is_w_reg(dest: string) -> boolean {
    case length_bytes(dest) > 0 of {
        true -> substring(dest, 0, 1) == "W";
        false -> false
    }
}

// A 64-bit (or 32-bit, W destination) immediate: MOVZ/MOVK on AArch64, xt_isa's word pair here.
fn emit_wide_imm(dest: string, value: string) -> string {
    xt_isa@xt_movi_text(dest, value)
}
