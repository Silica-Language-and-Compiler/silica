// ESP32-S3 port early app 04: console output. int64 values that need the high word on a 32-bit
// core (5000000000, the int64 extremes), negatives, strings and newlines.
// Prints are bound (`a: atom <- print_int64(...)`): the bare-statement form with a literal is an
// open host-compiler defect, pinned by trials/sequence_block_addition/
// sequence_print_int64_literal_statement.
fn main() -> atom {
    sequence proc[device_io]
        print_string("hello from silica");
        println();
        a: atom <- print_int64(0);
        println();
        b: atom <- print_int64(-42);
        println();
        c: atom <- print_int64(5000000000);
        println();
        d: atom <- print_int64(9223372036854775807);
        println();
        e: atom <- print_int64(-9223372036854775807);
        println()
    produces pure :ok end
}
