// ESP32-S3 port early app 13: checked int64 arithmetic (Layer 1 §7.8). checked_int64_add / _mul /
// _add1 return an (ok, value) pair through the runtime (board/runtime/rt_ordering.S); on overflow
// ok is false and the value is 0, as on the host.
fn show(p: (boolean, int64)) -> atom {
    sequence proc[device_io]
        (ok: boolean, v: int64) <- p;
        a: atom <- print_boolean(ok);
        print_string(" ");
        b: atom <- print_int64(v);
        println()
    produces pure b end
}

fn main() -> atom {
    a: atom <- show(checked_int64_add(30, 10));
    b: atom <- show(checked_int64_add(9223372036854775807, 1));
    c: atom <- show(checked_int64_add(-9223372036854775807, -2));
    d: atom <- show(checked_int64_add(-5, -7));
    e: atom <- show(checked_int64_mul(123456789, 1000));
    f: atom <- show(checked_int64_mul(4294967296, 4294967296));
    g: atom <- show(checked_int64_mul(-3037000500, 3037000500));
    h: atom <- show(checked_int64_mul(0, 9223372036854775807));
    i: atom <- show(checked_int64_mul(-1, 5));
    j: atom <- show(checked_int64_add1(41));
    k: atom <- show(checked_int64_add1(9223372036854775807));
    :ok
}
