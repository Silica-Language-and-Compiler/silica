// ESP32-S3 port early app 09: lists. Literal and empty lists, length, prepend, head / tail through
// case patterns, remove_head, list_at, a recursive fold, and a list long enough to span several
// chunks (the runtime's silica_rt_list_* routines, board/runtime/rt_list.S).
fn sum_list(xs: List[int64, mem(normal)]) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> 0;
        [h: int64, t: List[int64, mem(normal)]] -> h + sum_list(t);
        _: List[int64, mem(normal)] -> 0
    }
}

// Builds [1, 2, ..., n] by prepending n, n-1, ..., 1 onto acc (n >= 1).
fn count_down(n: int64, acc: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        next: List[int64, mem(normal)] <- prepend[int64, mem(normal)](n, acc);
        r: List[int64, mem(normal)] <- case n == 1 of {
            true -> next;
            false -> count_down(n - 1, next)
        }
    produces pure r end
}

fn head_or(xs: List[int64, mem(normal)], d: int64) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> d;
        [h: int64, _: List[int64, mem(normal)]] -> h;
        _: List[int64, mem(normal)] -> d
    }
}

fn main() -> atom {
    sequence proc[mem(normal), device_io]
        xs: List[int64, mem(normal)] <- [7, 8, 9];
        none: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        n1: int64 <- length[int64, mem(normal)](xs);
        n2: int64 <- length[int64, mem(normal)](none);
        p1: atom <- print_int64(n1);
        println();
        p2: atom <- print_int64(n2);
        println();
        with_head: List[int64, mem(normal)] <- prepend[int64, mem(normal)](1, xs);
        p3: atom <- print_int64(head_or(with_head, -1));
        println();
        p4: atom <- print_int64(length[int64, mem(normal)](with_head));
        println();
        rest: List[int64, mem(normal)] <- remove_head[int64, mem(normal)](with_head);
        p5: atom <- print_int64(head_or(rest, -1));
        println();
        p6: atom <- print_int64(head_or(none, -1));
        println();
        a: int64 <- list_at[int64, mem(normal)](xs, 0);
        b: int64 <- list_at[int64, mem(normal)](xs, 2);
        p7: atom <- print_int64(a * 100 + b);
        println();
        p8: atom <- print_int64(sum_list(with_head));
        println();
        long: List[int64, mem(normal)] <- count_down(100, none);
        p9: atom <- print_int64(length[int64, mem(normal)](long));
        println();
        p10: atom <- print_int64(sum_list(long));
        println();
        p11: atom <- print_int64(list_at[int64, mem(normal)](long, 63));
        println()
    produces pure :ok end
}
