// Per-actor FFI arena (Phase 12). ACB fields at +352 base, +360 end, +368 bump (384 B ACB).

export emit_ffi_arena_runtime_asm/0;

fn emit_ffi_arena_runtime_asm() -> string {
    "	.section	__TEXT,__text,regular,pure_instructions
	.globl	_silica_rt_ffi_arena_ensure
	.p2align	2
_silica_rt_ffi_arena_ensure:
	.cfi_startproc
	stp	x29, x30, [sp, #-16]!
	stp	x19, x20, [sp, #-16]!
	mov	x29, sp
	mov	x19, x0
	ldr	x8, [x19, #352]
	cbnz	x8, L_arena_ensure_done
	mov	x0, xzr
	mov	x1, #262144
	mov	x2, #3
	mov	x3, #4098
	mov	x4, #-1
	mov	x5, xzr
	bl	_mmap
	cmn	x0, #1
	b.eq	L_arena_ensure_fail
	cbz	x0, L_arena_ensure_fail
	mov	x8, x0
	add	x9, x8, #262144
	str	x8, [x19, #352]
	str	x9, [x19, #360]
	str	x8, [x19, #368]
L_arena_ensure_done:
	mov	x0, x19
	ldp	x19, x20, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
L_arena_ensure_fail:
	mov	x0, xzr
	ldp	x19, x20, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
	.cfi_endproc
	.globl	_silica_rt_ffi_arena_bump
	.p2align	2
_silica_rt_ffi_arena_bump:
	.cfi_startproc
	stp	x29, x30, [sp, #-16]!
	stp	x19, x20, [sp, #-16]!
	mov	x29, sp
	mov	x20, x0
	bl	_silica_rt_tls_current_actor_get
	cbz	x0, L_arena_bump_fail
	mov	x19, x0
	mov	x0, x19
	bl	_silica_rt_ffi_arena_ensure
	cbz	x0, L_arena_bump_fail
	ldr	x8, [x19, #368]
	ldr	x9, [x19, #360]
	add	x10, x20, #7
	bic	x10, x10, #7
	add	x11, x8, x10
	cmp	x11, x9
	b.hi	L_arena_bump_fail
	str	x11, [x19, #368]
	mov	x0, x8
	ldp	x19, x20, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
L_arena_bump_fail:
	mov	x0, xzr
	ldp	x19, x20, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
	.cfi_endproc
	.globl	_silica_rt_ffi_arena_reset
	.p2align	2
_silica_rt_ffi_arena_reset:
	.cfi_startproc
	ldr	x8, [x0, #352]
	cbz	x8, L_arena_reset_done
	str	x8, [x0, #368]
L_arena_reset_done:
	ret
	.cfi_endproc
	.globl	_silica_rt_ffi_arena_teardown
	.p2align	2
_silica_rt_ffi_arena_teardown:
	.cfi_startproc
	stp	x29, x30, [sp, #-16]!
	stp	x19, x20, [sp, #-16]!
	mov	x29, sp
	mov	x19, x0
	ldr	x8, [x19, #352]
	cbz	x8, L_arena_teardown_done
	mov	x0, x8
	mov	x1, #262144
	bl	_munmap
	str	xzr, [x19, #352]
	str	xzr, [x19, #360]
	str	xzr, [x19, #368]
L_arena_teardown_done:
	ldp	x19, x20, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
	.cfi_endproc
	.globl	_silica_rt_ffi_ptr_in_active_arena
	.p2align	2
_silica_rt_ffi_ptr_in_active_arena:
	.cfi_startproc
	stp	x29, x30, [sp, #-16]!
	stp	x19, x20, [sp, #-16]!
	mov	x29, sp
	mov	x20, x0
	bl	_silica_rt_tls_current_actor_get
	cbz	x0, L_arena_ptr_no
	mov	x19, x0
	ldr	x8, [x19, #352]
	ldr	x9, [x19, #360]
	cbz	x8, L_arena_ptr_no
	cmp	x20, x8
	b.lo	L_arena_ptr_no
	cmp	x20, x9
	b.hs	L_arena_ptr_no
	mov	x0, #1
	ldp	x19, x20, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
L_arena_ptr_no:
	mov	x0, xzr
	ldp	x19, x20, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
	.cfi_endproc
"
}
