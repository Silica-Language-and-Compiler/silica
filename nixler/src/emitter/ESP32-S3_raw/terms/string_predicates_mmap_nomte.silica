// String predicate helpers: starts_with / ends_with / contains.
// Resolve SilicaString (tag -1) or C-string the same way as L_string_eq_helper.
// X0 = haystack, X1 = needle; W0 = 0/1. Spec §5.3.3.

// ESP32-S3: these helpers are board runtime routines (board/runtime/rt_string.S, silica_rt_string_*);
// the emitter calls them directly, so nothing is emitted into the module.
export emit_string_starts_with_helper/0;
export emit_string_ends_with_helper/0;
export emit_string_contains_helper/0;

fn emit_string_starts_with_helper() -> string {
    ""
}

fn emit_string_ends_with_helper() -> string {
    ""
}

fn emit_string_contains_helper() -> string {
    ""
}
