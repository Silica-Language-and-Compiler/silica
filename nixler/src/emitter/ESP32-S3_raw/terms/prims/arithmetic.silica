// int64/int32/uint64/uint32 arithmetic prim emission: add, sub, mul, div, rem -- Xtensa (ESP32-S3).
// Operands arrive in the fixed temps r1 = <prefix>9 and r2 = <prefix>10 (term_emitter evaluates left
// into r1, right into r2); the result goes to dest. reg_prefix is "X" (int64/uint64) or "W" (32-bit and
// narrower). xt_isa does the instruction selection: 64-bit values are word pairs, division is libgcc
// for X and QUOS/QUOU/REMS/REMU for W. Floats use D1/D2, S1/S2, H1/H2 and go through xt_float.
// Division by zero calls silica_rt_badarith first, as on AArch64 (the check below; SDIV itself would
// just give 0).

use sir_ast;
use xt_isa;
use xt_float;

export emit_add_op/2;
export emit_sub_op/2;
export emit_mul_op/2;
export emit_div_op/2;
export emit_rem_op/2;
export emit_udiv_op/2;
export emit_urem_op/2;
export emit_fadd_op/1;
export emit_fsub_op/1;
export emit_fmul_op/1;
export emit_fdiv_op/1;
export emit_fadd_s_op/1;
export emit_fsub_s_op/1;
export emit_fmul_s_op/1;
export emit_fdiv_s_op/1;
export emit_fadd_h_op/1;
export emit_fsub_h_op/1;
export emit_fmul_h_op/1;
export emit_fdiv_h_op/1;
export emit_neg_op/2;
export emit_fneg_op/1;
export emit_fneg_s_op/1;
export emit_fneg_h_op/1;

fn op_reg(prefix: string, n: string) -> string {
    concat(prefix, n)
}

fn emit_add_op(dest: string, reg_prefix: string) -> string {
    xt_isa@xt_add(dest, op_reg(reg_prefix, "9"), op_reg(reg_prefix, "10"))
}

fn emit_sub_op(dest: string, reg_prefix: string) -> string {
    xt_isa@xt_sub(dest, op_reg(reg_prefix, "9"), op_reg(reg_prefix, "10"))
}

fn emit_mul_op(dest: string, reg_prefix: string) -> string {
    xt_isa@xt_mul(dest, op_reg(reg_prefix, "9"), op_reg(reg_prefix, "10"))
}

// Divisor (r2) zero -> silica_rt_badarith, which does not return.
fn zero_divisor_check(reg_prefix: string) -> string {
    concat(concat(xt_isa@xt_cbnz(op_reg(reg_prefix, "10"), "1f"), xt_isa@xt_call("_silica_rt_badarith")), "1:\n")
}

fn emit_div_op(dest: string, reg_prefix: string) -> string {
    concat(zero_divisor_check(reg_prefix), xt_isa@xt_sdiv(dest, op_reg(reg_prefix, "9"), op_reg(reg_prefix, "10")))
}

// Truncating remainder (sign of the dividend), as SDIV + MSUB computes it.
fn emit_rem_op(dest: string, reg_prefix: string) -> string {
    concat(zero_divisor_check(reg_prefix), xt_isa@xt_srem(dest, op_reg(reg_prefix, "9"), op_reg(reg_prefix, "10")))
}

fn emit_udiv_op(dest: string, reg_prefix: string) -> string {
    concat(zero_divisor_check(reg_prefix), xt_isa@xt_udiv(dest, op_reg(reg_prefix, "9"), op_reg(reg_prefix, "10")))
}

fn emit_urem_op(dest: string, reg_prefix: string) -> string {
    concat(zero_divisor_check(reg_prefix), xt_isa@xt_urem(dest, op_reg(reg_prefix, "9"), op_reg(reg_prefix, "10")))
}

fn emit_fadd_op(dest: string) -> string {
    xt_float@xt_fop("add", dest, "D1", "D2")
}

fn emit_fsub_op(dest: string) -> string {
    xt_float@xt_fop("sub", dest, "D1", "D2")
}

fn emit_fmul_op(dest: string) -> string {
    xt_float@xt_fop("mul", dest, "D1", "D2")
}

fn emit_fdiv_op(dest: string) -> string {
    xt_float@xt_fop("div", dest, "D1", "D2")
}

fn emit_fadd_s_op(dest: string) -> string {
    xt_float@xt_fop("add", dest, "S1", "S2")
}

fn emit_fsub_s_op(dest: string) -> string {
    xt_float@xt_fop("sub", dest, "S1", "S2")
}

fn emit_fmul_s_op(dest: string) -> string {
    xt_float@xt_fop("mul", dest, "S1", "S2")
}

fn emit_fdiv_s_op(dest: string) -> string {
    xt_float@xt_fop("div", dest, "S1", "S2")
}

fn emit_fadd_h_op(dest: string) -> string {
    xt_float@xt_fop("add", dest, "H1", "H2")
}

fn emit_fsub_h_op(dest: string) -> string {
    xt_float@xt_fop("sub", dest, "H1", "H2")
}

fn emit_fmul_h_op(dest: string) -> string {
    xt_float@xt_fop("mul", dest, "H1", "H2")
}

fn emit_fdiv_h_op(dest: string) -> string {
    xt_float@xt_fop("div", dest, "H1", "H2")
}

// Unary neg (built-in negate_<type>/1 -> prim neg): operand in r1 (X9/W9/D1/S1/H1 per term_emitter)
fn emit_neg_op(dest: string, reg_prefix: string) -> string {
    xt_isa@xt_neg(dest, op_reg(reg_prefix, "9"))
}

fn emit_fneg_op(dest: string) -> string {
    xt_float@xt_fneg(dest, "D1")
}

fn emit_fneg_s_op(dest: string) -> string {
    xt_float@xt_fneg(dest, "S1")
}

fn emit_fneg_h_op(dest: string) -> string {
    xt_float@xt_fneg(dest, "H1")
}
