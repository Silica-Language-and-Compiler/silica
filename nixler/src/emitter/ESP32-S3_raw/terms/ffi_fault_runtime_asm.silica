// Phase 13 — macOS sigaltstack / sigaction guarded-FFI fault bridge.
// Per-thread guarded TLS block layout (512 B, see ffi_guarded_runtime_asm.silica):
//   +0 depth, +8 actor ACB, +16 call_gen, +24 inside,
//   +32 fault_signal, +40 fault_addr, +48 fault_code, +56 fault_in_arena,
//   +64 sigjmp_buf (448 B).

export emit_ffi_fault_runtime_asm/0;

// Runtime abort (spec §15.4.5.5; design_documents/runtime_failure_reporting.md). Every runtime check
// that cannot continue calls one of the per-site entries below (or silica_rt_abort_with with its own
// reason); the report is the line "[silica] abort: <reason> at 0x<pc>", followed by " in
// <symbol>+0x<offset>" when dladdr names the address, on stderr, and the process exits with status 71.
// The pc is the call instruction of the site. Nothing is allocated, and the report does not run on the
// caller's stack: the first caller claims the report and moves onto a static 32 KB stack (the caller
// may be an actor at the end of its reservation, or the signal handler on its alternate stack); any
// later caller, on any thread, parks until the process has gone. The exit is C _exit (async-signal-safe,
// no atexit handlers), which is what the C abort() it replaces also skipped.
fn emit_abort_runtime_asm() -> string {
    "	.section	__TEXT,__cstring,cstring_literals
Lrta_pre:
	.asciz	\"[silica] abort: \"
Lrta_at:
	.asciz	\" at 0x\"
Lrta_r_region_overflow:
	.asciz	\"region allocation failed\"
Lrta_r_buf_invalid:
	.asciz	\"invalid buffer size\"
Lrta_r_buf_bounds:
	.asciz	\"buffer index out of bounds\"
Lrta_r_list_index:
	.asciz	\"list index out of range\"
Lrta_r_arena_key:
	.asciz	\"canonical arena key is zero\"
Lrta_r_arena_full:
	.asciz	\"canonical arena table is full\"
Lrta_r_arena_nomem:
	.asciz	\"canonical arena allocation failed\"
Lrta_r_guarded_ffi_state:
	.asciz	\"guarded FFI state could not be allocated\"
Lrta_r_ingress_full:
	.asciz	\"supervision ingress queue is full\"
Lrta_r_exit_queue_full:
	.asciz	\"supervisor ingress queue is full (exit delivery)\"
Lrta_r_stack_commit:
	.asciz	\"cannot commit memory for a growing actor stack\"
Lrta_r_stack_reserve:
	.asciz	\"stack reservation failed\"
	.section	__TEXT,__text,regular,pure_instructions
	.globl	_silica_rt_abort_with
	.p2align	2
_silica_rt_abort_with:
; X0 = NUL-terminated reason. The reported address is the BL that got here (X30 - 4). Never returns.
	sub	x1, x30, #4
	b	_silica_rt_abort_with_pc
	.globl	_silica_rt_abort_with_pc
	.p2align	2
_silica_rt_abort_with_pc:
; X0 = reason, X1 = the address to report. Never returns.
	mov	x19, x0
	mov	x20, x1
	adrp	x8, _silica_rt_abort_claimed@PAGE
	add	x8, x8, _silica_rt_abort_claimed@PAGEOFF
	mov	w9, #1
Lrta_claim:
	ldaxr	w10, [x8]
	cbnz	w10, Lrta_park
	stlxr	w11, w9, [x8]
	cbnz	w11, Lrta_claim
	adrp	x8, _silica_rt_abort_stack_top@PAGE
	add	x8, x8, _silica_rt_abort_stack_top@PAGEOFF
	mov	sp, x8
	mov	x29, xzr
	adrp	x0, Lrta_pre@PAGE
	add	x0, x0, Lrta_pre@PAGEOFF
	bl	_silica_rt_fault_puts
	mov	x0, x19
	bl	_silica_rt_fault_puts
	adrp	x0, Lrta_at@PAGE
	add	x0, x0, Lrta_at@PAGEOFF
	bl	_silica_rt_fault_puts
	mov	x0, x20
	bl	_silica_rt_fault_puthex
	mov	x0, x20
	adrp	x1, _silica_rt_fault_dlinfo@PAGE
	add	x1, x1, _silica_rt_fault_dlinfo@PAGEOFF
	bl	_dladdr
	cbz	w0, Lrta_eol
	adrp	x21, _silica_rt_fault_dlinfo@PAGE
	add	x21, x21, _silica_rt_fault_dlinfo@PAGEOFF
	ldr	x22, [x21, #16]
	cbz	x22, Lrta_eol
	adrp	x0, Lpfs_in@PAGE
	add	x0, x0, Lpfs_in@PAGEOFF
	bl	_silica_rt_fault_puts
	mov	x0, x22
	bl	_silica_rt_fault_puts
	ldr	x1, [x21, #24]
	cbz	x1, Lrta_eol
	sub	x22, x20, x1
	adrp	x0, Lpfs_plus@PAGE
	add	x0, x0, Lpfs_plus@PAGEOFF
	bl	_silica_rt_fault_puts
	mov	x0, x22
	bl	_silica_rt_fault_puthex
Lrta_eol:
	adrp	x0, Lpfs_eol@PAGE
	add	x0, x0, Lpfs_eol@PAGEOFF
	bl	_silica_rt_fault_puts
	mov	w0, #71
	bl	__exit
Lrta_park:
	yield
	b	Lrta_park
; Per-site entries: the reason in X0, then on to _silica_rt_abort_with with X30 untouched, so the
; reported address is still the site's BL.
	.globl	_silica_rt_abort_region_overflow
	.p2align	2
_silica_rt_abort_region_overflow:
	adrp	x0, Lrta_r_region_overflow@PAGE
	add	x0, x0, Lrta_r_region_overflow@PAGEOFF
	b	_silica_rt_abort_with
	.globl	_silica_rt_abort_buf_invalid
	.p2align	2
_silica_rt_abort_buf_invalid:
	adrp	x0, Lrta_r_buf_invalid@PAGE
	add	x0, x0, Lrta_r_buf_invalid@PAGEOFF
	b	_silica_rt_abort_with
	.globl	_silica_rt_abort_buf_bounds
	.p2align	2
_silica_rt_abort_buf_bounds:
	adrp	x0, Lrta_r_buf_bounds@PAGE
	add	x0, x0, Lrta_r_buf_bounds@PAGEOFF
	b	_silica_rt_abort_with
	.globl	_silica_rt_abort_list_index
	.p2align	2
_silica_rt_abort_list_index:
	adrp	x0, Lrta_r_list_index@PAGE
	add	x0, x0, Lrta_r_list_index@PAGEOFF
	b	_silica_rt_abort_with
	.globl	_silica_rt_abort_arena_key
	.p2align	2
_silica_rt_abort_arena_key:
	adrp	x0, Lrta_r_arena_key@PAGE
	add	x0, x0, Lrta_r_arena_key@PAGEOFF
	b	_silica_rt_abort_with
	.globl	_silica_rt_abort_arena_full
	.p2align	2
_silica_rt_abort_arena_full:
	adrp	x0, Lrta_r_arena_full@PAGE
	add	x0, x0, Lrta_r_arena_full@PAGEOFF
	b	_silica_rt_abort_with
	.globl	_silica_rt_abort_arena_nomem
	.p2align	2
_silica_rt_abort_arena_nomem:
	adrp	x0, Lrta_r_arena_nomem@PAGE
	add	x0, x0, Lrta_r_arena_nomem@PAGEOFF
	b	_silica_rt_abort_with
	.globl	_silica_rt_abort_guarded_ffi_state
	.p2align	2
_silica_rt_abort_guarded_ffi_state:
	adrp	x0, Lrta_r_guarded_ffi_state@PAGE
	add	x0, x0, Lrta_r_guarded_ffi_state@PAGEOFF
	b	_silica_rt_abort_with
	.globl	_silica_rt_abort_ingress_full
	.p2align	2
_silica_rt_abort_ingress_full:
	adrp	x0, Lrta_r_ingress_full@PAGE
	add	x0, x0, Lrta_r_ingress_full@PAGEOFF
	b	_silica_rt_abort_with
	.globl	_silica_rt_abort_exit_queue_full
	.p2align	2
_silica_rt_abort_exit_queue_full:
	adrp	x0, Lrta_r_exit_queue_full@PAGE
	add	x0, x0, Lrta_r_exit_queue_full@PAGEOFF
	b	_silica_rt_abort_with
	.globl	_silica_rt_abort_stack_reserve
	.p2align	2
_silica_rt_abort_stack_reserve:
	adrp	x0, Lrta_r_stack_reserve@PAGE
	add	x0, x0, Lrta_r_stack_reserve@PAGEOFF
	b	_silica_rt_abort_with
"
}

fn emit_ffi_fault_runtime_asm() -> string {
    bss: string <- "	.section	__DATA,__bss
	.p2align	3
_silica_rt_ffi_altstack_mem:
	.zero	65536
_silica_rt_sync_fault_handlers_installed:
	.zero	4
	.globl	_silica_rt_fault_pc
_silica_rt_fault_pc:
	.zero	8
_silica_rt_fault_dlinfo:
	.zero	48
_silica_rt_fault_hexbuf:
	.zero	32
_silica_rt_fault_addr:
	.zero	8
_silica_rt_fault_actor:
	.zero	8
_silica_rt_fault_sbase:
	.zero	8
_silica_rt_fault_ssize:
	.zero	8
	.globl	_silica_rt_own_image_base
_silica_rt_own_image_base:
	.zero	8
_silica_rt_ffi_altstack_active:
	.zero	4
_silica_rt_abort_claimed:
	.zero	4
	.p2align	4
_silica_rt_abort_stack:
	.zero	32768
_silica_rt_abort_stack_top:
";
    text: string <- "	.section	__TEXT,__text,regular,pure_instructions
	.globl	_silica_rt_install_sync_fault_handlers
	.p2align	2
_silica_rt_install_sync_fault_handlers:
	.cfi_startproc
	stp	x29, x30, [sp, #-16]!
	mov	x29, sp
	.cfi_def_cfa w29, 16
	.cfi_offset w30, -8
	.cfi_offset w29, -16
Lloh_ifh0:
	adrp	x8, _silica_rt_sync_fault_handlers_installed@PAGE
Lloh_ifh1:
	add	x8, x8, _silica_rt_sync_fault_handlers_installed@PAGEOFF
	ldr	w9, [x8]
	cbnz	w9, L_ifh_done
	mov	w9, #1
	str	w9, [x8]
	sub	sp, sp, #64
Lloh_as0:
	adrp	x9, _silica_rt_ffi_altstack_mem@PAGE
Lloh_as1:
	add	x9, x9, _silica_rt_ffi_altstack_mem@PAGEOFF
	str	x9, [sp]
	mov	x9, #65536
	str	x9, [sp, #8]
	str	wzr, [sp, #16]
	mov	x0, sp
	mov	x1, xzr
	bl	_sigaltstack
Lloh_asf0:
	adrp	x9, _silica_rt_ffi_altstack_active@PAGE
Lloh_asf1:
	add	x9, x9, _silica_rt_ffi_altstack_active@PAGEOFF
	mov	w10, #1
	str	w10, [x9]
Lloh_h0:
	adrp	x8, _silica_rt_sync_fault_handler@PAGE
Lloh_h1:
	add	x8, x8, _silica_rt_sync_fault_handler@PAGEOFF
	str	x8, [sp, #32]
	str	wzr, [sp, #40]
; SA_SIGINFO (0x40) | SA_ONSTACK (0x1) | SA_NODEFER (0x10). SA_NODEFER keeps the signal deliverable
; while its handler runs: a fault inside the handler must reach _silica_rt_fault_last_resort, and a
; synchronous fault on a blocked signal is the default action (status 139) instead (spec §15.4.5.5).
	mov	w9, #81
	str	w9, [sp, #44]
	mov	w0, #11
	add	x1, sp, #32
	mov	x2, xzr
	bl	_sigaction
	mov	w0, #10
	add	x1, sp, #32
	mov	x2, xzr
	bl	_sigaction
	mov	w0, #4
	add	x1, sp, #32
	mov	x2, xzr
	bl	_sigaction
	mov	w0, #8
	add	x1, sp, #32
	mov	x2, xzr
	bl	_sigaction
	add	sp, sp, #64
L_ifh_done:
	ldp	x29, x30, [sp], #16
	ret
	.loh AdrpAdd	Lloh_ifh0, Lloh_ifh1
	.loh AdrpAdd	Lloh_as0, Lloh_as1
	.loh AdrpAdd	Lloh_asf0, Lloh_asf1
	.loh AdrpAdd	Lloh_h0, Lloh_h1
	.cfi_endproc
; The startup code installs the handlers before main runs (spec §15.4.5.5): dyld calls every
; __mod_init_func entry before main, so a fault in main's prologue, or in anything else that runs
; before main's body, is reported like any other. The calls from spawn and from main's prologue remain
; and return at once (the installed flag); spawn's call is also what gives an actor thread its handler
; state on hosts where that differs.
	.section	__DATA,__mod_init_func,mod_init_funcs
	.p2align	3
	.quad	_silica_rt_install_sync_fault_handlers
	.section	__TEXT,__text,regular,pure_instructions
	.globl	_silica_rt_ffi_fault_altstack_probed
	.p2align	2
_silica_rt_ffi_fault_altstack_probed:
	.cfi_startproc
Lloh_ap0:
	adrp	x8, _silica_rt_ffi_altstack_active@PAGE
Lloh_ap1:
	add	x8, x8, _silica_rt_ffi_altstack_active@PAGEOFF
	ldr	w0, [x8]
	ret
	.loh AdrpAdd	Lloh_ap0, Lloh_ap1
	.cfi_endproc
	.globl	_silica_rt_ffi_trial_arena_base
	.p2align	2
_silica_rt_ffi_trial_arena_base:
	.cfi_startproc
	stp	x29, x30, [sp, #-16]!
	stp	x19, x20, [sp, #-16]!
	mov	x29, sp
	bl	_silica_rt_tls_current_actor_get
	cbz	x0, L_tab_zero
	mov	x19, x0
	bl	_silica_rt_ffi_arena_ensure
	cbz	x0, L_tab_zero
	ldr	x0, [x19, #352]
	ldp	x19, x20, [sp], #16
	ldp	x29, x30, [sp], #16
	ret
L_tab_zero:
	mov	x0, xzr
	ldp	x29, x30, [sp], #16
	ret
	.cfi_endproc
	.globl	_silica_rt_sync_fault_handler
	.p2align	2
_silica_rt_sync_fault_handler:
	.cfi_startproc
	stp	x24, x23, [sp, #-64]!
	stp	x22, x21, [sp, #16]
	stp	x20, x19, [sp, #32]
	stp	x29, x30, [sp, #48]
	add	x29, sp, #48
	mov	x22, x0
	mov	x23, x1
	mov	x24, x2
; A fault raised while a handler runs on this thread (the handler itself, or the runtime code it calls)
; takes the last-resort path and never re-enters the decision below (spec §15.4.5.5).
	mov	x0, x24
	bl	_silica_rt_fault_in_handler
	cbnz	w0, L_sfh_last_resort
	adrp	x8, _silica_rt_fault_pc@PAGE
	add	x8, x8, _silica_rt_fault_pc@PAGEOFF
	cbz	x24, Lsfh_pc_done
	ldr	x9, [x24, #48]
	cbz	x9, Lsfh_pc_done
	ldr	x9, [x9, #272]
	str	x9, [x8]
	ldr	x9, [x23, #24]
	adrp	x8, _silica_rt_fault_addr@PAGE
	add	x8, x8, _silica_rt_fault_addr@PAGEOFF
	str	x9, [x8]
	bl	_silica_rt_tls_current_actor_get
	adrp	x8, _silica_rt_fault_actor@PAGE
	add	x8, x8, _silica_rt_fault_actor@PAGEOFF
	str	x0, [x8]
	cbz	x0, Lsfh_no_actor
	ldr	x9, [x0, #160]
	adrp	x8, _silica_rt_fault_sbase@PAGE
	add	x8, x8, _silica_rt_fault_sbase@PAGEOFF
	str	x9, [x8]
	ldr	x9, [x0, #184]
	adrp	x8, _silica_rt_fault_ssize@PAGE
	add	x8, x8, _silica_rt_fault_ssize@PAGEOFF
	str	x9, [x8]
Lsfh_no_actor:
	adrp	x0, _silica_rt_sync_fault_handler@PAGE
	add	x0, x0, _silica_rt_sync_fault_handler@PAGEOFF
	adrp	x1, _silica_rt_fault_dlinfo@PAGE
	add	x1, x1, _silica_rt_fault_dlinfo@PAGEOFF
	bl	_dladdr
	adrp	x1, _silica_rt_fault_dlinfo@PAGE
	add	x1, x1, _silica_rt_fault_dlinfo@PAGEOFF
	ldr	x2, [x1, #8]
	adrp	x3, _silica_rt_own_image_base@PAGE
	add	x3, x3, _silica_rt_own_image_base@PAGEOFF
	str	x2, [x3]
; No diagnostic here: a fault inside a guarded FFI region is recovered just below and
; reported as an actor failure, so printing the site first would add a line that the
; caller never sees on a healthy recovery. The unrecoverable paths below still print it.
Lsfh_pc_done:
	mov	x0, x22
	mov	x1, x23
	bl	_silica_rt_ffi_guarded_fault_handler_try
	cbnz	w0, L_sfh_done
	cmp	w22, #11
	b.ne	L_sfh_crash
	mov	x19, x23
	ldr	x19, [x19, #24]
	bl	_silica_rt_tls_current_actor_get
	mov	x20, x0
	cbz	x20, L_sfh_crash
	ldr	x21, [x20, #160]
	cbz	x21, L_sfh_crash
	ldr	x22, [x20, #184]
	add	x22, x21, x22
	cmp	x19, x21
	b.lo	L_sfh_crash
	cmp	x19, x22
	b.hs	L_sfh_overflow
	bic	x0, x19, #0xfff
	mov	x1, #0x1000
	mov	w2, #3
	bl	_mprotect
	cmp	w0, #0
	b.ne	L_sfh_unrecoverable
	ldr	x8, [x20, #160]
	bic	x9, x19, #0xfff
	add	x9, x9, #0x1000
	sub	x9, x9, x8
	ldr	x10, [x20, #168]
	cmp	x9, x10
	b.ls	L_sfh_stack_done
	str	x9, [x20, #168]
L_sfh_stack_done:
	ldp	x29, x30, [sp, #48]
	ldp	x20, x19, [sp, #32]
	ldp	x22, x21, [sp, #16]
	ldp	x24, x23, [sp], #64
	ret
L_sfh_overflow:
	ldr	w9, [x20, #152]
	cbz	w9, L_sfh_crash
	str	wzr, [x20, #152]
	add	x0, x20, #80
	bl	_silica_rt_cv_signal
	ldp	x29, x30, [sp, #48]
	ldp	x20, x19, [sp, #32]
	ldp	x22, x21, [sp, #16]
	ldp	x24, x23, [sp], #64
	ret
L_sfh_unrecoverable:
; The host refused to commit memory for a growing actor stack. That is a runtime abort, not a
; fault (spec §15.4.10.2, §15.4.5.5): status 71, reported at the instruction that touched the stack.
	adrp	x0, Lrta_r_stack_commit@PAGE
	add	x0, x0, Lrta_r_stack_commit@PAGEOFF
	adrp	x1, _silica_rt_fault_pc@PAGE
	add	x1, x1, _silica_rt_fault_pc@PAGEOFF
	ldr	x1, [x1]
	b	_silica_rt_abort_with_pc
L_sfh_crash:
; Process-fatal: the report line, then C _exit (Darwin __exit; `_exit` in Darwin assembly is C exit(),
; which would run atexit handlers and flush stdio from inside the signal handler). Spec §15.4.5.5.
	bl	_silica_rt_print_fault_site
	mov	w0, #70
	bl	__exit
L_sfh_last_resort:
	mov	x0, x23
	mov	x1, x24
	b	_silica_rt_fault_last_resort
L_sfh_done:
	ldp	x29, x30, [sp, #48]
	ldp	x20, x19, [sp, #32]
	ldp	x22, x21, [sp, #16]
	ldp	x24, x23, [sp], #64
	ret
	.cfi_endproc
	.globl	_silica_rt_ffi_guarded_fault_handler_try
	.p2align	2
_silica_rt_ffi_guarded_fault_handler_try:
	.cfi_startproc
; X0=signum, X1=siginfo*
	stp	x21, x20, [sp, #-16]!
	stp	x19, x30, [sp, #-16]!
	mov	x21, x0
	mov	x19, x1
Lloh_gk0:
	adrp	x8, _silica_guarded_ffi_pthread_key@PAGE
Lloh_gk1:
	add	x8, x8, _silica_guarded_ffi_pthread_key@PAGEOFF
	ldr	x0, [x8]
// The key is zero until the first guarded region creates it. Reading a thread-specific
// value for key zero does NOT fail: on Darwin it returns a live pointer from a slot the C
// library reserves for itself. Without this check a fault raised before any guarded call
// took that pointer for the per-thread guarded state, wrote the fault record over the
// library's memory, and jumped through a sigjmp_buf made of unrelated bytes, which hung
// the process inside longjmp instead of reporting the fault and exiting.
	cbz	x0, L_gft_no
	bl	_pthread_getspecific
	cbz	x0, L_gft_no
	mov	x20, x0
	ldr	x9, [x20, #24]
	cbz	x9, L_gft_no
	sxtw	x9, w21
	str	x9, [x20, #32]
	ldr	x9, [x19, #24]
	str	x9, [x20, #40]
	ldr	w10, [x19, #8]
	sxtw	x10, w10
	str	x10, [x20, #48]
	mov	x10, xzr
	ldr	x11, [x20, #8]
	cbz	x11, L_gft_store_arena
	ldr	x12, [x11, #352]
	ldr	x13, [x11, #360]
	cbz	x12, L_gft_store_arena
	cmp	x9, x12
	b.lo	L_gft_store_arena
	cmp	x9, x13
	b.hs	L_gft_store_arena
	mov	x10, #1
L_gft_store_arena:
	str	x10, [x20, #56]
	adrp	x0, _silica_rt_fault_pc@PAGE
	add	x0, x0, _silica_rt_fault_pc@PAGEOFF
	ldr	x0, [x0]
	cbz	x0, Lgft_do_jmp
	adrp	x1, _silica_rt_fault_dlinfo@PAGE
	add	x1, x1, _silica_rt_fault_dlinfo@PAGEOFF
	stp	x19, x20, [sp, #-16]!
	bl	_dladdr
	ldp	x19, x20, [sp], #16
