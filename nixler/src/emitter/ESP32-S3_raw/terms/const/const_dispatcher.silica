// Const dispatcher: case sir_term_root_node(term).type_name -> type-specific emit
// String is handled in term_emitter (emit_string_const) - not dispatched here

use const_int64;
use const_uint64;
use const_float64;
use const_float32;
use const_float16;
use const_bool;
use const_atom;
use const_unit;
use const_default;
use module_linkage;
use var;
use xt_isa;

export emit_const/7;


// Local SIRTerm arena helpers (sir_ast node accessors are not exported).
fn sir_term_nodes_len(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)]) -> int64 {
    sequence proc[mem(normal)]
        result: int64 <- length[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)](nodes)
    produces
        pure result
    end
}

fn sir_term_node_at_from_head(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case nodes.is_nil of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> case idx <= 0 of {
            true -> nodes.head;
            false -> sir_term_node_at_from_head(nodes.tail, idx - 1)
        }
    }
}


fn sir_term_node_at(nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], idx: int64) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case idx < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> {
            n: int64 <- sir_term_nodes_len(nodes);
            case idx >= n of {
                true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
                false -> {
                    e: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- list_nth(nodes, n - 1 - idx);
                    { kind: e.kind, type_name: e.type_name, value: e.value, name: e.name, inner: e.inner, right_expr: e.right_expr }
                }
            }
        }
    }
}


fn sir_term_root_node(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } {
    case term.root < 0 of {
        true -> { kind: -1, type_name: "", value: "", name: "", inner: -1, right_expr: -1 };
        false -> sir_term_node_at(term.nodes, term.root)
    }
}

fn sir_term_at(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, idx: int64) -> { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } {
    { nodes: term.nodes, root: idx }
}

fn first_at_in_const_label(s: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "@" of {
            true -> i;
            false -> first_at_in_const_label(s, i + 1)
        }
    }
}

fn fn_ptr_link_label(label: string) -> string {
    at: int64 <- first_at_in_const_label(label, 0);
    case at < 0 of {
        true -> label;
        false -> substring(label, at + 1, length_bytes(label))
    }
}

fn emit_const(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, dest: string, table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, lexemes: List[string, mem(normal)] }, literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float64_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, float32_literal_table: { is_empty: boolean, index_map: { root: ref?(L, normal, (string, int64, int64, ref?(L, normal, rec), ref?(L, normal, rec))), compare_key: fn(string, string) -> :less | :equal | :greater, compare_value: fn(int64, int64) -> :less | :equal | :greater, region: region(L, normal), specialization_key: int64, compare_key_ordering_bundle: int64, compare_value_ordering_bundle: int64 }, values: List[string, mem(normal)] }, outer_reg: string) -> string {
    case sir_term_root_node(term).type_name of {
        "char" -> const_int64@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table, outer_reg);
        "int64" -> case length_bytes(dest) > 0 and substring(dest, 0, 1) == "S" of {
            true -> const_float32@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table, outer_reg);
            false -> case length_bytes(dest) > 0 and substring(dest, 0, 1) == "D" of {
                true -> const_float64@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table, outer_reg);
                false -> const_int64@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table, outer_reg)
            }
        };
        "uint64" -> const_uint64@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table, outer_reg);
        "float64" -> const_float64@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table, outer_reg);
        "float32" -> const_float32@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table, outer_reg);
        "float" -> const_float32@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table, outer_reg);
        "float16" -> const_float16@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table, outer_reg);
        "bool" -> const_bool@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table, outer_reg);
        "atom" -> const_atom@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table, outer_reg);
        "unit" -> const_unit@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table, outer_reg);
        "fn_ptr" -> {
            param_reg: string <- var@find_sp_binding_bare_or_percent_param(outer_reg, sir_term_root_node(term).value);
            case length_bytes(param_reg) > 0 and var@binding_is_physical_int_reg(param_reg) of {
                true -> var@emit_var_reg(term, dest, param_reg);
                false -> {
                    label: string <- module_linkage@asm_linkage_symbol_for_call(outer_reg, sir_term_root_node(term).value);
                    // ADRP/ADD only accept X/W general-purpose regs, never D/S — load address in X8 then copy to dest.
                    addr_reg: string <- case length_bytes(dest) > 0 and substring(dest, 0, 1) == "X" of {
                        true -> dest;
                        false -> "X8"
                    };
                    core: string <- xt_isa@xt_adr(addr_reg, label);
                    case dest == addr_reg of {
                        true -> core;
                        false -> concat(core, xt_isa@xt_mov(dest, addr_reg))
                    }
                }
            }
        };
        _: string -> case length_bytes(dest) > 0 of {
            true -> case substring(dest, 0, 1) == "S" of {
                true -> const_float32@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table, outer_reg);
                false -> case substring(dest, 0, 1) == "D" of {
                    true -> const_float64@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table, outer_reg);
                    false -> case substring(dest, 0, 1) == "H" of {
                        true -> const_float16@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table, outer_reg);
                        false -> const_default@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table, outer_reg)
                    }
                }
            };
            false -> const_default@emit_const(term, dest, table, literal_table, float64_literal_table, float32_literal_table, outer_reg)
        }
    }
}
