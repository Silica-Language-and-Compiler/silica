// Loads and stores over virtual registers (see xt_vr, xt_isa).
//
// Memory operands arrive in the AArch64 spelling the emitter already builds, and every form the Apple
// emitter produces is accepted (counted over the trial goldens):
//   [Xn]            [Xn, #imm]        [Xn, Xm]          [Xn, sym@PAGEOFF]   (ADRP already gave the full
//   [Xn, Xm, LSL #k]  (index scaled by 2^k)
//   [SP, #imm]!     [SP], #imm        [Xn], #imm        [Xn, #imm]!          address, so the offset is 0)
// Bases:
//   X29  -> the frame: [X29, #-N] is a1 + SFP - N, accessed through the XL*/XS* macros the module
//           prelude defines, because SFP is only known after the body (range chosen by the assembler)
//   SP   -> the auxiliary data stack: its pointer is the word at THREADPTR + 112 (xt_vr vr_vsp_off), one
//           per core; pre-/post-index update that word
//   other X VRs -> the VR's low word
// Width comes from the register: X/D 8 bytes (two words), W/S 4, H 2; the byte/half helpers are separate.
//
// Scratch use: a9 = address, a2/a3 = data words, a8 = second address operand. put_result from xt_isa is
// not reused so a store of the data words cannot clobber the address register.

use string_parse;
use xt_vr;

export xt_ldr/2;
export xt_str/2;
export xt_ldrb/2;
export xt_ldrsb/2;
export xt_ldrh/2;
export xt_ldrsh/2;
export xt_ldrsw/2;
export xt_strb/2;
export xt_strh/2;
export xt_ldp/3;
export xt_stp/3;
export xt_frame_off/1;

fn op3m(op: string, d: string, a: string, b: string) -> string {
    xt_vr@xt_ins(op, concat(d, concat(", ", concat(a, concat(", ", b)))))
}

fn find_char(s: string, c: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> 0 - 1;
        false -> case substring(s, i, i + 1) == c of {
            true -> i;
            false -> find_char(s, c, i + 1)
        }
    }
}

fn trim_spaces(s: string) -> string {
    n: int64 <- length_bytes(s);
    case n > 0 and substring(s, 0, 1) == " " of {
        true -> trim_spaces(substring(s, 1, n));
        false -> case n > 0 and substring(s, n - 1, n) == " " of {
            true -> trim_spaces(substring(s, 0, n - 1));
            false -> s
        }
    }
}

fn contains_at(s: string, pat: string, i: int64) -> boolean {
    case i + length_bytes(pat) > length_bytes(s) of {
        true -> false;
        false -> case substring(s, i, i + length_bytes(pat)) == pat of {
            true -> true;
            false -> contains_at(s, pat, i + 1)
        }
    }
}

// --- operand parsing -------------------------------------------------------------------------

fn mem_inner(m: string) -> string {
    e: int64 <- find_char(m, "]", 0);
    case e < 0 of {
        true -> "";
        false -> substring(m, 1, e)
    }
}

fn mem_after(m: string) -> string {
    e: int64 <- find_char(m, "]", 0);
    case e < 0 of {
        true -> "";
        false -> trim_spaces(substring(m, e + 1, length_bytes(m)))
    }
}

fn mem_base(m: string) -> string {
    inner: string <- mem_inner(m);
    c: int64 <- find_char(inner, ",", 0);
    case c < 0 of {
        true -> trim_spaces(inner);
        false -> trim_spaces(substring(inner, 0, c))
    }
}

fn mem_second(m: string) -> string {
    inner: string <- mem_inner(m);
    c: int64 <- find_char(inner, ",", 0);
    case c < 0 of {
        true -> "";
        false -> trim_spaces(substring(inner, c + 1, length_bytes(inner)))
    }
}

fn imm_of(t: string) -> int64 {
    u: string <- substring(t, 1, length_bytes(t));
    case length_bytes(u) > 1 and substring(u, 0, 1) == "-" of {
        true -> 0 - string_parse@string_to_int64(substring(u, 1, length_bytes(u)));
        false -> string_parse@string_to_int64(u)
    }
}

// Offset applied to the access itself (0 for post-index and for register/symbol offsets).
fn mem_disp(m: string) -> int64 {
    sec: string <- mem_second(m);
    case length_bytes(sec) > 0 and substring(sec, 0, 1) == "#" of {
        true -> imm_of(sec);
        false -> 0
    }
}

fn mem_is_pre(m: string) -> boolean {
    mem_after(m) == "!"
}

fn mem_post(m: string) -> int64 {
    a: string <- mem_after(m);
    case length_bytes(a) > 2 and substring(a, 0, 1) == "," of {
        true -> imm_of(trim_spaces(substring(a, 1, length_bytes(a))));
        false -> 0
    }
}

// [Xn, Xm] or [Xn, Xm, LSL #k]: the index register, and the scale applied to it.
fn mem_index_reg(m: string) -> string {
    sec: string <- mem_second(m);
    c: int64 <- find_char(sec, ",", 0);
    reg: string <- case c < 0 of {
        true -> sec;
        false -> trim_spaces(substring(sec, 0, c))
    };
    case length_bytes(reg) > 0 and xt_vr@vr_is_int(reg) of {
        true -> reg;
        false -> ""
    }
}

fn mem_index_shift(m: string) -> int64 {
    sec: string <- mem_second(m);
    c: int64 <- find_char(sec, ",", 0);
    case c < 0 of {
        true -> 0;
        false -> {
            rest: string <- trim_spaces(substring(sec, c + 1, length_bytes(sec)));
            h: int64 <- find_char(rest, "#", 0);
            case h < 0 of {
                true -> 0;
                false -> string_parse@string_to_int64(trim_spaces(substring(rest, h + 1, length_bytes(rest))))
            }
        }
    }
}

// --- address formation -----------------------------------------------------------------------

// Frame offset expression for [X29, #off] (off is normally negative).
fn xt_frame_off(off: int64) -> string {
    case off < 0 of {
        true -> concat("SFP-", xt_vr@xt_itos(0 - off));
        false -> case off == 0 of {
            true -> "SFP";
            false -> concat("SFP+", xt_vr@xt_itos(off))
        }
    }
}

// Fits the displacement field of an access of `size` bytes.
fn disp_fits(off: int64, size: int64) -> boolean {
    case size of {
        1 -> off >= 0 and off <= 255;
        2 -> off >= 0 and off <= 510 and off % 2 == 0;
        _: int64 -> off >= 0 and off <= 1020 - (size - 4) and off % 4 == 0
    }
}

fn add_imm_into(dst: string, src: string, k: int64) -> string {
    case k == 0 of {
        true -> case dst == src of {
            true -> "";
            false -> xt_vr@xt_ins("mov", concat(dst, concat(", ", src)))
        };
        false -> case k >= 0 - 128 and k <= 127 of {
            true -> op3m("addi", dst, src, xt_vr@xt_itos(k));
            false -> case dst == src of {
                true -> concat(xt_vr@xt_ins("movi", concat("a8, ", xt_vr@xt_itos(k))), op3m("add", dst, dst, "a8"));
                false -> concat(xt_vr@xt_ins("movi", concat(dst, concat(", ", xt_vr@xt_itos(k)))), op3m("add", dst, dst, src))
            }
        }
    }
}

// Code that leaves the base value of a non-frame operand in a register; returns it via base_reg().
fn base_load(base: string) -> string {
    xt_vr@vr_lo_load(base, "a9")
}

fn base_reg(base: string) -> string {
    xt_vr@vr_lo_reg(base, "a9")
}

// SP pre-/post-index: the core's auxiliary stack pointer += off (xt_vr vsp_adjust: the move, then
// the chunk check that grows a reservation or pops a release).
fn vsp_adjust(off: int64) -> string {
    xt_vr@vsp_adjust(off)
}

// Base writeback for a non-SP base (pre- or post-index).
fn base_writeback(base: string, off: int64) -> string {
    case off == 0 of {
        true -> "";
        false -> {
            // The access is done, so a9 is free; a8 stays free for add_imm_into's large-offset temp.
            r: string <- xt_vr@vr_lo_reg(base, "a9");
            concat(concat(xt_vr@vr_lo_load(base, "a9"), add_imm_into("a9", r, off)), xt_vr@vr_put_lo(base, "a9"))
        }
    }
}

// Emit `code(reg, disp)` against the operand: builds the address (a9) and a displacement that fits.
// Returns prefix code; the access line(s) are produced by the caller from addr_reg / addr_disp below.
fn addr_setup(m: string, size: int64) -> string {
    base: string <- mem_base(m);
    idx: string <- mem_index_reg(m);
    disp: int64 <- mem_disp(m);
    pre_sp: string <- case base == "SP" and mem_is_pre(m) of {
        true -> vsp_adjust(disp);
        false -> ""
    };
    case length_bytes(idx) > 0 of {
        true -> {
            sh: int64 <- mem_index_shift(m);
            scaled: string <- case sh == 0 of {
                true -> "";
                false -> op3m("slli", "a8", xt_vr@vr_lo_reg(idx, "a8"), xt_vr@xt_itos(sh))
            };
            ireg: string <- case sh == 0 of {
                true -> xt_vr@vr_lo_reg(idx, "a8");
                false -> "a8"
            };
            concat(concat(concat(base_load(base), xt_vr@vr_lo_load(idx, "a8")), scaled), op3m("add", "a9", base_reg(base), ireg))
        };
        false -> {
            eff: int64 <- case base == "SP" and mem_is_pre(m) of { true -> 0; false -> disp };
            load: string <- base_load(base);
            case disp_fits(eff, size) of {
                true -> concat(pre_sp, load);
                false -> concat(pre_sp, concat(load, add_imm_into("a9", base_reg(base), eff)))
            }
        }
    }
}

fn addr_reg(m: string, size: int64) -> string {
    base: string <- mem_base(m);
    idx: string <- mem_index_reg(m);
    disp: int64 <- mem_disp(m);
    eff: int64 <- case base == "SP" and mem_is_pre(m) of { true -> 0; false -> disp };
    case length_bytes(idx) > 0 of {
        true -> "a9";
        false -> case disp_fits(eff, size) of {
            true -> base_reg(base);
            false -> "a9"
        }
    }
}

fn addr_disp(m: string, size: int64) -> int64 {
    base: string <- mem_base(m);
    idx: string <- mem_index_reg(m);
    disp: int64 <- mem_disp(m);
    eff: int64 <- case base == "SP" and mem_is_pre(m) of { true -> 0; false -> disp };
    case length_bytes(idx) > 0 of {
        true -> 0;
        false -> case disp_fits(eff, size) of {
            true -> eff;
            false -> 0
        }
    }
}

// Post-index / non-SP pre-index writeback after the access.
fn addr_finish(m: string) -> string {
    base: string <- mem_base(m);
    post: int64 <- mem_post(m);
    case base == "SP" of {
        true -> vsp_adjust(post);
        false -> case mem_is_pre(m) of {
            true -> base_writeback(base, mem_disp(m));
            false -> base_writeback(base, post)
        }
    }
}

fn is_frame(m: string) -> boolean {
    mem_base(m) == "X29"
}

// --- word access primitives ------------------------------------------------------------------

// One 32/16/8-bit load or store at operand m plus extra byte offset `plus`.
// Frame operands go through the prelude macros (XL32 r, off / XS32 r, off, tmp ...).
fn access(op: string, macro_ld: string, macro_st: string, is_store: boolean, r: string, m: string, size: int64, plus: int64) -> string {
    case is_frame(m) of {
        true -> {
            off: string <- xt_frame_off(mem_disp(m) + plus);
            case is_store of {
                true -> xt_vr@xt_ins(macro_st, concat(r, concat(", ", concat(off, ", a9"))));
                false -> xt_vr@xt_ins(macro_ld, concat(r, concat(", ", off)))
            }
        };
        false -> op3m(op, r, addr_reg(m, size), xt_vr@xt_itos(addr_disp(m, size) + plus))
    }
}

fn setup_unless_frame(m: string, size: int64) -> string {
    case is_frame(m) of {
        true -> "";
        false -> addr_setup(m, size)
    }
}

fn finish_unless_frame(m: string) -> string {
    case is_frame(m) of {
        true -> "";
        false -> addr_finish(m)
    }
}

// --- loads -----------------------------------------------------------------------------------

fn width_of(r: string) -> int64 {
    c: string <- xt_vr@vr_class(r);
    case c == "X" or c == "D" of {
        true -> 8;
        false -> case c == "H" of {
            true -> 2;
            false -> 4
        }
    }
}

fn store_words(dst: string, lo: string, hi: string) -> string {
    xt_vr@vr_put(dst, lo, hi)
}

fn xt_ldr(dst: string, m: string) -> string {
    size: int64 <- width_of(dst);
    setup: string <- setup_unless_frame(m, size);
    body: string <- case size of {
        8 -> concat(access("l32i", "XL32", "XS32", false, "a2", m, 8, 0), access("l32i", "XL32", "XS32", false, "a3", m, 8, 4));
        2 -> access("l16ui", "XL16U", "XS16", false, "a2", m, 2, 0);
        _: int64 -> access("l32i", "XL32", "XS32", false, "a2", m, 4, 0)
    };
    concat(concat(setup, body), concat(finish_unless_frame(m), store_words(dst, "a2", "a3")))
}

fn xt_ldrb(dst: string, m: string) -> string {
    concat(concat(setup_unless_frame(m, 1), access("l8ui", "XL8U", "XS8", false, "a2", m, 1, 0)), concat(finish_unless_frame(m), store_words(dst, "a2", "a3")))
}

fn xt_ldrh(dst: string, m: string) -> string {
    concat(concat(setup_unless_frame(m, 2), access("l16ui", "XL16U", "XS16", false, "a2", m, 2, 0)), concat(finish_unless_frame(m), store_words(dst, "a2", "a3")))
}

// Sign-extending loads: into a W destination the value is sign-extended to 32 bits (high word 0);
// into an X destination to 64 bits.
fn sext_to_dst(dst: string, bits: int64) -> string {
    ext: string <- case bits == 32 of {
        true -> "";
        false -> op3m("sext", "a2", "a2", xt_vr@xt_itos(bits - 1))
    };
    case xt_vr@vr_class(dst) == "W" of {
        true -> concat(ext, store_words(dst, "a2", "a3"));
        false -> concat(concat(ext, op3m("srai", "a3", "a2", "31")), store_words(dst, "a2", "a3"))
    }
}

fn xt_ldrsb(dst: string, m: string) -> string {
    concat(concat(setup_unless_frame(m, 1), access("l8ui", "XL8U", "XS8", false, "a2", m, 1, 0)), concat(finish_unless_frame(m), sext_to_dst(dst, 8)))
}

fn xt_ldrsh(dst: string, m: string) -> string {
    concat(concat(setup_unless_frame(m, 2), access("l16si", "XL16S", "XS16", false, "a2", m, 2, 0)), concat(finish_unless_frame(m), sext_to_dst(dst, 32)))
}

fn xt_ldrsw(dst: string, m: string) -> string {
    concat(concat(setup_unless_frame(m, 4), access("l32i", "XL32", "XS32", false, "a2", m, 4, 0)), concat(finish_unless_frame(m), sext_to_dst(dst, 32)))
}

// --- stores ----------------------------------------------------------------------------------

fn xt_str(src: string, m: string) -> string {
    size: int64 <- width_of(src);
    load: string <- concat(xt_vr@vr_lo_load(src, "a2"), case size == 8 of { true -> xt_vr@vr_hi_load(src, "a3"); false -> "" });
    lo: string <- xt_vr@vr_lo_reg(src, "a2");
    hi: string <- xt_vr@vr_hi_reg(src, "a3");
    setup: string <- setup_unless_frame(m, size);
    body: string <- case size of {
        8 -> concat(access("s32i", "XL32", "XS32", true, lo, m, 8, 0), access("s32i", "XL32", "XS32", true, hi, m, 8, 4));
        2 -> access("s16i", "XL16U", "XS16", true, lo, m, 2, 0);
        _: int64 -> access("s32i", "XL32", "XS32", true, lo, m, 4, 0)
    };
    concat(concat(load, setup), concat(body, finish_unless_frame(m)))
}

fn xt_strb(src: string, m: string) -> string {
    concat(concat(xt_vr@vr_lo_load(src, "a2"), setup_unless_frame(m, 1)), concat(access("s8i", "XL8U", "XS8", true, xt_vr@vr_lo_reg(src, "a2"), m, 1, 0), finish_unless_frame(m)))
}

fn xt_strh(src: string, m: string) -> string {
    concat(concat(xt_vr@vr_lo_load(src, "a2"), setup_unless_frame(m, 2)), concat(access("s16i", "XL16U", "XS16", true, xt_vr@vr_lo_reg(src, "a2"), m, 2, 0), finish_unless_frame(m)))
}

// --- pairs -----------------------------------------------------------------------------------
//
// LDP/STP are two accesses at disp and disp + width. The SP push/pop forms keep their meaning: the
// pre-index adjustment happens once before both accesses, the post-index one after both.

fn pair_mem(m: string, extra: int64) -> string {
    base: string <- mem_base(m);
    d: int64 <- case base == "SP" and mem_is_pre(m) of { true -> 0; false -> mem_disp(m) };
    concat("[", concat(base, concat(", #", concat(xt_vr@xt_itos(d + extra), "]"))))
}

fn pair_pre(m: string) -> string {
    base: string <- mem_base(m);
    case mem_is_pre(m) of {
        true -> case base == "SP" of {
            true -> vsp_adjust(mem_disp(m));
            false -> ""
        };
        false -> ""
    }
}

fn pair_post(m: string) -> string {
    base: string <- mem_base(m);
    case base == "SP" of {
        true -> vsp_adjust(mem_post(m));
        false -> case mem_is_pre(m) of {
            true -> base_writeback(base, mem_disp(m));
            false -> base_writeback(base, mem_post(m))
        }
    }
}

fn xt_ldp(r1: string, r2: string, m: string) -> string {
    w: int64 <- width_of(r1);
    concat(concat(pair_pre(m), concat(xt_ldr(r1, pair_mem(m, 0)), xt_ldr(r2, pair_mem(m, w)))), pair_post(m))
}

fn xt_stp(r1: string, r2: string, m: string) -> string {
    w: int64 <- width_of(r1);
    concat(concat(pair_pre(m), concat(xt_str(r1, pair_mem(m, 0)), xt_str(r2, pair_mem(m, w)))), pair_post(m))
}
