// Boolean logical prim emission: and, or
// Operands in r9, r10 (X9/X10 or W9/W10) to avoid clobbering params. reg_prefix: "X" or "W".

use sir_ast;

export emit_and_op/2;
export emit_or_op/2;

fn emit_and_op(dest: string, reg_prefix: string) -> string {
    r1: string <- concat(reg_prefix, "9");
    r2: string <- concat(reg_prefix, "10");
    op_part: string <- concat(concat(concat("    AND ", dest), ", "), concat(r1, ", "));
    and_line: string <- concat(op_part, r2);
    cmp_line: string <- concat(concat("    CMP ", dest), ", #0\n");
    cset_line: string <- concat(concat("    CSET ", dest), ", NE\n");
    concat(concat(and_line, "\n"), concat(cmp_line, cset_line))
}

fn emit_or_op(dest: string, reg_prefix: string) -> string {
    r1: string <- concat(reg_prefix, "9");
    r2: string <- concat(reg_prefix, "10");
    op_part: string <- concat(concat(concat("    ORR ", dest), ", "), concat(r1, ", "));
    orr_line: string <- concat(op_part, r2);
    cmp_line: string <- concat(concat("    CMP ", dest), ", #0\n");
    cset_line: string <- concat(concat("    CSET ", dest), ", NE\n");
    concat(concat(orr_line, "\n"), concat(cmp_line, cset_line))
}
