// String length helpers: byte length and UTF-8 scalar count. Pure AArch64 (same normalize as io.rs).
// Char count: for valid UTF-8, equals Rust str::chars().count() (non-continuation bytes).
// X0 = string pointer; returns length in X0.

export emit_length_bytes_helper/0;
export emit_length_chars_helper/0;

fn emit_length_bytes_helper() -> string {
    "L_length_bytes_helper:\n    STP X29, X30, [SP, #-16]!\n    STP X19, X20, [SP, #-16]!\n    STP X21, X22, [SP, #-16]!\n    MOV X19, X0\n    CBZ X19, Llb_z\n    LDR X1, [X19]\n    MVN X2, X1\n    CMP X2, #1\n    B.HI Llb_bad\n    LDR X0, [X19, #16]\n    LDP X21, X22, [SP], #16\n    LDP X19, X20, [SP], #16\n    LDP X29, X30, [SP], #16\n    RET\nLlb_z:\n    MOV X0, #0\n    LDP X21, X22, [SP], #16\n    LDP X19, X20, [SP], #16\n    LDP X29, X30, [SP], #16\n    RET\nLlb_bad:\n    BRK #1\n"
}

fn emit_length_chars_helper() -> string {
    "L_length_chars_helper:\n    STP X29, X30, [SP, #-16]!\n    STP X19, X20, [SP, #-16]!\n    STP X21, X22, [SP, #-16]!\n    MOV X19, X0\n    CBZ X19, Lch_z\n    LDR X1, [X19]\n    MVN X2, X1\n    CMP X2, #1\n    B.HI Lch_bad\n    LDR X20, [X19, #8]\n    LDR X21, [X19, #16]\n    MOV X0, #0\n    MOV X9, #0\nLch_lp:\n    CMP X9, X21\n    B.HS Lch_done\n    LDRB W10, [X20, X9]\n    ADD X0, X0, #1\n    CMP W10, #0x80\n    B.LO Lch_a1\n    AND W11, W10, #0xE0\n    CMP W11, #0xC0\n    B.EQ Lch_a2\n    AND W11, W10, #0xF0\n    CMP W11, #0xE0\n    B.EQ Lch_a3\n    AND W11, W10, #0xF8\n    CMP W11, #0xF0\n    B.EQ Lch_a4\nLch_a1:\n    ADD X9, X9, #1\n    B Lch_lp\nLch_a2:\n    ADD X9, X9, #2\n    B Lch_lp\nLch_a3:\n    ADD X9, X9, #3\n    B Lch_lp\nLch_a4:\n    ADD X9, X9, #4\n    B Lch_lp\nLch_done:\n    LDP X21, X22, [SP], #16\n    LDP X19, X20, [SP], #16\n    LDP X29, X30, [SP], #16\n    RET\nLch_z:\n    MOV X0, #0\n    LDP X21, X22, [SP], #16\n    LDP X19, X20, [SP], #16\n    LDP X29, X30, [SP], #16\n    RET\nLch_bad:\n    BRK #1\n"
}
