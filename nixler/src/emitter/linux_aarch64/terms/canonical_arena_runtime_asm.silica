// Application-lifetime canonical arena registry for standard data structures (Layer 1 §7.1).
// One bump arena per stable int64 specialization key; arenas are never freed before process exit.
// Arena layout matches prims_memory alloc_region: [0:8]=bump, [8:16]=end, [16:24]=extension chain
// (empty here; L_region_grow fills it if one of these arenas ever fills up), [24:32]=own data end,
// data from offset 32.
//
// The table is process-shared and read from every thread (design region_memory_safety_design.md
// §9.4, H1). A probe reads each key with an acquire load; an insert happens under
// silica_rt_region_lock (the word L_region_grow also takes), which stores the arena pointer first
// and the key last with a release store, so a probe that sees the key sees the arena. A thread
// that found an empty slot takes the lock and probes again from the start: another insert of the
// same key may have landed in between, and the table changes only under the lock.

export emit_canonical_arena_runtime_asm/0;

fn emit_canonical_arena_runtime_asm() -> string {
    "
	.bss
	.p2align	3
	.globl	silica_rt_canonical_arena_table
silica_rt_canonical_arena_table:
	.space	8192
	.globl	silica_rt_canonical_arena_count
silica_rt_canonical_arena_count:
	.space	8
	.globl	silica_rt_region_lock
silica_rt_region_lock:
	.space	8
	.text
	.globl	silica_rt_canonical_arena_lookup
	.p2align	2
silica_rt_canonical_arena_lookup:
	.cfi_startproc
// X0 = stable specialization key (non-zero) -> X0 = region base pointer
// X22 = 1 once this call holds silica_rt_region_lock.
	stp	x21, x20, [sp, #-48]!
	stp	x19, x30, [sp, #16]
	str	x22, [sp, #32]
	.cfi_offset w30, -24
	.cfi_offset w19, -32
	.cfi_offset w20, -40
	.cfi_offset w21, -48
	mov	x19, x0
	cbz	x19, Lcal_abort_key
	mov	w20, #512
	mov	x22, xzr
Lcal_restart:
	mov	w9, w20
	udiv	w10, w19, w9
	msub	w8, w10, w9, w19
	mov	w21, wzr
Lcal_probe:
	cmp	w21, w20
	b.hs	Lcal_abort_full
	ubfiz	x11, x8, #4, #32
	adrp	x12, silica_rt_canonical_arena_table
	add	x12, x12, :lo12:silica_rt_canonical_arena_table
	add	x12, x12, x11
	ldar	x13, [x12]
	cbz	x13, Lcal_empty
	cmp	x13, x19
	b.eq	Lcal_found
	add	w8, w8, #1
	cmp	w8, w20
	csel	w8, wzr, w8, eq
	add	w21, w21, #1
	b	Lcal_probe
Lcal_found:
	ldr	x0, [x12, #8]
	cbz	x22, Lcal_return
	adrp	x9, silica_rt_region_lock
	add	x9, x9, :lo12:silica_rt_region_lock
	stlr	wzr, [x9]
Lcal_return:
	ldr	x22, [sp, #32]
	ldp	x19, x30, [sp, #16]
	ldp	x21, x20, [sp], #48
	ret
Lcal_empty:
	cbnz	x22, Lcal_insert
	adrp	x9, silica_rt_region_lock
	add	x9, x9, :lo12:silica_rt_region_lock
	mov	w11, #1
Lcal_lock:
	ldaxr	w10, [x9]
	cbnz	w10, Lcal_lock
	stxr	w13, w11, [x9]
	cbnz	w13, Lcal_lock
	mov	x22, #1
	b	Lcal_restart
Lcal_insert:
	mov	x21, x12
	mov	x0, #4128
	bl	malloc
	mov	x12, x21
	cbz	x0, Lcal_abort_nomem
	add	x14, x0, #32
	str	x14, [x0]
	mov	x15, #4128
	add	x14, x0, x15
	str	x14, [x0, #8]
	str	xzr, [x0, #16]
	str	x14, [x0, #24]
	str	x0, [x12, #8]
	stlr	x19, [x12]
	adrp	x13, silica_rt_canonical_arena_count
	add	x13, x13, :lo12:silica_rt_canonical_arena_count
	ldr	x14, [x13]
	add	x14, x14, #1
	str	x14, [x13]
	adrp	x9, silica_rt_region_lock
	add	x9, x9, :lo12:silica_rt_region_lock
	stlr	wzr, [x9]
	ldr	x22, [sp, #32]
	ldp	x19, x30, [sp, #16]
	ldp	x21, x20, [sp], #48
	ret
Lcal_abort_key:
	bl	silica_rt_abort_arena_key
Lcal_abort_full:
	bl	silica_rt_abort_arena_full
Lcal_abort_nomem:
	bl	silica_rt_abort_arena_nomem
	.cfi_endproc
	.globl	silica_rt_canonical_arena_same
	.p2align	2
silica_rt_canonical_arena_same:
	.cfi_startproc
// X0 = region A, X1 = region B -> X0 = 1 if same identity else 0
	cmp	x0, x1
	cset	w0, eq
	and	x0, x0, #1
	ret
	.cfi_endproc
"
}
