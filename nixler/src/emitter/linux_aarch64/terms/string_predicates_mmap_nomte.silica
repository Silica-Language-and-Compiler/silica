// String predicate helpers: starts_with / ends_with / contains.
// Resolve SilicaString (tag -1) or C-string the same way as L_string_eq_helper.
// X0 = haystack, X1 = needle; W0 = 0/1. Spec §5.3.3.

export emit_string_starts_with_helper/0;
export emit_string_ends_with_helper/0;
export emit_string_contains_helper/0;

fn emit_string_starts_with_helper() -> string {
    "L_string_starts_with_helper:\n    STP X29, X30, [SP, #-16]!\n    STP X19, X20, [SP, #-16]!\n    STP X21, X22, [SP, #-16]!\n    STP X23, X24, [SP, #-16]!\n    STP X25, X26, [SP, #-16]!\n    STP X27, X28, [SP, #-16]!\n    MOV X19, X0\n    MOV X20, X1\n    CBZ X19, Lsw_false\n    CBZ X20, Lsw_false\n    LDR X1, [X19]\n    MVN X2, X1\n    CMP X2, #1\n    B.HI Lsw_bad\n    LDR X21, [X19, #8]\n    LDR X22, [X19, #16]\n    LDR X1, [X20]\n    MVN X2, X1\n    CMP X2, #1\n    B.HI Lsw_bad\n    LDR X23, [X20, #8]\n    LDR X24, [X20, #16]\nLsw_n2_done:\n    CBZ X24, Lsw_true\n    CMP X24, X22\n    B.HI Lsw_false\n    MOV X25, X21\n    MOV X26, X23\n    MOV X27, X24\nLsw_cloop:\n    LDRB W28, [X25], #1\n    LDRB W0, [X26], #1\n    CMP W28, W0\n    B.NE Lsw_false\n    SUBS X27, X27, #1\n    B.NE Lsw_cloop\nLsw_true:\n    MOV W0, #1\n    B Lsw_exit\nLsw_false:\n    MOV W0, #0\nLsw_exit:\n    LDP X27, X28, [SP], #16\n    LDP X25, X26, [SP], #16\n    LDP X23, X24, [SP], #16\n    LDP X21, X22, [SP], #16\n    LDP X19, X20, [SP], #16\n    LDP X29, X30, [SP], #16\n    RET\n\nLsw_bad:\n    BRK #1\n"
}

fn emit_string_ends_with_helper() -> string {
    "L_string_ends_with_helper:\n    STP X29, X30, [SP, #-16]!\n    STP X19, X20, [SP, #-16]!\n    STP X21, X22, [SP, #-16]!\n    STP X23, X24, [SP, #-16]!\n    STP X25, X26, [SP, #-16]!\n    STP X27, X28, [SP, #-16]!\n    MOV X19, X0\n    MOV X20, X1\n    CBZ X19, Lew_false\n    CBZ X20, Lew_false\n    LDR X1, [X19]\n    MVN X2, X1\n    CMP X2, #1\n    B.HI Lew_bad\n    LDR X21, [X19, #8]\n    LDR X22, [X19, #16]\n    LDR X1, [X20]\n    MVN X2, X1\n    CMP X2, #1\n    B.HI Lew_bad\n    LDR X23, [X20, #8]\n    LDR X24, [X20, #16]\nLew_n2_done:\n    CBZ X24, Lew_true\n    CMP X24, X22\n    B.HI Lew_false\n    SUB X25, X22, X24\n    ADD X25, X21, X25\n    MOV X26, X23\n    MOV X27, X24\nLew_cloop:\n    LDRB W28, [X25], #1\n    LDRB W0, [X26], #1\n    CMP W28, W0\n    B.NE Lew_false\n    SUBS X27, X27, #1\n    B.NE Lew_cloop\nLew_true:\n    MOV W0, #1\n    B Lew_exit\nLew_false:\n    MOV W0, #0\nLew_exit:\n    LDP X27, X28, [SP], #16\n    LDP X25, X26, [SP], #16\n    LDP X23, X24, [SP], #16\n    LDP X21, X22, [SP], #16\n    LDP X19, X20, [SP], #16\n    LDP X29, X30, [SP], #16\n    RET\n\nLew_bad:\n    BRK #1\n"
}

fn emit_string_contains_helper() -> string {
    "L_string_contains_helper:\n    STP X29, X30, [SP, #-16]!\n    STP X19, X20, [SP, #-16]!\n    STP X21, X22, [SP, #-16]!\n    STP X23, X24, [SP, #-16]!\n    STP X25, X26, [SP, #-16]!\n    STP X27, X28, [SP, #-16]!\n    MOV X19, X0\n    MOV X20, X1\n    CBZ X19, Lsc_false\n    CBZ X20, Lsc_false\n    LDR X1, [X19]\n    MVN X2, X1\n    CMP X2, #1\n    B.HI Lsc_bad\n    LDR X21, [X19, #8]\n    LDR X22, [X19, #16]\n    LDR X1, [X20]\n    MVN X2, X1\n    CMP X2, #1\n    B.HI Lsc_bad\n    LDR X23, [X20, #8]\n    LDR X24, [X20, #16]\nLsc_n2_done:\n    CBZ X24, Lsc_true\n    CMP X24, X22\n    B.HI Lsc_false\n    SUB X25, X22, X24\n    ADD X25, X25, #1\n    MOV X26, X21\nLsc_outer:\n    MOV X27, X26\n    MOV X28, X23\n    MOV X0, X24\nLsc_inner:\n    LDRB W1, [X27], #1\n    LDRB W2, [X28], #1\n    CMP W1, W2\n    B.NE Lsc_next\n    SUBS X0, X0, #1\n    B.NE Lsc_inner\n    B Lsc_true\nLsc_next:\n    ADD X26, X26, #1\n    SUBS X25, X25, #1\n    B.NE Lsc_outer\n    B Lsc_false\nLsc_true:\n    MOV W0, #1\n    B Lsc_exit\nLsc_false:\n    MOV W0, #0\nLsc_exit:\n    LDP X27, X28, [SP], #16\n    LDP X25, X26, [SP], #16\n    LDP X23, X24, [SP], #16\n    LDP X21, X22, [SP], #16\n    LDP X19, X20, [SP], #16\n    LDP X29, X30, [SP], #16\n    RET\n\nLsc_bad:\n    BRK #1\n"
}
