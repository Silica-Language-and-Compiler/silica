            true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "sub" of {
                true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).inner)).kind == 1
                    and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).right_expr)).kind == 1
                    and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).inner)).name == term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).right_expr)).name;
                false -> false
            };
            false -> false
        }
    };
    use_two_arg_gpr_reorder_add_second_first: boolean <- length_bytes(st.rest_asm) > 0
        and two_arg_tail_rest
        and arg2_term_ok
        and (add_second_before_sub or mul_second_before_sub);
    // str_len_acc/count_a_acc/sum_digits_acc: arg1=substring sets MOV X1,#start clobbering acc(X1) before arg2 can use it.
    // Fix: emit arg2 (st.rest_asm) first to compute acc result into X1, save X1, emit substring arg1, restore X1.
    use_arg2_first_around_substring_arg1: boolean <- length_bytes(st.rest_asm) > 0
        and two_arg_tail_rest
        and arg1_is_substring
        and st.arg1_reg == "X0"
        and st.arg2_reg == "X1";
    arg2_binding_for_reorder: string <- case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).name == "user_call_rest" of {
        true -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).inner)).kind == 1 of {
            true -> var@find_sp_binding_bare_or_percent_param(bound.outer_reg, term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).inner)).name);
            false -> ""
        };
        false -> case term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).kind == 1 of {
            true -> var@find_sp_binding_bare_or_percent_param(bound.outer_reg, term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr)).name);
            false -> ""
        }
    };
    arg2_bound_in_x0_or_w0: boolean <- arg2_binding_for_reorder == "X0" or arg2_binding_for_reorder == "W0";
    use_arg2_save_around_arg1_x0: boolean <- length_bytes(st.rest_asm) > 0
        and two_arg_tail_rest
        and st.arg1_reg == "X0"
        and arg2_term_ok
        and arg2_bound_in_x0_or_w0;
    dealloc_bytes_call: int64 <- st.sret_stack_bytes
        + case st.save_indirect_callee_around_args of { true -> 16; false -> 0 };
    dealloc_asm_call: string <- case dealloc_bytes_call > 0 of {
        true -> concat("\n    ADD SP, SP, #", concat(term_call_helpers@dec_str(dealloc_bytes_call), ""));
        false -> ""
    };
    fuel: string <- case call_opts.use_tail of {
        true -> term_call_helpers@emit_fuel_backedge_stub_comment();
        false -> ""
    };
    before_call: string <- case length_bytes(call_opts.line_before_call_asm) > 0 of {
        true -> concat(call_opts.line_before_call_asm, "\n");
        false -> ""
    };
    // Tail BR never returns, so the save-slot ADD must run before LDP/BR.
    call_and_dealloc: string <- case call_opts.use_tail of {
        true -> concat(dealloc_asm_call, st.call_asm);
        false -> concat(st.call_asm, dealloc_asm_call)
    };
    call_prefix: string <- concat(fuel, concat(st.sret_setup, st.callee_prep));
    call_suffix: string <- concat(concat(st.callee_reload_after_args, before_call), call_and_dealloc);
    case st.use_simple_gpr_parallel_stage of {
        true -> emit_parallel_call_piece(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr), bound, pools, emit_child, call_prefix, call_suffix);
        false -> join_sequential_user_call(call_prefix, st.arg1_asm, st.rest_asm, call_suffix, st.a1ty, { reorder: use_two_arg_gpr_reorder, rem_first: use_two_arg_gpr_reorder_rem_first, add_second_first: use_two_arg_gpr_reorder_add_second_first, arg2_first_substring: use_arg2_first_around_substring_arg1, arg2_save_x0: use_arg2_save_around_arg1_x0 })
    }
}
