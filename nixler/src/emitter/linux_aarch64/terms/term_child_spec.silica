// Supervisor child_spec / trampoline helpers for record emission.

use prims_record;
use term_sir_helpers;
use var;
use atom_table;
use instantiated_fn_name;

export is_child_spec_record_type/1;
export is_supervisor_reply_record_type/1;
export emit_child_spec_hidden_trampoline_store/3;
export child_spec_field_abi_offset/1;

fn first_at_in_fn_label(s: string, i: int64) -> int64 {
    case i >= length_bytes(s) of {
        true -> -1;
        false -> case substring(s, i, i + 1) == "@" of {
            true -> i;
            false -> first_at_in_fn_label(s, i + 1)
        }
    }
}

fn child_spec_supervisor_trampoline_symbol_from_label(label: string) -> string {
    clean_label: string <- case length_bytes(label) > 0 and substring(label, 0, 1) == "%" of {
        true -> substring(label, 1, length_bytes(label));
        false -> label
    };
    at: int64 <- first_at_in_fn_label(clean_label, 0);
    case at < 0 of {
        true -> {
            suffix: string <- "_child_start";
            suffix_len: int64 <- length_bytes(suffix);
            label_len: int64 <- length_bytes(clean_label);
            case label_len > suffix_len and substring(clean_label, label_len - suffix_len, label_len) == suffix of {
                true -> concat("silica_supervisor_start_", substring(clean_label, 0, label_len - suffix_len));
                false -> ""
            }
        };
        false -> concat("silica_supervisor_start_", substring(clean_label, 0, at))
    }
}

fn child_spec_fn_label_from_term(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    case term_sir_helpers@sir_term_root_node(term).kind == 0 and term_sir_helpers@sir_term_root_node(term).type_name == "fn_ptr" of {
        true -> term_sir_helpers@sir_term_root_node(term).value;
        false -> case term_sir_helpers@sir_term_root_node(term).kind == 1 of {
            true -> term_sir_helpers@sir_term_root_node(term).name;
            false -> ""
        }
    }
}

fn child_spec_start_fn_label(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_make" of {
        false -> "";
        true -> case term_sir_helpers@sir_term_root_node(term).value == "start" and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 6 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).name == "tuple_make" of {
            true -> {
                e1w: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- term_sir_helpers@sir_term_at(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner), term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).right_expr);
                e1: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 } <- case term_sir_helpers@sir_term_root_node(e1w).kind == 6 and term_sir_helpers@sir_term_root_node(e1w).name == "tuple_make" of {
                    true -> term_sir_helpers@sir_term_at(e1w, term_sir_helpers@sir_term_root_node(e1w).inner);
                    false -> e1w
                };
                child_spec_fn_label_from_term(e1)
            };
            false -> case term_sir_helpers@sir_term_root_node(term).value == "behavior" of {
                true -> {
                    label: string <- child_spec_fn_label_from_term(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                    case length_bytes(label) > 0 of {
                        true -> label;
                        false -> child_spec_start_fn_label(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr))
                    }
                };
                false -> child_spec_start_fn_label(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr))
            }
        }
    }
}

// Same spelling as module_linkage@supervisor_fn_trampoline_symbol (file-local in the defining unit).
fn supervisor_fn_trampoline_symbol(fn_label: string) -> string {
    concat("silica_supervisor_start_fn_", instantiated_fn_name@link_name_to_asm_symbol(fn_label))
}

// The start function is an unqualified function constant (SIR kind 0, fn_ptr) without an
// `@`, i.e. a function of this unit, and not a `T_child_start` export.
fn child_spec_start_is_local_fn_ptr(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> boolean {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_make" of {
        false -> false;
        true -> case term_sir_helpers@sir_term_root_node(term).value == "behavior" of {
            true -> {
                v: { kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 } <- term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner));
                v.kind == 0 and v.type_name == "fn_ptr" and length_bytes(v.value) > 0 and first_at_in_fn_label(v.value, 0) < 0
            };
            false -> child_spec_start_is_local_fn_ptr(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr))
        }
    }
}

fn child_spec_agent_type_atom(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }) -> string {
    case term_sir_helpers@sir_term_root_node(term).kind == 6 and term_sir_helpers@sir_term_root_node(term).name == "record_make" of {
        false -> "";
        true -> case term_sir_helpers@sir_term_root_node(term).value == "agent_type" and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).kind == 0 and term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).type_name == "atom" of {
            true -> term_sir_helpers@sir_term_root_node(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).inner)).value;
            false -> child_spec_agent_type_atom(term_sir_helpers@sir_term_at(term, term_sir_helpers@sir_term_root_node(term).right_expr))
        }
    }
}

fn is_child_spec_record_type(R: string) -> boolean {
    length_bytes(prims_record@find_field_type_in_record(R, "id")) > 0
        and length_bytes(prims_record@find_field_type_in_record(R, "agent_type")) > 0
        and (length_bytes(prims_record@find_field_type_in_record(R, "start")) > 0
            or (length_bytes(prims_record@find_field_type_in_record(R, "initial_state")) > 0
                and length_bytes(prims_record@find_field_type_in_record(R, "behavior")) > 0))
        and length_bytes(prims_record@find_field_type_in_record(R, "restart")) > 0
        and length_bytes(prims_record@find_field_type_in_record(R, "shutdown")) > 0
}

fn is_supervisor_reply_record_type(R: string) -> boolean {
    length_bytes(prims_record@find_field_type_in_record(R, "tag")) > 0
        and length_bytes(prims_record@find_field_type_in_record(R, "child")) > 0
        and length_bytes(prims_record@find_field_type_in_record(R, "status")) > 0
        and length_bytes(prims_record@find_field_type_in_record(R, "children")) > 0
        and length_bytes(prims_record@find_field_type_in_record(R, "count")) > 0
        and length_bytes(prims_record@find_field_type_in_record(R, "child_info")) > 0
        and length_bytes(prims_record@find_field_type_in_record(R, "error")) > 0
}

// The child_spec hidden trampoline field sits at offset 64 of the record (after the shape
// word and the seven field slots). That record lives in a fixed-frame region, so a hardcoded
// "[SP, #64]" would write into whatever happened to be at SP -- nested :supervisor children
// lost their trampoline symbol and failed to start. Addressing is inlined here rather
// than reusing term_aggregate_helpers, which imports this module (cycle).
fn hidden_field_store(store_base: string, reg: string) -> string {
    case length_bytes(store_base) > 1 and substring(store_base, 0, 1) == "*" of {
        // A dynamic-part record (chunk 15 phase 2, term_aggregate_helpers@agg_indirect_base): the slot
        // holds the block's address.
        true -> {
            sfb: int64 <- var@parse_x29_neg_offset_bytes(substring(store_base, 1, length_bytes(store_base)));
            ld: string <- case sfb <= 255 of {
                true -> concat("    LDR X16, [X29, #-", concat(atom_table@int64_to_decimal_string(sfb), "]\n"));
                false -> case sfb > 4095 of {
                    true -> concat(var@mov_imm_wide("X16", sfb), "    SUB X16, X29, X16\n    LDR X16, [X16]\n");
                    false -> concat("    SUB X16, X29, #", concat(atom_table@int64_to_decimal_string(sfb), "\n    LDR X16, [X16]\n"))
                }
            };
            concat(ld, concat("    STR ", concat(reg, ", [X16, #64]")))
        };
        false -> hidden_field_store_frame(store_base, reg)
    }
}

fn hidden_field_store_frame(store_base: string, reg: string) -> string {
    fb: int64 <- var@parse_x29_neg_offset_bytes(store_base);
    case fb > 0 of {
        true -> {
            d: int64 <- fb - 64;
            case d <= 255 and d >= 0 of {
                true -> concat("    STR ", concat(reg, concat(", [X29, #-", concat(atom_table@int64_to_decimal_string(d), "]"))));
                false -> {
                    setup: string <- case fb > 4095 of {
                        true -> concat(var@mov_imm_wide("X16", fb), "    SUB X16, X29, X16\n");
                        false -> concat("    SUB X16, X29, #", concat(atom_table@int64_to_decimal_string(fb), "\n"))
                    };
                    concat(setup, concat("    STR ", concat(reg, ", [X16, #64]")))
                }
            }
        };
        false -> concat("    STR ", concat(reg, ", [SP, #64]"))
    }
}

fn emit_child_spec_hidden_trampoline_store(term: { nodes: List[{ kind: int64, type_name: string, value: string, name: string, inner: int64, right_expr: int64 }, mem(normal)], root: int64 }, R: string, store_base: string) -> string {
    case is_child_spec_record_type(R) of {
        false -> "";
        true -> {
            // Agent role is explicit in child_spec.agent_type (:worker | :supervisor).
            // Do not infer role from child record shape or behavior naming.
            agent_atom: string <- child_spec_agent_type_atom(term);
            case agent_atom == ":supervisor" of {
                false -> hidden_field_store(store_base, "XZR");
                true -> {
                    label: string <- child_spec_start_fn_label(term);
                    impl_sym: string <- child_spec_supervisor_trampoline_symbol_from_label(label);
                    // A same-unit start function (`behavior: inner_start`) has no impl trampoline;
                    // module_linkage@emit_supervisor_fn_trampolines defines one for it.
                    sym: string <- case length_bytes(impl_sym) == 0 and child_spec_start_is_local_fn_ptr(term) of {
                        true -> supervisor_fn_trampoline_symbol(label);
                        false -> impl_sym
                    };
                    case length_bytes(sym) == 0 of {
                        true -> hidden_field_store(store_base, "XZR");
                        false -> concat(concat(concat(concat(concat("    ADRP X9, ", sym), "\n    ADD X9, X9, :lo12:"), sym), "\n"), hidden_field_store(store_base, "X9"))
                    }
                }
            }
        }
    }
}

// The child-spec ABI the actor runtime reads (shape word at 0): id@8, agent_type@16,
// initial_state / start.0@24, behavior / start.1@32, restart@40, shutdown@48, flavor@56,
// hidden supervisor trampoline@64.
fn child_spec_field_abi_offset(fname: string) -> int64 {
    case fname == "id" of {
        true -> 8;
        false -> case fname == "agent_type" of {
            true -> 16;
            false -> case fname == "initial_state" of {
                true -> 24;
                false -> case fname == "behavior" of {
                    true -> 32;
                    false -> case fname == "start" of {
                        true -> 24;
                        false -> case fname == "restart" of {
                            true -> 40;
                            false -> case fname == "shutdown" of {
                                true -> 48;
                                false -> case fname == "flavor" of {
                                    true -> 56;
                                    false -> -1
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

