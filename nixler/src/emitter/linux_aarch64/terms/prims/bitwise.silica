// uint64 bitwise prim emission: bor, band, bnot, shl, shr
// Operands use r9/r10 (X9/X10). bnot uses only r9.

export emit_bor_op/2;
export emit_band_op/2;
export emit_bnot_op/2;
export emit_shl_op/2;
export emit_shr_op/2;

fn op_reg(prefix: string, n: string) -> string {
    concat(prefix, n)
}

fn emit_binary_bitwise_op(op: string, dest: string, reg_prefix: string) -> string {
    r1: string <- op_reg(reg_prefix, "9");
    r2: string <- op_reg(reg_prefix, "10");
    concat(concat(concat(concat(concat("    ", op), concat(" ", dest)), ", "), r1), concat(", ", r2))
}

fn emit_bor_op(dest: string, reg_prefix: string) -> string {
    emit_binary_bitwise_op("ORR", dest, reg_prefix)
}

fn emit_band_op(dest: string, reg_prefix: string) -> string {
    emit_binary_bitwise_op("AND", dest, reg_prefix)
}

fn emit_bnot_op(dest: string, reg_prefix: string) -> string {
    r1: string <- op_reg(reg_prefix, "9");
    concat(concat(concat("    MVN ", dest), ", "), r1)
}

fn emit_shl_op(dest: string, reg_prefix: string) -> string {
    emit_binary_bitwise_op("LSL", dest, reg_prefix)
}

fn emit_shr_op(dest: string, reg_prefix: string) -> string {
    emit_binary_bitwise_op("LSR", dest, reg_prefix)
}
