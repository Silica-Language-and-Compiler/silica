// Integer literal parsing for Silica lexer
// Supports decimal, hexadecimal (0x...), and binary (0b...) integer literals

// Import token kind enum
use lexer_token_kind;

// Import lexer core types
use lexer_core;

// Export helper functions
export is_decimal_digit_char/1;
export is_hex_digit_char/1;
export read_decimal_digits_only/2;
export read_integer_literal/1;


{-
- Returns true if the character is a decimal digit ('0' through '9'), and false otherwise.
- Used by the integer-literal lexer to recognize decimal digits when scanning integer literals (e.g. "42" or the decimal part of "0x12" after the "x"). Fits into the design as the predicate that gates consumption of decimal digit characters.
- Example: is_decimal_digit('0') and is_decimal_digit('9') return true; digits are accepted in decimal integer literals.
- Example: is_decimal_digit('5') returns true; the middle digit of "255" is accepted.
- Example: is_decimal_digit('a') and is_decimal_digit('x') return false; non-digit characters end or are not part of the decimal digit run.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single case match over one character; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn is_decimal_digit(c: char) -> boolean {
    case c of {
        '0' -> true;
        '1' -> true;
        '2' -> true;
        '3' -> true;
        '4' -> true;
        '5' -> true;
        '6' -> true;
        '7' -> true;
        '8' -> true;
        '9' -> true;
        _: char -> false
    }
}


{-
- Returns true if the character is a hexadecimal digit ('0'–'9', 'a'–'f', or 'A'–'F'), and false otherwise.
- Used by the integer-literal lexer when scanning hex literals (e.g. "0x1a" or "0xFF") to decide which characters belong to the literal. Fits into the design as the predicate for consuming hex digits after the "0x" prefix.
- Example: is_hex_digit('a') and is_hex_digit('F') return true; lowercase and uppercase hex digits are accepted in 0x... literals.
- Example: is_hex_digit('9') returns true; decimal digits are valid in hex (e.g. "0x90").
- Example: is_hex_digit('g') and is_hex_digit('z') return false; characters outside 0-9 and A-F/a-f end the hex run.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single case match over one character; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn is_hex_digit(c: char) -> boolean {
    case c of {
        '0' -> true;
        '1' -> true;
        '2' -> true;
        '3' -> true;
        '4' -> true;
        '5' -> true;
        '6' -> true;
        '7' -> true;
        '8' -> true;
        '9' -> true;
        'a' -> true;
        'b' -> true;
        'c' -> true;
        'd' -> true;
        'e' -> true;
        'f' -> true;
        'A' -> true;
        'B' -> true;
        'C' -> true;
        'D' -> true;
        'E' -> true;
        'F' -> true;
        _: char -> false
    }
}


{-
- Returns true if the character is a binary digit ('0' or '1'), and false otherwise.
- Used by the integer-literal lexer when scanning binary literals (e.g. "0b1010") to decide which characters belong to the literal. Fits into the design as the predicate for consuming binary digits after the "0b" prefix.
- Example: is_binary_digit('0') and is_binary_digit('1') return true; both are valid in 0b... literals.
- Example: is_binary_digit('1') returns true; the lexer accepts '1' when reading the bits of "0b111".
- Example: is_binary_digit('2') and is_binary_digit('a') return false; only '0' and '1' are allowed in binary literals.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single case match over one character; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn is_binary_digit(c: char) -> boolean {
    case c of {
        '0' -> true;
        '1' -> true;
        _: char -> false
    }
}


{-
- Returns true if the string is a single decimal digit character ("0" through "9"), and false otherwise.
- Used when the lexer works with string results from peek_char (which returns a single-character string): is_decimal_digit_char(peek_char(lexer)) determines whether the current character can be part of a decimal integer literal. Bridges the char-based is_decimal_digit to the lexer’s string-based API.
- Example: is_decimal_digit_char("0") and is_decimal_digit_char("9") return true; the lexer can consume these when scanning decimal literals like "42".
- Example: is_decimal_digit_char("5") returns true; the middle digit of "255" is accepted.
- Example: is_decimal_digit_char("a") and is_decimal_digit_char("") return false; non-digits and empty string are not decimal digits.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single case match over the string; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn is_decimal_digit_char(s: string) -> boolean {
    case s of {
        "0" -> true;
        "1" -> true;
        "2" -> true;
        "3" -> true;
        "4" -> true;
        "5" -> true;
        "6" -> true;
        "7" -> true;
        "8" -> true;
        "9" -> true;
        _: string -> false
    }
}


{-
- Returns true if the string is a single hexadecimal digit character ("0"–"9", "a"–"f", or "A"–"F"), and false otherwise.
- Used when the lexer works with string results from peek_char: is_hex_digit_char(peek_char(lexer)) determines whether the current character can be part of a hex integer literal (e.g. after "0x"). Bridges the char-based is_hex_digit to the lexer’s string-based API.
- Example: is_hex_digit_char("a") and is_hex_digit_char("F") return true; the lexer can consume these when scanning "0x1a" or "0xFF".
- Example: is_hex_digit_char("9") returns true; decimal digits are valid in hex literals.
- Example: is_hex_digit_char("g") and is_hex_digit_char("") return false; non-hex characters and empty string are not accepted.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single case match over the string; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn is_hex_digit_char(s: string) -> boolean {
    case s of {
        "0" -> true;
        "1" -> true;
        "2" -> true;
        "3" -> true;
        "4" -> true;
        "5" -> true;
        "6" -> true;
        "7" -> true;
        "8" -> true;
        "9" -> true;
        "a" -> true;
        "b" -> true;
        "c" -> true;
        "d" -> true;
        "e" -> true;
        "f" -> true;
        "A" -> true;
        "B" -> true;
        "C" -> true;
        "D" -> true;
        "E" -> true;
        "F" -> true;
        _: string -> false
    }
}


{-
- Returns true if the string is a single binary digit character ("0" or "1"), and false otherwise.
- Used when the lexer works with string results from peek_char: is_binary_digit_char(peek_char(lexer)) determines whether the current character can be part of a binary integer literal (e.g. after "0b"). Bridges the char-based is_binary_digit to the lexer’s string-based API.
- Example: is_binary_digit_char("0") and is_binary_digit_char("1") return true; the lexer can consume these when scanning "0b1010".
- Example: is_binary_digit_char("1") returns true; the lexer accepts "1" when reading the bits of "0b111".
- Example: is_binary_digit_char("2") and is_binary_digit_char("") return false; only "0" and "1" are allowed in binary literals.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single case match over the string; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn is_binary_digit_char(s: string) -> boolean {
    case s of {
        "0" -> true;
        "1" -> true;
        _: string -> false
    }
}


{-
- Consumes zero or more hexadecimal digits from the lexer, appends them to the given lexeme, and returns an integer_literal token (with the accumulated lexeme and start_location) and the lexer at the first non-hex character or EOF.
- Used by read_hex_literal after "0x": pass the lexer past "0x", start_location at the start of "0x...", and lexeme "0x"; read_hex_digits consumes hex digits and returns the complete token and updated lexer. Stops at EOF or the first non-hex character.
- Example: lexer at "1a" with start_location and lexeme "0x" — consumes "1" then "a", returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "0x1a" at start_location, lexer past "a").
- Example: lexer at EOF with lexeme "0x" — returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "0x" at start_location, lexer unchanged); the literal has no digits after the prefix.
- Example: lexer at "1g" with lexeme "0x" — consumes "1", then "g" is non-hex so returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "0x1" at start_location, lexer at "g").
- Time: O(k), Ω(1), Θ(k) where k is the number of hex digits consumed. Space: O(k), Ω(1), Θ(k) for recursion depth and accumulated lexeme (concat in each step).
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn read_hex_digits(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, start_location: { file: string, line: int64, column: int64, offset: int64 }, lexeme: string) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
        next: string <- lexer_core@peek_char(lexer);
    case next of {
        "" -> (lexer_core@make_token(lexer_token_kind@token_kind_integer_literal(), lexeme, start_location), lexer);
        _: string -> case is_hex_digit_char(next) of {
            true -> {
                updated_lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(lexer);
                updated_lexeme: string <- concat(lexeme, next);
                read_hex_digits(updated_lexer, start_location, updated_lexeme)
            };
            false -> (lexer_core@make_token(lexer_token_kind@token_kind_integer_literal(), lexeme, start_location), lexer)
        }
    }
}


{-
- Parses a hexadecimal integer literal starting with "0x": advances past the "0" and "x", then reads zero or more hex digits via read_hex_digits, and returns the integer_literal token and updated lexer.
- Called when the lexer has already seen "0x" (peek_char "0" and peek_next_char "x"); start_location should be the position of the "0". The "0x" prefix is included in the token lexeme; read_hex_digits appends any following hex digits.
- Example: lexer at "0" of "0x1a" with start_location at that "0" — advances past "0" and "x", then read_hex_digits consumes "1" and "a"; result is ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "0x1a", lexer past "a").
- Example: lexer at "0" of "0xFF" — after advancing past "0x", read_hex_digits consumes "F","F"; result is ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "0xFF", lexer past the second "F").
- Example: lexer at "0" of "0x" with nothing after — advances past "0x", read_hex_digits sees EOF and returns token "0x"; result is ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "0x", lexer at EOF).
- Time: O(k), Ω(1), Θ(k) where k is the number of hex digits after "0x". Space: O(k), Ω(1), Θ(k) for read_hex_digits recursion and lexeme.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn read_hex_literal(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, start_location: { file: string, line: int64, column: int64, offset: int64 }) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
    // Advance past '0'
    after_zero: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(lexer);
    // Advance past 'x'
    after_x: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(after_zero);
    updated_lexeme: string <- "0x";
    
    // Recursively read hex digits
    read_hex_digits(after_x, start_location, updated_lexeme)
}


{-
- Consumes zero or more binary digits ("0" or "1") from the lexer, appends them to the given lexeme, and returns an integer_literal token (with the accumulated lexeme and start_location) and the lexer at the first non-binary character or EOF.
- Used by read_binary_literal after "0b": pass the lexer past "0b", start_location at the start of "0b...", and lexeme "0b"; read_binary_digits consumes binary digits and returns the complete token and updated lexer. Stops at EOF or the first character that is not "0" or "1".
- Example: lexer at "10" with start_location and lexeme "0b" — consumes "1" then "0", returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "0b10" at start_location, lexer past "0").
- Example: lexer at EOF with lexeme "0b" — returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "0b" at start_location, lexer unchanged); the literal has no digits after the prefix.
- Example: lexer at "12" with lexeme "0b" — consumes "1", then "2" is not a binary digit so returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "0b1" at start_location, lexer at "2").
- Time: O(k), Ω(1), Θ(k) where k is the number of binary digits consumed. Space: O(k), Ω(1), Θ(k) for recursion depth and accumulated lexeme (concat in each step).
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn read_binary_digits(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, start_location: { file: string, line: int64, column: int64, offset: int64 }, lexeme: string) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
        next: string <- lexer_core@peek_char(lexer);
    case next of {
        "" -> (lexer_core@make_token(lexer_token_kind@token_kind_integer_literal(), lexeme, start_location), lexer);
        _: string -> case is_binary_digit_char(next) of {
            true -> {
                updated_lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(lexer);
                updated_lexeme: string <- concat(lexeme, next);
                read_binary_digits(updated_lexer, start_location, updated_lexeme)
            };
            false -> (lexer_core@make_token(lexer_token_kind@token_kind_integer_literal(), lexeme, start_location), lexer)
        }
    }
}


{-
- Parses a binary integer literal starting with "0b": advances past the "0" and "b", then reads zero or more binary digits via read_binary_digits, and returns the integer_literal token and updated lexer.
- Called when the lexer has already seen "0b" (peek_char "0" and peek_next_char "b"); start_location should be the position of the "0". The "0b" prefix is included in the token lexeme; read_binary_digits appends any following "0" or "1" characters.
- Example: lexer at "0" of "0b1010" with start_location at that "0" — advances past "0" and "b", then read_binary_digits consumes "1","0","1","0"; result is ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "0b1010", lexer past the last "0").
- Example: lexer at "0" of "0b1" — after advancing past "0b", read_binary_digits consumes "1"; result is ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "0b1", lexer past "1").
- Example: lexer at "0" of "0b" with nothing after — advances past "0b", read_binary_digits sees EOF and returns token "0b"; result is ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "0b", lexer at EOF).
- Time: O(k), Ω(1), Θ(k) where k is the number of binary digits after "0b". Space: O(k), Ω(1), Θ(k) for read_binary_digits recursion and lexeme.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn read_binary_literal(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, start_location: { file: string, line: int64, column: int64, offset: int64 }) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
    // Advance past '0'
    after_zero: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(lexer);
    // Advance past 'b'
    after_b: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(after_zero);
    updated_lexeme: string <- "0b";
    
    // Recursively read binary digits
    read_binary_digits(after_b, start_location, updated_lexeme)
}


{-
- Consumes zero or more decimal digits from the lexer, appends them to the given lexeme (or uses the first digit as the start when lexeme is ""), and returns an integer_literal token and the lexer at the first non-digit or EOF; if no digits were accumulated and a non-digit or EOF is seen, returns a token with lexeme "0".
- Used for decimal integer literals (no "0x" or "0b" prefix): the caller may pass lexeme "" so the first digit becomes the start of the lexeme. When the run of digits ends (non-digit or EOF), the accumulated lexeme is used for the token; when lexeme is still "" at that point, the token is given lexeme "0" so a valid integer literal is always produced.
- Example: lexer at "42" with start_location and lexeme "" — consumes "4" then "2", returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "42" at start_location, lexer past "2").
- Example: lexer at EOF with lexeme "" — returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "0" at start_location, lexer unchanged); no digits seen so token is "0".
- Example: lexer at "3x" with lexeme "" — consumes "3", then "x" is non-digit so returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "3" at start_location, lexer at "x").
- Time: O(k), Ω(1), Θ(k) where k is the number of decimal digits consumed. Space: O(k), Ω(1), Θ(k) for recursion depth and accumulated lexeme.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn read_decimal_digits(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, start_location: { file: string, line: int64, column: int64, offset: int64 }, lexeme: string) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
        next: string <- lexer_core@peek_char(lexer);
    case next of {
        "" -> (lexer_core@make_token(lexer_token_kind@token_kind_integer_literal(), lexeme, start_location), lexer);
        _: string -> case is_decimal_digit_char(next) of {
            true -> {
                updated_lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(lexer);
                updated_lexeme: string <- case lexeme of {
                    "" -> next;
                    _: string -> concat(lexeme, next)
                };
                read_decimal_digits(updated_lexer, start_location, updated_lexeme)
            };
            false -> case lexeme of {
                "" -> (lexer_core@make_token(lexer_token_kind@token_kind_integer_literal(), "0", start_location), lexer);
                _: string -> (lexer_core@make_token(lexer_token_kind@token_kind_integer_literal(), lexeme, start_location), lexer)
            }
        }
    }
}


{-
- Consumes zero or more decimal digits from the lexer, appends them to the given lexeme, and returns the accumulated lexeme and the lexer at the first non-digit or EOF. Does not emit a token. Used by lexer_float_literals to read the integer part of a float literal before checking for "." and fractional part.
- Reuses the same digit-consumption logic as read_decimal_digits but returns (lexeme, lexer) without building a token. When lexeme is "" and no digits are consumed, returns ("", lexer).
- Example: lexer at "42" with lexeme "" — consumes "4" then "2", returns ("42", lexer past "2").
- Example: lexer at "3.14" with lexeme "" — consumes "3", then "." is non-digit so returns ("3", lexer at ".").
- Time: O(k), Ω(1), Θ(k) where k is the number of decimal digits consumed. Space: O(k), Ω(1), Θ(k) for recursion depth and accumulated lexeme.
- Last-date-modified: 2025-02-24
-}
fn read_decimal_digits_only(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, lexeme: string) -> (string, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
    next: string <- lexer_core@peek_char(lexer);
    case next of {
        "" -> (lexeme, lexer);
        _: string -> case is_decimal_digit_char(next) of {
            true -> {
                updated_lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(lexer);
                updated_lexeme: string <- case lexeme of {
                    "" -> next;
                    _: string -> concat(lexeme, next)
                };
                read_decimal_digits_only(updated_lexer, updated_lexeme)
            };
            false -> (lexeme, lexer)
        }
    }
}


{-
- Reads one integer literal from the current lexer position and returns the integer_literal token and the updated lexer; supports decimal, hex (0x...), and binary (0b...) by dispatching to read_hex_literal, read_binary_literal, or read_decimal_digits.
- Entry point for integer literal tokenization: the lexer calls this when it has determined the next token is an integer (e.g. current character is a digit or "0"). Does not parse the numeric value; the token’s lexeme is the raw source text. Fits into the design as the single function the lexer uses to consume an integer literal.
- Example: lexer at "42" — first_char "4", so read_decimal_digits(lexer, start_location, "") is called; result is ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "42", lexer past "2").
- Example: lexer at "0xFF" — first_char "0", second_char "x", so read_hex_literal is called; result is ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "0xFF", lexer past "F").
- Example: lexer at "0b10" — first_char "0", second_char "b", so read_binary_literal is called; result is ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "0b10", lexer past "0").
- Time: O(k), Ω(1), Θ(k) where k is the length of the literal in characters. Space: O(k), Ω(1), Θ(k) for the dispatched reader’s recursion and lexeme.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn read_integer_literal(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
    start_location: { file: string, line: int64, column: int64, offset: int64 } <- lexer_core@current_location(lexer);
    _: int64 <- lexer.position;
    
    // Check if starts with '0x' for hex or '0b' for binary
    first_char: string <- lexer_core@peek_char(lexer);
    second_char: string <- lexer_core@peek_next_char(lexer);
    
    case first_char of {
        "0" -> case second_char of {
            "x" -> read_hex_literal(lexer, start_location);
            "b" -> read_binary_literal(lexer, start_location);
            _: string -> read_decimal_digits(lexer, start_location, "")
        };
        _: string -> read_decimal_digits(lexer, start_location, "")
    }
}






