// Shared float literal parsing for Silica lexer (float32 and float64)
// Supports decimal_float (digit+ "." digit+) and scientific_float (decimal_float ("e"|"E") ["+"|"-"] digit+)
// Reuses is_decimal_digit_char and read_decimal_digits_only from lexer_integer_literals (int64/uint64 digit logic)

// Import token kind
use lexer_token_kind;

// Import lexer core types
use lexer_core;

// Import integer literal helpers (reuse int64/uint64 digit logic)
use lexer_integer_literals;
use lexer_keywords;

// Export entry points
export read_numeric_literal/1;
export read_negative_numeric_literal/2;


{-
- Reads one numeric literal (integer or float) from the current lexer position. Dispatches to integer literal parsing for 0x/0b (hex/binary) or when no decimal point is found; otherwise parses as float literal per grammar: decimal_float | scientific_float. Shared by float32 and float64.
- Reuses lexer_integer_literals@read_integer_literal for hex/binary and read_decimal_digits_only for digit consumption (same logic as int64/uint64 integer literals).
- Example: lexer at "42" — returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "42", lexer past "2").
- Example: lexer at "3.14" — returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } float_literal "3.14", lexer past "4").
- Example: lexer at "1.0e10" — returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } float_literal "1.0e10", lexer past "0").
- Time: O(k), Ω(1), Θ(k). Space: O(k), Ω(1), Θ(k).
- Last-date-modified: 2025-02-27
-}
fn read_numeric_literal_raw(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
    start_location: { file: string, line: int64, column: int64, offset: int64 } <- lexer_core@current_location(lexer);
        first_char: string <- lexer_core@peek_char(lexer);
    second_char: string <- lexer_core@peek_next_char(lexer);
    case first_char of {
        "0" -> case second_char of {
            "x" -> lexer_integer_literals@read_integer_literal(lexer);
            "b" -> lexer_integer_literals@read_integer_literal(lexer);
            _: string -> try_read_float_or_integer(lexer, start_location)
        };
        _: string -> try_read_float_or_integer(lexer, start_location)
    }
}

{-
- Reads a negative numeric literal. Call when lexer is positioned after "-" (e.g. at "1.414" or "0x80").
- Consumes the following numeric literal through read_numeric_literal (decimal, float, hexadecimal or binary) and prepends "-" to the lexeme, so every radix a positive literal may use is also a negative literal.
- Example: lexer at "1.414" (after "-" consumed) — returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } float_literal "-1.414", lexer past "4").
- Example: lexer at "0x80" (after "-" consumed) — returns ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } integer_literal "-0x80", lexer past "0").
- Last-date-modified: 2026-10-02
-}
fn read_negative_numeric_literal(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, start_location: { file: string, line: int64, column: int64, offset: int64 }) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
        (t: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, next_lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) <- read_numeric_literal(lexer);
    t_lexeme: string <- lexer_core@token_lexeme(t);
    neg_lexeme: string <- concat("-", t_lexeme);
    neg_token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- lexer_core@make_token(lexer_core@token_get_kind(t), neg_lexeme, start_location);
    case lexer_core@token_get_kind(t) == lexer_token_kind@token_kind_lexical_error() of {
        true -> (t, next_lexer);
        false -> (neg_token, next_lexer)
    }
}

{-
- Attempts to read a float literal (digit+ "." digit+ [exponent]); if the pattern does not match, emits an integer literal.
- Last-date-modified: 2025-02-27
-}
fn try_read_float_or_integer(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, start_location: { file: string, line: int64, column: int64, offset: int64 }) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
    sequence
        (int_part: string, after_int: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) <- lexer_integer_literals@read_decimal_digits_only(lexer, "");
        next: string <- lexer_core@peek_char(after_int);
        next_next: string <- lexer_core@peek_next_char(after_int);
        is_float_start: boolean <- next == "." and lexer_integer_literals@is_decimal_digit_char(next_next);
        result: ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) <- case is_float_start of {
            true -> {
                (with_frac: string, after_frac: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) <- read_float_fractional_part(after_int, int_part);
                (final_lexeme: string, after_exp: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) <- read_float_exponent_part(after_frac, with_frac);
                token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- lexer_core@make_token(lexer_token_kind@token_kind_float_literal(), final_lexeme, start_location);
                (token, after_exp)
            };
            false -> {
                lexeme: string <- case int_part of {
                    "" -> "0";
                    _: string -> int_part
                };
                token: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- lexer_core@make_token(lexer_token_kind@token_kind_integer_literal(), lexeme, start_location);
                (token, after_int)
            }
        }
    produces
        pure result
    end
}


{-
- Reads the fractional part of a float literal: consumes ".", then one or more decimal digits, appending to the lexeme.
- Grammar: "." digit+
- Example: lexer at ".14" with lexeme "3" — consumes ".", "1", "4"; returns ("3.14", lexer past "4").
- Time: O(k), Ω(1), Θ(k). Space: O(k), Ω(1), Θ(k).
- Last-date-modified: 2025-02-27
-}
fn read_float_fractional_part(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, lexeme: string) -> (string, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
    // Advance past '.'
    after_dot: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(lexer);
    lexeme_with_dot: string <- concat(lexeme, ".");
    (frac_lexeme: string, after_frac: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) <- lexer_integer_literals@read_decimal_digits_only(after_dot, "");
    case frac_lexeme of {
        "" -> (lexeme_with_dot, after_dot);
        _: string -> (concat(lexeme_with_dot, frac_lexeme), after_frac)
    }
}


{-
- Reads the optional exponent part of a float literal: ("e"|"E") ["+"|"-"] digit+
- If current char is not 'e' or 'E', returns (lexeme, lexer) unchanged.
- Example: lexer at "e10" with lexeme "1.0" — consumes "e","1","0"; returns ("1.0e10", lexer past "0").
- Example: lexer at "E-3" with lexeme "2.5" — consumes "E","-","3"; returns ("2.5E-3", lexer past "3").
- Time: O(k), Ω(1), Θ(k). Space: O(k), Ω(1), Θ(k).
- Last-date-modified: 2025-02-27
-}
fn read_float_exponent_part(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, lexeme: string) -> (string, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
    next: string <- lexer_core@peek_char(lexer);
    case next of {
        "e" -> read_float_exponent_digits(lexer, lexeme);
        "E" -> read_float_exponent_digits(lexer, lexeme);
        _: string -> (lexeme, lexer)
    }
}


{-
- Consumes "e" or "E", optional "+" or "-", then digit+; appends to lexeme.
- Last-date-modified: 2025-02-27
-}
fn read_float_exponent_digits(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, lexeme: string) -> (string, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
    consumed: string <- lexer_core@peek_char(lexer);
    after_e: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(lexer);
    lexeme_with_e: string <- concat(lexeme, consumed);
    next: string <- lexer_core@peek_char(after_e);
    case next of {
        "+" -> {
            after_plus: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(after_e);
            (exp_lexeme: string, after_exp: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) <- lexer_integer_literals@read_decimal_digits_only(after_plus, "");
            (concat(lexeme_with_e, concat("+", exp_lexeme)), after_exp)
        };
        "-" -> {
            after_minus: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- lexer_core@advance(after_e);
            (exp_lexeme: string, after_exp: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) <- lexer_integer_literals@read_decimal_digits_only(after_minus, "");
            (concat(lexeme_with_e, concat("-", exp_lexeme)), after_exp)
        };
        _: string -> case lexer_integer_literals@is_decimal_digit_char(next) of {
            true -> {
                (exp_lexeme: string, after_exp: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) <- lexer_integer_literals@read_decimal_digits_only(after_e, "");
                (concat(lexeme_with_e, exp_lexeme), after_exp)
            };
            false -> (lexeme_with_e, after_e)
        }
    }
}

// Reads a numeric literal and rejects malformed ones (spec 2.2.3, 2.5) with
// E0005: `0x` / `0b` without digits, an exponent without digits, digits
// followed by '.' and no fraction digit, and a literal followed directly by a
// letter, digit or '_' (`12abc`, `0x1G`, `0b102`, `1_000`, `1e5`).
fn read_numeric_literal(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> ({ kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) {
    (t: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, next_lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) <- read_numeric_literal_raw(lexer);
    lexeme: string <- lexer_core@token_lexeme(t);
    next: string <- lexer_core@peek_char(next_lexer);
    is_float: boolean <- lexer_core@token_get_kind(t) == lexer_token_kind@token_kind_float_literal();
    problem: string <- numeric_literal_problem(lexeme, is_float, next, lexer_core@peek_next_char(next_lexer));
    case problem == "" of {
        true -> (t, next_lexer);
        false -> (lexer_core@lexical_error_token("E0005", concat(concat(concat("malformed numeric literal '", concat(lexeme, numeric_shown_suffix(next))), "': "), problem), t.location), next_lexer)
    }
}

// The text after the lexeme shown in the message: the offending next character
// when it is an identifier character.
fn numeric_shown_suffix(next: string) -> string {
    case lexer_keywords@is_identifier_char(next) of {
        true -> next;
        false -> ""
    }
}

// "" when the literal is well formed; otherwise what is wrong with it.
fn numeric_literal_problem(lexeme: string, is_float: boolean, next: string, next_next: string) -> string {
    case lexeme == "0x" of {
        true -> "a hex literal needs at least one hex digit (0-9, a-f, A-F) after 0x";
        false -> case lexeme == "0b" of {
            true -> "a binary literal needs at least one binary digit (0 or 1) after 0b";
            false -> case is_float and (ends_with(lexeme, "e") or ends_with(lexeme, "E") or ends_with(lexeme, "+") or ends_with(lexeme, "-")) of {
                true -> "the exponent of a float literal needs at least one digit";
                false -> case lexer_keywords@is_identifier_char(next) of {
                    true -> "a numeric literal cannot be followed directly by a letter, a digit of another base or '_'";
                    false -> case next == "." of {
                        false -> "";
                        true -> numeric_dot_problem(is_float, next_next)
                    }
                }
            }
        }
    }
}

// A '.' right after a numeric literal: `1.` directly before the end of the file,
// ';', ')', ',' or ']' has no fraction digit, and `1.5.2` has a second '.'. Other
// dots after an integer (`{ y: 2. }`, `1.name`) are left to the parser, whose
// messages name the construct (E1046 for a record).
fn numeric_dot_problem(is_float: boolean, next_next: string) -> string {
    case is_float of {
        true -> case lexer_integer_literals@is_decimal_digit_char(next_next) of {
            true -> "a float literal has exactly one '.'";
            false -> ""
        };
        false -> case next_next == "" or next_next == ";" or next_next == ")" or next_next == "," or next_next == "]" of {
            true -> "a float literal needs at least one digit after '.'";
            false -> ""
        }
    }
}
