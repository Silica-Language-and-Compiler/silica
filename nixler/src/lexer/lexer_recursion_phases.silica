// { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }-level classification for compiler/design_documents/recursion_implementation.md (all phases).
// The design document describes runtime/IR (explicit frames, fuel, tail/fallback) — there are no new
// surface spellings for those phases. This module groups existing token kinds so lexer-adjacent
// tooling can filter tokens by phase-relevance without hardcoding kind numbers elsewhere.

use lexer_token_kind;

export token_kind_recursion_phase1_core_representation/1;
export token_kind_recursion_phase2_lowering_execution/1;
export token_kind_recursion_phase3_preemption_fairness/1;
export token_kind_recursion_phase4_debugging_observability/1;
export token_kind_recursion_phase5_optimizations/1;
export token_kind_recursion_phase6_fallbacks/1;
export token_kind_any_recursion_implementation_phase/1;


fn token_kind_recursion_phase1_core_representation(k: int64) -> boolean {
    // Phase 1 — core representation: callee/structure in source (fn), recursive types (rec).
    k == lexer_token_kind@token_kind_fn_keyword() or k == lexer_token_kind@token_kind_rec_keyword()
}

fn token_kind_recursion_phase2_lowering_execution(k: int64) -> boolean {
    // Phase 2 — lowering: calls, returns, and callee/parameter names.
    k == lexer_token_kind@token_kind_fn_keyword() or k == lexer_token_kind@token_kind_return_keyword() or k == lexer_token_kind@token_kind_left_paren() or k == lexer_token_kind@token_kind_right_paren() or k == lexer_token_kind@token_kind_identifier()
}

fn token_kind_recursion_phase3_preemption_fairness(k: int64) -> boolean {
    // Phase 3 — runnable units (proc/effects), back-edges in source (return, case arms, if).
    k == lexer_token_kind@token_kind_proc_keyword() or k == lexer_token_kind@token_kind_effect_keyword() or k == lexer_token_kind@token_kind_return_keyword() or k == lexer_token_kind@token_kind_case_keyword() or k == lexer_token_kind@token_kind_of_keyword() or k == lexer_token_kind@token_kind_if_keyword()
}

fn token_kind_recursion_phase4_debugging_observability(k: int64) -> boolean {
    // Phase 4 — symbols and control points that appear in stack traces / spans.
    k == lexer_token_kind@token_kind_fn_keyword() or k == lexer_token_kind@token_kind_return_keyword() or k == lexer_token_kind@token_kind_identifier() or k == lexer_token_kind@token_kind_case_keyword()
}

fn token_kind_recursion_phase5_optimizations(k: int64) -> boolean {
    // Phase 5 — tail-oriented surface (return sites; fn defines callable boundaries).
    k == lexer_token_kind@token_kind_return_keyword() or k == lexer_token_kind@token_kind_fn_keyword()
}

fn token_kind_recursion_phase6_fallbacks(k: int64) -> boolean {
    // Phase 6 — same call/return surface whether lowered to trampoline or native TCO.
    k == lexer_token_kind@token_kind_fn_keyword() or k == lexer_token_kind@token_kind_return_keyword() or k == lexer_token_kind@token_kind_left_paren() or k == lexer_token_kind@token_kind_right_paren()
}

fn token_kind_any_recursion_implementation_phase(k: int64) -> boolean {
    token_kind_recursion_phase1_core_representation(k) or token_kind_recursion_phase2_lowering_execution(k) or token_kind_recursion_phase3_preemption_fairness(k) or token_kind_recursion_phase4_debugging_observability(k) or token_kind_recursion_phase5_optimizations(k) or token_kind_recursion_phase6_fallbacks(k)
}
