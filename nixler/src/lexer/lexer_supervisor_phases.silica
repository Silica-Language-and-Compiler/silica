// { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }-level classification for design_documents/supervisors_implementation_development_plan.md.
// Phase B (supervision ingress + scheduler ordering): silica-spec §15.4.9, §16.2.2 — runtime drains
// the supervision ingress before the standard mailbox each turn. User code still uses the same
// message parameter, case/of, cast/call/send, spawn_linked, and link/monitor/demonitor surface
// spellings; there is no separate recv-from-ingress keyword.
// Phase C (exit notification, §15.4.10–§15.4.11): failure payload field typing uses built-in
// `failure_reason` (failure_reason_keyword) and `actor_ref` for child_ref; case/of + atom_literal
// for discriminated :normal / :language_error / :memory_fault / … variants.
// Phase D (Supervisor trait, §15.4.13): export trait / required { fn init … } / spawn_linked+link+self
// enforcement — surface keyword kinds are grouped for tooling.
// Phase E (declarative children + automatic restart, §15.4.12.1, §15.4.12.3, §15.4.13.1–2): runtime applies
// supervisor_flags and child_spec.restart to the static table; escalation uses allowed_restart_count and
// restarts_time_frame. { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }-side surface is atom literals (restart + strategy), int literals, inline records,
// List[..., normal] child lists, function types for start, and spawn_linked for dynamic children (§15.4.13.3).
// Phase F (FailureReporter + unwind, §15.4.11.4, §15.4.13.4–13.6): trait FailureReporter { region_dump_limit; handle_report };
// `bytes` type for region_dumps; `String` in spec tokenizes as string_keyword; method names are ordinary identifiers.
// Phase G (link, monitor, cascading shutdown, §15.4.8.4–§15.4.8.7): `link` / `monitor` / `demonitor` + spawn_linked share behavior-only surface with Phase B;
// DOWN to standard mailbox only (not ingress) — spec message `(:down, monitor_ref, actor_ref, failure_reason)` uses atom :down, types monitor_ref, actor_ref, failure_reason (§15.4.8.6).

use lexer_token_kind;

export token_kind_supervisor_phase_b_ingress_ordering/1;
export token_kind_supervisor_phase_c_failure_payload/1;
export token_kind_supervisor_phase_d_supervisor_trait_surface/1;
export token_kind_supervisor_phase_e_automatic_restart_surface/1;
export token_kind_supervisor_phase_f_failure_reporter_surface/1;
export token_kind_supervisor_phase_g_link_monitor_down_surface/1;


fn token_kind_supervisor_phase_b_ingress_ordering(k: int64) -> boolean {
    k == lexer_token_kind@token_kind_spawn_keyword() or k == lexer_token_kind@token_kind_spawn_dangerous_keyword() or k == lexer_token_kind@token_kind_spawn_linked_keyword() or k == lexer_token_kind@token_kind_link_keyword() or k == lexer_token_kind@token_kind_monitor_keyword() or k == lexer_token_kind@token_kind_demonitor_keyword() or k == lexer_token_kind@token_kind_cast_keyword() or k == lexer_token_kind@token_kind_send_keyword() or k == lexer_token_kind@token_kind_self_keyword() or k == lexer_token_kind@token_kind_actor_keyword() or k == lexer_token_kind@token_kind_actor_ref_keyword() or k == lexer_token_kind@token_kind_dangerous_actor_ref_keyword() or k == lexer_token_kind@token_kind_case_keyword() or k == lexer_token_kind@token_kind_of_keyword() or k == lexer_token_kind@token_kind_recv_keyword()
}

// §15.4.11 failure notification typing + pattern variants (tooling / trials classification).
fn token_kind_supervisor_phase_c_failure_payload(k: int64) -> boolean {
    k == lexer_token_kind@token_kind_failure_reason_keyword() or k == lexer_token_kind@token_kind_atom_literal() or k == lexer_token_kind@token_kind_case_keyword() or k == lexer_token_kind@token_kind_of_keyword() or k == lexer_token_kind@token_kind_if_keyword() or k == lexer_token_kind@token_kind_actor_ref_keyword()
}

// §15.4.13 Supervisor trait file surface: init, static children, behavior-only intrinsics.
fn token_kind_supervisor_phase_d_supervisor_trait_surface(k: int64) -> boolean {
    k == lexer_token_kind@token_kind_trait_keyword() or k == lexer_token_kind@token_kind_export_keyword() or k == lexer_token_kind@token_kind_required_keyword() or k == lexer_token_kind@token_kind_provided_keyword() or k == lexer_token_kind@token_kind_fn_keyword() or k == lexer_token_kind@token_kind_module_keyword() or k == lexer_token_kind@token_kind_use_keyword() or k == lexer_token_kind@token_kind_impl_keyword() or k == lexer_token_kind@token_kind_for_keyword() or k == lexer_token_kind@token_kind_spawn_linked_keyword() or k == lexer_token_kind@token_kind_link_keyword() or k == lexer_token_kind@token_kind_self_keyword()
}

// §15.4.12–15.4.13.2 declarative restart + §15.4.13.3 dynamic children (token kinds for trials / tooling).
fn token_kind_supervisor_phase_e_automatic_restart_surface(k: int64) -> boolean {
    k == lexer_token_kind@token_kind_atom_literal()
        or k == lexer_token_kind@token_kind_integer_literal()
        or k == lexer_token_kind@token_kind_int64_keyword()
        or k == lexer_token_kind@token_kind_left_brace()
        or k == lexer_token_kind@token_kind_right_brace()
        or k == lexer_token_kind@token_kind_left_paren()
        or k == lexer_token_kind@token_kind_right_paren()
        or k == lexer_token_kind@token_kind_comma()
        or k == lexer_token_kind@token_kind_colon()
        or k == lexer_token_kind@token_kind_list_keyword()
        or k == lexer_token_kind@token_kind_normal_keyword()
        or k == lexer_token_kind@token_kind_fn_keyword()
        or k == lexer_token_kind@token_kind_right_arrow()
        or k == lexer_token_kind@token_kind_spawn_linked_keyword()
}

// §15.4.13.4 FailureReporter trait: region_dump_limit / handle_report signatures; string+bytes+atom tuple list types.
fn token_kind_supervisor_phase_f_failure_reporter_surface(k: int64) -> boolean {
    k == lexer_token_kind@token_kind_trait_keyword() or k == lexer_token_kind@token_kind_export_keyword() or k == lexer_token_kind@token_kind_required_keyword() or k == lexer_token_kind@token_kind_provided_keyword() or k == lexer_token_kind@token_kind_fn_keyword() or k == lexer_token_kind@token_kind_module_keyword() or k == lexer_token_kind@token_kind_use_keyword() or k == lexer_token_kind@token_kind_impl_keyword() or k == lexer_token_kind@token_kind_for_keyword() or k == lexer_token_kind@token_kind_string_keyword() or k == lexer_token_kind@token_kind_bytes_keyword() or k == lexer_token_kind@token_kind_atom_keyword()
}

// §15.4.8.4–§15.4.8.7 + §15.4.8.6 DOWN: link/monitor/demonitor + spawn_linked surface; standard-mailbox recv/cast/send;
// DOWN tuple `(:down, monitor_ref, actor_ref, failure_reason)` — left/right paren + comma; case/of for matching.
fn token_kind_supervisor_phase_g_link_monitor_down_surface(k: int64) -> boolean {
    k == lexer_token_kind@token_kind_link_keyword()
        or k == lexer_token_kind@token_kind_monitor_keyword()
        or k == lexer_token_kind@token_kind_demonitor_keyword()
        or k == lexer_token_kind@token_kind_spawn_linked_keyword()
        or k == lexer_token_kind@token_kind_spawn_keyword()
        or k == lexer_token_kind@token_kind_spawn_dangerous_keyword()
        or k == lexer_token_kind@token_kind_actor_ref_keyword()
        or k == lexer_token_kind@token_kind_dangerous_actor_ref_keyword()
        or k == lexer_token_kind@token_kind_monitor_ref_keyword()
        or k == lexer_token_kind@token_kind_failure_reason_keyword()
        or k == lexer_token_kind@token_kind_atom_literal()
        or k == lexer_token_kind@token_kind_case_keyword()
        or k == lexer_token_kind@token_kind_of_keyword()
        or k == lexer_token_kind@token_kind_left_paren()
        or k == lexer_token_kind@token_kind_right_paren()
        or k == lexer_token_kind@token_kind_comma()
        or k == lexer_token_kind@token_kind_self_keyword()
        or k == lexer_token_kind@token_kind_recv_keyword()
        or k == lexer_token_kind@token_kind_cast_keyword()
        or k == lexer_token_kind@token_kind_send_keyword()
}
