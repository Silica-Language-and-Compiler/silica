// Core token types, source location, and basic tokenization infrastructure
// This file provides the foundation for lexical analysis in Silica

// Import token kind types and functions
use lexer_token_kind;

// Export functions used by other lexer modules
export current_location/1;
export make_token/3;
export peek_char/1;
export peek_next_char/1;
export advance/1;
export advance_by/2;
export extract_lexeme/2;
export token_lexeme/1;
export token_get_kind/1;
export new_lexer/2;
export is_whitespace/1;
export skip_whitespace/1;
export utf8_char_is_valid/1;
export lexical_error_token/3;

{-
- Represents a position in source code by file name, line, column, and byte offset.
- Used by the lexer and parser to record where tokens and syntax nodes originate, so errors and tooling can point to the exact place in the source. Fits into the design as the shared location type for tokens (e.g. { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }.location) and for reporting.
- Example: at start of "main.silica", location might be { file: "main.silica", line: 1, column: 0, offset: 0 }.
- Example: after consuming "foo " on line 1, location might be { file: "main.silica", line: 1, column: 4, offset: 4 }.
- Example: when building a { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }, the lexer sets location to the { file: string, line: int64, column: int64, offset: int64 } where the token started, so later phases can USE it for diagnostics or IDE highlights.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}

{-
- Represents a single lexical token: its kind code, the source text (lexeme), and where it occurred.
- Used by the lexer to pass recognized tokens to the parser; the parser then builds syntax from the token stream. The location field supports error reporting and tooling. Fits into the design as the unit of output from the lexer and input to the parser.
- Example: for the identifier "foo" at line 2 column 1 of "main.silica", a { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } might have kind set to the identifier code, lexeme "foo", and location with file "main.silica", line 2, column 1, and the corresponding offset.
- Example: for the operator "+", kind is the plus token code, lexeme "+", and location points to the position of "+" in the source.
- Example: for a string literal "\"hi\"", kind is the string-literal code, lexeme "\"hi\"", and location is where the opening quote started.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}

{-
- Holds the source text and current position (byte offset, line, column) for incremental tokenization.
- Used as the state passed through the lexer: new_lexer creates it, advance/peek_char/peek_next_char update or read it, and make_token uses it to build { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } values with correct locations. Fits into the design as the single mutable (conceptually) cursor over the source string.
- Example: right after new_lexer("FN x() {}", "main.silica"), the { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } has source that string, position 0, line 1, column 1, file "main.silica".
- Example: after advancing past "FN ", position is 3, line still 1, column 4; the next peek_char would return "x".
- Example: after advancing past a newline, line is incremented and column resets to 1 so that subsequent tokens get the correct { file: string, line: int64, column: int64, offset: int64 }.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
{-
- Builds a { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } for the given source string and file name, with position at the start (offset 0, line 1, column 1).
- Used to initialize lexical analysis: call this once per file or input string, then pass the returned { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } to the tokenizer. The resulting { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } is ready for peek_char, advance, and token production.
- Example: new_lexer("FN x() {}", "main.silica") returns a { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } with that source, position 0, line 1, column 1, file "main.silica"; the next character is "f".
- Example: new_lexer("", "empty.silica") returns a { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } with empty source and position 0; peek_char will yield "".
- Example: new_lexer("a\nb", "f.silica") returns a { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } at the first character "a"; after advancing past the newline, line becomes 2 and column 1.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single struct construction; source and file are not copied, only referenced.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn new_lexer(source: string, file: string) -> { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } {
    sequence
        result: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- { source: source, position: 0, line: 1, column: 1, file: file, offset: 0 }
    produces
        pure result
    end
}

{-
- Returns a { file: string, line: int64, column: int64, offset: int64 } reflecting the lexer’s current position (file, line, column, and byte offset).
- Used when building tokens or reporting errors so that each token or message can record where it came from. The result is built from the { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }’s file, line, column, and position fields.
- Example: for a lexer just returned by new_lexer("FN", "x.silica"), current_location returns { file: "x.silica", line: 1, column: 1, offset: 0 }.
- Example: after advancing 5 characters on line 1, current_location returns column 6 and offset 5 (line still 1).
- Example: after advancing past a newline, current_location returns line 2, column 1, and offset equal to the new position.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). One { file: string, line: int64, column: int64, offset: int64 } struct built from four field reads.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn current_location(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> { file: string, line: int64, column: int64, offset: int64 } {
    sequence
        result: { file: string, line: int64, column: int64, offset: int64 } <- { file: lexer.file, line: lexer.line, column: lexer.column, offset: lexer.offset }
    produces
        pure result
    end
}

{-
- Builds a { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } with the given kind code, lexeme string, and source location.
- Used by the lexer when it has recognized a token: call current_location to get the start position, then make_token to produce the { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } for the parser. Fits into the design as the single constructor for { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } values.
- Example: make_token(lexer_token_kind@identifier(), "foo", current_location(lexer)) returns a { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } for the identifier "foo" at the lexer’s current position.
- Example: make_token(lexer_token_kind@plus(), "+", loc) returns a { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } for the "+" operator at location loc.
- Example: make_token(lexer_token_kind@string_literal(), "\"hi\"", loc) returns a { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } for the string literal with lexeme "\"hi\"" at loc.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } struct construction; arguments are not copied beyond normal passing.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn make_token(kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } {
    sequence
        result: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } <- { kind: kind, lexeme: lexeme, location: location }
    produces
        pure result
    end
}

fn token_lexeme(t: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> string {
    t.lexeme
}

fn token_get_kind(t: { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }) -> int64 {
    t.kind
}

{-
- Returns the single character at the lexer’s current position, or the empty string if the position is past the end of the source.
- Used to decide what token to recognize or whether to skip whitespace/comments without advancing. Does not change the lexer; advance moves the position. Implemented as substring(source, position, position+1).
- Example: for a lexer at the start of "FN x", peek_char returns "f"; position is unchanged.
- Example: when position equals source length (e.g. after consuming all of "FN"), peek_char returns "" (EOF).
- Example: for a lexer at the "x" in "FN x", peek_char returns "x"; the lexer can then advance after building the identifier token.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single substring of length 0 or 1; no recursion.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn peek_char(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> string {
    // Use substring to get single character at position
    // Returns empty string if position is beyond source length
    substring(lexer.source, lexer.position, lexer.position + 1)
}

{-
- Returns the single character immediately after the lexer’s current position, or the empty string if that position is past the end of the source.
- Used when the lexer needs one character of lookahead (e.g. to detect "//" by checking peek_char and peek_next_char together). Does not change the lexer. Implemented as substring(source, position+1, position+2).
- Example: for a lexer at the first character of "FN", peek_char is "f" and peek_next_char is "n".
- Example: when position is at the last character of the source, peek_next_char returns "" (no character after current).
- Example: for a lexer at the first "/" of "// comment", peek_char is "/" and peek_next_char is "/", so the lexer can recognize a line comment.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single substring of length 0 or 1; no recursion.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn peek_next_char(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> string {
    substring(lexer.source, lexer.position + 1, lexer.position + 2)
}


{-
- Returns a { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } with position advanced by one character; line and column are updated (column resets to 1 after a newline, otherwise column increments).
- Used after consuming a character so the next peek_char or token start reflects the new position. Does not mutate the original lexer; returns a new { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }. Newline handling keeps line/column correct for source locations.
- Example: for a lexer at the "f" of "FN", advance returns a { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } with position 1, line 1, column 2; peek_char on the result returns "n".
- Example: for a lexer at the newline in "a\nb", advance returns a { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } with position past the newline, line 2, column 1; the next character is "b".
- Example: for a lexer already at EOF (position at source length), advance still returns a { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } with position+1; line and column are updated as if the current character were non-newline (peek_char is "").
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). One peek_char, comparisons, and one new { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } struct; no recursion or unbounded allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn advance(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } {
    // Get current character to check if its newline
    current: string <- peek_char(lexer);
    
    // Check if current character is newline
    is_newline: boolean <- current == "\n";
    new_line: int64 <- case is_newline of {
        true -> lexer.line + 1;
        false -> lexer.line
    };
    new_column: int64 <- case is_newline of {
        true -> 1;
        false -> lexer.column + 1
    };
    
    {
        source: lexer.source,
        position: lexer.position + 1,
        line: new_line,
        column: new_column,
        file: lexer.file,
        offset: lexer.offset + length_bytes(current)
    }
}


{-
- Advances the lexer by n bytes. Used for UTF-8 multi-byte sequences where bytes 2..n are
- continuation bytes (never newline). Updates position and column; line unchanged.
- Last-date-modified: 2025-03-03
-}
fn advance_by(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, n: int64) -> { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } {
    sequence
        result: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } <- {
        source: lexer.source,
        position: lexer.position + n,
        line: lexer.line,
        column: lexer.column + n,
        file: lexer.file,
        offset: lexer.offset + length_bytes(substring(lexer.source, lexer.position, lexer.position + n))
    }
    produces
        pure result
    end
}


{-
- Returns the substring of the lexer’s source from start_pos (inclusive) to the lexer’s current position (exclusive).
- Used after recognizing a token: save the position at token start, advance until the token ends, then extract_lexeme(lexer, start_pos) gives the exact source text for the token. That string can be stored in { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } }.lexeme or used for keyword/identifier distinction.
- Example: after advancing from position 0 to 3 over "foo", extract_lexeme(lexer, 0) returns "foo".
- Example: for a single-character token "+" that started at position 5, after advance the lexer has position 6; extract_lexeme(lexer, 5) returns "+".
- Example: when start_pos equals lexer.position (e.g. no characters consumed yet), extract_lexeme returns "".
- Time: O(k), Ω(k), Θ(k) where k = position - start_pos. Space: O(k), Ω(k), Θ(k) for the returned substring.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn extract_lexeme(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }, start_pos: int64) -> string {
    substring(lexer.source, start_pos, lexer.position)
}


{-
- Returns true if the given single-character string is a whitespace character (space, tab, newline, or carriage return), and false otherwise.
- Used by the lexer to decide whether to skip characters (e.g. via skip_whitespace) before recognizing the next token. Only the four characters " ", "\t", "\n", and "\r" are considered whitespace.
- Example: is_whitespace(" ") returns true; space is skipped between tokens.
- Example: is_whitespace("a") returns false; the lexer does not skip letters.
- Example: is_whitespace("\n") and is_whitespace("\t") return true; newlines and tabs are skipped as whitespace.
- Time: O(1), Ω(1), Θ(1). Space: O(1), Ω(1), Θ(1). Single case match over the character; no recursion or allocation.
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn is_whitespace(c: string) -> boolean {
    // Space, tab, newline, and CR are all whitespace — including blank lines
    // (a newline after only spaces/tabs). They are not tokens. Use `==` so
    // silica-boot (which may not unescape case patterns) still matches the
    // real bytes. `//` comments stop at a real newline in skip_line_comment;
    // a lone `/` is division.
    c == " " or c == "\t" or c == "\n" or c == "\r"
}


{-
- Advances the lexer past zero or more consecutive whitespace characters (space, tab, newline, carriage return) and returns the resulting lexer; stops at EOF or the first non-whitespace character.
- Used at the start of tokenization or between tokens so that the lexer only considers meaningful characters. Does not consume non-whitespace; if the current character is not whitespace, returns the lexer unchanged.
- Example: for a lexer at the start of "  \tfoo", skip_whitespace returns a lexer with position past the spaces and tab, so the next peek_char is "f".
- Example: when the lexer is already on a non-whitespace character (e.g. "x"), skip_whitespace returns the lexer unchanged.
- Example: when the lexer is at EOF (peek_char ""), skip_whitespace returns the lexer unchanged.
- Time: O(k), Ω(1), Θ(k) where k is the number of whitespace characters skipped. Space: O(k), Ω(1), Θ(k) for recursion depth (or Θ(1) if tail-call optimized).
- Last-date-modified: 2025-02-10
- Last-modified-by: Lee S. Barney
-}
fn skip_whitespace(lexer: { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 }) -> { source: string, position: int64, line: int64, column: int64, file: string, offset: int64 } {
    current: string <- peek_char(lexer);
    case current of {
        "" -> lexer;
        _: string -> case is_whitespace(current) of {
            true -> skip_whitespace(advance(lexer));
            false -> lexer
        }
    }
}

// UTF-8 validation (spec 2.1). Strings carry no byte access, so the checks
// below use the runtime's own character split: substring takes a lead byte's
// full length (C2-DF two bytes, E0-EF three, F0-F7 four, any other byte one)
// whatever follows it, and contains/starts_with compare bytes.
fn utf8_high_bytes() -> string {
    "\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8A\x8B\x8C\x8D\x8E\x8F\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9A\x9B\x9C\x9D\x9E\x9F\xA0\xA1\xA2\xA3\xA4\xA5\xA6\xA7\xA8\xA9\xAA\xAB\xAC\xAD\xAE\xAF\xB0\xB1\xB2\xB3\xB4\xB5\xB6\xB7\xB8\xB9\xBA\xBB\xBC\xBD\xBE\xBF\xC0\xC1\xC2\xC3\xC4\xC5\xC6\xC7\xC8\xC9\xCA\xCB\xCC\xCD\xCE\xCF\xD0\xD1\xD2\xD3\xD4\xD5\xD6\xD7\xD8\xD9\xDA\xDB\xDC\xDD\xDE\xDF\xE0\xE1\xE2\xE3\xE4\xE5\xE6\xE7\xE8\xE9\xEA\xEB\xEC\xED\xEE\xEF\xF0\xF1\xF2\xF3\xF4\xF5\xF6\xF7\xF8\xF9\xFA\xFB\xFC\xFD\xFE\xFF"
}

fn utf8_continuation_bytes() -> string {
    "\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8A\x8B\x8C\x8D\x8E\x8F\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9A\x9B\x9C\x9D\x9E\x9F\xA0\xA1\xA2\xA3\xA4\xA5\xA6\xA7\xA8\xA9\xAA\xAB\xAC\xAD\xAE\xAF\xB0\xB1\xB2\xB3\xB4\xB5\xB6\xB7\xB8\xB9\xBA\xBB\xBC\xBD\xBE\xBF"
}

fn utf8_continuation_80_8f() -> string {
    "\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8A\x8B\x8C\x8D\x8E\x8F"
}

fn utf8_continuation_80_9f() -> string {
    "\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8A\x8B\x8C\x8D\x8E\x8F\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9A\x9B\x9C\x9D\x9E\x9F"
}

// True when the one-character string `c` (a substring of length 1 of the
// source) is a well-formed UTF-8 encoding of one Unicode scalar value: ASCII,
// or a lead byte C2-F4 followed by the right number of continuation bytes, with
// no overlong form (E0 80-9F, F0 80-8F), no surrogate (ED A0-BF) and nothing
// above U+10FFFF (F4 90-BF, F5-F7). "" (end of input) counts as valid.
fn utf8_char_is_valid(c: string) -> boolean {
    n: int64 <- length_bytes(c);
    case n of {
        0 -> true;
        1 -> not contains(utf8_high_bytes(), c);
        _: int64 -> utf8_multibyte_is_valid(c, n)
    }
}

fn utf8_multibyte_is_valid(c: string, n: int64) -> boolean {
    // length_chars splits by lead byte without the substring cursor, so this
    // is 4 exactly when the lead's length is n (not cut off by the end of the
    // source).
    case length_chars(concat(c, "\x80\x80\x80")) == 4 of {
        false -> false;
        true -> {
            // A leading C2 swallows c's lead byte, so c's continuation bytes
            // become characters 1 .. n-1 of `shifted` while they are 80-BF.
            // They are read in increasing order only: a backward cursor step
            // over ill-formed UTF-8 is unreliable in runtimes before 2026-10-16.
            shifted: string <- concat("\xC2", c);
            b1: string <- substring(shifted, 1, 2);
            case utf8_is_continuation(b1) of {
                false -> false;
                true -> case n == 2 of {
                    true -> true;
                    false -> utf8_rest_is_valid(c, shifted, b1, n)
                }
            }
        }
    }
}

fn utf8_rest_is_valid(c: string, shifted: string, b1: string, n: int64) -> boolean {
    b2: string <- substring(shifted, 2, 3);
    case utf8_is_continuation(b2) of {
        false -> false;
        true -> case n == 3 of {
            true -> utf8_lead_range_ok(c, b1);
            false -> {
                b3: string <- substring(shifted, 3, 4);
                case utf8_is_continuation(b3) of {
                    false -> false;
                    true -> utf8_lead_range_ok(c, b1)
                }
            }
        }
    }
}

fn utf8_is_continuation(b: string) -> boolean {
    case length_bytes(b) == 1 of {
        false -> false;
        true -> contains(utf8_continuation_bytes(), b)
    }
}

fn utf8_lead_range_ok(c: string, second: string) -> boolean {
    case starts_with(c, "\xE0") of {
        true -> not contains(utf8_continuation_80_9f(), second);
        false -> case starts_with(c, "\xED") of {
            true -> contains(utf8_continuation_80_9f(), second);
            false -> case starts_with(c, "\xF0") of {
                true -> not contains(utf8_continuation_80_8f(), second);
                false -> case starts_with(c, "\xF4") of {
                    true -> contains(utf8_continuation_80_8f(), second);
                    false -> not (starts_with(c, "\xF5") or starts_with(c, "\xF6") or starts_with(c, "\xF7"))
                }
            }
        }
    }
}

// A lexical-error token (spec 2.5): lexeme "<code> <message>".
fn lexical_error_token(code: string, message: string, location: { file: string, line: int64, column: int64, offset: int64 }) -> { kind: int64, lexeme: string, location: { file: string, line: int64, column: int64, offset: int64 } } {
    make_token(lexer_token_kind@token_kind_lexical_error(), concat(concat(code, " "), message), location)
}
