// Module interface (iface) extract/publish + read/stub inject + Phase 3 invalidation
// + Phase 4 interned type-DAG persist (see module_iface_type_dag).
// Design: design_documents/module_interface_cache_and_bottom_up_typecheck_plan.md

use parser_ast;
use type_checker_callee_env;
use effect_checker_core;
use atom_table;
use module_iface_type_dag;
use type_checker_start_order;

