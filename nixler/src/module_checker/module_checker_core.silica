// Module checking phase: after parsing, before type checking (spec §19.2–19.3, §3.4.8 trait files).
// Validates `use` against silica.config, module-qualified calls vs `use`, cross-module export surfaces,
// and trait-module rules (`export trait` vs filename, exports vs required/provided/impl methods).
// Supervisors Phase F (supervisors_implementation_development_plan.md): `export trait FailureReporter`
// required-method shape vs spec §15.4.13.4 (region_dump_limit, handle_report).
// Supervisors Phase E (same plan, §15.4.12–§15.4.13.2): `export trait Supervisor` must declare
// `init` returning the static supervisor_flags + List[child_spec, normal] surface the runtime uses
// for the internal child table and automatic restart (declarative children).
// Supervisors Phase G (same plan, §15.4.8.4–§15.4.8.7): module phase only extends cross-module export
// checks — `link` / `monitor` / `demonitor` are intrinsics for E1011 (see
// is_phase_g_link_monitor_demonitor_intrinsic_for_export_surface). DOWN vs ingress is runtime.

use parser_ast;
use type_checker_core;
use instantiated_fn_name;
use type_checker_traits;
use type_checker_supervisor;
use diagnostics_core;
use module_checker_ffi;
use module_checker_device;

// Int64 1/0 — seed-built selfhost has inverted/stuck bool from `tag == n`.
fn int64_same(a: int64, b: int64) -> int64 {
    case a < b of {
        true -> 0;
        false -> case b < a of {
            true -> 0;
            false -> 1
        }
    }
}

fn empty_list_string() -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[string, mem(normal)] <- empty[string, mem(normal)]()
    produces
        pure result
    end
}

fn cons_string(s: string, tail: List[string, mem(normal)]) -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        result: List[string, mem(normal)] <- prepend[string, mem(normal)](s, tail)
    produces
        pure result
    end
}

