// Shared diagnostics module - compiler error message formatting
// Follows silica-specification.md §1.6 Compiler Error Messages format
// Uses line-by-line output (no int64_to_string)

use lexer_core;

export print_compiler_error/5;
export print_compiler_warning/5;

// --- Error code allocation (per compiler/error_codes.md) ---
// { source: string, position: int64, line: int64, column: int64, file: string }:        E0001-E0999 (LexicalErrors)
// Parser:       E1000-E1999 (ParseErrors)
// Type checker: E2000-E2999 (TypeErrors)
// Effect checker: E3000-E3999 (EffectErrors)
// SIR generator: E4000-E4049 (CodegenErrors - SIR phase)
// Emitter:      E4050-E4099 (CodegenErrors - emit phase)
// Module:       E5000-E5999 (ModuleErrors); E4010/E4014 export-list, E4016 executable-or-library shape (module_checker, spec §19.1–19.2)
// Internal:     E9000-E9999 (InternalErrors)

// { source: string, position: int64, line: int64, column: int64, file: string } error codes
// E0001 UnexpectedCharacter, E0002 InvalidEscapeSequence, E0003 UnterminatedStringLiteral,
// E0004 UnterminatedCharacterLiteral, E0005 InvalidIntegerLiteral, E0006 UnterminatedBlockComment

// Parser error codes
// E1000 ParseErrorDefault, E1001 ExpectedToken, E1002 NestedFunctionDeclaration,
// E1003 ExpectedIdentifier, E1004 ExpectedType, E1005 ExpectedExpression, etc.
// E1009 UnknownModuleInUse — `use` names a module not in silica.config (module_checker phase)
// E1010 ModuleQualifiedCallWithoutUse — module@fn appears without a matching `use` for that module (module_checker)
// E1011 CrossModuleCallNotExported — module@fn not on callee export surface (module_checker, spec §19.2)
// E1045 MissingFunctionPrefix — top-level function-shaped declaration is missing `fn`
// E1046 InvalidRecordTail — unexpected token after the final inline record item
// E1047 NamedCustomTypeDeclarationNotAllowed — named `struct` or `type Name = …` declarations are not allowed (§3.4.2)
// E1048 SequenceMissingSequenceKeyword — `produces` appears without a preceding `sequence`
// E1049 SequenceMissingProducesKeyword — `sequence` block is missing `produces`
// E1050 SequenceMissingPureKeyword — `produces` clause is missing `pure`
// E1051 SequenceMissingEndKeyword — `sequence` block is missing closing `end`
// E1052 SequenceDuplicateSequenceKeyword — duplicate `sequence` keyword in sequence block
// E1053 SequenceDuplicateProducesKeyword — duplicate `produces` keyword in sequence block
// E1054 SequenceExtraEndKeyword — extra `end` after sequence block
// E1056 SequenceEmptyProcEffects — `sequence` with no effects; omit `proc` for pure blocks
// E1057 ArrowSequenceCaseRhs — `sequence...produces pure...end` cannot be the RHS of `->`
// E1058 ReservedKeywordBinding — reserved keyword (e.g. `meta`) used as a variable binding name
// E1059 ReservedKeywordRecordField — reserved keyword (e.g. `required` / `provided`) used as a record field name
// E1060 UnbalancedBraces — `{` / `}` depth does not return to zero (unclosed `{` or extra `}`)
// E1061 NamedStructConstructionNotAllowed — `Name { field: … }` construction is not allowed (§3.4.2); use anonymous `{ field: … }`
// E1062 IncompleteListReturnType — `-> List {` is ill-formed; write `-> List[T, mem(S)] { … }`
// E1063 IncompleteListBracket — `List[` opened without a matching `]` (e.g. `List[ { … }` without `]`); write `List[T, mem(S)]`
// E1064 UnbracedMultilineCaseArm — multi-statement case arm RHS (`;` between expressions) must be wrapped in `{ ... }`
// E1065 UnclosedFunctionParameterList — function body `{` began before `)` closed the parameter list
// E1000 ParseErrorDefault — uncategorized syntactic defect (statement-boundary fall-through when next token does not start a statement)
// E1040 MissingStatementTerminator — expected `;` between consecutive statements

// Type checker error codes
// E2000 TypeErrorDefault, E2001 TypeMismatch, E2002 UndefinedType, E2003 TypeUnificationFailure, etc.
// E2002 bool-as-type — source wrote `bool`; the language type is `boolean`
// E2018 BindingMissingTypeAnnotation — `name <- expr` without `: <type>` (§8.3.1)

// Effect checker error codes
// E3000 EffectErrorDefault, E3001 MissingEffectCapability, E3002 EffectNotActive, etc.

// SIR generator error codes (E4000-E4049)
// E4000 SIR default, E4001-E4049 reserved for SIR-specific errors

// Emitter error codes (E4050-E4099)
// E4050 Emitter default, E4051-E4099 reserved for emitter-specific errors

{-
- Prints a compiler error in the format specified by silica-specification.md §1.6.
- Uses line-by-line output (no int64_to_string) to produce human-readable and LLM-parseable format.
- Format: header line, file, line, column, offset, message, spec reference, metadata block.
-}
fn print_compiler_error(error_type: string, error_code: string, location: { file: string, line: int64, column: int64, offset: int64 }, message: string, spec_section: string) -> int8 {
    sequence proc[DeviceIO]
        // Human-readable header (line/column printed separately)
        println("❌ Compilation error: ");
        print(error_type);
        println(" error at ");
        println(location.file);
        print(" line: ");
        print_int64(location.line);
        println("");
        print(" column: ");
        print_int64(location.column);
        println("");
        println(error_code);
        println("");
        // Human-readable description
        println(message);
        print("See specification: spec:");
        println(spec_section);
        println("");
        // LLM-parseable metadata (line-by-line format, parseable without int64_to_string)
        println("<!-- SILICA-ERROR-METADATA");
        print("errorCode: ");
        println(error_code);
        println("errorType: error");
        print("file: ");
        println(location.file);
        print("line: ");
        print_int64(location.line);
        println("");
        print("column: ");
        print_int64(location.column);
        println("");
        print("offset: ");
        print_int64(location.offset);
        println("");
        print("specSection: ");
        println(spec_section);
        println("-->");
        result: int8 <- 0
    produces
        pure result
    end
}

{-
- Prints a compiler warning in the same structured shape as compiler errors.
- Warnings are advisory diagnostics only; callers must not USE them to fail compilation.
-}
fn print_compiler_warning(warning_type: string, warning_code: string, location: { file: string, line: int64, column: int64, offset: int64 }, message: string, spec_section: string) -> int8 {
    sequence proc[DeviceIO]
        println("WARNING:");
        print(warning_type);
        println(" at");
        println(location.file);
        print(" line: ");
        print_int64(location.line);
        println("");
        print(" column: ");
        print_int64(location.column);
        println("");
        println(warning_code);
        println("");
        println(message);
        print("See specification: spec:");
        println(spec_section);
        println("");
        println("<!-- SILICA-WARNING-METADATA");
        print("warningCode: ");
        println(warning_code);
        println("diagnosticType: warning");
        print("file: ");
        println(location.file);
        print("line: ");
        print_int64(location.line);
        println("");
        print("column: ");
        print_int64(location.column);
        println("");
        print("offset: ");
        print_int64(location.offset);
        println("");
        print("specSection: ");
        println(spec_section);
        println("-->");
        result: int8 <- 0
    produces
        pure result
    end
}
