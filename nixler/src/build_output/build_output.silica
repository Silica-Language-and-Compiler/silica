// Build output: write assembly and other compiler artifacts to disk
// Single responsibility: given source path and content, write the .sams file

export write_assembly/2;
export write_runtime_assembly/1;
export write_link_manifest/1;

// Write assembly to a .sams file derived from the source path.
// e.g. "test.silica" -> "test.sams", "path/to/foo.silica" -> "path/to/foo.sams"
// Returns 0 on success (caller may ignore)
// Ensures assembly ends with newline to avoid .byte 10.text concatenation when assembler reads.
fn write_assembly(source_path: string, asm: string) -> int64 {
    sequence proc[DeviceIO]
        output_path: string <- sams_path_from_source(source_path);
        delete_file(output_path);
        asm_terminated: string <- concat(asm, "\n");
        appended: boolean <- append_file(output_path, asm_terminated);
        result: int64 <- 0
    produces
        pure result
    end
}

fn write_runtime_assembly(asm: string) -> int64 {
    sequence proc[DeviceIO]
        output_path: string <- "__silica_runtime.sams";
        delete_file(output_path);
        asm_terminated: string <- concat(asm, "\n");
        appended: boolean <- append_file(output_path, asm_terminated);
        result: int64 <- 0
    produces
        pure result
    end
}

// Write or clear silica.link (Phase 9 link manifest). Empty content removes the file.
fn write_link_manifest(content: string) -> int64 {
    sequence proc[DeviceIO]
        output_path: string <- "silica.link";
        delete_file(output_path);
        result: int64 <- case length_bytes(content) == 0 of {
            true -> 0;
            false -> {
                manifest: string <- case ends_with(content, "\n") of {
                    true -> content;
                    false -> concat(content, "\n")
                };
                appended: boolean <- append_file(output_path, manifest);
                0
            }
        }
    produces
        pure result
    end
}

// Derive .sams output path from source path.
// Workaround: use explicit steps and variable for suffix to avoid bootstrap concat bug
// that can drop the second argument when used inline in case branches.
fn sams_path_from_source(source_path: string) -> string {
    suffix: string <- ".sams";
    case ends_with(source_path, ".silica") of {
        true -> {
            base_end: int64 <- length_bytes(source_path) - 7;
            base: string <- substring(source_path, 0, base_end);
            concat(base, suffix)
        };
        false -> concat(source_path, suffix)
    }
}
